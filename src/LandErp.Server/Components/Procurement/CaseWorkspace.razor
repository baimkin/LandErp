@using System.ComponentModel.DataAnnotations
@using LandErp.Application.Modules.Procurement.Contracts
@using LandErp.Application.Modules.Procurement.Domain
@using Microsoft.AspNetCore.Components.Forms
@inherits WorkspaceComponent
@inject IProcurementWorkspace Workspace

@if(Loading) { <PageState Kind="loading" Title="Открываем объект…" /> }
else if(Forbidden) { <PageState Kind="forbidden" Title="Нет доступа к объекту" /> }
else if(card!=null)
{
    @if(Error!=null) { <PageState Kind="error" Title="@Error"><ActionButton Label="Обновить карточку" OnClick="ReloadAsync" /></PageState> }
    @if(Success!=null) { <PageState Kind="success" Title="@Success" /> }
    <div class="stack case-workspace" data-case-version="@card.Item.CaseVersion">
        <section class="case-titlebar">
            <div><span class="kicker">@card.Item.BusinessNumber</span><h2>@card.Item.Title</h2><p>@(card.Item.Location??"Местоположение уточняется") · @(card.Item.Assignee??"Ответственный не назначен")</p></div>
            <div class="case-title-actions">@foreach(var source in card.Item.Sources) { <SourceBadge Source="source" /> }<StatusBadge Label="@ProcurementLabels.Stage(card.Item.Stage)" Tone="@(card.Item.Stage=="acquired" ? "success" : card.Item.Stage=="returned" ? "warning" : "info")" />@if(card.CanConfirmPurchase&&card.Item.Stage!="acquired"){<button class="btn primary" @onclick="OpenPurchase">Отметить как куплено</button>}</div>
        </section>

        @if(card.Item.Stage=="acquired")
        {
            <section class="surface case-acquired-banner">
                <div><span class="kicker">Закупка завершена</span><h3>Объект куплен</h3></div>
                <div><small>Фактическая цена</small><strong>@ProcurementLabels.Money(card.AcquisitionPrice)</strong></div>
                <div><small>Дата покупки / регистрации</small><strong>@(card.AcquisitionDate?.ToString("dd.MM.yyyy")??"Не указана")</strong></div>
                @if(!string.IsNullOrWhiteSpace(card.AcquisitionComment)){<p>@card.AcquisitionComment</p>}
                @if(card.CanConfirmPurchase){<button class="btn secondary" @onclick="OpenCorrection">Исправить данные покупки</button>}
            </section>
        }

        <section class="case-hero">
            <article class="surface case-object-card">
                @if(card.Photos.Length>0) { <a class="case-cover" href="@card.Photos[0]" target="_blank" rel="noopener noreferrer"><img src="@card.Photos[0]" alt="Фото объекта из источника" referrerpolicy="no-referrer" /></a> }
                else { <div class="case-cover empty">Фото объекта пока нет</div> }
                <div class="case-object-facts"><h3>Рабочие факты</h3><div class="facts-grid"><div><small>Площадь</small><strong>@ProcurementLabels.Area(card.Item.Area)</strong></div><div><small>Кадастровый номер</small><strong>@(card.CadastralNumber??"Не указан")</strong></div><div><small>Источники</small><strong>@SourceSummary()</strong></div></div>
                @if(card.Item.Changed) { <p class="case-warning">Источник изменился. Рабочие факты не перезаписаны — проверьте вкладку «Источники».</p> }</div>
            </article>
            <div class="case-side-stack">
                <article class="surface"><h3>Цена и торг</h3><div class="price-grid"><div><small>Публичная / рабочая</small><strong>@ProcurementLabels.Money(card.Item.Price)</strong></div><div><small>Продавец</small><strong>@ProcurementLabels.Money(card.Negotiations.Select(x=>x.SellerPrice).FirstOrDefault(x=>x!=null))</strong></div><div><small>Мы</small><strong>@ProcurementLabels.Money(card.Negotiations.Select(x=>x.BuyerOffer).FirstOrDefault(x=>x!=null))</strong></div><div><small>@(card.Item.Stage=="acquired"?"Факт покупки":"Согласовано")</small><strong>@ProcurementLabels.Money(card.Item.Stage=="acquired"?card.AcquisitionPrice:card.Negotiations.Select(x=>x.AgreedPrice).FirstOrDefault(x=>x!=null))</strong></div></div><p class="subtle">Публичная цена источника и CRM-переговоры — разные факты.</p></article>
                <article class="surface"><h3>Следующее действие</h3><strong>@NextAction()</strong>@if(!string.IsNullOrWhiteSpace(card.Item.NextActionDescription)){<p>@card.Item.NextActionDescription</p>}<p class="subtle">Ответственный: @(card.Item.Assignee??"не назначен") · срок: @ProcurementLabels.Time(card.Item.DueAt)</p></article>
            </div>
        </section>

        <nav class="case-tabs" aria-label="Разделы карточки">@foreach((string id,string label) in Tabs) { <button type="button" class="case-tab @(tab==id?"active":"")" @onclick="()=>tab=id">@label</button> }</nav>

        @if(tab=="overview")
        {
            <section class="case-dashboard"><div class="stack">
                <article class="surface"><div class="section-heading"><h3>Последние переговоры</h3><div class="form-actions"><button class="btn quiet" @onclick='()=>tab="negotiations"'>Все переговоры</button>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<button class="btn primary" @onclick="OpenNegotiation">Добавить контакт</button>}</div></div>@if(card.Negotiations.Count==0){<p class="subtle">Контакты ещё не зафиксированы.</p>}@foreach(var item in card.Negotiations.Take(3)){<div class="dossier-row"><strong>@NegotiationTitle(item)</strong><small>@item.Outcome · @ProcurementLabels.Time(item.EffectiveAt)</small></div>}</article>
                <article class="surface"><div class="section-heading"><h3>Проверки</h3><button class="btn quiet" @onclick='()=>tab="checks"'>Открыть</button></div><div class="check-summary"><div><strong>Базовые · @card.Checks.Count(x=>x.Level==CaseCheckLevel.Quick)</strong><small>@CheckSummary(CaseCheckLevel.Quick)</small></div><div><strong>Глубокие · @card.Checks.Count(x=>x.Level==CaseCheckLevel.Deep)</strong><small>@CheckSummary(CaseCheckLevel.Deep)</small></div></div>@foreach(var blocker in card.Checks.Where(x=>x.Blocker)){<p class="case-problem">@blocker.Title: @blocker.Result</p>}</article>
                <article class="surface"><h3>Осмотр</h3>@if(card.Inspection==null){<p class="subtle">Осмотр ещё не начат.</p>}else{<strong>@(card.Inspection.Status==InspectionStatus.Completed?"Осмотр завершён":"Черновик осмотра")</strong><p class="subtle">@card.Inspection.OverallConclusion</p>}</article>
            </div><div class="stack">
                <article class="surface"><h3>Готовность досье</h3><strong>@ReadinessPercent()%</strong><p class="subtle">Проверки: @CompletedChecks()/@card.Checks.Count · документы: @ReadyDocuments()/@card.DocumentRequirements.Count · осмотр: @(card.Inspection?.Status==InspectionStatus.Completed?"завершён":"не завершён")</p>@if(OpenRisks()>0){<p class="case-problem">Открытых рисков: @OpenRisks(). Перед покупкой руководителю нужно оценить их вручную.</p>}@if(MissingDocuments()>0){<p class="case-problem">Не получено документов: @MissingDocuments().</p>}</article>
                <article class="surface"><h3>Последние события</h3><BusinessTimeline Items="card.Timeline.Take(5).ToArray()" /></article>
                <article class="surface"><h3>Следующее решение</h3><div class="decision-actions">@if(card.CanManagerDecide){<ActionButton Label="Наблюдать" Tone="secondary" OnClick='()=>Open(ProcurementAction.Monitor,"Наблюдать")' /><ActionButton Label="Уточнить" Tone="secondary" OnClick='()=>Open(ProcurementAction.Clarify,"Уточнить")' /><ActionButton Label="Отклонить" Tone="secondary" OnClick='()=>Open(ProcurementAction.Reject,"Отклонить")' /><ActionButton Label="Передать руководителю" OnClick='()=>Open(ProcurementAction.Forward,"Передать руководителю")' />}else if(card.CanHeadDecide){<ActionButton Label="Вернуть менеджеру" Tone="secondary" OnClick='()=>Open(ProcurementAction.Return,"Вернуть менеджеру")' /><ActionButton Label="Продолжить работу" OnClick='()=>Open(ProcurementAction.Approve,"Одобрить")' /><ActionButton Label="Наблюдать" Tone="secondary" OnClick='()=>Open(ProcurementAction.Monitor,"Наблюдать")' /><ActionButton Label="Отклонить" Tone="secondary" OnClick='()=>Open(ProcurementAction.Reject,"Отклонить")' />}else{<p class="subtle">Решение ожидает текущего исполнителя либо этап уже завершён.</p>}</div></article>
                @if(card.CanManagerDecide || card.CanHeadDecide){<article class="surface"><h3>Рабочая заметка</h3><EditForm Model="note" FormName="case-note" OnValidSubmit="SaveNoteAsync"><DataAnnotationsValidator /><ValidationSummary /><label class="field"><span>Комментарий</span><textarea @bind="note.Text" maxlength="4000"></textarea></label><ActionButton Label="Сохранить заметку" Type="submit" Busy="Busy" Disabled="@(string.IsNullOrWhiteSpace(note.Text))" /></EditForm></article>}
            </div></section>
        }
        else if(tab=="negotiations")
        {
            <section class="stack"><article class="surface"><div class="section-heading"><div><h3>Переговоры</h3><p class="subtle">Одна запись — одно событие коммуникации. Цена необязательна; несколько цен одного разговора сохраняются вместе.</p></div>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<button class="btn primary" @onclick="OpenNegotiation">Добавить контакт</button>}</div>@if(card.Negotiations.Count==0){<PageState Kind="empty" Title="Переговоров пока нет" />}@foreach(var item in card.Negotiations){<div class="dossier-row"><div><strong>@NegotiationTitle(item)</strong><small>@Meta(item.Channel,item.Contact,item.Author,ProcurementLabels.Time(item.EffectiveAt))</small><p>@item.Outcome</p>@if(item.SellerPrice!=null||item.BuyerOffer!=null||item.AgreedPrice!=null){<p class="subtle">Продавец: @ProcurementLabels.Money(item.SellerPrice) · Мы: @ProcurementLabels.Money(item.BuyerOffer) · Согласовано: @ProcurementLabels.Money(item.AgreedPrice)</p>}@if(item.Conditions.Length>0){<p class="subtle">Условия: @item.Conditions</p>}@if(item.Comment.Length>0){<p>@item.Comment</p>}@if(item.NextStep.Length>0){<p class="subtle">Следующий шаг: @item.NextStep · @ProcurementLabels.Time(item.NextStepDueAt)</p>}</div></div>}</article>
            </section>
        }
        else if(tab=="checks")
        {
            <section class="stack"><div class="section-heading"><div><h2>Проверки объекта</h2><p class="subtle">Быстрые проверки выполняются раньше, глубокие — когда объект реально рассматривается к покупке.</p></div>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<button class="btn primary" @onclick="OpenCheck">Добавить проверку</button>}</div><div class="check-columns">@foreach(var level in Enum.GetValues<CaseCheckLevel>()){<article class="surface"><h3>@ProcurementLabels.CheckLevel(level)</h3><p class="subtle">@(level==CaseCheckLevel.Quick?"Ранний структурированный скрининг.":"Юридические и иные углублённые проверки после решения руководителя.")</p>@foreach(var item in card.Checks.Where(x=>x.Level==level)){<div class="dossier-row @(item.Blocker?"blocker":"")"><strong>@item.Title · @ProcurementLabels.CheckStatus(item.Status)</strong><small>@(item.Responsible??"Ответственный не назначен") · @ProcurementLabels.Time(item.DueAt)</small><p>@item.Result</p>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<button class="btn quiet" @onclick="()=>EditCheck(item)">Изменить</button>}</div>}@if(!card.Checks.Any(x=>x.Level==level)){<p class="subtle">Записей пока нет.</p>}</article>}</div>
            @if(card.CanManageDossier){<details class="surface"><summary>Справочник типовых проверок</summary>@foreach(var item in card.CheckTemplates){<div class="dossier-row"><div><strong>@item.Title</strong><small>@ProcurementLabels.CheckLevel(item.Level) · порядок @item.SortOrder · @(item.Active?"активна":"неактивна")</small><p>@item.Description</p></div><button class="btn quiet" @onclick="()=>EditCheckTemplate(item)">Изменить</button></div>}<EditForm Model="checkTemplate" FormName="check-template" OnValidSubmit="SaveCheckTemplateAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field dossier-wide"><span>Название</span><input @bind="checkTemplate.Title" /></label><label class="field"><span>Уровень</span><InputSelect @bind-Value="checkTemplate.Level"><option value="Quick">Базовая</option><option value="Deep">Глубокая</option></InputSelect></label><label class="field"><span>Порядок</span><InputNumber @bind-Value="checkTemplate.SortOrder" /></label><label class="field dossier-wide"><span>Описание</span><textarea @bind="checkTemplate.Description"></textarea></label><label class="check-field"><InputCheckbox @bind-Value="checkTemplate.Active" /> Активна</label><div class="form-actions"><ActionButton Label="Сохранить в справочник" Type="submit" Busy="Busy" /></div></div></EditForm></details>}
            </section>
        }
        else if(tab=="inspection")
        { <article class="surface"><div class="section-heading"><h3>Осмотр</h3>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<div class="form-actions">@if(card.Inspection!=null){<button class="btn secondary" @onclick='()=>OpenInspectionAttachment($"i:{card.Inspection.Id}")'>Добавить общий материал</button>}<a class="btn primary" href="/procurement/@CaseId/inspection">@(card.Inspection==null?"Начать осмотр":"Открыть форму осмотра")</a></div>}</div>@if(card.Inspection==null){<PageState Kind="empty" Title="Осмотр ещё не проведён" />}else{<p><strong>@(card.Inspection.Status==InspectionStatus.Completed?"Завершён":"Черновик")</strong> · @card.Inspection.Inspector · @ProcurementLabels.Time(card.Inspection.CompletedAt??card.Inspection.StartedAt)</p><p>@card.Inspection.OverallConclusion</p>@foreach(var media in card.Attachments.Where(x=>x.OwnerType==CaseAttachmentOwner.Inspection)){<a class="btn quiet" href="/api/procurement/attachments/@media.Id" target="_blank" rel="noopener">@media.Label ↗</a>}<div class="inspection-results">@foreach(var item in card.Inspection.Items){<div class="dossier-row @(InspectionProblem(item)?"blocker":"")"><div><strong>@item.Title</strong><small>@InspectionAnswer(item)</small>@if(item.Note.Length>0){<p>@item.Note</p>}@foreach(var media in card.Attachments.Where(x=>x.OwnerType==CaseAttachmentOwner.InspectionItem&&x.OwnerId==item.Id)){<a class="btn quiet" href="/api/procurement/attachments/@media.Id" target="_blank" rel="noopener">@media.Label · @ProcurementLabels.AttachmentKind(media.Kind) ↗</a>}</div>@if(card.CanManageDossier&&card.Item.Stage!="acquired"&&item.AllowAttachments){<button class="btn secondary" @onclick='()=>OpenInspectionAttachment($"ii:{item.Id}")'>Добавить материал</button>}</div>}</div>}</article> }
        else if(tab=="documents")
        {
            <section class="stack"><article class="surface"><div class="section-heading"><div><h2>Документы</h2><p class="subtle">Полученные файлы, недостающие документы и их назначение в проверках.</p></div>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<button class="btn primary" @onclick="()=>OpenAttachment(null)">Добавить документ</button>}</div>@foreach(var item in card.DocumentRequirements){<div class="dossier-row @(item.Status==CaseDocumentStatus.Missing?"blocker":"")"><div><strong>@item.Title · @ProcurementLabels.DocumentStatus(item.Status)</strong><small>@item.ExpectedSource · обновил @item.UpdatedBy · @ProcurementLabels.Time(item.UpdatedAt)</small><p>@item.Description</p>@if(item.DueAt!=null){<p class="subtle">Срок: @ProcurementLabels.Time(item.DueAt)</p>}@if(item.Note.Length>0){<p>@item.Note</p>}@foreach(var attachmentId in item.AttachmentIds){<a class="btn quiet" href="/api/procurement/attachments/@attachmentId" target="_blank" rel="noopener">Открыть документ ↗</a>}</div>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<div class="form-actions"><button class="btn secondary" @onclick="()=>OpenAttachment(item.Id)">Прикрепить</button><button class="btn quiet" @onclick="()=>EditDocumentRequirement(item)">Изменить статус</button></div>}</div>}</article>
            <article class="surface"><h3>Прочие вложения</h3>@foreach(var item in card.Attachments.Where(x=>x.DocumentRequirementId==null)){<div class="dossier-row"><div><strong>@item.Label</strong><small>@item.OwnerLabel · @ProcurementLabels.AttachmentKind(item.Kind) · @ProcurementLabels.FileStatus(item.Status) · @FormatSize(item.SizeBytes)</small>@if(item.Description.Length>0){<p>@item.Description</p>}</div>@if(item.Status==LandErp.Application.Foundation.Files.StoredFileStatus.Available){<a class="btn secondary" href="/api/procurement/attachments/@item.Id" target="_blank" rel="noopener">Открыть ↗</a>}else if(item.Status==LandErp.Application.Foundation.Files.StoredFileStatus.UploadFailed){<button class="btn secondary" @onclick="()=>retryAttachmentId=item.Id">Повторить загрузку</button>}</div>}@if(!card.Attachments.Any(x=>x.DocumentRequirementId==null)){<p class="subtle">Прочих вложений нет.</p>}</article>
            @if(retryAttachmentId!=null){<article class="surface"><h3>Повторная загрузка материала</h3><InputFile OnChange="SelectRetryFile" /><small>@(retryFile?.Name??"Выберите исходный файл повторно")</small><div class="form-actions"><button class="btn secondary" @onclick="()=>retryAttachmentId=null">Отмена</button><ActionButton Label="Повторить загрузку" OnClick="RetryAttachmentAsync" Busy="Busy" Disabled="@(retryFile==null)" /></div></article>}
            </section>
        }
        else if(tab=="history") { <article class="surface"><h3>История PropertyCase</h3><p class="subtle">Бизнес-хронология не заменяет системный аудит.</p><BusinessTimeline Items="card.Timeline" /></article> }
        else if(tab=="sources")
        {
            <section class="stack"><article class="surface"><h3>Источники</h3>@if(card.Sources.Count==0){<p class="subtle">PropertyCase существует без внешних источников.</p>}@foreach(var source in card.Sources){<div class="dossier-row"><div><SourceBadge Source="source.Source" /><strong>@source.Title</strong><small>@source.Provenance · @(source.ExternalId??"без внешнего ID") · @ProcurementLabels.Money(source.Price)</small></div>@if(source.Url!=null){<a class="btn secondary" href="@source.Url" target="_blank" rel="noopener noreferrer">Открыть источник ↗</a>}</div>}</article>
            <article class="surface"><h3>Изменения в источниках</h3>@if(card.Observations.Count==0){<p class="subtle">Наблюдений пока нет.</p>}@foreach(var item in card.Observations.Take(20)){<div class="dossier-row"><div><strong>@ProcurementLabels.Time(item.ObservedAt)</strong><small>@(item.Changes.Length==0?"Первое наблюдение":string.Join(" · ",item.Changes))</small><p>@(item.Data.Title.Raw??"Без названия") · @ProcurementLabels.Money(item.Data.Price.Parsed)</p></div></div>}</article>
            <article class="surface"><h3>Расхождения с рабочими фактами</h3><p class="subtle">Источник никогда не перезаписывает подтверждённое значение автоматически.</p>@foreach(var item in card.Discrepancies.Where(x=>x.Different)){<div class="dossier-row"><div><strong>@ProcurementLabels.Fact(item.Field) · @item.Source</strong><small>Рабочее: @item.WorkingValue · источник: @item.SourceValue</small></div>@if(card.CanManageDossier){<button class="btn secondary" @onclick="()=>ApplyFactAsync(item)">Применить явно</button>}</div>}@if(!card.Discrepancies.Any(x=>x.Different)){<p class="subtle">Расхождений нет.</p>}</article></section>
        }
    </div>
    @if(dialogAction!=null) { <DecisionDialog Card="card" Action="@dialogAction.Value" Title="@dialogTitle" OnConfirm="ConfirmAsync" OnClose="CloseDialog" Busy="Busy" Error="Error" /> }
    @if(negotiationOpen){<Modal Title="Добавить контакт / переговоры" OnClose="()=>negotiationOpen=false"><EditForm Model="negotiation" FormName="negotiation" OnValidSubmit="SaveNegotiationAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field"><span>Цена продавца, ₽ (необязательно)</span><InputNumber @bind-Value="negotiation.SellerPrice" /></label><label class="field"><span>Наше предложение, ₽ (необязательно)</span><InputNumber @bind-Value="negotiation.BuyerOffer" /></label><label class="field"><span>Согласованная цена, ₽ (необязательно)</span><InputNumber @bind-Value="negotiation.AgreedPrice" /></label><label class="field"><span>Канал</span><input @bind="negotiation.Channel" /></label><label class="field"><span>Контакт</span><input @bind="negotiation.Contact" /></label><label class="field dossier-wide"><span>Результат / статус</span><textarea @bind="negotiation.Outcome" placeholder="Не дозвонились, получили документы, договорились о показе…"></textarea></label><label class="field dossier-wide"><span>Условия</span><textarea @bind="negotiation.Conditions"></textarea></label><label class="field"><span>Следующий шаг</span><input @bind="negotiation.NextStep" /></label><label class="field"><span>Срок следующего шага (МСК)</span><input type="datetime-local" value="@negotiation.NextDue" @oninput="e=>negotiation.NextDue=e.Value?.ToString()??string.Empty" /></label><label class="field"><span>Фактическое время (МСК)</span><input type="datetime-local" value="@negotiation.Effective" @oninput="e=>negotiation.Effective=e.Value?.ToString()??string.Empty" /></label><label class="field dossier-wide"><span>Комментарий</span><textarea @bind="negotiation.Comment"></textarea></label><div class="form-actions"><button type="button" class="btn secondary" @onclick="()=>negotiationOpen=false">Отмена</button><ActionButton Label="Сохранить контакт" Type="submit" Busy="Busy" /></div></div></EditForm></Modal>}
    @if(checkOpen){<Modal Title="@(check.Id==null?"Добавить проверку":"Обновить проверку")" OnClose="()=>checkOpen=false"><EditForm Model="check" FormName="case-check" OnValidSubmit="SaveCheckAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid">@if(check.Id==null){<label class="field dossier-wide"><span>Типовая проверка (необязательно)</span><select @bind="check.TemplateKey" @bind:after="UseCheckTemplate"><option value="">Вручную</option>@foreach(var item in card.CheckTemplates.Where(x=>x.Active)){<option value="@item.Id">@item.Title · @ProcurementLabels.CheckLevel(item.Level)</option>}</select></label>}<label class="field"><span>Уровень</span><InputSelect @bind-Value="check.Level">@foreach(var value in Enum.GetValues<CaseCheckLevel>()){<option value="@value">@ProcurementLabels.CheckLevel(value)</option>}</InputSelect></label><label class="field"><span>Статус</span><InputSelect @bind-Value="check.Status">@foreach(var value in Enum.GetValues<CaseCheckStatus>()){<option value="@value">@ProcurementLabels.CheckStatus(value)</option>}</InputSelect></label><label class="field dossier-wide"><span>Название</span><input @bind="check.Title" /></label><label class="field"><span>Ответственный</span><select @bind="check.Responsible"><option value="">Не назначен</option>@foreach(var employee in card.Managers.Concat(card.Heads).DistinctBy(x=>x.EmployeeId)){<option value="@employee.EmployeeId">@employee.Name</option>}</select></label><label class="field"><span>Срок (МСК)</span><input type="datetime-local" value="@check.Due" @oninput="e=>check.Due=e.Value?.ToString()??string.Empty" /></label><label class="field dossier-wide"><span>Результат / заключение</span><textarea @bind="check.Result"></textarea></label><label class="field"><span>Стоимость, ₽</span><InputNumber @bind-Value="check.Cost" /></label><label class="check-field dossier-wide"><InputCheckbox @bind-Value="check.Blocker" disabled="@(!card.CanManageBlockers)" /> Блокирует дальнейшее решение (только руководитель)</label><div class="form-actions"><button type="button" class="btn secondary" @onclick="()=>checkOpen=false">Отмена</button><ActionButton Label="Сохранить проверку" Type="submit" Busy="Busy" /></div></div></EditForm></Modal>}
    @if(attachmentOpen){<Modal Title="Добавить материал" OnClose="CloseAttachment"><EditForm Model="attachment" FormName="attachment" OnValidSubmit="SaveAttachmentAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field dossier-wide"><span>Пункт документов (необязательно)</span><select @bind="attachment.RequirementKey" @bind:after="UseDocumentRequirement"><option value="">Не относится к обязательному документу</option>@foreach(var item in card.DocumentRequirements){<option value="@item.Id">@item.Title · @ProcurementLabels.DocumentStatus(item.Status)</option>}</select></label><label class="field"><span>Связь</span><select @bind="attachment.OwnerKey"><option value="case">Весь объект</option>@foreach(var item in card.Negotiations){<option value="n:@item.Id">Переговоры · @ProcurementLabels.Time(item.EffectiveAt)</option>}@foreach(var item in card.Checks){<option value="c:@item.Id">Проверка · @item.Title</option>}@if(card.Inspection!=null){<option value="i:@card.Inspection.Id">Осмотр целиком</option>@foreach(var item in card.Inspection.Items.Where(x=>x.AllowAttachments)){<option value="ii:@item.Id">Пункт осмотра · @item.Title</option>}}</select></label><label class="field"><span>Тип</span><InputSelect @bind-Value="attachment.Kind">@foreach(var value in Enum.GetValues<CaseAttachmentKind>()){<option value="@value">@ProcurementLabels.AttachmentKind(value)</option>}</InputSelect></label><label class="field dossier-wide"><span>Название</span><input @bind="attachment.Label" /></label><label class="field dossier-wide"><span>Описание / комментарий</span><textarea @bind="attachment.Description"></textarea></label>@if(attachment.Kind==CaseAttachmentKind.Link){<label class="field dossier-wide"><span>HTTPS-ссылка</span><input type="url" @bind="attachment.Url" /></label>}else{<label class="field dossier-wide"><span>Файл до 8 МБ</span><InputFile OnChange="SelectFile" accept="@ProcurementLabels.Accept(attachment.Kind)" /><small>@(selectedFile?.Name??"Файл не выбран")</small></label>}<div class="form-actions"><button type="button" class="btn secondary" @onclick="CloseAttachment">Отмена</button><ActionButton Label="Добавить материал" Type="submit" Busy="Busy" /></div></div></EditForm></Modal>}
    @if(documentRequirementOpen){<Modal Title="Статус документа" OnClose="()=>documentRequirementOpen=false"><EditForm Model="documentRequirement" FormName="document-requirement" OnValidSubmit="SaveDocumentRequirementAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><div class="dossier-wide"><strong>@documentRequirement.Title</strong><p class="subtle">@documentRequirement.Description</p></div><label class="field"><span>Статус</span><InputSelect @bind-Value="documentRequirement.Status"><option value="Missing">Нет</option><option value="Requested">Запрошен</option>@if(documentRequirement.HasAttachment){<option value="Received">Получен</option><option value="Verified">Проверен</option>}</InputSelect></label><label class="field"><span>Срок (МСК)</span><input type="datetime-local" value="@documentRequirement.Due" @oninput="e=>documentRequirement.Due=e.Value?.ToString()??string.Empty" /></label><label class="field dossier-wide"><span>Комментарий</span><textarea @bind="documentRequirement.Note" maxlength="2000"></textarea></label><div class="form-actions"><button type="button" class="btn secondary" @onclick="()=>documentRequirementOpen=false">Отмена</button><ActionButton Label="Сохранить статус" Type="submit" Busy="Busy" /></div></div></EditForm></Modal>}
    @if(purchaseOpen){<Modal Title="Отметить объект как купленный" OnClose="()=>purchaseOpen=false"><EditForm Model="purchase" FormName="acquire-case" OnValidSubmit="AcquireAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field"><span>Фактическая цена покупки, ₽</span><InputNumber @bind-Value="purchase.Price" /></label><label class="field"><span>Дата покупки / регистрации</span><InputDate @bind-Value="purchase.Date" /></label><label class="field dossier-wide"><span>Комментарий (необязательно)</span><textarea @bind="purchase.Comment"></textarea></label><p class="subtle dossier-wide">После подтверждения PropertyCase останется доступным со всей историей. Отдельная сделка или LandAsset не создаются.</p><div class="form-actions"><button type="button" class="btn secondary" @onclick="()=>purchaseOpen=false">Отмена</button><ActionButton Label="Подтвердить покупку" Type="submit" Busy="Busy" /></div></div></EditForm></Modal>}
    @if(correctionOpen){<Modal Title="Исправить данные покупки" OnClose="()=>correctionOpen=false"><EditForm Model="correction" FormName="correct-acquisition" OnValidSubmit="CorrectAcquisitionAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field"><span>Фактическая цена, ₽</span><InputNumber @bind-Value="correction.Price" /></label><label class="field"><span>Дата покупки / регистрации</span><InputDate @bind-Value="correction.Date" /></label><label class="field dossier-wide"><span>Комментарий</span><textarea @bind="correction.Comment"></textarea></label><label class="field dossier-wide"><span>Причина исправления</span><textarea @bind="correction.Reason" maxlength="1000"></textarea></label><p class="subtle dossier-wide">Предыдущие значения, причина и автор останутся в истории и системном аудите.</p><div class="form-actions"><button type="button" class="btn secondary" @onclick="()=>correctionOpen=false">Отмена</button><ActionButton Label="Сохранить исправление" Type="submit" Busy="Busy" /></div></div></EditForm></Modal>}
}
else { <PageState Kind="error" Title="Карточку не удалось загрузить"><ActionButton Label="Повторить" OnClick="ReloadAsync" /></PageState> }

@code {
    [Parameter] public Guid CaseId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private static readonly (string Id,string Label)[] Tabs=[("overview","Основное"),("negotiations","Переговоры"),("checks","Проверки"),("inspection","Осмотр"),("documents","Документы"),("history","История"),("sources","Источники")];
    private CaseCard? card; private Guid loaded; private string tab="overview"; private ProcurementAction? dialogAction; private string dialogTitle=""; private bool negotiationOpen; private bool checkOpen; private bool attachmentOpen; private bool documentRequirementOpen; private bool purchaseOpen; private bool correctionOpen;
    private NoteInput note=new(); private NegotiationInput negotiation=new(); private CheckInput check=new(); private CheckTemplateInput checkTemplate=new(); private AttachmentInput attachment=new(); private DocumentRequirementInput documentRequirement=new(); private PurchaseInput purchase=new(); private CorrectionInput correction=new(); private IBrowserFile? selectedFile; private Guid? retryAttachmentId; private IBrowserFile? retryFile;
    protected override async Task ReadAsync(){card=await Workspace.ReadCardAsync(CurrentSubject,CaseId,CancellationToken.None);loaded=CaseId;}
    protected override async Task OnParametersSetAsync(){if(loaded!=CaseId)await ReloadAsync();}
    private string SourceSummary()=>card!.Sources.Count==0?"Нет связанных":string.Join(" + ",card.Sources.Select(x=>ProcurementLabels.Source(x.Source)).Distinct());
    private static string NegotiationTitle(NegotiationView item)=>item.AgreedPrice!=null?"Согласована цена":item.BuyerOffer!=null?"Наше предложение":item.SellerPrice!=null?"Цена продавца":item.Outcome.Length>0?item.Outcome:"Событие коммуникации";
    private static string Meta(params string?[] values)=>string.Join(" · ",values.Where(x=>!string.IsNullOrWhiteSpace(x)));
    private string CheckSummary(CaseCheckLevel level)=>card!.Checks.Any(x=>x.Level==level&&x.Blocker)?"Есть блокирующие вопросы":card.Checks.Any(x=>x.Level==level)?"Проверки зафиксированы":"Не начаты";
    private string NextAction()=>card!.Item.Stage=="acquired"?"Закупка завершена":string.IsNullOrWhiteSpace(card.Item.NextActionTitle)?"Следующее действие не назначено":card.Item.NextActionTitle;
    private int CompletedChecks()=>card!.Checks.Count(x=>x.Status is CaseCheckStatus.Passed or CaseCheckStatus.Issue);
    private int OpenRisks()=>card!.Checks.Count(x=>x.Blocker&&x.Status!=CaseCheckStatus.Passed);
    private int ReadyDocuments()=>card!.DocumentRequirements.Count(x=>x.Status is CaseDocumentStatus.Received or CaseDocumentStatus.Verified);
    private int MissingDocuments()=>card!.DocumentRequirements.Count-ReadyDocuments();
    private int ReadinessPercent(){int parts=0,total=3;if(card!.Checks.Count>0&&CompletedChecks()==card.Checks.Count)parts++;if(card.DocumentRequirements.Count>0&&ReadyDocuments()==card.DocumentRequirements.Count)parts++;if(card.Inspection?.Status==InspectionStatus.Completed)parts++;return parts*100/total;}
    private void OpenNegotiation(){negotiation=new();negotiationOpen=true;}
    private void OpenCheck(){check=new();checkOpen=true;}
    private void OpenPurchase(){purchase=new(){Price=card!.Negotiations.Select(x=>x.AgreedPrice).FirstOrDefault(x=>x!=null)??card.Item.Price??0,Date=DateOnly.FromDateTime(DateTime.Today)};purchaseOpen=true;}
    private void OpenCorrection(){correction=new(){Price=card!.AcquisitionPrice??0,Date=card.AcquisitionDate??DateOnly.FromDateTime(DateTime.Today),Comment=card.AcquisitionComment??""};correctionOpen=true;}
    private void Open(ProcurementAction action,string title){dialogAction=action;dialogTitle=title;} private void CloseDialog()=>dialogAction=null;
    private async Task ConfirmAsync(DecisionDraft draft){await ExecuteAsync(()=>Workspace.DecideAsync(CurrentSubject,new(CaseId,card!.Item.CaseVersion,card.Item.SourceRevision,dialogAction!.Value,draft.Reason,draft.Clarification,draft.Target,ProcurementLabels.ParseLocal(draft.Due)),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null)dialogAction=null;await OnChanged.InvokeAsync();}
    private async Task SaveNoteAsync(){await ExecuteAsync(()=>Workspace.AddNoteAsync(CurrentSubject,new(CaseId,card!.Item.CaseVersion,note.Text,false,"",null),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null)note=new();}
    private async Task SaveNegotiationAsync(){await ExecuteAsync(()=>Workspace.AddNegotiationAsync(CurrentSubject,new(CaseId,card!.Item.CaseVersion,negotiation.SellerPrice,negotiation.BuyerOffer,negotiation.AgreedPrice,negotiation.Channel,negotiation.Contact,negotiation.Outcome,negotiation.Conditions,negotiation.Comment,negotiation.NextStep,ProcurementLabels.ParseLocal(negotiation.NextDue),ProcurementLabels.ParseLocal(negotiation.Effective)??DateTimeOffset.UtcNow),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null){negotiationOpen=false;negotiation=new();}}
    private async Task SaveCheckAsync(){Guid? responsible=Guid.TryParse(check.Responsible,out Guid value)?value:null;Guid? templateId=Guid.TryParse(check.TemplateKey,out Guid template)?template:null;await ExecuteAsync(()=>Workspace.SaveCheckAsync(CurrentSubject,new(CaseId,check.Id,card!.Item.CaseVersion,check.Version,check.Level,check.Title,check.Status,responsible,true,ProcurementLabels.ParseLocal(check.Due),check.Cost,check.Result,check.Blocker,templateId),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null){checkOpen=false;check=new();}}
    private void EditCheck(CheckView item){check=new(){Id=item.Id,Version=item.Version,Level=item.Level,Title=item.Title,Status=item.Status,Responsible=item.ResponsibleEmployeeId?.ToString()??"",Due=ProcurementLabels.LocalInput(item.DueAt),Cost=item.Cost,Result=item.Result,Blocker=item.Blocker};checkOpen=true;}
    private void UseCheckTemplate(){if(Guid.TryParse(check.TemplateKey,out Guid id)&&card!.CheckTemplates.FirstOrDefault(x=>x.Id==id) is { } item){check.Title=item.Title;check.Level=item.Level;}}
    private void EditCheckTemplate(CheckTemplateView item)=>checkTemplate=new(){Id=item.Id,Version=item.Version,Title=item.Title,Level=item.Level,Description=item.Description,SortOrder=item.SortOrder,Active=item.Active};
    private async Task SaveCheckTemplateAsync(){await ExecuteAsync(()=>Workspace.SaveCheckTemplateAsync(CurrentSubject,new(checkTemplate.Id,checkTemplate.Version,checkTemplate.Title,checkTemplate.Level,checkTemplate.Description,checkTemplate.SortOrder,checkTemplate.Active),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null)checkTemplate=new();}
    private void SelectFile(InputFileChangeEventArgs args)=>selectedFile=args.File;
    private void SelectRetryFile(InputFileChangeEventArgs args)=>retryFile=args.File;
    private async Task RetryAttachmentAsync(){if(retryAttachmentId==null||retryFile==null)return;await using Stream input=retryFile.OpenReadStream(8*1024*1024);using MemoryStream buffer=new();await input.CopyToAsync(buffer);await ExecuteAsync(()=>Workspace.RetryAttachmentAsync(CurrentSubject,new(CaseId,retryAttachmentId.Value,retryFile.Name,retryFile.ContentType,buffer.ToArray()),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null){retryAttachmentId=null;retryFile=null;}}
    private void OpenAttachment(Guid? requirementId){attachment=new(){RequirementKey=requirementId?.ToString()??""};UseDocumentRequirement();selectedFile=null;attachmentOpen=true;}
    private void OpenInspectionAttachment(string ownerKey){attachment=new(){OwnerKey=ownerKey,Kind=CaseAttachmentKind.Photo};selectedFile=null;attachmentOpen=true;}
    private void CloseAttachment(){attachmentOpen=false;attachment=new();selectedFile=null;}
    private void UseDocumentRequirement(){if(Guid.TryParse(attachment.RequirementKey,out Guid id)&&card!.DocumentRequirements.FirstOrDefault(x=>x.Id==id) is { } item){attachment.Kind=CaseAttachmentKind.Document;attachment.OwnerKey="case";if(string.IsNullOrWhiteSpace(attachment.Label))attachment.Label=item.Title;}}
    private async Task SaveAttachmentAsync(){byte[]? content=null;string name="";string type="";if(attachment.Kind!=CaseAttachmentKind.Link){if(selectedFile==null){await ExecuteAsync(()=>Task.FromException(new ArgumentException("Выберите файл.")));return;}await using Stream input=selectedFile.OpenReadStream(8*1024*1024);using MemoryStream buffer=new();await input.CopyToAsync(buffer);content=buffer.ToArray();name=selectedFile.Name;type=selectedFile.ContentType;}ParseOwner(attachment.OwnerKey,out CaseAttachmentOwner owner,out Guid? ownerId);Guid? requirementId=Guid.TryParse(attachment.RequirementKey,out Guid requirement)?requirement:null;await ExecuteAsync(()=>Workspace.AddAttachmentAsync(CurrentSubject,new(CaseId,owner,ownerId,attachment.Kind,attachment.Label,attachment.Description,name,type,content,attachment.Kind==CaseAttachmentKind.Link?attachment.Url:null,requirementId),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null)CloseAttachment();}
    private void EditDocumentRequirement(DocumentRequirementView item){documentRequirement=new(){Id=item.Id,Version=item.Version,Title=item.Title,Description=item.Description,Status=item.Status,Due=ProcurementLabels.LocalInput(item.DueAt),Note=item.Note,HasAttachment=card!.Attachments.Any(x=>item.AttachmentIds.Contains(x.Id)&&x.Status==LandErp.Application.Foundation.Files.StoredFileStatus.Available)};documentRequirementOpen=true;}
    private async Task SaveDocumentRequirementAsync(){await ExecuteAsync(()=>Workspace.SaveDocumentRequirementAsync(CurrentSubject,new(CaseId,documentRequirement.Id,card!.Item.CaseVersion,documentRequirement.Version,documentRequirement.Status,ProcurementLabels.ParseLocal(documentRequirement.Due),documentRequirement.Note),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null){documentRequirementOpen=false;documentRequirement=new();}}
    private async Task AcquireAsync(){await ExecuteAsync(()=>Workspace.MarkAcquiredAsync(CurrentSubject,new(CaseId,card!.Item.CaseVersion,purchase.Price,purchase.Date,purchase.Comment),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null){purchaseOpen=false;purchase=new();}}
    private async Task CorrectAcquisitionAsync(){await ExecuteAsync(()=>Workspace.CorrectAcquisitionAsync(CurrentSubject,new(CaseId,card!.Item.CaseVersion,correction.Price,correction.Date,correction.Comment,correction.Reason),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null){correctionOpen=false;correction=new();}}
    private async Task ApplyFactAsync(SourceDiscrepancyView item)=>await ExecuteAsync(()=>Workspace.ApplySourceFactAsync(CurrentSubject,new(CaseId,item.CatalogItemId,card!.Item.CaseVersion,item.Field),Guid.CreateVersion7().ToString(),CancellationToken.None));
    private static void ParseOwner(string key,out CaseAttachmentOwner owner,out Guid? id){id=null;if(key.StartsWith("ii:",StringComparison.Ordinal)&&Guid.TryParse(key[3..],out Guid ii)){owner=CaseAttachmentOwner.InspectionItem;id=ii;}else if(key.StartsWith("i:",StringComparison.Ordinal)&&Guid.TryParse(key[2..],out Guid i)){owner=CaseAttachmentOwner.Inspection;id=i;}else if(key.StartsWith("n:",StringComparison.Ordinal)&&Guid.TryParse(key[2..],out Guid n)){owner=CaseAttachmentOwner.Negotiation;id=n;}else if(key.StartsWith("c:",StringComparison.Ordinal)&&Guid.TryParse(key[2..],out Guid c)){owner=CaseAttachmentOwner.Check;id=c;}else owner=CaseAttachmentOwner.Case;}
    private static string InspectionAnswer(InspectionItemView item)=>item.Status==InspectionItemStatus.NotChecked?"Не проверено":item.Status==InspectionItemStatus.Unanswered?"Нет ответа":item.Answer+(item.Unit.Length==0?"":" "+item.Unit);
    private static bool InspectionProblem(InspectionItemView item)=>item.Status==InspectionItemStatus.Answered&&item.NormalAnswer.Length>0&&!string.Equals(item.Answer,item.NormalAnswer,StringComparison.OrdinalIgnoreCase);
    private static string FormatSize(long size)=>size==0?"ссылка":size<1024?$"{size} Б":$"{size/1024d:N1} КБ";
    private sealed class NoteInput{[Required,MaxLength(4000)]public string Text{get;set;}="";}
    private sealed class NegotiationInput{public decimal? SellerPrice{get;set;}public decimal? BuyerOffer{get;set;}public decimal? AgreedPrice{get;set;}public string Channel{get;set;}="Звонок";public string Contact{get;set;}="Продавец";public string Outcome{get;set;}="";public string Conditions{get;set;}="";public string Comment{get;set;}="";public string NextStep{get;set;}="";public string NextDue{get;set;}="";public string Effective{get;set;}=ProcurementLabels.LocalInput(DateTimeOffset.UtcNow);}
    private sealed class CheckInput{public Guid? Id{get;set;}public long? Version{get;set;}public string TemplateKey{get;set;}="";public CaseCheckLevel Level{get;set;}public CaseCheckStatus Status{get;set;}public string Responsible{get;set;}="";[Required]public string Title{get;set;}="";public string Result{get;set;}="";public string Due{get;set;}="";public decimal? Cost{get;set;}public bool Blocker{get;set;}}
    private sealed class CheckTemplateInput{public Guid? Id{get;set;}public long? Version{get;set;}[Required]public string Title{get;set;}="";public CaseCheckLevel Level{get;set;}public string Description{get;set;}="";public int SortOrder{get;set;}=10;public bool Active{get;set;}=true;}
    private sealed class AttachmentInput{public string RequirementKey{get;set;}="";public string OwnerKey{get;set;}="case";public CaseAttachmentKind Kind{get;set;}=CaseAttachmentKind.Document;[Required]public string Label{get;set;}="";public string Description{get;set;}="";public string Url{get;set;}="";}
    private sealed class DocumentRequirementInput{public Guid Id{get;set;}public long Version{get;set;}public string Title{get;set;}="";public string Description{get;set;}="";public CaseDocumentStatus Status{get;set;}public string Due{get;set;}="";[MaxLength(2000)]public string Note{get;set;}="";public bool HasAttachment{get;set;}}
    private sealed class PurchaseInput{[Range(1,double.MaxValue)]public decimal Price{get;set;}[Required]public DateOnly Date{get;set;}=DateOnly.FromDateTime(DateTime.Today);[MaxLength(4000)]public string Comment{get;set;}="";}
    private sealed class CorrectionInput{[Range(1,double.MaxValue)]public decimal Price{get;set;}[Required]public DateOnly Date{get;set;}=DateOnly.FromDateTime(DateTime.Today);[MaxLength(4000)]public string Comment{get;set;}="";[Required,MinLength(3),MaxLength(1000)]public string Reason{get;set;}="";}
}
