        bool recorded = await ExecuteConfirmedAsync(() => Workspace.RegisterViewAsync(CurrentSubject, id,
            Guid.CreateVersion7().ToString(), CancellationToken.None), nameof(OpenDetailAsync));
        Success = null;
        return recorded;
