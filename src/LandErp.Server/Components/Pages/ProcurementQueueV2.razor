            <div class="mf modal-pager"><span>@NegotiationHistoryCaption</span><div><button class="btn" type="button" disabled="@(negotiationHistory == null || negotiationHistory.Offset == 0 || negotiationsLoading)" @onclick="PreviousNegotiationsAsync">‹</button><button class="btn" type="button" disabled="@(negotiationHistory == null || negotiationHistory.Offset + negotiationHistory.Size >= negotiationHistory.Total || negotiationsLoading)" @onclick="NextNegotiationsAsync">›</button></div></div>
        </div>
    </div>
}

@if (inspectionReportOpen && detail != null)
{
    <div class="modalBack on" @onclick="CloseInspectionReport">
        <div class="modal history-modal" @onclick:stopPropagation="true">
            <div class="mh"><div class="grow"><b>Результат осмотра</b><div class="sub">@detail.BusinessNumber · Результаты осмотра</div></div><button class="btn" type="button" @onclick="CloseInspectionReport">×</button></div>
            <div class="mb history-body">
                @if (inspectionReportLoading)
                {
                    <div class="modal-state">Загружаем результат осмотра…</div>
                }
                else if (inspectionReportError != null)
                {
                    <div class="modal-state error">@inspectionReportError</div>
                }
                else if (inspectionReport == null)
                {
                    <div class="modal-state">Осмотр ещё не проводился.</div>
                }
                else
                {
                    <section class="inspection-report-head">
                        <div><span>Статус</span><b>@(inspectionReport.Status == InspectionStatus.Completed ? "Завершён" : "Черновик")</b></div>
                        <div><span>Инспектор</span><b>@inspectionReport.Inspector</b></div>
                        <div><span>Дата</span><b>@(inspectionReport.CompletedAt is { } completedAt ? ShortDateTime(completedAt) : inspectionReport.StartedAt is { } startedAt ? ShortDateTime(startedAt) : "—")</b></div>
                    </section>
                    @if (!string.IsNullOrWhiteSpace(inspectionReport.OverallConclusion)) { <div class="report-note"><b>Итог</b><p>@inspectionReport.OverallConclusion</p></div> }
                    @if (!string.IsNullOrWhiteSpace(inspectionReport.PreliminaryDecision)) { <div class="report-note"><b>Предварительное решение</b><p>@inspectionReport.PreliminaryDecision</p></div> }
                    <div class="material-list report-materials">
                        @foreach (ProcurementQueueV2Attachment attachment in inspectionReport.Attachments)
                        {
                            @if (attachment.Status == StoredFileStatus.Available) { <a href="/api/procurement/attachments/@attachment.Id" target="_blank" rel="noopener">@MaterialIcon(attachment.Kind) @attachment.Label ↗</a> }
                            else { <span>@MaterialIcon(attachment.Kind) @attachment.Label · @ProcurementLabels.FileStatus(attachment.Status)</span> }
                        }
                    </div>
                    <div class="inspection-report-list">
                        @foreach (var group in inspectionReport.Items.GroupBy(item => InspectionGroup(item.Title)))
                        {
                            <section class="inspection-report-group"><h4>@group.Key</h4>
                            @foreach (var item in group)
                            {
                            <article class="inspection-report-item @(item.Problem ? "problem" : "")">
                                <div><b>@item.Title</b><span class="badge @(item.Problem ? "warn" : item.Status == InspectionItemStatus.Answered ? "ok" : "neutral")">@InspectionStatusLabel(item)</span></div>
                                @if (!string.IsNullOrWhiteSpace(item.Note)) { <p>@item.Note</p> }
                                <div class="material-list">
                                    @foreach (ProcurementQueueV2Attachment attachment in item.Attachments)
                                    {
                                        @if (attachment.Status == StoredFileStatus.Available) { <a href="/api/procurement/attachments/@attachment.Id" target="_blank" rel="noopener">@MaterialIcon(attachment.Kind) @attachment.Label ↗</a> }
                                        else { <span>@MaterialIcon(attachment.Kind) @attachment.Label · @ProcurementLabels.FileStatus(attachment.Status)</span> }
                                    }
                                </div>
                            </article>
                            }
                            </section>
                        }
                    </div>
                }
            </div>
            <div class="mf"><button class="btn" type="button" @onclick="CloseInspectionReport">Закрыть</button>@if (detail.CanAssignInspections || detail.CanPerformInspections) { <button class="btn primary" type="button" @onclick="OpenInspectionEditor">@(detail.CanPerformInspections?"Открыть форму осмотра":"Открыть назначение")</button> }</div>
        </div>
    </div>
}

@if(kanbanSettingsOpen){<CaseModal Title="Канбан · воронки и этапы" Kind="kanban-settings-modal" OnClose="()=>kanbanSettingsOpen=false"><KanbanSettings Subject="CurrentSubject" SelectedPipelineId="activePipeline" Saved="SettingsSaved" Cancelled="()=>kanbanSettingsOpen=false" /></CaseModal>}
@if(addExistingOpen){<CaseModal Title="Добавить существующий объект" Error="candidateError" Busy="kanbanBusy" OnClose="()=>addExistingOpen=false"><p>Один объект, общие документы и задачи. Поиск показывает до 50 доступных объектов.</p><label>Номер или название<input @bind="candidateSearch" /></label><button type="button" class="btn" @onclick="FindCandidates">Найти</button>@foreach(var item in candidates){<p><button type="button" class="btn" disabled="@(pendingAdd!=null)" @onclick="()=>AddExisting(item)">@(item.TransferredMembershipVersion==null?"Добавить":"Вернуть прежнее участие")</button> @item.Number · @item.Title</p>}@if(pendingAdd!=null){<button type="button" class="btn" @onclick="RetryAddExisting">Проверить результат добавления</button>}</CaseModal>}
@if(boardTaskTarget is {} taskTarget){<CaseNextAction @key="taskTarget.CaseId" @ref="boardTask" CaseId="taskTarget.CaseId" ShowList="false" OnSaved="ReloadAsync" />}
@code {
    private CaseSourceChangesNotice? sourceNotice;
    private Task RefreshSourceNotices()=>sourceNotice?.Refresh()??Task.CompletedTask;
    [Parameter, SupplyParameterFromQuery(Name = "stage")] public string? InitialStage { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "mine")] public bool MineOnly { get; set; }
    private static readonly CultureInfo Ru = CultureInfo.GetCultureInfo("ru-RU");
    private ProcurementQueueV2Page? queuePage;
    private ProcurementQueueV2Detail? detail;
    private CaseCard? drawerCard;
    private Guid? selectedCaseId;
    private bool drawerLoading;
    private string? drawerError;

    private string searchDraft = "";
    private string search = "";
    private string stageFilter = "";
    private string assigneeFilter = "";
    private bool dueTodayOnly;
    private bool overdueOnly;
    private ProcurementQueueV2Sort sort = ProcurementQueueV2Sort.RecordedAt;
    private bool descending = true;
    [Parameter, SupplyParameterFromQuery(Name="overview")] public bool FromOverview { get; set; }
    private (string? Stage,bool Mine,bool Overview)? appliedRoute;
    private bool priceChangedOnly;
    private int offset;
    private const int PageSize = 30;

    private CaseCard? decisionCard;
    private ProcurementAction decisionAction;
    private bool negotiationOpen;
    private bool manualCaseOpen;
    private ManualCaseDraft manualCase = new();
    private bool negotiationsOpen;
    private bool negotiationsLoading;
    private string? negotiationsError;
    private ProcurementNegotiationHistoryPage? negotiationHistory;
    private int negotiationOffset;
    private const int NegotiationPageSize = 20;
    private bool inspectionReportOpen;
    private bool inspectionReportLoading;
    private string? inspectionReportError;
    private ProcurementInspectionReport? inspectionReport;

    protected override async Task OnParametersSetAsync()
    {
        if(appliedRoute!=(InitialStage,MineOnly,FromOverview)||appliedKanbanRoute!=(PipelineId,View)) await ReloadAsync();
    }
    private Guid? marketGroupId;
    private GroupMarketView? groupMarket;
    private IReadOnlyList<GroupMarketView> drawerMarkets = [];
    private IReadOnlyList<IncomingSearchGroupView> marketGroups = [];
    private async Task MarketGroupChangedAsync(ChangeEventArgs args) { marketGroupId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null; offset = 0; await ReloadAsync(); }
    protected override async Task ReadAsync()
    {
        if(appliedRoute!=(InitialStage,MineOnly,FromOverview))
        {
            stageFilter=InitialStage??"";search=searchDraft=assigneeFilter="";
            marketGroupId=null;dueTodayOnly=overdueOnly=priceChangedOnly=false;offset=0;
            appliedRoute=(InitialStage,MineOnly,FromOverview);
        }
        await ReadKanbanAsync();
        queuePage = await ReadModel.ReadPageAsync(CurrentSubject, BuildFilter(), CancellationToken.None);
        marketGroups = await Markets.ReadProcurementGroupsAsync(CurrentSubject, CancellationToken.None);
        groupMarket = await Markets.ReadProcurementAsync(CurrentSubject, marketGroupId, CancellationToken.None);
        if (selectedCaseId is Guid caseId)
        {
            detail = await ReadModel.ReadDetailAsync(CurrentSubject, caseId, CancellationToken.None);
            drawerCard = await Workspace.ReadCardAsync(CurrentSubject, caseId, CancellationToken.None);
            drawerMarkets = await Markets.ReadCaseAsync(CurrentSubject, caseId, CancellationToken.None);
        }
    }

    private ProcurementQueueV2Filter BuildFilter()
    {
        Guid? assignee = Guid.TryParse(assigneeFilter, out Guid assigneeId) ? assigneeId : null;
        if(InPipeline)return new ProcurementQueueV2Filter(AssigneeId:assignee,Sort:sort,Descending:descending,Offset:offset,Size:PageSize,PipelineId:activePipeline);
        return new ProcurementQueueV2Filter(
            Text: search,
            Stage: stageFilter,
            AssigneeId: assignee,
            Source: null,
            SourceChangedOnly: false,
            DueTodayOnly: dueTodayOnly,
            OverdueOnly: overdueOnly,
            Checks: ProcurementQueueV2CheckFilter.Any,
            Sort: sort,
            Descending: descending,
            Offset: offset,
            Size: PageSize,
            MineOnly: MineOnly,
            PriceChangedOnly: priceChangedOnly, SearchGroupId: marketGroupId);
    }

    private bool HasFilters => marketGroupId != null || search.Length > 0 || stageFilter.Length > 0 || assigneeFilter.Length > 0 || dueTodayOnly || overdueOnly || priceChangedOnly;
    private bool HasOperationalFilter => stageFilter.Length > 0 || dueTodayOnly || overdueOnly || priceChangedOnly;
    private string PageCaption => queuePage == null || queuePage.Total == 0 ? "Показано 0 объектов" : $"Показано {queuePage.Offset + 1}–{Math.Min(queuePage.Offset + queuePage.Size, queuePage.Total)} из {queuePage.Total} объектов";

    private async Task ApplySearchAsync() { search = searchDraft.Trim(); offset = 0; await ReloadAsync(); }
    private async Task SearchChangedAsync(ChangeEventArgs e) { searchDraft = e.Value?.ToString() ?? ""; await ApplySearchAsync(); }
    private async Task SearchKeyDownAsync(KeyboardEventArgs args) { if (args.Key == "Enter") await ApplySearchAsync(); }
    private async Task StageChangedAsync(ChangeEventArgs e) { stageFilter = e.Value?.ToString() ?? ""; dueTodayOnly = overdueOnly = priceChangedOnly = false; offset = 0; await ReloadAsync(); }
    private async Task AssigneeChangedAsync(ChangeEventArgs e) { assigneeFilter = e.Value?.ToString() ?? ""; offset = 0; await ReloadAsync(); }
    private async Task ToggleManagerSortAsync()
    {
        if (sort == ProcurementQueueV2Sort.Manager) descending = !descending;
        else { sort = ProcurementQueueV2Sort.Manager; descending = false; }
        offset = 0;
        await ReloadAsync();
    }
    private string ManagerSortAria => sort != ProcurementQueueV2Sort.Manager ? "none" : descending ? "descending" : "ascending";
    private string ManagerSortIndicator => sort != ProcurementQueueV2Sort.Manager ? "↕" : descending ? "↓" : "↑";
    private async Task ToggleDueTodayAsync() { dueTodayOnly = !dueTodayOnly; if (dueTodayOnly) { overdueOnly = priceChangedOnly = false; stageFilter = ""; } offset = 0; await ReloadAsync(); }
    private async Task ToggleOverdueAsync() { overdueOnly = !overdueOnly; if (overdueOnly) { dueTodayOnly = priceChangedOnly = false; stageFilter = ""; } offset = 0; await ReloadAsync(); }
    private async Task TogglePriceChangedAsync() { priceChangedOnly = !priceChangedOnly; if (priceChangedOnly) { dueTodayOnly = overdueOnly = false; stageFilter = ""; } offset = 0; await ReloadAsync(); }
    private async Task ShowReturnedAsync() { stageFilter = stageFilter == "returned" ? "" : "returned"; dueTodayOnly = overdueOnly = priceChangedOnly = false; offset = 0; await ReloadAsync(); }
    private async Task ShowCheckingAsync() { stageFilter = stageFilter == "analysis" ? "" : "analysis"; dueTodayOnly = overdueOnly = priceChangedOnly = false; offset = 0; await ReloadAsync(); }
    private async Task ShowPendingHeadAsync() { stageFilter = stageFilter == "pending_head" ? "" : "pending_head"; dueTodayOnly = overdueOnly = priceChangedOnly = false; offset = 0; await ReloadAsync(); }
    private async Task ClearOperationalFiltersAsync() { stageFilter = ""; dueTodayOnly = overdueOnly = priceChangedOnly = false; offset = 0; await ReloadAsync(); }
    private async Task ClearFiltersAsync() { marketGroupId = null; search = searchDraft = stageFilter = assigneeFilter = ""; dueTodayOnly = overdueOnly = priceChangedOnly = false; offset = 0; await ReloadAsync(); }
    private async Task PreviousPageAsync() { offset = Math.Max(0, offset - PageSize); await ReloadAsync(); }
    private async Task NextPageAsync() { if (queuePage != null && offset + PageSize < queuePage.Total) { offset += PageSize; await ReloadAsync(); } }

    private async Task OpenDrawerAsync(Guid caseId)
    {
        if (Busy) return;
        selectedCaseId = caseId; detail = null; drawerCard = null; drawerMarkets = []; drawerError = null; drawerLoading = true;
        try { detail = await ReadModel.ReadDetailAsync(CurrentSubject, caseId, CancellationToken.None); drawerCard = await Workspace.ReadCardAsync(CurrentSubject, caseId, CancellationToken.None); }
        catch (AccessDeniedException exception) { drawerError = ReadFailure(exception, "Нет доступа к этому объекту."); }
        catch (Exception exception) { drawerError = ReadFailure(exception, "Не удалось загрузить объект. Повторите после восстановления соединения."); }
        finally { drawerLoading = false; }
    }

    private void CloseDrawer() { if (Busy) return; RestoreKanbanFocus(); selectedCaseId = null; detail = null; drawerError = null; decisionCard = null; negotiationOpen = negotiationsOpen = inspectionReportOpen = false; }
    private void OpenFullCase() { if (!Busy && detail != null) Navigation.NavigateTo($"/procurement/{detail.CaseId}"); }
    private void OpenCaseSection(string section) { if (!Busy && detail != null) Navigation.NavigateTo($"/procurement/{detail.CaseId}?tab={section}"); }
    private void OpenInspectionEditor() { if (!Busy && detail != null) Navigation.NavigateTo($"/procurement/{detail.CaseId}/inspection"); }

    private async Task OpenNegotiationsAsync()
    {
        if (detail == null) return;
        negotiationOffset = 0;
        negotiationsOpen = true;
        await LoadNegotiationsAsync();
    }

    private async Task LoadNegotiationsAsync()
    {
        if (detail == null) return;
        negotiationsLoading = true;
        negotiationsError = null;
        try { negotiationHistory = await ReadModel.ReadNegotiationsAsync(CurrentSubject, detail.CaseId, negotiationOffset, NegotiationPageSize, CancellationToken.None); }
        catch (AccessDeniedException exception) { negotiationsError = ReadFailure(exception, "Нет доступа к истории переговоров."); }
        catch (Exception exception) { negotiationsError = ReadFailure(exception, "Не удалось загрузить историю переговоров."); }
        finally { negotiationsLoading = false; }
    }

    private void CloseNegotiations() { negotiationsOpen = false; negotiationHistory = null; negotiationsError = null; }
    private async Task PreviousNegotiationsAsync() { negotiationOffset = Math.Max(0, negotiationOffset - NegotiationPageSize); await LoadNegotiationsAsync(); }
    private async Task NextNegotiationsAsync() { if (negotiationHistory != null && negotiationOffset + NegotiationPageSize < negotiationHistory.Total) { negotiationOffset += NegotiationPageSize; await LoadNegotiationsAsync(); } }

    private async Task OpenInspectionReportAsync()
    {
        if (detail == null) return;
        inspectionReportOpen = true;
        inspectionReportLoading = true;
        inspectionReportError = null;
        try { inspectionReport = await ReadModel.ReadInspectionReportAsync(CurrentSubject, detail.CaseId, CancellationToken.None); }
        catch (AccessDeniedException exception) { inspectionReportError = ReadFailure(exception, "Нет доступа к результату осмотра."); }
        catch (Exception exception) { inspectionReportError = ReadFailure(exception, "Не удалось загрузить результат осмотра."); }
        finally { inspectionReportLoading = false; }
    }

    private void CloseInspectionReport() { inspectionReportOpen = false; inspectionReport = null; inspectionReportError = null; }

    private void OpenManualCase()
    {
        if (Busy || queuePage?.CanCreateManualCase != true) return;
        manualCase = new();
        manualCaseOpen = true;
    }

    private void CloseManualCase() { if (!Busy) manualCaseOpen = false; }

    private async Task CreateManualCaseAsync()
    {
        ManualPropertyCaseResult? result = null;
        bool committed = await ExecuteConfirmedAsync(async () => result = await Workspace.CreateManualCaseAsync(CurrentSubject,
            new CreateManualPropertyCase(manualCase.Title, manualCase.Location, manualCase.CadastralNumber,
                manualCase.Price, manualCase.AreaSquareMeters, manualCase.Comment, manualCase.CommandId), OperationId, CancellationToken.None));
        if (committed && result != null)
        {
            manualCaseOpen = false;
            manualCase = new();
            if(InPipeline && kanbanConfig?.Pipelines.SingleOrDefault(p=>p.IsDefault) is {} defaultPipeline){kanbanMessage="Объект создан в основной воронке «"+defaultPipeline.Name+"».";Navigation.NavigateTo($"/procurement?view={(ShowKanban?"kanban":"table")}&pipeline={defaultPipeline.Id}");}
            if (!Forbidden) await OpenDrawerAsync(result.CaseId);
        }
    }

    private async Task OpenDecisionAsync(ProcurementAction action)
    {
        if (Busy || detail == null) return;
        drawerError = null;
        try { ClearFeedback(); decisionNeedsRefresh=false; var current = await Workspace.ReadCardAsync(CurrentSubject, detail.CaseId, CancellationToken.None); drawerCard=current; if(CaseDecisionPresentation.Blocked(current,action)!=null) return; decisionAction=action; decisionCard=current; }
        catch (AccessDeniedException exception) { drawerError = ReadFailure(exception, "Нет права на это решение."); }
        catch (Exception exception) { drawerError = ReadFailure(exception, "Не удалось подготовить действие."); }
    }

    private void CloseDecision() { if (!Busy) decisionCard = null; }

    private async Task ConfirmDecisionAsync(DecisionDraft draft)
    {
        if (decisionCard == null || decisionNeedsRefresh) return;
        CaseCard card = decisionCard;
        bool committed = await ExecuteConfirmedAsync(() => Workspace.DecideAsync(CurrentSubject,
            new DecisionCommand(card.Item.CaseId, card.Item.CaseVersion, card.Item.SourceRevision, decisionAction,
                draft.Reason, draft.Clarification, draft.Target, ProcurementLabels.ParseLocal(draft.Due)),
            OperationId, CancellationToken.None));
        decisionNeedsRefresh=!committed && (LastWriteWasConflict || Forbidden || WriteOutcome==WorkspaceWriteOutcome.Unknown);
        if (committed) decisionCard = null;
    }

    private void OpenNegotiation()
    {
        if (Busy || detail == null || !detail.CanManageDossier) return;
        negotiationOpen = true;
    }
    private void CloseNegotiation() { if (!Busy) negotiationOpen = false; }
    private async Task CommunicationSaved(string message)
    {
        negotiationOpen = false;
        await ReloadAsync();
        Success = message;
    }

    private bool decisionNeedsRefresh;
    private async Task RefreshDecisionAsync()
    {
        if(decisionCard==null || Busy) return;
        Guid id=decisionCard.Item.CaseId;
        await ReloadAsync();
        if(!Forbidden && Error==null && drawerCard?.Item.CaseId==id) { decisionCard=drawerCard; decisionNeedsRefresh=false; }
    }
    private static string NextActionTypeLabel(WorkTaskType type) => type switch
    {
        WorkTaskType.Call => "Звонок",
        WorkTaskType.Meeting => "Встреча",
        WorkTaskType.Check => "Проверка",
        WorkTaskType.Documents => "Документы",
        WorkTaskType.Decision => "Решение",
        _ => "Другое"
    };

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string CompactText(string? value, int max) => string.IsNullOrWhiteSpace(value) ? "—"
        : value.Length <= max ? value : value[..(max - 1)] + "…";
    private static string MoneyCompact(decimal? value)
    {
        if (value == null) return "—";
        if (Math.Abs(value.Value) >= 1_000_000m) return $"{(value.Value / 1_000_000m).ToString("0.#", Ru)} млн ₽";
        return $"{NumberFormat.Money(value.Value)} ₽";
    }
    private static string PricePerSotkaCaption(decimal? price, decimal? areaSquareMeters)
    {
        if (price == null) return "Цена не указана";
        decimal? perSotka = LocationEconomics.PricePerSotka(price, areaSquareMeters);
        return perSotka == null ? "Нет площади для расчёта" : $"{NumberFormat.Money(perSotka.Value)} ₽ / сот.";
    }
    private static string PriceDeltaCaption(decimal delta, decimal? percent)
    {
        if (delta == 0m) return "Без изменения от старта";
        string arrow = delta < 0m ? "↓" : "↑";
        string sign = delta < 0m ? "−" : "+";
        string amount = MoneyCompact(Math.Abs(delta));
        string percentText = percent == null ? "" : $" · {sign}{Math.Abs(percent.Value).ToString("0.#", Ru)}%";
        return $"{arrow} {amount}{percentText} от старта";
    }
    private static string AreaSotki(decimal? squareMeters) => squareMeters == null ? "—" : $"{(squareMeters.Value / 100m).ToString("0.##", Ru)} сот.";
    private static string ShortDate(DateTimeOffset? value) => value == null ? "—" : ProcurementLabels.Time(value).Split(' ')[0];
    private static string ShortDateTime(DateTimeOffset value) => ProcurementLabels.Time(value).Replace(" МСК", "", StringComparison.Ordinal);
    private static string ContactCaption(ProcurementLatestContact item) => string.Join(" · ", new[] { item.Channel, item.Outcome }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private static string ContactTime(DateTimeOffset value) => ProcurementLabels.Time(value).Replace(" МСК", "", StringComparison.Ordinal);
    private static string Initials(string name)
    {
        string[] parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return string.Concat(parts.Take(2).Select(item => char.ToUpperInvariant(item[0])));
    }
    private static string SourcesText(IReadOnlyList<ProcurementSourceTypeSummary> sources) => sources.Count == 0
        ? "Нет источников"
        : string.Join(" · ", sources.Select(item => item.Count > 1 ? $"{ProcurementLabels.Source(item.Source)} ×{item.Count}" : ProcurementLabels.Source(item.Source)));
    private static string SourcesText(IReadOnlyList<ProcurementSourceDetail> sources) => sources.Count == 0
        ? "Нет источников"
        : string.Join(" · ", sources.Select(item => ProcurementLabels.Source(item.Source)).Distinct(StringComparer.Ordinal));
    private static string StageBadge(string stage) => stage switch
    {
        "negotiation" => "violet",
        "pending_head" => "warn",
        "approved" or "acquired" => "ok",
        "rejected" or "returned" => "bad",
        "analysis" or "clarify" => "info",
        _ => "neutral"
    };
    private static string CheckBadge(ProcurementQuickCheckSummary check) => check.Issues > 0 ? "warn" : check.Total > 0 && check.Completed == check.Total ? "ok" : "info";
    private static string CheckBadge(ProcurementCheckLevelSummary check) => check.Issues > 0 ? "warn" : check.Total > 0 && check.Completed == check.Total ? "ok" : "info";
    private static string CheckRatio(ProcurementQuickCheckSummary check) => check.Total == 0 ? "Не начат" : $"{check.Completed} / {check.Total}";
    private static string CheckRatio(ProcurementCheckLevelSummary check) => check.Total == 0 ? "не начат" : $"{check.Completed}/{check.Total}";
    private static string CheckLevelDescription(ProcurementCheckLevelSummary check) => check.Total == 0
        ? "Проверки ещё не начаты."
        : check.Issues > 0 ? $"Есть проблем: {check.Issues}. Осталось: {check.Remaining}." : $"Осталось: {check.Remaining}.";
    private static string DueCss(ProcurementDueState state) => state == ProcurementDueState.Overdue ? "text-bad" : state == ProcurementDueState.Today ? "text-warn" : "";
    private static string DueBadge(ProcurementDueState state) => state == ProcurementDueState.Overdue ? "bad" : state == ProcurementDueState.Today ? "warn" : "neutral";
    private static string DueCompact(DateTimeOffset? value, ProcurementDueState state)
    {
        if (value == null) return "Срок не задан";
        string time = ProcurementLabels.Time(value).Replace(" МСК", "", StringComparison.Ordinal);
        string hhmm = time.Length >= 16 ? time[^5..] : time;
        return state switch
        {
            ProcurementDueState.Today => $"Сегодня {hhmm}",
            ProcurementDueState.Overdue => $"Просрочено · {time[..Math.Min(10, time.Length)]}",
            _ => time
        };
    }
    private static string RowClass(ProcurementQueueV2RowState state) => state switch
    {
        ProcurementQueueV2RowState.Overdue => "row-overdue",
        ProcurementQueueV2RowState.DueToday => "row-today",
        ProcurementQueueV2RowState.CheckIssue => "row-check",
        ProcurementQueueV2RowState.SourceChanged => "row-source",
        _ => ""
    };
    private static string NegotiationTitle(ProcurementQueueV2Negotiation item)
    {
        if (!string.IsNullOrWhiteSpace(item.Outcome)) return item.Outcome;
        if (item.SellerPrice != null) return $"Продавец: {MoneyCompact(item.SellerPrice)}";
        if (item.BuyerOffer != null) return $"Наше предложение: {MoneyCompact(item.BuyerOffer)}";
        return string.IsNullOrWhiteSpace(item.Channel) ? "Контакт" : item.Channel;
    }

    private static string NegotiationTitle(ProcurementNegotiationHistoryItem item)
    {
        if (!string.IsNullOrWhiteSpace(item.Outcome)) return item.Outcome;
        if (item.AgreedPrice != null) return $"Согласовано: {MoneyCompact(item.AgreedPrice)}";
        if (item.BuyerOffer != null) return $"Наше предложение: {MoneyCompact(item.BuyerOffer)}";
        if (item.SellerPrice != null) return $"Продавец: {MoneyCompact(item.SellerPrice)}";
        return string.IsNullOrWhiteSpace(item.Channel) ? "Контакт" : item.Channel;
    }

    private string NegotiationHistoryCaption => negotiationHistory == null || negotiationHistory.Total == 0
        ? "0 контактов"
        : $"{negotiationHistory.Offset + 1}–{Math.Min(negotiationHistory.Offset + negotiationHistory.Items.Count, negotiationHistory.Total)} из {negotiationHistory.Total}";

    private static string InspectionStatusLabel(ProcurementInspectionReportItem item) => item.Status switch
    {
        InspectionItemStatus.NotChecked => "Не проверено",
        InspectionItemStatus.Unanswered => "Не указано",
        _ when item.Problem => $"Проблема · {InspectionAnswer(item)}",
        _ => InspectionAnswer(item)
    };

    private static string InspectionGroup(string title)
    {
        string text=title.ToLowerInvariant();
        if(text.Contains("дорог") || text.Contains("подъезд")) return "Подъезд";
        if(text.Contains("электр") || text.Contains("газ") || text.Contains("вод") || text.Contains("канализац")) return "Коммуникации";
        if(text.Contains("участ") || text.Contains("рельеф") || text.Contains("границ") || text.Contains("забор")) return "Участок";
        return "Окружение";
    }
    private static string InspectionAnswer(ProcurementInspectionReportItem item) => string.IsNullOrWhiteSpace(item.Answer)
        ? "Не указано"
        : bool.TryParse(item.Answer, out bool answer) ? (answer ? "Да" : "Нет") : item.Answer + (string.IsNullOrWhiteSpace(item.Unit) ? "" : " " + item.Unit);

    private static string MaterialIcon(CaseAttachmentKind kind) => kind switch
    {
        CaseAttachmentKind.Photo => "📷",
        CaseAttachmentKind.Video => "🎬",
        CaseAttachmentKind.Audio => "🎙",
        CaseAttachmentKind.Link => "🔗",
        _ => "📎"
    };





    private sealed class ManualCaseDraft
    {
        public Guid CommandId { get; } = Guid.CreateVersion7();
        [Required, MinLength(3), MaxLength(512)] public string Title { get; set; } = "";
        [MaxLength(20000)] public string? Location { get; set; }
        [MaxLength(128)] public string? CadastralNumber { get; set; }
        public decimal? Price { get; set; }
        public decimal? AreaSquareMeters { get; set; }
        [Required, MinLength(3), MaxLength(900)] public string Comment { get; set; } = "";
    }
}
