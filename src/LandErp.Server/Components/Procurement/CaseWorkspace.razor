@using System.ComponentModel.DataAnnotations
@using LandErp.Application.Foundation.Files
@using LandErp.Application.Modules.Catalog.Contracts
@using LandErp.Application.Modules.Procurement.Contracts
@using LandErp.Application.Modules.Procurement.Domain
@using Microsoft.AspNetCore.Components.Forms
@inherits CaseWorkspaceComponent
@inject ICatalogWorkspace CatalogWorkspace
@inject IProcurementWorkspace Workspace

@if(Loading) { <PageState Kind="loading" Title="Открываем объект…" /> }
else if(Forbidden) { <PageState Kind="forbidden" Title="Нет доступа к объекту" /> }
else if(card!=null)
{
    <CaseToast Message="@Success" />
    @if(Error!=null&&!AnyDialog){<div class="case-feedback" role="alert">@Error <button class="btn secondary" @onclick="ReloadAsync">Обновить карточку</button></div>}
    @if(RefreshWarning!=null){<div class="case-feedback" role="status">@RefreshWarning <button class="btn secondary" @onclick="ReloadAsync">Обновить</button></div>}
    <div class="stack case-workspace" data-case-version="@card.Item.CaseVersion">
        <section class="case-titlebar">
            <div class="case-identity">
                <div class="case-breadcrumb">@if(FullPage){<a href="/procurement">← Очередь закупки</a><span aria-hidden="true">/</span>}<span>@card.Item.BusinessNumber</span></div>
                @if(FullPage){<h1>@card.Item.Title</h1>}else{<h2>@card.Item.Title</h2>}
                <p>@(card.Item.Location??"Местоположение уточняется")</p>
            </div>
            <div class="case-title-actions">@foreach(var source in card.Item.Sources) { <SourceBadge Source="source" /> }<StatusBadge Label="@ProcurementLabels.Stage(card.Item.Stage)" Tone="@(card.Item.Stage=="acquired" ? "success" : card.Item.Stage=="returned" ? "warning" : "info")" />@if(card.CanManageDossier){<button class="btn secondary" @onclick="()=>{ClearFeedback();noteOpen=true;}">＋ Заметка</button>}@if(card.CanManagerDecide||card.CanHeadDecide){<button class="btn secondary" @onclick="()=>{ClearFeedback();decisionsOpen=true;}">Решение по объекту</button>}</div>
        </section>

        @if(card.Item.Stage=="acquired")
        {
            <section class="surface case-acquired-banner">
                <div><span class="kicker">Закупка завершена</span><h3>Объект куплен</h3></div>
                <div><small>Фактическая цена</small><strong>@ProcurementLabels.Money(card.AcquisitionPrice)</strong></div>
                <div><small>Дата покупки / регистрации</small><strong>@(card.AcquisitionDate?.ToString("dd.MM.yyyy")??"Не указана")</strong></div>
                @if(!string.IsNullOrWhiteSpace(card.AcquisitionComment)){<p>@card.AcquisitionComment</p>}
                @if(card.CanConfirmPurchase){<button class="btn secondary" @onclick="OpenCorrection">Исправить данные покупки</button>}
            </section>
        }

        <nav class="case-tabs" aria-label="Разделы карточки">
            @foreach((string id,string label) in Tabs)
            {
                <button type="button" class="case-tab @(tab==id?"active":"")" aria-current="@(tab==id?"page":null)" @onclick="()=>tab=id">@label</button>
            }
        </nav>

        @if(tab=="overview")
        {
            <section class="case-hero">
                <article class="surface case-object-card">
                    <div class="case-gallery">
                        @if(card.Photos.Length>0)
                        {
                            <div class="case-cover">
                                <button class="photo-open" @onclick="()=>galleryOpen=true" aria-label="Открыть галерею"><img src="@card.Photos[photoIndex]" alt="Фото объекта" referrerpolicy="no-referrer" /></button>
                                @if(card.Photos.Length>1){<button class="photo-arrow prev" @onclick="()=>MovePhoto(-1)" aria-label="Предыдущее фото">‹</button><button class="photo-arrow next" @onclick="()=>MovePhoto(1)" aria-label="Следующее фото">›</button>}
                                <span class="case-photo-caption">@(photoIndex+1) / @card.Photos.Length ⤢</span>
                            </div>
                        }
                        else
                        {
                            <div class="case-cover empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8" cy="9" r="1.5"/><path d="m3 17 5-5 4 4 3-3 6 6"/></svg><strong>Фото пока нет</strong><span>Основные сведения об объекте — рядом</span></div>
                        }
                    </div>
                    <div class="case-object-facts">
                        <div class="section-heading"><h3>Об объекте</h3>@if(card.CanManageDossier){<button class="btn quiet" @onclick="OpenFactCorrection">Исправить рабочие данные</button>}</div>
                        <dl class="case-facts">
                            <div><dt>Площадь</dt><dd>@AreaInSotki()<small>@ProcurementLabels.Area(card.Item.Area)</small></dd></div>
                            <div><dt>Кадастровый номер</dt><dd>@(string.IsNullOrWhiteSpace(card.CadastralNumber)?"Не указан":card.CadastralNumber)</dd></div>
                            <div><dt>Ответственный</dt><dd>@(card.Item.Assignee??"Не назначен")</dd></div>
                            <div><dt>Источники</dt><dd>@SourceSummary()</dd></div>
                        </dl>
                        @if(card.Item.Changed){<p class="case-warning">В источнике есть изменения. Сравните их с рабочими данными на вкладке «Источники».</p>}
                        <div class="case-description @(descriptionExpanded?"expanded":"")"><h3>Описание</h3><p>@(string.IsNullOrWhiteSpace(card.Description)?"Описание пока не добавлено.":card.Description)</p>@if(!string.IsNullOrWhiteSpace(card.Description)){<button class="btn quiet" @onclick="()=>descriptionExpanded=!descriptionExpanded">@(descriptionExpanded?"Свернуть описание ↑":"Развернуть описание ↓")</button>}</div>
                    </div>
                </article>
                <div class="case-side-stack">
                    <article class="surface case-pricing">
                        <h3>Цена и торг</h3>
                        <div class="case-main-price"><span>Рабочая цена</span><strong>@ProcurementLabels.Money(card.Item.Price)</strong></div>
                        <div class="price-grid">
                            <div><small>Продавец</small><strong>@OptionalPrice(card.Negotiations.Select(x=>x.SellerPrice).FirstOrDefault(x=>x!=null))</strong></div>
                            <div><small>Наше предложение</small><strong>@OptionalPrice(card.Negotiations.Select(x=>x.BuyerOffer).FirstOrDefault(x=>x!=null))</strong></div>
                            <div><small>@(card.Item.Stage=="acquired"?"Куплено за":"Согласовано")</small><strong>@OptionalPrice(card.Item.Stage=="acquired"?card.AcquisitionPrice:card.Negotiations.Select(x=>x.AgreedPrice).FirstOrDefault(x=>x!=null))</strong></div>
                        </div>
                        <button class="btn quiet" @onclick='()=>tab="negotiations"'>Перейти к переговорам →</button>
                    </article>
                    <article class="surface case-next-action">
                        <div class="section-heading"><h3>Следующее действие</h3>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<button class="btn quiet" @onclick="()=>{ClearFeedback();nextActionOpen=true;}">Изменить</button>}</div><strong>@NextAction()</strong>
                        @if(!string.IsNullOrWhiteSpace(card.Item.NextActionDescription)){<p>@card.Item.NextActionDescription</p>}
                        <p class="subtle">@(card.Item.Assignee??"Ответственный не назначен") · @(card.Item.DueAt==null?"Срок не назначен":ProcurementLabels.Time(card.Item.DueAt))</p>
                    </article>
                </div>
            </section>
        }
        else
        {
            <section class="case-context" aria-label="Краткая сводка объекта">
                <div><small>Рабочая цена</small><strong>@ProcurementLabels.Money(card.Item.Price)</strong></div>
                <div><small>Площадь</small><strong>@AreaInSotki()</strong></div>
                <div><small>Ответственный</small><strong>@(card.Item.Assignee??"Не назначен")</strong></div>
                <div><small>Следующее действие</small><strong>@NextAction()</strong><small>@(card.Item.DueAt==null?"Срок не назначен":ProcurementLabels.Time(card.Item.DueAt))</small></div>
            </section>
        }

        @if(tab=="overview")
        {
            <section class="case-dashboard">
                <article class="surface"><div class="section-heading"><h2>Ход работы</h2><div class="form-actions">@if(card.CanManageDossier){<button class="btn quiet" @onclick="()=>{ClearFeedback();noteOpen=true;}">Заметка</button>}@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<button class="btn secondary" @onclick="OpenNegotiation">＋ Контакт</button>}</div></div>
                    @if(card.Timeline.Count==0){<div class="case-empty"><strong>История работы начинается здесь</strong><p>Запишите контакт или добавьте заметку об объекте.</p></div>}
                    <BusinessTimeline Items="card.Timeline.Take(6).ToArray()" />
                    <button class="btn quiet" @onclick='()=>tab="history"'>Вся история →</button>
                </article>
                <div class="stack"><article class="surface"><h2>Контроль объекта</h2>
                    <div class="control-row"><div><strong>Проверки</strong><small>@(card.Checks.Count==0?"Ещё не назначены":"Результаты и открытые вопросы")</small></div><button class="btn quiet" @onclick='()=>tab="checks"'>@CompletedChecks() / @card.Checks.Count →</button></div>
                    <div class="control-row"><div><strong>Документы</strong><small>Получено из необходимых</small></div><button class="btn quiet" @onclick='()=>tab="documents"'>@ReadyDocuments() / @card.DocumentRequirements.Count →</button></div>
                    <div class="control-row"><div><strong>Осмотр</strong><small>@(card.Inspection==null?"Не назначен":card.Inspection.Status==InspectionStatus.Completed?"Завершён":card.Inspection.StartedAt==null?"Назначен":"В работе")</small></div><button class="btn quiet" @onclick='()=>tab="inspection"'>Открыть →</button></div>
                    @if(OpenRisks()>0){<p class="case-problem">Открытых блокирующих вопросов: @OpenRisks()</p>}
                </article><article class="surface"><h3>Решение по объекту</h3><p class="subtle">Проверьте результаты и открытые вопросы перед следующим этапом.</p>@if(card.CanManagerDecide||card.CanHeadDecide){<button class="btn primary" @onclick="()=>{ClearFeedback();decisionsOpen=true;}">Выбрать решение</button>}else{<p class="subtle">Режим просмотра: рабочее решение недоступно.</p>}@if(card.CanConfirmPurchase){<button class="btn quiet" @onclick="@(card.Item.Stage=="acquired"?OpenCorrection:OpenPurchase)">@(card.Item.Stage=="acquired"?"Данные покупки":"Оформить покупку")</button>}</article></div>
            </section>
        }
        else if(tab=="negotiations")
        {
            <section class="stack"><article class="surface"><div class="section-heading"><div><h3>Переговоры</h3><p class="subtle">Контакты, предложения по цене и договорённости по объекту.</p></div>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<button class="btn primary" @onclick="OpenNegotiation">Добавить контакт</button>}</div>@if(card.Negotiations.Count==0){<PageState Kind="empty" Title="Переговоров пока нет" />}@foreach(var item in card.Negotiations){<div class="dossier-row"><div><strong>@NegotiationTitle(item)</strong><small>@Meta(item.Channel,item.Contact,item.Author,ProcurementLabels.Time(item.EffectiveAt))</small><p>@item.Outcome</p>@if(item.SellerPrice!=null||item.BuyerOffer!=null||item.AgreedPrice!=null){<p class="subtle">Продавец: @ProcurementLabels.Money(item.SellerPrice) · Мы: @ProcurementLabels.Money(item.BuyerOffer) · Согласовано: @ProcurementLabels.Money(item.AgreedPrice)</p>}@if(item.Conditions.Length>0){<p class="subtle">Условия: @item.Conditions</p>}@if(item.Comment.Length>0){<p>@item.Comment</p>}@if(item.NextStep.Length>0){<p class="subtle">Следующий шаг: @item.NextStep · @ProcurementLabels.Time(item.NextStepDueAt)</p>}</div></div>}</article>
            </section>
        }
        else if(tab=="checks")
        {
            <section class="stack"><div class="section-heading"><div><h2>Проверки объекта</h2><p class="subtle">Быстрые проверки выполняются раньше, глубокие — когда объект реально рассматривается к покупке.</p></div>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<button class="btn primary" @onclick="OpenCheck">Добавить проверку</button>}</div><div class="check-columns">@foreach(var level in Enum.GetValues<CaseCheckLevel>()){<article class="surface"><h3>@ProcurementLabels.CheckLevel(level)</h3><p class="subtle">@(level==CaseCheckLevel.Quick?"Ранний структурированный скрининг.":"Юридические и иные углублённые проверки после решения руководителя.")</p>@foreach(var item in card.Checks.Where(x=>x.Level==level)){<div class="dossier-row @(item.Blocker?"blocker":"")"><strong>@item.Title · @ProcurementLabels.CheckStatus(item.Status)</strong><small>@(item.Responsible??"Ответственный не назначен") · @ProcurementLabels.Time(item.DueAt)</small><p>@item.Result</p>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<button class="btn quiet" @onclick="()=>EditCheck(item)">Изменить</button>}</div>}@if(!card.Checks.Any(x=>x.Level==level)){<p class="subtle">Записей пока нет.</p>}</article>}</div>
            @if(card.CanManageTemplates){<button class="btn quiet" @onclick="()=>{ClearFeedback();templatesOpen=true;}">Настроить типовые проверки</button>}
            </section>
        }
        else if(tab=="inspection")
        { <article class="surface"><div class="section-heading"><h3>Осмотр</h3>@if((card.CanAssignInspections||card.CanPerformInspections)&&card.Item.Stage!="acquired"){<div class="form-actions">@if(card.Inspection!=null&&card.CanPerformInspections){<button class="btn secondary" @onclick='()=>OpenInspectionAttachment($"i:{card.Inspection.Id}")'>Добавить общий материал</button>}<a class="btn primary" href="/procurement/@CaseId/inspection">@(card.Inspection==null?"Назначить осмотр":card.CanPerformInspections?"Открыть форму осмотра":"Открыть назначение")</a></div>}</div>@if(card.Inspection==null){<PageState Kind="empty" Title="Осмотр ещё не проведён" />}else{<p><strong>@(card.Inspection.Status==InspectionStatus.Completed?"Завершён":card.Inspection.StartedAt==null?"Назначен":"В работе")</strong> · @card.Inspection.Inspector · @ProcurementLabels.Time(card.Inspection.CompletedAt??card.Inspection.StartedAt)</p><p>@card.Inspection.OverallConclusion</p>@foreach(var media in card.Attachments.Where(x=>x.OwnerType==CaseAttachmentOwner.Inspection)){<div class="form-actions"><small>@media.Label · @ProcurementLabels.FileStatus(media.Status)</small>@if(media.Status==StoredFileStatus.Available){<a class="btn quiet" href="/api/procurement/attachments/@media.Id" target="_blank" rel="noopener">Открыть ↗</a>}else if(card.CanPerformInspections&&AttachmentCanRetry(media)){<button class="btn quiet" @onclick="()=>BeginAttachmentRetry(media.Id)">Восстановить загрузку</button>}</div>}<div class="inspection-results">@foreach(var item in card.Inspection.Items){<div class="dossier-row @(InspectionProblem(item)?"blocker":"")"><div><strong>@item.Title</strong><small>@InspectionAnswer(item)</small>@if(item.Note.Length>0){<p>@item.Note</p>}@foreach(var media in card.Attachments.Where(x=>x.OwnerType==CaseAttachmentOwner.InspectionItem&&x.OwnerId==item.Id)){<div class="form-actions"><small>@media.Label · @ProcurementLabels.AttachmentKind(media.Kind) · @ProcurementLabels.FileStatus(media.Status)</small>@if(media.Status==StoredFileStatus.Available){<a class="btn quiet" href="/api/procurement/attachments/@media.Id" target="_blank" rel="noopener">Открыть ↗</a>}else if(card.CanPerformInspections&&AttachmentCanRetry(media)){<button class="btn quiet" @onclick="()=>BeginAttachmentRetry(media.Id)">Восстановить загрузку</button>}</div>}</div>@if(card.CanPerformInspections&&card.Item.Stage!="acquired"&&item.AllowAttachments){<button class="btn secondary" @onclick='()=>OpenInspectionAttachment($"ii:{item.Id}")'>Добавить материал</button>}</div>}</div>}</article> }
        else if(tab=="documents")
        {
            <section class="stack"><article class="surface"><div class="section-heading"><div><h2>Документы</h2><p class="subtle">Файлы и их проверка — отдельные состояния</p></div>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<button class="btn primary" @onclick="()=>OpenAttachment(null)">＋ Добавить документ</button>}</div>
                <div class="document-table-wrap"><table class="document-table"><thead><tr><th>Документ / файл</th><th>Статус</th><th>Обновлено</th><th>Действия</th></tr></thead><tbody>
                @foreach(var item in card.DocumentRequirements)
                {
                    <tr><td><strong>@item.Title</strong><small>@item.Description</small>
                    @foreach(var file in card.Attachments.Where(x=>item.AttachmentIds.Contains(x.Id))){<div class="document-file"><span>@file.Label · @FormatSize(file.SizeBytes)</span>@if(file.Status==StoredFileStatus.Available){<a href="/api/procurement/attachments/@file.Id" target="_blank" rel="noopener">Открыть ↗</a>}else{<small>@ProcurementLabels.FileStatus(file.Status)</small>@if(AttachmentCanRetry(file)){<button class="btn quiet" @onclick="()=>BeginAttachmentRetry(file.Id)">Восстановить загрузку</button>}}</div>}
                    @if(item.Note.Length>0){<small>@item.Note</small>}</td><td><StatusBadge Label="@ProcurementLabels.DocumentStatus(item.Status)" Tone="@(item.Status==CaseDocumentStatus.Verified?"success":"neutral")"/></td><td><small>@item.UpdatedBy<br/>@ProcurementLabels.Time(item.UpdatedAt)</small>@if(item.DueAt!=null){<small>Срок: @ProcurementLabels.Time(item.DueAt)</small>}</td><td>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<div class="document-actions"><button class="btn secondary" @onclick="()=>OpenAttachment(item.Id)">Прикрепить</button><button class="btn quiet" @onclick="()=>EditDocumentRequirement(item)">Статус</button></div>}</td></tr>
                }
                </tbody></table></div>
                @if(card.DocumentRequirements.Count==0){<div class="case-empty">Обязательные документы не заданы. Добавленные файлы доступны ниже.</div>}
            </article>
            <article class="surface"><h3>Прочие вложения</h3>@foreach(var item in card.Attachments.Where(x=>x.DocumentRequirementId==null)){<div class="dossier-row"><div><strong>@item.Label</strong><small>@item.OwnerLabel · @ProcurementLabels.AttachmentKind(item.Kind) · @ProcurementLabels.FileStatus(item.Status) · @FormatSize(item.SizeBytes)</small>@if(item.Description.Length>0){<p>@item.Description</p>}</div>@if(item.Status==StoredFileStatus.Available){<a class="btn secondary" href="/api/procurement/attachments/@item.Id" target="_blank" rel="noopener">Открыть ↗</a>}else if(AttachmentCanRetry(item)){<button class="btn secondary" @onclick="()=>BeginAttachmentRetry(item.Id)">Восстановить загрузку</button>}</div>}@if(!card.Attachments.Any(x=>x.DocumentRequirementId==null)){<p class="subtle">Прочих вложений нет.</p>}</article>
            </section>
        }
        else if(tab=="history") { <article class="surface"><h3>История объекта</h3><p class="subtle">Контакты, документы и решения по объекту.</p><BusinessTimeline Items="card.Timeline" /></article> }
        else if(tab=="sources")
        {
            <section class="stack"><article class="surface"><h3>Источники</h3>@if(card.Sources.Count==0){<p class="subtle">PropertyCase существует без внешних источников.</p>}@foreach(var source in card.Sources){<div class="dossier-row"><div><SourceBadge Source="source.Source" /><strong>@source.Title</strong><small>@source.Provenance · @(source.ExternalId??"без внешнего ID") · @ProcurementLabels.Money(source.Price)</small></div><div class="form-actions">@if(source.Url!=null){<a class="btn secondary" href="@source.Url" target="_blank" rel="noopener noreferrer">Открыть источник ↗</a>}@if(card.CanCorrectSourceLinks){<button class="btn quiet" disabled="@Busy" @onclick="()=>OpenSourceLinkCorrectionAsync(source)">Исправить связь</button>}</div></div>}</article>
            <article class="surface"><h3>Изменения в источниках</h3>@if(card.Observations.Count==0){<p class="subtle">Наблюдений пока нет.</p>}@foreach(var item in card.Observations.Take(20)){<div class="dossier-row"><div><strong>@ProcurementLabels.Time(item.ObservedAt)</strong><small>@(item.Changes.Length==0?"Первое наблюдение":string.Join(" · ",item.Changes))</small><p>@(item.Data.Title.Raw??"Без названия") · @ProcurementLabels.Money(item.Data.Price.Parsed)</p></div></div>}</article>
            <article class="surface"><h3>Расхождения с рабочими фактами</h3><p class="subtle">Источник никогда не перезаписывает подтверждённое значение автоматически.</p>@foreach(var item in card.Discrepancies.Where(x=>x.Different)){<div class="dossier-row"><div><strong>@ProcurementLabels.Fact(item.Field) · @item.Source</strong><small>Рабочее: @item.WorkingValue · источник: @item.SourceValue</small></div>@if(card.CanManageDossier){<button class="btn secondary" @onclick="()=>{ClearFeedback();pendingFact=item;}">Применить явно</button>}</div>}@if(!card.Discrepancies.Any(x=>x.Different)){<p class="subtle">Расхождений нет.</p>}</article></section>
        }
    </div>
    @if(pendingFact is {} fact){<CaseModal Title="Сравнить сведения источника" Subtitle="Изменится только выбранное рабочее поле" Error="@Error" Busy="Busy" OnClose="()=>pendingFact=null"><h3>@ProcurementLabels.Fact(fact.Field)</h3><div class="form-grid"><div><small>В карточке</small><p>@fact.WorkingValue</p></div><div><small>В источнике</small><p>@fact.SourceValue</p></div></div><div class="form-actions"><ActionButton Label="Принять значение источника" OnClick="()=>ApplyFactAsync(fact)" Busy="Busy"/></div></CaseModal>}
    @if(nextActionOpen){<CaseNextAction CaseId="CaseId" OnClose="()=>nextActionOpen=false" OnSaved="NextActionSaved"/>}
    @if(galleryOpen&&card.Photos.Length>0){<CaseGallery Photos="card.Photos" InitialIndex="photoIndex" OnClose="()=>galleryOpen=false" />}
    @if(decisionsOpen){<CaseModal Title="Решение по объекту" Error="@Error" Busy="Busy" OnClose="()=>decisionsOpen=false"><article class="surface"><h3>Следующее решение</h3><div class="decision-actions">@if(card.CanManagerDecide){<ActionButton Label="Наблюдать" Tone="secondary" OnClick='()=>Open(ProcurementAction.Monitor,"Наблюдать")' /><ActionButton Label="Уточнить" Tone="secondary" OnClick='()=>Open(ProcurementAction.Clarify,"Уточнить")' /><ActionButton Label="Отклонить" Tone="secondary" OnClick='()=>Open(ProcurementAction.Reject,"Отклонить")' /><ActionButton Label="Передать руководителю" OnClick='()=>Open(ProcurementAction.Forward,"Передать руководителю")' />}else if(card.CanHeadDecide){<ActionButton Label="Вернуть менеджеру" Tone="secondary" OnClick='()=>Open(ProcurementAction.Return,"Вернуть менеджеру")' /><ActionButton Label="Продолжить работу" OnClick='()=>Open(ProcurementAction.Approve,"Одобрить")' /><ActionButton Label="Наблюдать" Tone="secondary" OnClick='()=>Open(ProcurementAction.Monitor,"Наблюдать")' /><ActionButton Label="Отклонить" Tone="secondary" OnClick='()=>Open(ProcurementAction.Reject,"Отклонить")' />}else{<p class="subtle">Решение ожидает текущего исполнителя либо этап уже завершён.</p>}</div></article></CaseModal>}
    @if(templatesOpen&&card.CanManageTemplates){<CaseModal Title="Типовые проверки" Error="@Error" Busy="Busy" OnClose="()=>templatesOpen=false">@foreach(var item in card.CheckTemplates){<div class="dossier-row"><div><strong>@item.Title</strong><small>@ProcurementLabels.CheckLevel(item.Level) · порядок @item.SortOrder · @(item.Active?"активна":"неактивна")</small><p>@item.Description</p></div><button class="btn quiet" @onclick="()=>EditCheckTemplate(item)">Изменить</button></div>}<EditForm Model="checkTemplate" FormName="check-template" OnValidSubmit="SaveCheckTemplateAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field dossier-wide"><span>Название</span><input @bind="checkTemplate.Title" /></label><label class="field"><span>Уровень</span><InputSelect @bind-Value="checkTemplate.Level"><option value="Quick">Базовая</option><option value="Deep">Глубокая</option></InputSelect></label><label class="field"><span>Порядок</span><InputNumber @bind-Value="checkTemplate.SortOrder" /></label><label class="field dossier-wide"><span>Описание</span><textarea @bind="checkTemplate.Description"></textarea></label><label class="check-field"><InputCheckbox @bind-Value="checkTemplate.Active" /> Активна</label><div class="form-actions"><ActionButton Label="Сохранить в справочник" Type="submit" Busy="Busy" /></div></div></EditForm></CaseModal>}
    @if(noteOpen){<CaseModal Title="Рабочая заметка" Subtitle="Внутренний комментарий для команды" Error="@Error" Busy="Busy" OnClose="()=>noteOpen=false"><EditForm Model="note" OnValidSubmit="SaveNoteAsync"><DataAnnotationsValidator/><ValidationSummary/><label class="field"><span>Текст заметки</span><InputTextArea @bind-Value="note.Text"/><ValidationMessage For="()=>note.Text"/></label><div class="form-actions"><ActionButton Label="Добавить заметку" Type="submit" Busy="Busy"/></div></EditForm></CaseModal>}
    @if(dialogAction!=null) { <CaseDecisionDialog Card="card" Action="@dialogAction.Value" Title="@dialogTitle" OnConfirm="ConfirmAsync" OnClose="CloseDialog" Busy="Busy" Error="@Error" /> }
    @if(negotiationOpen)
    {
        <CaseModal Title="Записать контакт" Subtitle="Сначала результат разговора. Цены — при необходимости." Error="@Error" Busy="Busy" OnClose="()=>negotiationOpen=false">
            <EditForm Model="negotiation" FormName="negotiation" OnValidSubmit="SaveNegotiationAsync"><DataAnnotationsValidator/><ValidationSummary/>
                <div class="form-grid">
                    <label class="field"><span>Способ связи</span><InputSelect @bind-Value="negotiation.Channel"><option>Звонок</option><option>Мессенджер</option><option>Встреча</option><option>Электронная почта</option><option>Другое</option></InputSelect></label>
                    <label class="field"><span>Когда связались (МСК)</span><input type="datetime-local" value="@negotiation.Effective" @oninput="e=>negotiation.Effective=e.Value?.ToString()??string.Empty" /></label>
                    <label class="field dossier-wide"><span>Результат контакта *</span><InputTextArea @bind-Value="negotiation.Outcome" placeholder="Например: договорились осмотреть участок в пятницу"/><ValidationMessage For="()=>negotiation.Outcome"/></label>
                    <label class="field dossier-wide"><span>С кем связались</span><InputText @bind-Value="negotiation.Contact" /></label>
                </div>
                <details><summary>Обсуждали цену</summary><div class="form-grid">
                    <label class="field"><span>Цена продавца, ₽</span><InputNumber @bind-Value="negotiation.SellerPrice" min="0"/></label><label class="field"><span>Наше предложение, ₽</span><InputNumber @bind-Value="negotiation.BuyerOffer" min="0"/></label>
                    <label class="field dossier-wide"><span>Согласованная цена, ₽</span><InputNumber @bind-Value="negotiation.AgreedPrice" min="0"/><small>Только если обе стороны подтвердили сумму.</small></label>
                    <label class="field dossier-wide"><span>Условия договорённости</span><InputTextArea @bind-Value="negotiation.Conditions" placeholder="Порядок расчётов, сроки, условия передачи"/></label>
                </div></details>
                <details><summary>Дальнейшая договорённость</summary><div class="form-grid"><label class="field"><span>Что договорились сделать</span><InputText @bind-Value="negotiation.NextStep"/></label><label class="field"><span>Срок (МСК)</span><input type="datetime-local" value="@negotiation.NextDue" @oninput="e=>negotiation.NextDue=e.Value?.ToString()??string.Empty"/></label><label class="field dossier-wide"><span>Дополнительный комментарий</span><InputTextArea @bind-Value="negotiation.Comment"/></label></div><p class="subtle">Договорённость сохранится в истории контакта. Текущая задача объекта изменяется отдельно через «Следующее действие».</p></details>
                <div class="form-actions"><button type="button" class="btn secondary" @onclick="()=>negotiationOpen=false">Отмена</button><ActionButton Label="Добавить контакт" Type="submit" Busy="Busy"/></div>
            </EditForm>
        </CaseModal>
    }
    @if(checkOpen)
    {
        <CaseModal Title="@(check.Id==null?"Назначить проверку":"Результат проверки")" Subtitle="@(check.Id==null?"Определите задачу и исполнителя. Результат можно записать позже.":check.Title)" Error="@Error" Busy="Busy" OnClose="()=>checkOpen=false">
            <EditForm Model="check" FormName="case-check" OnValidSubmit="SaveCheckAsync"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid">
                @if(check.Id==null){<label class="field dossier-wide"><span>Что проверить</span><select @bind="check.TemplateKey" @bind:after="UseCheckTemplate"><option value="">Своя проверка</option>@foreach(var item in card.CheckTemplates.Where(x=>x.Active)){<option value="@item.Id">@item.Title</option>}</select></label>
                @if(card.CheckTemplates.FirstOrDefault(x=>x.Id.ToString()==check.TemplateKey) is {} template){<p class="subtle dossier-wide">@template.Description</p>}}
                <label class="field dossier-wide"><span>Название *</span><InputText @bind-Value="check.Title"/><ValidationMessage For="()=>check.Title"/></label>
                <label class="field"><span>Глубина проверки</span><InputSelect @bind-Value="check.Level">@foreach(var level in Enum.GetValues<CaseCheckLevel>()){<option value="@level">@ProcurementLabels.CheckLevel(level)</option>}</InputSelect></label>
                <label class="field"><span>Ответственный</span><select @bind="check.Responsible"><option value="">Не назначен</option>@foreach(var employee in card.Assignees){<option value="@employee.EmployeeId">@employee.Name</option>}</select></label>
                <label class="field"><span>Срок (МСК)</span><input type="datetime-local" value="@check.Due" @oninput="e=>check.Due=e.Value?.ToString()??string.Empty"/></label>
                @if(check.Id!=null){<label class="field"><span>Итог / статус</span><InputSelect @bind-Value="check.Status">@foreach(var status in Enum.GetValues<CaseCheckStatus>()){<option value="@status">@ProcurementLabels.CheckStatus(status)</option>}</InputSelect></label><label class="field dossier-wide"><span>Заключение</span><InputTextArea @bind-Value="check.Result" placeholder="Что установлено и на основании каких документов?"/></label>}
            </div>
            @if(check.Id!=null){<details><summary>Дополнительные сведения</summary><label class="field"><span>Стоимость проверки, ₽</span><InputNumber @bind-Value="check.Cost" min="0"/></label>@if(card.CanManageBlockers){<label class="check-field"><InputCheckbox @bind-Value="check.Blocker"/> Блокирует дальнейшее решение</label><small>Причину укажите в заключении.</small>}</details>}
            <div class="form-actions"><button type="button" class="btn secondary" @onclick="()=>checkOpen=false">Отмена</button><ActionButton Label="@(check.Id==null?"Назначить проверку":"Сохранить результат")" Type="submit" Busy="Busy"/></div></EditForm>
        </CaseModal>
    }
    @if(attachmentOpen){<CaseModal Error="@Error" Busy="Busy" Title="Добавить материал" OnClose="CloseAttachment"><EditForm Model="attachment" FormName="attachment" OnValidSubmit="SaveAttachmentAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid">@if(attachment.Kind==CaseAttachmentKind.Link){<label class="field dossier-wide"><span>HTTPS-ссылка</span><input type="url" @bind="attachment.Url" /></label>}else{<label class="upload dossier-wide"><strong>@(selectedFile?.Name??"＋ Выберите или перетащите файл")</strong><small>@(selectedFile==null?$"До {FileUploadLimits.MaxRawFileMegabytes} МБ · файл будет сохранён в хранилище":FormatSize(selectedFile.Size)+" · нажмите, чтобы заменить")</small><InputFile OnChange="SelectFile" accept="@ProcurementLabels.Accept(attachment.Kind)" />@if(UploadFileTooLarge(selectedFile)){<small class="case-problem">@FileUploadLimits.TooLargeMessage</small>}</label>}<label class="field dossier-wide"><span>Название</span><input @bind="attachment.Label" /></label><label class="field dossier-wide"><span>Описание / комментарий</span><textarea @bind="attachment.Description"></textarea></label><details class="dossier-wide"><summary>Назначение и связь</summary><div class="form-grid"><label class="field dossier-wide"><span>Пункт документов (необязательно)</span><select @bind="attachment.RequirementKey" @bind:after="UseDocumentRequirement"><option value="">Не относится к обязательному документу</option>@foreach(var item in card.DocumentRequirements){<option value="@item.Id">@item.Title · @ProcurementLabels.DocumentStatus(item.Status)</option>}</select></label><label class="field"><span>Связь</span><select @bind="attachment.OwnerKey"><option value="case">Весь объект</option>@foreach(var item in card.Negotiations){<option value="n:@item.Id">Переговоры · @ProcurementLabels.Time(item.EffectiveAt)</option>}@foreach(var item in card.Checks){<option value="c:@item.Id">Проверка · @item.Title</option>}@if(card.Inspection!=null){<option value="i:@card.Inspection.Id">Осмотр целиком</option>@foreach(var item in card.Inspection.Items.Where(x=>x.AllowAttachments)){<option value="ii:@item.Id">Пункт осмотра · @item.Title</option>}}</select></label><label class="field"><span>Тип</span><InputSelect @bind-Value="attachment.Kind">@foreach(var value in Enum.GetValues<CaseAttachmentKind>()){<option value="@value">@ProcurementLabels.AttachmentKind(value)</option>}</InputSelect></label></div></details><div class="form-actions"><button type="button" class="btn secondary" @onclick="CloseAttachment">Отмена</button><ActionButton Label="Добавить материал" Type="submit" Busy="Busy" Disabled="@(attachment.Kind!=CaseAttachmentKind.Link&&(selectedFile==null||UploadFileTooLarge(selectedFile)))" /></div></div></EditForm></CaseModal>}
    @if(documentRequirementOpen){<CaseModal Error="@Error" Busy="Busy" Title="Статус документа" OnClose="()=>documentRequirementOpen=false"><EditForm Model="documentRequirement" FormName="document-requirement" OnValidSubmit="SaveDocumentRequirementAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><div class="dossier-wide"><strong>@documentRequirement.Title</strong><p class="subtle">@documentRequirement.Description</p></div><label class="field"><span>Статус</span><InputSelect @bind-Value="documentRequirement.Status"><option value="Missing">Нет</option><option value="Requested">Запрошен</option>@if(documentRequirement.HasAttachment){<option value="Received">Получен</option><option value="Verified">Проверен</option>}</InputSelect></label><label class="field"><span>Срок (МСК)</span><input type="datetime-local" value="@documentRequirement.Due" @oninput="e=>documentRequirement.Due=e.Value?.ToString()??string.Empty" /></label><label class="field dossier-wide"><span>Комментарий</span><textarea @bind="documentRequirement.Note" maxlength="2000"></textarea></label><div class="form-actions"><button type="button" class="btn secondary" @onclick="()=>documentRequirementOpen=false">Отмена</button><ActionButton Label="Сохранить статус" Type="submit" Busy="Busy" /></div></div></EditForm></CaseModal>}
    @if(purchaseOpen){<CaseModal Error="@Error" Busy="Busy" Title="Отметить объект как купленный" OnClose="()=>purchaseOpen=false"><EditForm Model="purchase" FormName="acquire-case" OnValidSubmit="AcquireAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field"><span>Фактическая цена покупки, ₽</span><InputNumber @bind-Value="purchase.Price" /></label><label class="field"><span>Дата покупки / регистрации</span><InputDate @bind-Value="purchase.Date" /></label><label class="field dossier-wide"><span>Комментарий (необязательно)</span><textarea @bind="purchase.Comment"></textarea></label><p class="subtle dossier-wide">После подтверждения объект останется доступным со всей историей. Укажите фактическую цену и дату покупки.</p><div class="form-actions"><button type="button" class="btn secondary" @onclick="()=>purchaseOpen=false">Отмена</button><ActionButton Label="Подтвердить покупку" Type="submit" Busy="Busy" /></div></div></EditForm></CaseModal>}
    @if(correctionOpen){<CaseModal Error="@Error" Busy="Busy" Title="Исправить данные покупки" OnClose="()=>correctionOpen=false"><EditForm Model="correction" FormName="correct-acquisition" OnValidSubmit="CorrectAcquisitionAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field"><span>Фактическая цена, ₽</span><InputNumber @bind-Value="correction.Price" /></label><label class="field"><span>Дата покупки / регистрации</span><InputDate @bind-Value="correction.Date" /></label><label class="field dossier-wide"><span>Комментарий</span><textarea @bind="correction.Comment"></textarea></label><label class="field dossier-wide"><span>Причина исправления</span><textarea @bind="correction.Reason" maxlength="1000"></textarea></label><p class="subtle dossier-wide">Предыдущие значения, причина и автор останутся в истории и системном аудите.</p><div class="form-actions"><button type="button" class="btn secondary" @onclick="()=>correctionOpen=false">Отмена</button><ActionButton Label="Сохранить исправление" Type="submit" Busy="Busy" /></div></div></EditForm></CaseModal>}
    @if(factCorrectionOpen){<CaseModal Title="Исправить рабочие данные" Busy="Busy" OnClose="CloseFactCorrection"><EditForm Model="factCorrection" FormName="correct-case-fact" OnValidSubmit="SaveFactCorrectionAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field dossier-wide"><span>Поле</span><InputSelect @bind-Value="factCorrection.Field" @bind-Value:after="UseFactCorrectionField">@foreach(var value in Enum.GetValues<CaseFactField>()){<option value="@value">@ProcurementLabels.Fact(value)</option>}</InputSelect></label><div class="correction-preview dossier-wide"><div><small>Сейчас</small><strong>@FactCurrentDisplay()</strong></div><div><small>После исправления</small><strong>@FactProposedDisplay()</strong></div></div>@if(FactUsesText()){<label class="field dossier-wide"><span>Новое значение</span><InputText @bind-Value="factCorrection.TextValue" maxlength="@FactTextMaxLength()" /></label>}else{<label class="field dossier-wide"><span>@(factCorrection.Field==CaseFactField.Price?"Новое значение, ₽":"Новое значение, м²")</span><InputNumber @bind-Value="factCorrection.NumericValue" /></label><p class="subtle dossier-wide">Пустое значение очистит этот рабочий факт.</p>}@if(factCorrection.Field is CaseFactField.Location or CaseFactField.CadastralNumber){<p class="subtle dossier-wide">Пустое значение очистит этот рабочий факт.</p>}<label class="field dossier-wide"><span>Причина исправления</span><InputTextArea @bind-Value="factCorrection.Reason" maxlength="4000" /></label><p class="subtle dossier-wide">Меняется только рабочий факт карточки. Значения исходных источников не переписываются.</p>@if(Error!=null){<div class="correction-error dossier-wide"><p class="case-problem">@Error</p><button type="button" class="btn secondary" disabled="@Busy" @onclick="RefreshCorrectionAsync">Обновить данные</button></div>}<div class="form-actions dossier-wide"><button type="button" class="btn secondary" disabled="@Busy" @onclick="CloseFactCorrection">Отмена</button><ActionButton Label="Сохранить исправление" Type="submit" Busy="Busy" /></div></div></EditForm></CaseModal>}
    @if(sourceLinkOpen){<CaseModal Title="Исправить связь источника" Busy="Busy" OnClose="CloseSourceLinkCorrection">@if(sourceLinkLoading){<p class="subtle">Загружаем доступные объекты…</p>}else if(sourceLinkLoadError!=null){<div class="correction-error"><p class="case-problem">@sourceLinkLoadError</p><button type="button" class="btn secondary" @onclick="RefreshCorrectionAsync">Обновить данные</button></div>}else{<EditForm Model="sourceLinkCorrection" FormName="correct-source-link" OnValidSubmit="SaveSourceLinkCorrectionAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><div class="dossier-wide"><strong>@sourceLinkCorrection.SourceTitle</strong><p class="subtle">Исправление связи не меняет данные самого источника.</p></div><div class="correction-preview dossier-wide"><div><small>Текущая связь</small><strong>@sourceLinkCorrection.CurrentBusinessNumber</strong></div><div><small>После исправления</small><strong>@SourceLinkTargetDisplay()</strong></div></div><label class="field dossier-wide"><span>Новая связь</span><InputSelect @bind-Value="sourceLinkCorrection.TargetCaseId"><option value="">Только отвязать — вернуть источник во входящие</option>@foreach(var target in sourceLinkTargets){<option value="@target.CaseId">@target.BusinessNumber · @target.Title</option>}</InputSelect></label><label class="field dossier-wide"><span>Причина исправления</span><InputTextArea @bind-Value="sourceLinkCorrection.Reason" maxlength="4000" /></label><p class="subtle dossier-wide">Старая связь останется в истории. Подтверждённой станет только выбранная связь.</p>@if(Error!=null){<div class="correction-error dossier-wide"><p class="case-problem">@Error</p><button type="button" class="btn secondary" disabled="@Busy" @onclick="RefreshCorrectionAsync">Обновить данные</button></div>}<div class="form-actions dossier-wide"><button type="button" class="btn secondary" disabled="@Busy" @onclick="CloseSourceLinkCorrection">Отмена</button><ActionButton Label="Сохранить связь" Type="submit" Busy="Busy" /></div></div></EditForm>}</CaseModal>}
    @if(retryAttachmentId!=null){<CaseModal Title="Восстановить загрузку" Busy="Busy" OnClose="CloseAttachmentRetry"><p><strong>@(RetryAttachmentView()?.Label??"Вложение")</strong></p><p class="subtle">Текущее состояние: @ProcurementLabels.FileStatus(RetryAttachmentView()?.Status??StoredFileStatus.PendingUpload). Повтор продолжит это же вложение и не создаст новую запись. Выберите исходный файл повторно.</p><InputFile OnChange="SelectRetryFile" accept="@ProcurementLabels.Accept(RetryAttachmentView()?.Kind??CaseAttachmentKind.Document)" /><small>@(retryFile?.Name??"Файл не выбран")</small>@if(UploadFileTooLarge(retryFile)){<p class="case-problem">@FileUploadLimits.TooLargeMessage</p>}@if(Error!=null){<p class="case-problem">@Error</p>}<div class="form-actions"><button type="button" class="btn secondary" disabled="@Busy" @onclick="CloseAttachmentRetry">Отмена</button><ActionButton Label="Повторить в это вложение" OnClick="RetryAttachmentAsync" Busy="Busy" Disabled="@(retryFile==null||UploadFileTooLarge(retryFile))" /></div></CaseModal>}
}
else { <PageState Kind="error" Title="Карточку не удалось загрузить"><ActionButton Label="Повторить" OnClick="ReloadAsync" /></PageState> }

@code {
    [Parameter] public Guid CaseId { get; set; }
    [Parameter] public bool FullPage { get; set; }
    private SourceDiscrepancyView? pendingFact;
    private bool nextActionOpen;
    private async Task NextActionSaved(){nextActionOpen=false;await ReloadAsync();Success="Следующее действие сохранено";}
    private int photoIndex; private bool galleryOpen, descriptionExpanded, noteOpen, decisionsOpen, templatesOpen;
    private bool AnyDialog => pendingFact!=null||nextActionOpen||galleryOpen||noteOpen||decisionsOpen||templatesOpen||negotiationOpen||checkOpen||attachmentOpen||documentRequirementOpen||purchaseOpen||correctionOpen||factCorrectionOpen||sourceLinkOpen||retryAttachmentId!=null||dialogAction!=null;
    private void MovePhoto(int step) => photoIndex=(photoIndex+step+card!.Photos.Length)%card.Photos.Length;
    private string AreaInSotki() => card!.Item.Area is {} area ? (area/100m).ToString("0.##",System.Globalization.CultureInfo.GetCultureInfo("ru-RU"))+" сот." : "Не указана";
    private static string OptionalPrice(decimal? price) => price is null ? "Не указано" : ProcurementLabels.Money(price);
    [Parameter] public EventCallback OnChanged { get; set; }
    private static readonly (string Id,string Label)[] Tabs=[("overview","Основное"),("negotiations","Переговоры"),("checks","Проверки"),("inspection","Осмотр"),("documents","Документы"),("history","История"),("sources","Источники")];
    private CaseCard? card; private Guid loaded; private string tab="overview"; private ProcurementAction? dialogAction; private string dialogTitle=""; private bool negotiationOpen; private bool checkOpen; private bool attachmentOpen; private bool documentRequirementOpen; private bool purchaseOpen; private bool correctionOpen; private bool factCorrectionOpen; private bool sourceLinkOpen; private bool sourceLinkLoading;
    private string? sourceLinkLoadError; private IReadOnlyList<CaseLinkTarget> sourceLinkTargets=[];
    private NoteInput note=new(); private NegotiationInput negotiation=new(); private CheckInput check=new(); private CheckTemplateInput checkTemplate=new(); private AttachmentInput attachment=new(); private DocumentRequirementInput documentRequirement=new(); private PurchaseInput purchase=new(); private CorrectionInput correction=new(); private FactCorrectionInput factCorrection=new(); private SourceLinkCorrectionInput sourceLinkCorrection=new(); private IBrowserFile? selectedFile; private Guid? retryAttachmentId; private IBrowserFile? retryFile;
    protected override async Task ReadAsync(){card=await Workspace.ReadCardAsync(CurrentSubject,CaseId,CancellationToken.None);photoIndex=loaded==CaseId?Math.Clamp(photoIndex,0,Math.Max(0,card.Photos.Length-1)):0;if(loaded!=CaseId){factCorrectionOpen=false;sourceLinkOpen=false;sourceLinkTargets=[];}loaded=CaseId;}
    protected override async Task OnParametersSetAsync(){if(loaded!=CaseId)await ReloadAsync();}
    private string SourceSummary()=>card!.Sources.Count==0?"Нет связанных":string.Join(" + ",card.Sources.Select(x=>ProcurementLabels.Source(x.Source)).Distinct());
    private static string NegotiationTitle(NegotiationView item)=>item.AgreedPrice!=null?"Согласована цена":item.BuyerOffer!=null?"Наше предложение":item.SellerPrice!=null?"Цена продавца":item.Outcome.Length>0?item.Outcome:"Событие коммуникации";
    private static string Meta(params string?[] values)=>string.Join(" · ",values.Where(x=>!string.IsNullOrWhiteSpace(x)));
    private string CheckSummary(CaseCheckLevel level)=>card!.Checks.Any(x=>x.Level==level&&x.Blocker)?"Есть блокирующие вопросы":card.Checks.Any(x=>x.Level==level)?"Проверки зафиксированы":"Не начаты";
    private string NextAction()=>card!.Item.Stage=="acquired"?"Закупка завершена":string.IsNullOrWhiteSpace(card.Item.NextActionTitle)?"Следующее действие не назначено":card.Item.NextActionTitle;
    private int CompletedChecks()=>card!.Checks.Count(x=>x.Status is CaseCheckStatus.Passed or CaseCheckStatus.Issue);
