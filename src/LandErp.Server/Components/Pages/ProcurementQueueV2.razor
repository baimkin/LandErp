@using LandErp.Application.Modules.Overview.Contracts
@using LandErp.Application.Modules.Catalog.Contracts
@inject IGroupMarketService Markets
@page "/procurement"
@page "/procurement-v2"
@attribute [Authorize]
@using System.Globalization
@using LandErp.Application.Foundation.Files
@using LandErp.Application.Modules.Catalog.Domain
@using LandErp.Application.Modules.Procurement.Contracts
@using LandErp.Application.Modules.Procurement.Domain
@using LandErp.Application.Modules.Workflow.Domain
@using LandErp.Server.Components.Procurement
@inherits WorkspaceComponent
@inject IProcurementQueueV2ReadService ReadModel
@inject IProcurementWorkspace Workspace
@inject NavigationManager Navigation

<PageTitle>Очередь закупки · LandErp</PageTitle>

<section class="pq2-reference @(ShowKanban ? "pq2-kanban" : "")">
    <main class="main">
        @if(!InPipeline){
        @if(!Loading && Error==null && !Forbidden && queuePage!=null){<p class="queue-scope" role="status">@(stageFilter=="pending_head" ? "Ждут решения руководителя" : stageFilter.Length==0 ? "Активные объекты · кроме отклонённых и купленных" : ProcurementLabels.Stage(stageFilter)) · объектов: @queuePage.Total</p>}
        <div class="head">
            <div>
                <span class="kicker">Рабочие объекты закупки</span>
                <h1>Очередь закупки</h1>
                <p>Только уже выбранные объекты. В очереди — минимум информации; детали открываются справа.</p>
            </div>
            <button type="button" class="btn primary" disabled="@(queuePage?.CanCreateManualCase != true || Busy)" @onclick="OpenManualCase">+ Создать объект вручную</button>
        </div>

        }
        @if(kanbanConfig!=null)
        {
            <div class="kanban-toolbar">
                <label class="kanban-pipeline"><span>Воронка</span><select class="ui-select" value="@(InPipeline?activePipeline:Guid.Empty)" @onchange="ChangePipeline">@if(!ShowKanban){<option value="@Guid.Empty">Все воронки</option>}@foreach(var p in kanbanConfig.Pipelines){<option value="@p.Id">@p.Name</option>}</select></label>
                @if(InPipeline && queuePage!=null){<label class="kanban-pipeline"><span>Менеджер</span><select class="ui-select" value="@assigneeFilter" @onchange="AssigneeChangedAsync" aria-label="Менеджер"><option value="">Все менеджеры</option>@foreach(var assignee in queuePage.Assignees){<option value="@assignee.Id">@assignee.Name</option>}</select></label>}
                <div class="kanban-switch"><button type="button" class="btn @(!ShowKanban?"primary":"")" @onclick="()=>ChangeView(false)">Таблица</button><button type="button" class="btn @(ShowKanban?"primary":"")" @onclick="()=>ChangeView(true)">Канбан</button></div>
                @if(InPipeline&&kanbanConfig.CanConfigureKanban){<button type="button" class="btn" @onclick="()=>kanbanSettingsOpen=true">Настроить этапы</button>}
                @if(InPipeline&&kanbanConfig.CanManageCards){<button type="button" class="btn" @onclick="OpenAddExisting">Добавить существующий объект</button>}
                @if(InPipeline){<button type="button" class="btn primary" disabled="@(queuePage?.CanCreateManualCase!=true||Busy)" @onclick="OpenManualCase">+ Создать объект вручную</button>}
            </div>
            @if(!InPipeline){<p class="kanban-scope-hint">Общая очередь: доступные объекты закупки из всех воронок и без воронки. По умолчанию — кроме купленных и отклонённых. Канбан показывает одну выбранную воронку.</p>}
            <KanbanToast Message="@kanbanMessage" AutoDismiss="kanbanSuccess" Sequence="kanbanNoticeVersion" />
            @if(pendingMove!=null&&!kanbanBusy){<button type="button" class="btn" @onclick="RetryKanbanMove">Проверить результат переноса</button>}
        }
        @if (Loading)
        {
            <div class="state"><strong>Загружаем очередь закупки…</strong></div>
        }
        else if (Forbidden)
        {
            <div class="state"><strong>Нет доступа к очереди закупки</strong></div>
        }
        else
        {
            @if (Error != null)
            {
                <div class="state error"><strong>@Error</strong><button type="button" class="btn" @onclick="ReloadAsync">Обновить данные</button></div>
            }
            @if (Success != null)
            {
                <div class="state" role="status"><strong>@Success</strong>@if (RefreshRequired) { <button type="button" class="btn" @onclick="ReloadAsync">Обновить данные</button> }</div>
            }

            @if (queuePage != null)
            {
                @if(ShowKanban && kanbanBoard!=null)
                {
                    <KanbanBoard Board="kanbanBoard" Busy="@(kanbanBusy||pendingMove!=null)" Open="OpenKanbanDrawer" OpenTask="OpenKanbanTask" Move="MoveBoardCard" More="MoreKanban" />
                }
                else
                {
                @if(!InPipeline){
                <div class="stats" aria-label="Сводка очереди">
                    <button type="button" class="stat @(dueTodayOnly ? "selected" : "")" @onclick="ToggleDueTodayAsync">
                        <span>Сегодня</span><b>@(queuePage.Summary.DueToday)</b><small>объектов с задачами</small>
                    </button>
                    <button type="button" class="stat danger @(overdueOnly ? "selected" : "")" @onclick="ToggleOverdueAsync">
                        <span>Просрочено</span><b>@(queuePage.Summary.Overdue)</b><small>объектов с задачами</small>
                    </button>
                    <button type="button" class="stat warning @(stageFilter == "returned" ? "selected" : "")" @onclick="ShowReturnedAsync">
                        <span>Возвращены</span><b>@(queuePage.Summary.Returned)</b><small>руководителем</small>
                    </button>
                    <button type="button" class="stat @(stageFilter == "analysis" ? "selected" : "")" @onclick="ShowCheckingAsync">
                        <span>На проверке</span><b>@(queuePage.Summary.Checking)</b><small>первичный анализ</small>
                    </button>
                    <div class="stat market-stat"><GroupMarketPrices Value="groupMarket" Subject="CurrentSubject" Saved="ReloadAsync" EmptyText="Выберите группу поиска в фильтрах" /></div>
                </div>

                }
                <section class="box">
                    @if(!InPipeline){
                    <div class="tools">
                        <input value="@searchDraft"
                               @oninput="e => searchDraft = e.Value?.ToString() ?? string.Empty"
                               @onchange="SearchChangedAsync"
                               @onkeydown="SearchKeyDownAsync"
                               placeholder="Адрес, PC, кадастровый номер, продавец…" />
                        <select class="ui-select" value="@stageFilter" @onchange="StageChangedAsync" aria-label="Состояние закупки">
                            <option value="">Все состояния закупки</option>
                            @foreach (string stage in queuePage.Stages)
                            {
                                <option value="@stage">@ProcurementLabels.Stage(stage)</option>
                            }
                        </select>
                        <select class="ui-select" value="@assigneeFilter" @onchange="AssigneeChangedAsync" aria-label="Ответственный">
                            <option value="">Все ответственные</option>
                            @foreach (ProcurementQueueV2Assignee assignee in queuePage.Assignees)
                            {
                                <option value="@assignee.Id">@assignee.Name</option>
                            }
                        </select>
                        <select class="ui-select" value="@marketGroupId" @onchange="MarketGroupChangedAsync" aria-label="Группа поиска"><option value="">Все группы поиска</option>@foreach(var group in marketGroups){<option value="@group.Id">@group.Name</option>}</select>
                        @if (HasFilters)
                        {
                            <button type="button" class="btn reset" @onclick="ClearFiltersAsync">Сбросить</button>
                        }
                    </div>

                    <div class="chips">
                        <button type="button" class="chipbtn @(!HasOperationalFilter ? "on" : "")" @onclick="ClearOperationalFiltersAsync">Все <b>@(queuePage.Total)</b></button>
                        <button type="button" class="chipbtn @(dueTodayOnly ? "on" : "")" @onclick="ToggleDueTodayAsync">Сегодня <b>@(queuePage.Summary.DueToday)</b></button>
                        <button type="button" class="chipbtn @(overdueOnly ? "on" : "")" @onclick="ToggleOverdueAsync">Просрочено <b>@(queuePage.Summary.Overdue)</b></button>
                        <button type="button" class="chipbtn @(stageFilter == "returned" ? "on" : "")" @onclick="ShowReturnedAsync">Возвращены <b>@(queuePage.Summary.Returned)</b></button>
                        <button type="button" class="chipbtn @(priceChangedOnly ? "on" : "")" @onclick="TogglePriceChangedAsync">Изменилась цена <b>@(queuePage.Summary.PriceChanged)</b></button>
                        <button type="button" class="chipbtn @(stageFilter == "pending_head" ? "on" : "")" @onclick="ShowPendingHeadAsync">У руководителя <b>@(queuePage.Summary.PendingHead)</b></button>
                    </div>

                    }
                    <div class="table">
                        <table class="procurement-table">
                            <colgroup>@foreach(var width in InPipeline?new[]{20,9,13,10,13,7,13,8,7}:new[]{24,9,11,15,9,13,12,7}){<col style="width:@(width)%" />}</colgroup>
                            <thead>
                                <tr>
                                    <th>Объект</th>
                                    <th>Состояние закупки</th>
                                    @if(InPipeline){<th>Статус работы</th>}
                                    <th>Цена / площадь</th>
                                    <th>Следующее действие</th>
                                    <th>Проверка</th>
                                    <th>Последний контакт</th>
                                    <th aria-sort="@ManagerSortAria"><button type="button" class="queue-sort @(sort == ProcurementQueueV2Sort.Manager ? "active" : "")" @onclick="ToggleManagerSortAsync">Ответственный <span aria-hidden="true">@ManagerSortIndicator</span></button></th>
                                    <th>Источники</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (queuePage.Items.Count == 0)
                                {
                                    <tr><td colspan="@(InPipeline?9:8)" class="empty">По выбранным условиям объектов нет.</td></tr>
                                }
                                @foreach (ProcurementQueueV2Row item in queuePage.Items)
                                {
                                    <tr @key="item.CaseId" class="@RowClass(item.RowState)" @onclick="() => OpenDrawerAsync(item.CaseId)">
                                        <td class="obj">
                                            <div class="objline">
                                                @if (!string.IsNullOrWhiteSpace(item.ThumbnailUrl))
                                                {
                                                    <img class="thumb" src="@item.ThumbnailUrl" alt="" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <span class="queue-photo-placeholder" aria-hidden="true">⌂</span>
                                                }
                                                <div>
                                                    <a class="object-title-link"
                                                       href="@($"/procurement/{item.CaseId}")" target="_blank" rel="noopener noreferrer"
                                                       title="Открыть полную карточку"
                                                       @onclick:stopPropagation="true">@item.Title</a>
                                                    <div class="sub">@item.BusinessNumber@if (!string.IsNullOrWhiteSpace(item.CadastralNumber)) { <text> · @item.CadastralNumber</text> }</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge @StageBadge(item.Stage)">@ProcurementLabels.Stage(item.Stage)</span></td>
                                        @if(InPipeline){<td @onclick:stopPropagation="true">@if(item.KanbanMembership is {} membership){<KanbanStagePicker Membership="membership" Stages="CurrentKanbanStages" Disabled="@(!item.CanMoveKanban||kanbanBusy||pendingMove!=null)" Move="MoveSelectedStage" />}else{<span>—</span>}</td>}
                                        <td class="price"><b>@MoneyCompact(item.WorkingPrice)</b><div class="sub">@AreaSotki(item.AreaSquareMeters)</div></td>
                                        <td><span class="badge neutral">@NextActionTypeLabel(item.NextActionType)</span><b>@ValueOrDash(item.NextActionTitle)</b><div class="sub" title="@item.NextActionDescription">@CompactText(item.NextActionDescription, 80)</div><div class="sub @DueCss(item.DueState)">@WorkTaskDeadline.Format(item.DueAt, item.DueHasTime)</div></td>
                                        <td><span class="badge @CheckBadge(item.QuickChecks)">@CheckRatio(item.QuickChecks)</span></td>
                                        <td>
                                            @if (item.LatestContact == null)
                                            {
                                                <span>Нет контакта</span><div class="sub">переговоров нет</div>
                                            }
                                            else
                                            {
                                                <span>@ContactTime(item.LatestContact.EffectiveAt)</span><div class="sub">@ContactCaption(item.LatestContact)</div>
                                            }
                                        </td>
                                        <td><div class="ass"><span class="av">@Initials(item.AssigneeName)</span><span>@item.AssigneeName</span></div></td>
                                        <td><span class="badge neutral">@SourcesText(item.Sources)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <footer class="pager">
                        <span>@PageCaption</span>
                        <div>
                            <button type="button" class="btn" @onclick="PreviousPageAsync" disabled="@(queuePage.Offset == 0)">‹</button>
                            <span class="page-number">@(queuePage.Total == 0 ? 1 : queuePage.Offset / queuePage.Size + 1)</span>
                            <button type="button" class="btn" @onclick="NextPageAsync" disabled="@(queuePage.Offset + queuePage.Size >= queuePage.Total)">›</button>
                        </div>
                    </footer>
                </section>
                }
            }
        }
    </main>
</section>

@if (selectedCaseId != null)
{
    <div class="overlay on" @onclick="CloseDrawer"></div>
    <aside class="drawer on" @onclick:stopPropagation="true" aria-label="Карточка объекта" @onkeydown="KanbanDrawerKey">
        @if (drawerLoading)
        {
            <div class="dh"><div class="grow"><b>Карточка объекта</b></div><button class="btn" type="button" @onclick="CloseDrawer">×</button></div>
            <div class="db"><div class="state"><strong>Загружаем объект…</strong></div></div>
        }
        else if (drawerError != null)
        {
            <div class="dh"><div class="grow"><b>Карточка объекта</b></div><button class="btn" type="button" @onclick="CloseDrawer">×</button></div>
            <div class="db"><div class="state error"><strong>@drawerError</strong></div></div>
        }
        else if (detail != null)
        {
            <div class="dh">
                <div class="grow"><b>@detail.Title</b><div class="sub">@detail.BusinessNumber@if (!string.IsNullOrWhiteSpace(detail.CadastralNumber)) { <text> · @detail.CadastralNumber</text> }</div></div>
                <button class="btn" type="button" @onclick="OpenFullCase">Открыть полную карточку ↗</button>
                <button class="btn" type="button" @onclick="CloseDrawer">×</button>
            </div>
            <div class="db">
                @if (Success != null) { <div class="state" role="status"><strong>@Success</strong>@if (RefreshRequired) { <button class="btn" type="button" @onclick="ReloadAsync">Обновить данные</button> }</div> }
                @if (Error != null) { <div class="state error" role="alert">@Error</div> }

                <CaseSourceChangesNotice @key="detail.CaseId" @ref="sourceNotice" CaseId="detail.CaseId" />
                <div class="card hero">
                    @if (!string.IsNullOrWhiteSpace(detail.ThumbnailUrl))
                    {
                        <img class="photo" src="@detail.ThumbnailUrl" alt="" />
                    }
                    else
                    {
                        <div class="photo fallback" aria-hidden="true">⌂</div>
                    }
                    <div class="facts">
                        @if(InPipeline && SelectedMembership is {} selectedMembership){<div class="fact work-status"><span>Статус работы</span><KanbanStagePicker Membership="selectedMembership" Stages="CurrentKanbanStages" Disabled="@(!SelectedCanMove||kanbanBusy||pendingMove!=null)" Move="MoveSelectedStage" /></div>}
                        <div class="fact"><label>Объект</label><b>@detail.Title</b><small>@ValueOrDash(detail.CadastralNumber)</small></div>
                        <div class="fact"><label>Состояние закупки</label><b>@ProcurementLabels.Stage(detail.Stage)</b></div>
                        <div class="fact"><label>Площадь</label><b>@AreaSotki(detail.AreaSquareMeters)</b></div>
                        <div class="fact"><label>Ответственный</label><b>@detail.AssigneeName</b></div>
                    </div>
                </div>

                <div class="card">
                    <div class="ct"><b>Экономика связанных зон</b><span class="muted">Желаемая цена и расчёт по рабочей площади</span></div>
                    @if (drawerMarkets.Count == 0)
                    {
                        <GroupMarketPrices Value="null" Subject="CurrentSubject" Saved="ReloadAsync" EmptyText="У объекта нет связанной зоны поиска" PurchaseMode="true" AreaSquareMeters="detail.AreaSquareMeters" />
                    }
                    else
                    {
                        <div class="drawer-markets">
                            @foreach (var market in drawerMarkets)
                            {
                                <div class="drawer-market"><GroupMarketPrices Value="market" Subject="CurrentSubject" Saved="ReloadAsync" PurchaseMode="true" AreaSquareMeters="detail.AreaSquareMeters" /></div>
                            }
                        </div>
                    }
                </div>

                <div class="card">
                    <div class="ct"><b>Цена и торг</b><button class="btn" type="button" @onclick="OpenNegotiationsAsync">История цены и переговоров</button></div>
                    <div class="prices">
                        <div class="p"><label>Цена объявления</label><b>@MoneyCompact(detail.CurrentSourceAsk ?? detail.WorkingPrice)</b><small>@PricePerSotkaCaption(detail.CurrentSourceAsk ?? detail.WorkingPrice, detail.AreaSquareMeters)</small>@if(detail.StartPrice!=null){<small>Старт: @MoneyCompact(detail.StartPrice)</small>}</div>
                        <div class="p good"><label>Продавец</label><b>@MoneyCompact(detail.LatestSellerOffer)</b><small>@PricePerSotkaCaption(detail.LatestSellerOffer, detail.AreaSquareMeters)</small></div>
                        <div class="p ours"><label>Мы</label><b>@MoneyCompact(detail.LatestBuyerOffer)</b><small>@PricePerSotkaCaption(detail.LatestBuyerOffer, detail.AreaSquareMeters)</small></div>
                        <div class="p good"><label>Согласовано</label><b>@MoneyCompact(detail.LatestAgreedPrice)</b><small>@PricePerSotkaCaption(detail.LatestAgreedPrice, detail.AreaSquareMeters)</small></div>
                    </div>
                    @if (detail.PriceDeltaFromStart != null)
                    {
                        <div class="sub">@PriceDeltaCaption(detail.PriceDeltaFromStart.Value, detail.PriceDeltaFromStartPercent)</div>
                    }
                </div>

                <div class="card">
                    <CaseNextAction @key="(detail.CaseId,detail.CaseVersion)" CaseId="detail.CaseId" OnSaved="ReloadAsync" />
                </div>

                @if (drawerCard != null)
                {
                    <div class="card"><CaseRichNoteBlock @key="(detail.CaseId, CaseNoteSection.Working)" CaseId="detail.CaseId" Section="CaseNoteSection.Working"
                        Title="Рабочие заметки" Subject="CurrentSubject" Attachments="drawerCard.Attachments" CanEdit="drawerCard.CanManageDossier"
                        Value="@drawerCard.RichNotes.SingleOrDefault(x=>x.Section==CaseNoteSection.Working)" Saved="ReloadAsync" /></div>
                }

                <div class="card">
                    <div class="ct"><b>Переговоры</b><div><span class="badge info">Последние @detail.Negotiations.Count</span><button class="btn" type="button" @onclick="OpenNegotiationsAsync">Все переговоры</button> @if (detail.CanManageDossier && detail.Stage != "acquired") { <button class="btn primary" type="button" @onclick="OpenNegotiation">Записать общение</button> }</div></div>
                    @if(detail.Negotiations.Count==0){<p class="muted">Переговоры ещё не начаты.</p>}
                    <CaseActivityFeed Items="detail.Negotiations.Select(CaseFeedFormat.From).ToArray()"/>
                </div>

                <div class="card">
                    <div class="ct"><b>Проверки</b><button class="btn" type="button" @onclick='()=>OpenCaseSection("checks")'>Открыть проверки</button></div>
                    @if (drawerCard != null) { <div class="drawer-checks"><CaseChecks @key="detail.CaseId" CaseId="detail.CaseId" Card="drawerCard" Subject="CurrentSubject" Refresh="ReloadAsync" /></div> }
                </div>

                <div class="card">
                    <div class="ct"><b>Осмотр участка</b>@if (detail.Inspection.Exists) { <button class="btn" type="button" @onclick="OpenInspectionReportAsync">Посмотреть результат</button> } else if (detail.CanAssignInspections && detail.Stage != "acquired") { <button class="btn" type="button" @onclick="OpenInspectionEditor">Назначить осмотр</button> }</div>
                    @if (!detail.Inspection.Exists)
                    {
                        <div class="inspection empty-inspection">
                            <div class="inspection-top"><div><b>Осмотр ещё не проводился</b><p>Полевой чек-лист, фото, видео и аудио появятся здесь после начала осмотра.</p></div><span class="badge neutral">Нет данных</span></div>
                        </div>
                    }
                    else
                    {
                        <div class="inspection">
                            <div class="inspection-top">
                                <div><b>@(detail.Inspection.Status == InspectionStatus.Completed ? "Осмотр завершён" : "Осмотр начат") · @ShortDate(detail.Inspection.Date)</b>@if (!string.IsNullOrWhiteSpace(detail.Inspection.Conclusion)) { <p>@detail.Inspection.Conclusion</p> }</div>
                                <span class="badge @(detail.Inspection.Problems > 0 ? "warn" : "ok")">@(detail.Inspection.Problems > 0 ? "Есть замечания" : "Без проблем")</span>
                            </div>
                            <div class="inspection-stats">
                                <span class="inspection-stat"><b>@detail.Inspection.CheckedItems</b> из @detail.Inspection.TotalItems пунктов</span>
                                <span class="inspection-stat"><b>@detail.Inspection.Problems</b> проблем</span>
                                <span class="inspection-stat"><b>@detail.Inspection.PhotoVideoCount</b> фото/видео</span>
                                <span class="inspection-stat"><b>@detail.Inspection.AudioCount</b> аудио</span>
                                <span class="inspection-stat"><b>@detail.Inspection.FileCount</b> файлов</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="card">
                    <div class="ct"><b>Последние события</b><button class="btn" type="button" @onclick='()=>OpenCaseSection("history")'>Вся история</button></div>
                    @if (detail.Timeline.Count == 0)
                    {
                        <div class="muted">Событий пока нет.</div>
                    }
                    else
                    {
                        <CaseActivityFeed Items="detail.Timeline.Select(CaseFeedFormat.From).ToArray()"/>
                    }
                </div>

                <div class="card">
                    <div class="ct"><b>Источники</b><span class="badge neutral">@detail.Sources.Count</span></div>
                    @if (detail.Sources.Count == 0)
                    {
                        <div class="muted">Case создан без внешних источников.</div>
                    }
                    else
                    {
                        <CaseSourceLinks Items="detail.Sources.Select(x=>new CaseSourceLinkItem(x.Source,x.Title??x.ExternalId??ProcurementLabels.Source(x.Source),x.Url)).ToArray()"/>
                        @foreach(var source in detail.Sources){<div><span>@ProcurementLabels.Source(source.Source)</span><SourceChangesButton @key="(detail.CaseId,source.CatalogItemId)" CaseId="detail.CaseId" CatalogItemId="source.CatalogItemId" OnViewed="RefreshSourceNotices" /></div>}

                    }
                </div>
            </div>

            <div class="df decisions-footer">
                @if(drawerCard!=null)
                {
                    <CaseDecisionState Card="drawerCard" Busy="Busy" OnAction="OpenDecisionAsync" OnSection="OpenCaseSection" />
                    @if(CaseDecisionPresentation.CanPurchase(drawerCard)){<button class="btn secondary" type="button" @onclick="OpenFullCase">Оформить покупку в карточке</button>}
                }
                <button class="btn quiet" type="button" @onclick="OpenFullCase">Открыть карточку</button>
            </div>
        }
    </aside>
}

@if (manualCaseOpen)
{
    <div class="modalBack on" @onclick="CloseManualCase">
        <div class="modal add-modal" @onclick:stopPropagation="true">
            <div class="mh"><div class="grow"><b>Создать объект вручную</b><div class="sub">Объект без обязательного входящего объявления</div></div><button class="btn" type="button" @onclick="CloseManualCase">×</button></div>
            <EditForm Model="manualCase" FormName="procurement-v2-manual-case" OnValidSubmit="CreateManualCaseAsync">
                <DataAnnotationsValidator />
                <div class="mb">
                    <ValidationSummary />
                    @if (Error != null) { <div class="modal-state error" role="alert">@Error</div> }
                    <div class="form">
                        <div class="field full"><label>Название объекта</label><input @bind="manualCase.Title" maxlength="512" placeholder="Например, участок у деревни Новая" /></div>
                        <div class="field"><label>Локация</label><input @bind="manualCase.Location" maxlength="20000" /></div>
                        <div class="field"><label>Кадастровый номер</label><input @bind="manualCase.CadastralNumber" maxlength="128" /></div>
                        <div class="field"><label>Рабочая цена, ₽</label><NumberInput @bind-Value="manualCase.Price"  Money="true" /></div>
                        <div class="field"><label>Площадь, м²</label><NumberInput @bind-Value="manualCase.AreaSquareMeters"  /></div>
                        <div class="field full"><label>Как узнали об объекте / контекст</label><textarea @bind="manualCase.Comment" maxlength="900" placeholder="Звонок собственника, Telegram, рекомендация директора…"></textarea></div>
                    </div>
                </div>
                <div class="mf"><button class="btn" type="button" @onclick="CloseManualCase">Отмена</button><button class="btn primary" type="submit" disabled="@Busy">Создать объект</button></div>
            </EditForm>
        </div>
    </div>
}

@if (decisionCard != null)
{
    <DecisionDialog Card="decisionCard" Action="decisionAction" Title="@CaseDecisionPresentation.Title(decisionAction)" Busy="@Busy" Error="@Error" NeedsRefresh="decisionNeedsRefresh" OnRefresh="RefreshDecisionAsync"
                    OnConfirm="ConfirmDecisionAsync" OnClose="CloseDecision" />
}

@if (negotiationOpen && detail != null)
{
    <CaseCommunication CaseId="detail.CaseId" OnClose="CloseNegotiation" OnSaved="CommunicationSaved" />
}

@if (negotiationsOpen && detail != null)
{
    <div class="modalBack on" @onclick="CloseNegotiations">
        <div class="modal history-modal" @onclick:stopPropagation="true">
            <div class="mh"><div class="grow"><b>История цены и переговоров</b><div class="sub">@detail.BusinessNumber · все зафиксированные контакты</div></div><button class="btn" type="button" @onclick="CloseNegotiations">×</button></div>
            <div class="mb history-body">
                @if (negotiationsLoading)
                {
                    <div class="modal-state">Загружаем историю…</div>
                }
