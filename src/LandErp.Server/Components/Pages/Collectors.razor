@page "/collectors"
@attribute [Authorize(Policy = "agents.manage")]
@inherits WorkspaceComponent
@using LandErp.Application.Modules.Collection.Contracts
@using LandErp.Application.Modules.Catalog.Domain
@using LandErp.Collector.Contracts.V1
@inject ICollectionAdministration Administration
@inject IOrganizationWorkspace Organization
<PageTitle>Collector · LandErp</PageTitle>
<PageHeader Title="Collector и сбор" Breadcrumb="Данные / Collector" Description="Связь, разрешённые поиски и результаты локальных приложений." />
@if (Loading) { <PageState Kind="loading" Title="Проверяем связь…" /> }
else if (Forbidden) { <PageState Kind="forbidden" Title="Нет доступа" /> }
else
{
    @if (Error != null) { <PageState Kind="error" Title="@Error"><ActionButton Label="Повторить" OnClick="ReloadAsync" /></PageState> }
    @if (Success != null) { <PageState Kind="success" Title="@Success" /> }
    @if (credential != null) { <article class="surface"><h2>Collector создан</h2><p>Сохраните token локально вне Git; он показывается только сейчас.</p><label class="field"><span>ID Collector</span><input readonly value="@credential.AgentId" /></label><label class="field"><span>Одноразовый token Collector</span><input readonly value="@credential.Token" autocomplete="off" /></label><ActionButton Label="Скрыть token" OnClick="() => credential = null" /></article> }
    @if (view != null && organization != null)
    {
        <div class="form-grid"><article class="surface"><h2>Локальные приложения</h2>
        @if(view.Agents.Count == 0) { <p class="subtle">Создайте Collector и подключите его в локальном приложении.</p> }
        @foreach(AgentView agent in view.Agents) { <div class="list-row"><div><strong>@agent.Name</strong><small>@agent.Version · @agent.Capabilities</small><small>Heartbeat: @Time(agent.LastHeartbeatAt)</small></div><StatusBadge Label="@(!agent.Enabled ? "Отозван" : agent.Online ? "Online" : "Offline")" Tone="@(agent.Online ? "success" : "warning")" /><ActionButton Label="Перевыпустить token" Tone="quiet" OnClick="() => RotateAsync(agent)" />@if(agent.Enabled) { <ActionButton Label="Отозвать" Tone="quiet" OnClick="() => RevokeAsync(agent)" /> }</div> }
        <EditForm Model="agentInput" FormName="agent" OnValidSubmit="CreateAgentAsync"><DataAnnotationsValidator /><ValidationSummary /><label class="field"><span>Имя Collector</span><input @bind="agentInput.Name" @bind:event="oninput" /></label><ActionButton Type="submit" Label="Создать Collector" Busy="Busy" Disabled="@(string.IsNullOrWhiteSpace(agentInput.Name))" /></EditForm></article>
        <article class="surface"><h2>Разрешённый поиск</h2><EditForm Model="searchInput" FormName="search" OnValidSubmit="CreateSearchAsync"><DataAnnotationsValidator /><ValidationSummary />
        <label class="field"><span>Название поиска</span><input @bind="searchInput.Label" @bind:event="oninput" /></label>
        <label class="field"><span>Источник поиска</span><InputSelect aria-label="Источник поиска" @bind-Value="searchInput.Source"><option value="Avito">Avito</option><option value="Cian">Cian</option></InputSelect></label>
        <label class="field"><span>Ссылка поиска</span><input type="url" @bind="searchInput.Url" @bind:event="oninput" /></label>
        <p class="subtle">Конкретный Collector не назначается: работу возьмёт свободный совместимый парсер.</p>
        <label class="field"><span>Предел страниц</span><InputNumber @bind-Value="searchInput.MaxPages" /></label><ActionButton Type="submit" Label="Сохранить поиск" Busy="Busy" /></EditForm></article></div>
        <article class="surface"><h2>Поиски</h2>@foreach(SearchView search in view.Searches) { <div class="list-row"><div><strong>@search.Label</strong><small>@search.Source · до @search.MaxPages страниц</small><a href="@search.Url" target="_blank" rel="noopener noreferrer">Открыть источник</a></div><ActionButton Label="Поставить сбор" OnClick="() => EnqueueAsync(search.Id)" Busy="Busy" /></div> }</article>
        <article class="surface table-surface"><div class="table-toolbar"><h2>Последние работы</h2></div>@if(view.Jobs.Count == 0) { <PageState Title="Работ пока нет" Description="Поставьте сбор для разрешённого поиска." /> }
        else { <div class="table-wrap"><table class="data-table"><thead><tr><th>Поиск / Collector</th><th>Состояние</th><th>Срок lease</th><th>Результат</th></tr></thead><tbody>@foreach(CollectionJobView job in view.Jobs) { <tr><td><strong>@job.Label</strong><small>@job.Agent · @Time(job.CreatedAt)</small></td><td><StatusBadge Label="@JobLabel(job.State)" Tone="@(job.State == "Completed" ? "success" : "warning")" /></td><td>@Time(job.LeaseExpiresAt)</td><td>@job.ResultCode<small>Принято: @job.AcceptedCount</small></td></tr> }</tbody></table></div> }</article>
    }
}
@code {
    private CollectionAdminView? view; private OrganizationView? organization; private AgentCredential? credential;
    private readonly AgentInput agentInput = new(); private SearchInput searchInput = new();
    protected override async Task ReadAsync() { view=await Administration.ReadAsync(CurrentSubject,CancellationToken.None); organization=await Organization.ReadAsync(CurrentSubject,CancellationToken.None); }
    private Task CreateAgentAsync() => ExecuteAsync(async () => { credential=await Administration.CreateAgentAsync(CurrentSubject,agentInput.Name,Guid.CreateVersion7().ToString(),CancellationToken.None); agentInput.Name=""; });
    private Task RevokeAsync(AgentView agent) => ExecuteAsync(() => Administration.RevokeAgentAsync(CurrentSubject,agent.Id,agent.Revision,Guid.CreateVersion7().ToString(),CancellationToken.None));
    private Task RotateAsync(AgentView agent) => ExecuteAsync(async () => credential=await Administration.RotateCredentialAsync(CurrentSubject,agent.Id,agent.Revision,Guid.CreateVersion7().ToString(),CancellationToken.None));
    private Task CreateSearchAsync() => ExecuteAsync(async () => { await Administration.CreateSearchAsync(CurrentSubject,new(searchInput.Label,searchInput.Source,searchInput.Url,searchInput.MaxPages),Guid.CreateVersion7().ToString(),CancellationToken.None); searchInput=new(); });
    private Task EnqueueAsync(Guid id) => ExecuteAsync(() => Administration.EnqueueAsync(CurrentSubject,id,Guid.CreateVersion7().ToString(),CancellationToken.None));
    private static string Time(DateTimeOffset? instant) => instant?.ToUniversalTime().ToString("dd.MM HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture) ?? "—";
    private static string JobLabel(string state) => state switch { "Pending"=>"Ожидает", "Leased"=>"Собирается", "Completed"=>"Завершена", "LimitReached"=>"Предел страниц", "AwaitingManualAction"=>"Ручная проверка", "Interrupted"=>"Прервана", _=>"Ошибка" };
    private sealed class AgentInput { [Required,MaxLength(200)] public string Name { get; set; }=""; }
    private sealed class SearchInput { [Required,MaxLength(200)] public string Label { get; set; }=""; [Required,Url] public string Url { get; set; }=""; public CatalogSource Source { get; set; } [Range(1,100)] public int MaxPages { get; set; }=10; }
}
