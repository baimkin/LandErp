    private void CloseAttachmentRetry(){if(!Busy){retryAttachmentId=null;retryFile=null;}}
    private async Task RetryAttachmentAsync(){if(retryAttachmentId==null||retryFile==null)return;Guid id=retryAttachmentId.Value;IBrowserFile file=retryFile;bool committed=await ExecuteConfirmedAsync(async()=>{byte[] content=await ReadUploadAsync(file);await Workspace.RetryAttachmentAsync(CurrentSubject,new(CaseId,id,file.Name,file.ContentType,content),OperationId,CancellationToken.None);});if(committed){Success="Файл загружен повторно";CloseAttachmentRetry();}}

