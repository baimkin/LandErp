@page "/collectors"
@attribute [Authorize(Policy = "agents.manage")]
@attribute [Authorize(Policy = "searches.manage")]
@inherits WorkspaceComponent
@using LandErp.Application.Modules.Collection.Contracts
@using LandErp.Application.Modules.Collection.Domain
@using LandErp.Application.Modules.Catalog.Domain
@using LandErp.Collector.Contracts.V1
@inject ICollectionAdministration Administration
@inject IOrganizationWorkspace Organization
@inject NavigationManager Navigation
<PageTitle>Поиски и парсинг · LandErp</PageTitle>
<PageHeader Title="Поиски и парсинг" Breadcrumb="Данные / Поиски и парсинг" Description="Группы поисков, расписания, общая очередь и состояние локальных парсеров." />
@if (Loading) { <PageState Kind="loading" Title="Проверяем связь…" /> }
else if (Forbidden) { <PageState Kind="forbidden" Title="Нет доступа" /> }
else
{
    @if (Error != null) { <PageState Kind="error" Title="@Error"><ActionButton Label="Повторить" OnClick="ReloadAsync" /></PageState> }
    @if (Success != null) { <PageState Kind="success" Title="@Success" /> }
    @if (credential != null) { <article class="surface"><h2>Parser создан</h2><p>Скопируйте код подключения в Parser. Он содержит секретный token и показывается только сейчас.</p><label class="field"><span>Код подключения</span><textarea readonly rows="4" autocomplete="off">@ConnectionCode</textarea></label><details><summary>Технические данные</summary><label class="field"><span>ID Parser</span><input readonly value="@credential.AgentId" /></label><label class="field"><span>Token</span><input readonly value="@credential.Token" autocomplete="off" /></label></details><ActionButton Label="Скрыть код" OnClick="() => credential = null" /></article> }
    @if (view != null && organization != null)
    {
        <div class="metric-grid"><article class="metric"><strong>@view.ActiveSearches</strong><span>активных поисков</span></article><article class="metric"><strong>@view.PendingJobs</strong><span>в общей очереди</span></article><article class="metric"><strong>@view.AttentionJobs</strong><span>требуют внимания</span></article><article class="metric"><strong>@view.Agents.Count(a => a.Online)</strong><span>парсеров на связи</span></article></div>
        <div class="form-grid"><article class="surface"><h2>Локальные приложения</h2>
        @if(view.Agents.Count == 0) { <p class="subtle">Создайте Collector и подключите его в локальном приложении.</p> }
        @foreach(AgentView agent in view.Agents) { <div class="list-row"><div><strong>@agent.Name</strong><small>@agent.Version · @agent.Capabilities</small><small>@(agent.CanManageSearches ? "Может добавлять поиски" : "Только выполняет задания")</small><small>@agent.OperationalStatus@if(agent.CurrentSearch is not null){<text>: @agent.CurrentSearch</text>} · @Time(agent.LastHeartbeatAt)</small></div><StatusBadge Label="@agent.OperationalStatus" Tone="@(agent.Online ? "success" : "warning")" /><ActionButton Label="@(agent.CanManageSearches ? "Запретить добавление" : "Разрешить добавление")" Tone="quiet" OnClick="() => ToggleAgentSearchManagementAsync(agent)" /><ActionButton Label="Перевыпустить token" Tone="quiet" OnClick="() => RotateAsync(agent)" />@if(agent.Enabled) { <ActionButton Label="Отозвать" Tone="quiet" OnClick="() => RevokeAsync(agent)" /> }</div> }
        <EditForm Model="agentInput" FormName="agent" OnValidSubmit="CreateAgentAsync"><DataAnnotationsValidator /><ValidationSummary /><label class="field"><span>Имя Collector</span><input @bind="agentInput.Name" @bind:event="oninput" /></label><label class="field"><span><input type="checkbox" @bind="agentInput.CanManageSearches" /> Разрешить добавлять группы и поиски</span></label><ActionButton Type="submit" Label="Создать Collector" Busy="Busy" Disabled="@(string.IsNullOrWhiteSpace(agentInput.Name))" /></EditForm></article>
        <article class="surface"><h2>Новый поиск</h2><EditForm Model="searchInput" FormName="search" OnValidSubmit="CreateSearchAsync"><DataAnnotationsValidator /><ValidationSummary />
        <label class="field"><span>Название поиска</span><input @bind="searchInput.Label" @bind:event="oninput" /></label>
        <label class="field"><span>Источник поиска</span><InputSelect aria-label="Источник поиска" @bind-Value="searchInput.Source"><option value="Avito">Avito</option><option value="Cian">Cian</option></InputSelect></label>
        <label class="field"><span>Ссылка поиска</span><input type="url" @bind="searchInput.Url" @bind:event="oninput" /></label>
        <p class="subtle">Конкретный Collector не назначается: работу возьмёт свободный совместимый парсер.</p>
        <label class="field"><span>Группа</span><InputSelect aria-label="Группа" @bind-Value="searchInput.GroupId"><option value="">Без группы</option>@foreach(var group in view.Groups.Where(g=>g.Active)){<option value="@group.Id">@group.Name</option>}</InputSelect></label>
        <label class="field"><span>Расписание</span><InputSelect aria-label="Расписание" @bind-Value="searchInput.ScheduleKind"><option value="Manual">Только вручную</option><option value="Interval">По интервалу</option><option value="FixedTimes">В заданное время</option></InputSelect></label>
        @if(searchInput.ScheduleKind==CollectionScheduleKind.Interval){<label class="field"><span>Интервал, минут</span><InputNumber aria-label="Интервал, минут" @bind-Value="searchInput.IntervalMinutes" /></label>}
        @if(searchInput.ScheduleKind==CollectionScheduleKind.FixedTimes){<label class="field"><span>Время (ЧЧ:ММ, через запятую)</span><input @bind="searchInput.FixedTimes" /></label>}
        <label class="field"><span>Предел страниц</span><InputNumber @bind-Value="searchInput.MaxPages" /></label><ActionButton Type="submit" Label="Сохранить поиск" Busy="Busy" /></EditForm></article></div>
        <article class="surface"><h2>Группы поисков</h2><EditForm Model="groupInput" FormName="group" OnValidSubmit="CreateGroupAsync"><DataAnnotationsValidator /><label class="field"><span>Название группы</span><input @bind="groupInput.Name" /></label><label class="field"><span>Порядок</span><InputNumber @bind-Value="groupInput.SortOrder" /></label><ActionButton Type="submit" Label="Создать группу" Busy="Busy" /></EditForm>@foreach(var group in view.Groups){<div class="list-row"><div><strong>@group.Name</strong><small>@group.SearchCount поисков · @(group.Active?"активна":"архив")</small></div>@if(group.Active){<ActionButton Label="В архив" Tone="quiet" OnClick="()=>ArchiveGroupAsync(group)" />}</div>}</article>
        <article class="surface"><h2>Поиски и расписания</h2>@foreach(SearchView search in view.Searches) { <div class="list-row"><div><strong>@search.Label</strong><small>@search.Group · @search.Source · @search.Schedule</small><small>@search.LastResult · следующий запуск: @Time(search.NextRunAt)</small><a href="@search.Url" target="_blank" rel="noopener noreferrer">Открыть источник</a></div><StatusBadge Label="@(search.Enabled?"Активен":"Приостановлен")" Tone="@(search.Enabled?"success":"neutral")" /><ActionButton Label="Запустить сейчас" OnClick="() => EnqueueAsync(search.Id)" Busy="Busy" /><ActionButton Label="@(search.Enabled?"Приостановить":"Включить")" Tone="quiet" OnClick="()=>ToggleSearchAsync(search)" /></div> }</article>
        <article class="surface table-surface"><div class="table-toolbar"><h2>Последние работы</h2></div>@if(view.Jobs.Count == 0) { <PageState Title="Работ пока нет" Description="Поставьте сбор для разрешённого поиска." /> }
        else { <div class="table-wrap"><table class="data-table"><thead><tr><th>Поиск / парсер</th><th>Состояние</th><th>Срок выдачи</th><th>Результат</th></tr></thead><tbody>@foreach(CollectionJobView job in view.Jobs) { <tr><td><strong>@job.Label</strong><small>@(job.Agent??"Ещё не назначен") · @Time(job.CreatedAt)</small></td><td><StatusBadge Label="@JobLabel(job.State)" Tone="@(job.State == "Completed" ? "success" : "warning")" /></td><td>@Time(job.LeaseExpiresAt)</td><td>@job.ResultCode<small>Обработано: @job.ProcessedCount · принято: @job.AcceptedCount · новых: @job.NewListingsCount · изменено: @job.ChangedListingsCount</small></td></tr> }</tbody></table></div> }</article>
    }
}
@code {
    private CollectionAdminView? view; private OrganizationView? organization; private AgentCredential? credential;
    private string ConnectionCode => credential == null ? "" : CollectorConnectionCode.Create(new Uri(Navigation.BaseUri), credential.AgentId, credential.Token);
    private readonly AgentInput agentInput = new(); private SearchInput searchInput = new(); private readonly GroupInput groupInput=new();
    protected override async Task ReadAsync() { view=await Administration.ReadAsync(CurrentSubject,CancellationToken.None); organization=await Organization.ReadAsync(CurrentSubject,CancellationToken.None); }
    private Task CreateAgentAsync() => ExecuteAsync(async () => { credential=await Administration.CreateAgentAsync(CurrentSubject,agentInput.Name,agentInput.CanManageSearches,Guid.CreateVersion7().ToString(),CancellationToken.None); agentInput.Name=""; agentInput.CanManageSearches=false; });
    private Task RevokeAsync(AgentView agent) => ExecuteAsync(() => Administration.RevokeAgentAsync(CurrentSubject,agent.Id,agent.Revision,Guid.CreateVersion7().ToString(),CancellationToken.None));
    private Task ToggleAgentSearchManagementAsync(AgentView agent) => ExecuteAsync(() => Administration.SetAgentSearchManagementAsync(CurrentSubject,agent.Id,agent.Revision,!agent.CanManageSearches,Guid.CreateVersion7().ToString(),CancellationToken.None));
    private Task RotateAsync(AgentView agent) => ExecuteAsync(async () => credential=await Administration.RotateCredentialAsync(CurrentSubject,agent.Id,agent.Revision,Guid.CreateVersion7().ToString(),CancellationToken.None));
    private Task CreateSearchAsync() => ExecuteAsync(async () => { string[] times=searchInput.FixedTimes.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries); await Administration.CreateSearchAsync(CurrentSubject,new(searchInput.Label,searchInput.Source,searchInput.Url,searchInput.MaxPages,searchInput.GroupId,new(searchInput.ScheduleKind,searchInput.IntervalMinutes,times)),Guid.CreateVersion7().ToString(),CancellationToken.None); searchInput=new(); });
    private Task CreateGroupAsync()=>ExecuteAsync(async()=>{await Administration.CreateGroupAsync(CurrentSubject,groupInput.Name,groupInput.SortOrder,Guid.CreateVersion7().ToString(),CancellationToken.None);groupInput.Name="";});
    private Task ArchiveGroupAsync(SearchGroupView group)=>ExecuteAsync(()=>Administration.ArchiveGroupAsync(CurrentSubject,group.Id,group.Revision,Guid.CreateVersion7().ToString(),CancellationToken.None));
    private Task ToggleSearchAsync(SearchView search)=>ExecuteAsync(()=>Administration.UpdateSearchAsync(CurrentSubject,new(search.Id,search.Revision,search.Label,search.Source,search.Url,search.MaxPages,search.GroupId,new(search.ScheduleKind,search.IntervalMinutes,search.FixedTimes),!search.Enabled),Guid.CreateVersion7().ToString(),CancellationToken.None));
    private Task EnqueueAsync(Guid id) => ExecuteAsync(() => Administration.EnqueueAsync(CurrentSubject,id,Guid.CreateVersion7().ToString(),CancellationToken.None));
    private static string Time(DateTimeOffset? instant) => instant?.ToUniversalTime().ToString("dd.MM HH:mm 'UTC'",System.Globalization.CultureInfo.InvariantCulture) ?? "—";
    private static string JobLabel(string state) => state switch { "Pending"=>"Ожидает", "Leased"=>"Собирается", "Completed"=>"Завершена", "LimitReached"=>"Предел страниц", "AwaitingManualAction"=>"Ручная проверка", "Interrupted"=>"Прервана", _=>"Ошибка" };
    private sealed class AgentInput { [Required,MaxLength(200)] public string Name { get; set; }=""; public bool CanManageSearches { get; set; } }
    private sealed class GroupInput { [Required,MaxLength(200)] public string Name {get;set;}=""; [Range(0,10000)] public int SortOrder {get;set;} }
    private sealed class SearchInput { [Required,MaxLength(200)] public string Label { get; set; }=""; [Required,Url] public string Url { get; set; }=""; public CatalogSource Source { get; set; } [Range(1,100)] public int MaxPages { get; set; }=10; public Guid? GroupId {get;set;} public CollectionScheduleKind ScheduleKind {get;set;} public int? IntervalMinutes {get;set;}=60; public string FixedTimes {get;set;}="09:00"; }
}
