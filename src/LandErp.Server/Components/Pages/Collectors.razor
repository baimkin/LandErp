@page "/collectors"
@attribute [Authorize(Policy = "collection.read")]
@inherits WorkspaceComponent
@using LandErp.Application.Foundation
@using LandErp.Application.Foundation.Files
@using LandErp.Application.Modules.Collection.Contracts
@using LandErp.Application.Modules.Collection.Domain
@using LandErp.Application.Modules.Catalog.Domain
@using LandErp.Collector.Contracts.V1
@inject ICollectionAdministration Administration
@inject IDatabaseStatus DatabaseStatus
@inject IFileStorageHealth StorageStatus
@inject NavigationManager Navigation

<PageTitle>Поиски и парсинг · LandErp</PageTitle>
<div class="collectors-page">
<PageHeader Title="Поиски и парсинг" Breadcrumb="Данные / Поиски и парсинг" Description="Поиски, расписания, общая очередь и состояние локальных парсеров.">
    <AuthorizeView Policy="searches.manage"><div class="header-actions"><button class="btn secondary" @onclick="OpenGroups">Группы</button><button class="btn primary" @onclick="() => OpenSearch()">+ Добавить поиск</button></div></AuthorizeView>
</PageHeader>
<div class="refresh-line"><span>Время: @ZoneLabel · обновлено @Time(refreshedAt) · автообновление каждые 15 с</span><button type="button" class="text-action" disabled="@Busy" @onclick="ReloadAsync">Обновить</button></div>
@if (refreshMessage is not null) { <p role="status" class="form-note">@refreshMessage</p> }
@if (Error is not null && !HasOpenDialog) { <PageState Kind="error" Title="@Error" /> }
@if (Success is not null && !HasOpenDialog) { <p role="status" class="success-notice">@Success</p> }
@if (!Loading && !Forbidden)
{
    <section class="ops-health" aria-label="Состояние системы">
        <div class="ops-health-head"><div><h2>Состояние системы</h2><p>Минимальный operational-контур. Обновляется вместе со страницей; storage проверяется не чаще раза в минуту.</p></div></div>
        <div class="ops-health-grid">
            <article class="health-item ok"><i></i><div><strong>Server</strong><span>Работает</span><small>веб-приложение отвечает</small></div></article>
            <article class="health-item @HealthTone(databaseReady)"><i></i><div><strong>Database</strong><span>@(databaseReady?"Работает":"Недоступна")</span><small>PostgreSQL readiness</small></div></article>
            <article class="health-item @HealthTone(WorkerHealthy)"><i></i><div><strong>Worker</strong><span>@WorkerState</span><small>последний цикл @Time(view?.Scheduler.LastStartedAt)</small></div></article>
            <article class="health-item @HealthTone(SchedulerHealthy)"><i></i><div><strong>Scheduler</strong><span>@(view?.Scheduler.State??"Нет данных")</span><small>успешно @Time(view?.Scheduler.LastSucceededAt)</small></div></article>
            <article class="health-item @(!databaseReady?"bad":StaleAgents+OfflineAgents>0?"warn":"ok")"><i></i><div><strong>Parser Agents</strong><span>@(databaseReady?$"{view?.OnlineAgents??0} online · {StaleAgents} stale · {OfflineAgents} offline":"Нет данных")</span><small>@(databaseReady?"stale: нет heartbeat 3–10 минут":"требуется Database")</small></div></article>
            <article class="health-item @(!databaseReady?"bad":BacklogCount>0?"warn":"ok")"><i></i><div><strong>Backlog</strong><span>@(databaseReady?$"{BacklogCount} заданий":"Нет данных")</span><small>@(databaseReady?$"{view?.PendingJobs??0} pending · {ExpiredLeaseCount} reclaimable":"требуется Database")</small></div></article>
            <article class="health-item @(!databaseReady?"bad":ExpiredLeaseCount>0?"bad":"ok")"><i></i><div><strong>Expired leases</strong><span>@(databaseReady?ExpiredLeaseCount.ToString():"Нет данных")</span><small>@(!databaseReady?"требуется Database":ExpiredLeaseCount==0?"просроченных назначений нет":"Parser может reclaim при следующем claim")</small></div></article>
            <article class="health-item @HealthTone(StorageHealthy)"><i></i><div><strong>Storage</strong><span>@StorageLabel(storageHealth)</span><small>@(storageHealth.Available?"read-only probe успешен":storageHealth.Code)</small></div></article>
        </div>
    </section>
    @if(!databaseReady){<PageState Kind="error" Title="База данных недоступна"><p>Server работает, но рабочие данные сейчас недоступны. Проверьте PostgreSQL перед продолжением работы.</p></PageState>}
}
@if (Loading) { <PageState Kind="loading" Title="Загружаем поиски и парсеры…" /> }
else if (Forbidden) { <PageState Kind="forbidden" Title="Нет доступа" /> }
else if (view is not null)
{

    <section class="metrics" aria-label="Состояние сбора данных">
        <article><strong>@view.ActiveSearches</strong><span>активных поисков</span><small>из @view.Searches.Count всего</small></article>
        <article><strong>@view.OnlineAgents</strong><span>парсеров на связи</span><small>@view.BusyAgents сейчас работают</small></article>
        <article><strong>@view.PendingJobs</strong><span>в общей очереди</span><small>работу возьмёт свободный парсер</small></article>
        <article class="@(AttentionCount > 0 ? "attention" : "")"><strong>@AttentionCount</strong><span>требуют внимания</span><small>@(AttentionCount > 0 ? "откройте детали ниже" : "всё работает штатно")</small></article>
    </section>
    @if (AttentionCount > 0) { <section class="attention-panel" role="status"><b>!</b><div><strong>Нужно внимание</strong><p>@AttentionSummary</p></div><button class="text-action" @onclick="ShowAttention">@(showAttentionDetails ? "Скрыть причины" : "Показать причины")</button></section> }
    @if(showAttentionDetails && AttentionCount > 0)
    {
        <div class="attention-details" role="status">
            @if(!SchedulerHealthy){<p><strong>Служба расписаний: @view.Scheduler.State.</strong> Автоматические запуски требуют работающего Worker. Обратитесь к администратору; до восстановления можно запускать поиск вручную.</p>}
            @if(ExpiredLeaseCount>0){<p><strong>Просроченных lease: @ExpiredLeaseCount.</strong> Эти задания доступны для повторного claim совместимым Parser.</p>}
            @foreach(var agent in view.Agents.Where(AgentNeedsAttention)){<p><strong>@agent.Name:</strong> @agent.OperationalStatus — откройте локальное приложение Parser.</p>}
            @foreach(var search in view.Searches.Where(NeedsAttention)){<p><strong>@search.Label:</strong> @LastRunTitle(search.LastRun). Проверьте последний запуск в истории.</p>}
        </div>
    }

    <section class="workspace-card searches-card">
        <div class="section-heading"><div><h2>Список поисков</h2><p>Поиски выполняются любым свободным совместимым парсером.</p></div><AuthorizeView Policy="searches.manage"><button class="btn primary compact" @onclick="() => OpenSearch()">+ Добавить поиск</button></AuthorizeView></div>
        <div class="filters"><label class="search-box"><span class="sr-only">Найти поиск</span><input placeholder="Найти по названию или ссылке" @bind="query" @bind:event="oninput" /></label><label><span class="sr-only">Группа</span><select @bind="groupFilter"><option value="all">Все группы</option><option value="none">Без группы</option>@foreach(var group in view.Groups.OrderBy(x=>x.SortOrder)){<option value="@group.Id">@group.Name</option>}</select></label><label><span class="sr-only">Статус</span><select @bind="statusFilter"><option value="all">Все статусы</option><option value="active">Активные</option><option value="paused">Приостановленные</option><option value="attention">Требуют внимания</option></select></label><label><span class="sr-only">Архив групп</span><select @bind="groupVisibility"><option value="active">Действующие группы</option><option value="archived">Архив групп</option><option value="all">Включая архив</option></select></label>@if(HasFilters){<button class="text-action" @onclick="ResetFilters">Сбросить</button>}</div>
        @if (FilteredSections.Count == 0) { <div class="empty"><strong>Поиски не найдены</strong><span>Измените фильтры или добавьте новый поиск.</span></div> }
        else { <div class="search-table" role="table"><div class="table-head"><span>Поиск</span><span>Расписание</span><span>Последний запуск</span><span>Результат</span><span>Следующий</span><span></span></div>
        @foreach(var groupSection in FilteredSections)
        {
            <div class="group-row"><button class="group-toggle" @onclick="() => ToggleGroup(groupSection.Key)" aria-expanded="@IsExpanded(groupSection.Key)"><i>@(IsExpanded(groupSection.Key)?"⌄":"›")</i><span><strong><span class="group-label">Группа</span> @groupSection.Name @if(!groupSection.Active){<span class="muted">· архив</span>}</strong><small>@groupSection.Searches.Count поисков · @groupSection.ActiveCount активных</small></span></button><span>@groupSection.Schedule</span><span>@Time(groupSection.LastRunAt)</span><span class="aggregate"><b>@groupSection.Processed</b><small>обработано</small><b>+@groupSection.NewListings</b><small>новых</small><b>~@groupSection.Changed</b><small>изменено</small></span><span>@Time(groupSection.NextRunAt)</span><AuthorizeView Policy="searches.manage">@if(groupSection.Active){<button class="icon-action" title="Добавить поиск в группу" aria-label="Добавить поиск в группу" @onclick="() => OpenSearch(groupSection.GroupId)">+</button>}</AuthorizeView></div>
            @if(IsExpanded(groupSection.Key)) { @foreach(var search in groupSection.Searches) { <div class="search-row @(NeedsAttention(search)?"needs-attention":"")"><div class="search-name"><i class="source">@SourceShort(search.Source)</i><span><a href="@search.Url" target="_blank" rel="noopener noreferrer" title="Открыть источник">@search.Label ↗</a><small>@search.Source · до @search.MaxPages стр.</small></span></div><div><strong>@search.Schedule</strong><small>@(search.Enabled?"Активен":"Приостановлен")</small></div><div><strong>@LastRunTitle(search.LastRun)</strong><small>@Time(search.LastRun?.CompletedAt ?? search.LastRun?.CreatedAt)</small></div><div class="run-result">@if(search.LastRun is null){<span>—</span>}else{<b>@search.LastRun.ProcessedCount</b><small> обработано</small><em>+@search.LastRun.NewListingsCount / ~@search.LastRun.ChangedListingsCount</em>}</div><div>@if(search.LastRun?.RetryAt is not null){<strong>Повтор: @Time(search.LastRun.RetryAt)</strong><small>расписание: @Time(search.NextRunAt)</small>}else{<strong>@Time(search.NextRunAt)</strong>@if(!search.Enabled){<small>не запланирован</small>}}</div><div class="row-actions"><StatusBadge Label="@(search.Enabled?"Активен":"Пауза")" Tone="@(search.Enabled?"success":"neutral")" /><AuthorizeView Policy="searches.manage"><button class="icon-action" title="Запустить сейчас" disabled="@(Busy || !search.Enabled)" aria-label="Запустить поиск сейчас" @onclick="() => EnqueueAsync(search.Id)">▶</button><button class="icon-action" title="Изменить" aria-label="Настроить поиск" @onclick="() => OpenEditSearch(search)">⋯</button></AuthorizeView></div></div> } }
        }</div>}
    </section>

    <section class="workspace-card"><div class="section-heading"><div><h2>Локальные парсеры</h2><p>Подключённые компьютеры сами забирают подходящую работу из общей очереди.</p></div><AuthorizeView Policy="agents.manage"><button class="btn secondary compact" @onclick="OpenConnection">+ Подключить парсер</button></AuthorizeView></div>
        <div class="scheduler"><i class="@(view.Scheduler.State=="Работает"?"ok":"warn")"></i><strong>Расписания: @view.Scheduler.State.ToLowerInvariant()</strong><span>Последний цикл @Time(view.Scheduler.LastSucceededAt) · добавлено: @view.Scheduler.LastQueuedCount</span></div>
        @if(view.Agents.Count==0){<div class="empty"><strong>Парсеры ещё не подключены</strong><span>Создайте код подключения и вставьте его в LandErp Parser.</span></div>}
        else { <div class="agent-grid">@foreach(var agent in view.Agents.OrderByDescending(x=>x.Online).ThenBy(x=>x.Name)){<article class="agent-card @AgentTone(agent)"><div class="agent-title"><div><i></i><strong>@agent.Name</strong></div><StatusBadge Label="@agent.OperationalStatus" Tone="@AgentBadgeTone(agent)" /></div><p>@agent.Version · @Capabilities(agent.Capabilities)</p>@if(agent.CurrentSearch is not null){<div class="agent-work"><span>Выполняет</span><strong>@agent.CurrentSearch</strong><div class="progress"><i style="width:@Progress(agent)%"></i></div><small>@ProgressLabel(agent)</small></div>}else{<div class="agent-work idle"><span>@(agent.Online?"Готов к следующему заданию":"Ожидаем подключение приложения")</span></div>}<footer><span>Связь: @Time(agent.LastHeartbeatAt)</span><span>@(agent.CanManageSearches?"Может добавлять поиски":"Только выполняет задания")</span></footer><AuthorizeView Policy="agents.manage"><button class="card-menu" @onclick="() => OpenAgent(agent)" aria-label="Настройки @agent.Name">⋯</button></AuthorizeView></article>}</div>}
    </section>

    <section class="workspace-card"><div class="section-heading"><div><h2>История запусков</h2><p>Последние 100 заданий. Фильтры применяются к этому списку.</p></div><span class="muted">@FilteredJobs.Count записей</span></div><div class="filters"><label class="search-box"><span class="sr-only">Найти запуск</span><input placeholder="Поиск или парсер" @bind="historyQuery" @bind:event="oninput" /></label><label><span class="sr-only">Результат</span><select @bind="historyFilter"><option value="all">Все результаты</option><option value="completed">Завершённые (включая лимит)</option><option value="attention">Требуют внимания</option><option value="running">В работе</option></select></label></div>
        @if(FilteredJobs.Count==0){<div class="empty"><strong>Запусков пока нет</strong><span>Запустите поиск вручную или дождитесь расписания.</span></div>}else{<div class="history-wrap"><table><thead><tr><th>Поиск</th><th>Парсер</th><th>Поставлено в очередь</th><th>Статус</th><th>Обработано</th><th>Новых</th><th>Изменено</th><th></th></tr></thead><tbody>@foreach(var job in PagedJobs){<tr><td><strong>@job.Label</strong></td><td>@(job.Agent??"Ещё не назначен")</td><td>@Time(job.CreatedAt)</td><td><StatusBadge Label="@JobLabel(job.State)" Tone="@JobTone(job.State)" /></td><td>@job.ProcessedCount</td><td class="positive">+@job.NewListingsCount</td><td>@job.ChangedListingsCount</td><td><button class="icon-action" aria-label="Подробности запуска" @onclick="() => selectedJob=job">›</button></td></tr>}</tbody></table></div>@if(HistoryPages>1){<div class="pager"><button disabled="@(historyPage==1)" @onclick="() => historyPage--">Назад</button><span>@Math.Min(historyPage, HistoryPages) из @HistoryPages</span><button disabled="@(historyPage>=HistoryPages)" @onclick="() => historyPage++">Далее</button></div>}}
    </section>
}
</div>

@if(showSearchModal && view is not null)
{
    <Modal Title="@(editingSearch is null ? "Добавить поиск" : "Настроить поиск")" OnClose="CloseSearch">
        @if(Error is not null){<p role="alert" class="form-error">@Error</p>}
        <EditForm Model="searchInput" FormName="collector-search" OnValidSubmit="SaveSearchAsync">
            <DataAnnotationsValidator /><ValidationSummary />
            <fieldset disabled="@Busy" class="search-form-fields">
                <label class="field"><span>Название</span><InputText @bind-Value="searchInput.Label" /></label>
                <label class="field"><span>Ссылка на результаты поиска</span><InputText type="url" @bind-Value="searchInput.Url" /></label>
                <div class="modal-grid">
                    <label class="field"><span>Источник</span><InputSelect @bind-Value="searchInput.Source"><option value="Avito">Avito</option><option value="Cian">Cian</option></InputSelect></label>
                    <label class="field"><span>Группа</span><InputSelect @bind-Value="searchInput.GroupId"><option value="">Без группы</option>@foreach(var group in view.Groups.Where(g=>g.Active || g.Id==searchInput.GroupId).OrderBy(g=>g.SortOrder)){<option value="@group.Id">@group.Name@(!group.Active ? " (архив)" : "")</option>}</InputSelect></label>
                </div>
                <button type="button" class="text-action" @onclick="() => showQuickGroup=!showQuickGroup">@(showQuickGroup ? "Отменить новую группу" : "+ Новая группа")</button>
                @if(showQuickGroup)
                {
                    <div class="quick-group"><label class="field"><span>Название новой группы</span><input @bind="quickGroupName" @bind:event="oninput" maxlength="200" /></label><button type="button" class="btn secondary" disabled="@(Busy || string.IsNullOrWhiteSpace(quickGroupName))" @onclick="QuickCreateGroupAsync">Создать и выбрать</button></div>
                }
                <section class="schedule-editor">
                    <h3>Когда запускать</h3>
                    <p class="form-note">Часовой пояс: @ZoneLabel</p>
                    <label class="field"><span>Повторение</span><InputSelect @bind-Value="searchInput.ScheduleKind" @bind-Value:after="UpdatePreviewAsync"><option value="Manual">Только вручную</option><option value="Interval">Через интервал</option><option value="FixedTimes">Ежедневно в указанное время</option></InputSelect></label>
                    @if(searchInput.ScheduleKind==CollectionScheduleKind.Interval)
                    {
                        <div class="interval-fields"><label class="field"><span>Каждые</span><InputNumber @bind-Value="searchInput.IntervalValue" @bind-Value:after="UpdatePreviewAsync" /></label><label class="field"><span>Единицы</span><InputSelect @bind-Value="searchInput.IntervalUnit" @bind-Value:after="UpdatePreviewAsync"><option value="1">минут</option><option value="60">часов</option><option value="1440">дней</option></InputSelect></label></div>
                        <p class="form-note">От 5 минут до 7 дней. Интервал отсчитывается от постановки планового задания, а не от завершения сбора.</p>
                    }
                    @if(searchInput.ScheduleKind==CollectionScheduleKind.FixedTimes)
                    {
                        <div class="time-rows">
                            @foreach(var row in searchInput.Times)
                            {
                                <div class="time-row" @key="row"><label class="field"><span>Время запуска</span><input type="time" value="@row.Value" @onchange="async e => { row.Value=e.Value?.ToString() ?? string.Empty; await UpdatePreviewAsync(); }" /></label><button type="button" class="icon-action" aria-label="Удалить время запуска" disabled="@(searchInput.Times.Count==1)" @onclick="async () => { searchInput.Times.Remove(row); await UpdatePreviewAsync(); }">×</button></div>
                            }
                        </div>
                        <button type="button" class="text-action" disabled="@(searchInput.Times.Count>=12)" @onclick="AddTime">+ Добавить время</button>
                        <p class="form-note">Например, 09:00 и 16:00 — два сбора каждый день.</p>
                    }
                    @if(editingSearch is null)
                    {
                        <label class="check-field"><InputCheckbox @bind-Value="searchInput.RunImmediately" /><span>Запустить первый сбор после сохранения</span></label>
                        <p class="form-note">@(searchInput.RunImmediately ? "Первое задание попадёт в очередь сразу. Последующие — по расписанию." : "Сохранение не запускает сбор. Он начнётся по расписанию или по кнопке «Запустить».")</p>
                    }
                    else
                    {
                        <label class="check-field"><InputCheckbox @bind-Value="searchInput.Enabled" @bind-Value:after="UpdatePreviewAsync" /><span>Поиск активен</span></label>
                    }
                    <p class="schedule-preview" role="status">@previewText</p>
                </section>
                <label class="field"><span>Предел страниц за один сбор</span><InputNumber @bind-Value="searchInput.MaxPages" /><small>От 1 до 100. Достижение лимита — завершение сбора, а не ошибка.</small></label>
                <p class="form-note">В указанное время задание поступает в общую очередь. Сбор начнётся, когда освободится совместимый парсер.</p>
                @if(!SchedulerHealthy && searchInput.ScheduleKind!=CollectionScheduleKind.Manual){<p class="form-warning">Служба расписаний сейчас не подтверждает работу. До её восстановления доступен ручной запуск.</p>}
                <div class="modal-actions"><span></span><button type="button" class="btn secondary" @onclick="CloseSearch">Отмена</button><button type="submit" class="btn primary" disabled="@Busy">@(Busy ? "Сохраняем…" : "Сохранить")</button></div>
            </fieldset>
        </EditForm>
    </Modal>
}
@if(showConnectionModal){<Modal Title="Подключить новый парсер" OnClose="CloseConnection">@if(Error is not null){<p role="alert" class="form-error">@Error</p>}@if(connectionCode is null){<EditForm Model="agentInput" FormName="collector-connection" OnValidSubmit="CreateAgentAsync"><DataAnnotationsValidator/><ValidationSummary/><label class="field"><span>Название компьютера</span><input autofocus @bind="agentInput.Name" @bind:event="oninput" /></label><p class="form-note">Право добавлять поиски по умолчанию выключено.</p><div class="modal-actions"><span></span><button type="button" class="btn secondary" @onclick="CloseConnection">Отмена</button><button type="submit" class="btn primary" disabled="@(Busy||string.IsNullOrWhiteSpace(agentInput.Name))">Создать код</button></div></EditForm>}else{<div class="connection-success"><b>✓</b><h3>Код готов</h3><p>Вставьте его в LandErp Parser. Код действует до @Time(connectionCode.ExpiresAt).</p><label class="field"><span>Код подключения</span><textarea readonly rows="4">@ConnectionCode(connectionCode)</textarea></label><div class="modal-actions"><span></span><button class="btn primary" @onclick="CloseConnection">Готово</button></div></div>}</Modal>}
@if(showGroupsModal && view is not null){<Modal Title="Группы поисков" OnClose="CloseGroups">@if(Error is not null){<p role="alert" class="form-error">@Error</p>}<EditForm Model="groupInput" FormName="collector-group" OnValidSubmit="CreateGroupAsync"><DataAnnotationsValidator/><div class="inline-form"><label class="field"><span>Новая группа</span><input @bind="groupInput.Name" /></label><label class="field"><span>Порядок</span><InputNumber @bind-Value="groupInput.SortOrder" /></label><button type="submit" class="btn primary" disabled="@(Busy||string.IsNullOrWhiteSpace(groupInput.Name))">Добавить</button></div></EditForm><div class="group-list">@foreach(var group in view.Groups.OrderBy(x=>x.SortOrder)){<div><span><strong>@group.Name</strong><small>@group.SearchCount поисков · @(group.Active?"активна":"архив")</small></span>@if(group.Active){<button class="text-action danger-text" @onclick="() => ArchiveGroupAsync(group)">В архив</button>}</div>}</div><div class="modal-actions"><span></span><button class="btn secondary" @onclick="CloseGroups">Закрыть</button></div></Modal>}
@if(selectedAgent is not null){<Modal Title="Настройки парсера" OnClose="CloseAgent">@if(Error is not null){<p role="alert" class="form-error">@Error</p>}<div class="dialog-head"><strong>@selectedAgent.Name</strong><StatusBadge Label="@selectedAgent.OperationalStatus" Tone="@AgentBadgeTone(selectedAgent)" /></div><div class="setting"><div><strong>Добавление групп и поисков</strong><p>Разрешить этому Parser создавать серверные поиски.</p></div><button class="switch @(selectedAgent.CanManageSearches?"on":"")" disabled="@Busy" role="switch" aria-checked="@selectedAgent.CanManageSearches" @onclick="() => ToggleAgentSearchManagementAsync(selectedAgent)"><span></span></button></div><div class="setting"><div><strong>Новый токен</strong><p>Старый токен сразу перестанет работать.</p></div><button class="btn secondary" disabled="@Busy" @onclick="() => RotateAsync(selectedAgent)">Перевыпустить</button></div>@if(credential?.AgentId==selectedAgent.Id){<label class="field"><span>Новый токен — сохраните сейчас</span><textarea readonly rows="3">@credential.Token</textarea></label>}@if(selectedAgent.Enabled){<div class="setting danger-zone"><div><strong>Отключить парсер</strong><p>Он больше не сможет получать задания.</p></div><button class="btn danger" disabled="@Busy" @onclick="() => RevokeAsync(selectedAgent)">Отключить</button></div>}<div class="modal-actions"><span></span><button class="btn secondary" @onclick="CloseAgent">Закрыть</button></div></Modal>}
@if(selectedJob is not null){<Modal Title="Результат запуска" OnClose="() => selectedJob=null"><div class="dialog-head"><div><strong>@selectedJob.Label</strong><small>@(selectedJob.Agent??"Парсер не назначен")</small></div><StatusBadge Label="@JobLabel(selectedJob.State)" Tone="@JobTone(selectedJob.State)" /></div><dl class="details"><div><dt>Создано</dt><dd>@Time(selectedJob.CreatedAt)</dd></div><div><dt>Завершено</dt><dd>@Time(selectedJob.CompletedAt)</dd></div><div><dt>Обработано</dt><dd>@selectedJob.ProcessedCount</dd></div><div><dt>Принято</dt><dd>@selectedJob.AcceptedCount</dd></div><div><dt>Новых</dt><dd>+@selectedJob.NewListingsCount</dd></div><div><dt>Изменено</dt><dd>@selectedJob.ChangedListingsCount</dd></div>@if(selectedJob.RetryAttempt>0){<div><dt>Попытка</dt><dd>@(selectedJob.RetryAttempt+1)</dd></div>}@if(selectedJob.RetryAt is not null){<div><dt>Автоповтор</dt><dd>@Time(selectedJob.RetryAt)</dd></div>}</dl>@if(selectedJob.Coverage is not null){<p class="form-note">@CoverageText(selectedJob.Coverage)</p>}@if(!string.IsNullOrWhiteSpace(selectedJob.ReasonCode)){<p class="form-note">@ReasonLabel(selectedJob.ReasonCode)</p>}@foreach(string warning in selectedJob.Warnings){<p class="form-note">Предупреждение: @ReasonLabel(warning)</p>}<div class="modal-actions"><span></span><button class="btn secondary" @onclick="() => selectedJob=null">Закрыть</button></div></Modal>}
