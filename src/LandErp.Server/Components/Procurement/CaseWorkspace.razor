    private void UseDocumentRequirement(){if(Guid.TryParse(attachment.RequirementKey,out Guid id)&&card!.DocumentRequirements.FirstOrDefault(x=>x.Id==id) is { } item){attachment.Kind=CaseAttachmentKind.Document;attachment.OwnerKey="case";if(string.IsNullOrWhiteSpace(attachment.Label))attachment.Label=item.Title;}}
    private async Task SaveAttachmentAsync()
    {
        await ExecuteAsync(async ()=>
        {
            byte[]? content=null;string name="",type="";
            if(attachment.Kind!=CaseAttachmentKind.Link)
            {
                if(selectedFile==null)throw new ArgumentException("Выберите файл.");
                content=await ReadUploadAsync(selectedFile);name=selectedFile.Name;type=selectedFile.ContentType;
            }
            ParseOwner(attachment.OwnerKey,out CaseAttachmentOwner owner,out Guid? ownerId);
            Guid? requirementId=Guid.TryParse(attachment.RequirementKey,out Guid requirement)?requirement:null;
            await Workspace.AddAttachmentAsync(CurrentSubject,new(CaseId,owner,ownerId,attachment.Kind,attachment.Label,attachment.Description,name,type,content,attachment.Kind==CaseAttachmentKind.Link?attachment.Url:null,requirementId),OperationId,CancellationToken.None);
        },"Материал добавлен");
        if(Success!=null)CloseAttachment();
    }

