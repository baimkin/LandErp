        CatalogEventKind.MonitoringTriggered => "Порог мониторинга достигнут",
        CatalogEventKind.Classified => "Принято решение",
        _ => "PropertyCase возобновлён"
    };

    private static string Age(DateTimeOffset value)
    {
        TimeSpan age = DateTimeOffset.UtcNow - value;
        return age.TotalHours < 24 ? $"{Math.Max(0, (int)age.TotalHours)} ч назад" : $"{(int)age.TotalDays} дн. назад";
    }

