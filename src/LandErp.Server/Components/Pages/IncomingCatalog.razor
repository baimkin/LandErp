@page "/incoming"
@attribute [Authorize(Policy = "manager_queue.read")]
@using LandErp.Application.Modules.Catalog.Contracts
@using LandErp.Application.Modules.Catalog.Domain
@inherits WorkspaceComponent
@inject ICatalogWorkspace Workspace
@inject NavigationManager Navigation
<PageTitle>Входящие предложения · LandErp</PageTitle>
<PageHeader Title="Входящие предложения" Breadcrumb="Закупка / Первичный отбор" Description="Общий поток Avito, Cian, Telegram, ручных и других источников.">
    <ActionButton Label="+ Добавить объявление / предложение" OnClick="() => manualOpen=true" />
</PageHeader>
<FilterBar><EditForm Model="filter" FormName="incoming-filter" OnValidSubmit="ReloadAsync"><div class="queue-filters"><label class="field"><span>Поиск</span><input @bind="filter.Text" @bind:event="oninput" placeholder="Название, локация, внешний ID" /></label><label class="field"><span>Источник</span><InputSelect @bind-Value="filter.Source"><option value="">Все</option>@foreach(CatalogSource source in Enum.GetValues<CatalogSource>()) { <option value="@source">@source</option> }</InputSelect></label><label class="field"><span>Состояние</span><InputSelect @bind-Value="filter.Disposition"><option value="">Все</option>@foreach(CatalogDisposition state in Enum.GetValues<CatalogDisposition>()) { <option value="@state">@DispositionLabel(state)</option> }</InputSelect></label><ActionButton Label="Применить" Type="submit" /></div></EditForm></FilterBar>
@if(Loading) { <PageState Kind="loading" Title="Загружаем входящие…" /> }
else if(Forbidden) { <PageState Kind="forbidden" Title="Нет доступа ко входящим" /> }
else if(Error!=null) { <PageState Kind="error" Title="@Error"><ActionButton Label="Повторить" OnClick="ReloadAsync" /></PageState> }
else if(catalogPage!=null)
{
    @if(Success!=null) { <PageState Kind="success" Title="@Success" /> }
    <div class="queue-summary"><strong>@catalogPage.Total предложений</strong><small>Catalog является общим входящим пулом организации</small></div>
    @if(catalogPage.Items.Count==0) { <PageState Title="Входящих предложений нет" Description="Добавьте предложение вручную или дождитесь нового результата источника." /> }
    else { <div class="procurement-queue">@foreach(CatalogItemView item in catalogPage.Items) { <article class="queue-card surface"><div class="queue-main"><div class="queue-meta"><SourceBadge Source="item.Source" /><StatusBadge Label="@DispositionLabel(item.Disposition)" Tone="@(item.Disposition==CatalogDisposition.Incoming ? "info" : "neutral")" />@if(item.BusinessNumber!=null){<a href="@($"/procurement/{item.PropertyCaseId}")">@item.BusinessNumber</a>}</div><h2 class="queue-title">@item.Title</h2><p>@(item.Location??"Местоположение неизвестно")</p><small>@item.Provenance · @(item.ExternalId??"без внешнего ID")</small>@if(item.Url!=null){<p><a href="@item.Url" target="_blank" rel="noopener noreferrer">Открыть источник ↗</a></p>}</div><div class="queue-side"><strong>@LandErp.Server.Components.Procurement.ProcurementLabels.Money(item.Price)</strong><span>@LandErp.Server.Components.Procurement.ProcurementLabels.Area(item.AreaSquareMeters)</span>@if(item.PropertyCaseId==null){<ActionButton Label="Взять в работу" OnClick="() => OpenTakeAsync(item)" /><ActionButton Label="Наблюдать" Tone="secondary" OnClick="() => DispositionAsync(item,CatalogDisposition.Monitoring)" /><ActionButton Label="Не подходит" Tone="quiet" OnClick="() => DispositionAsync(item,CatalogDisposition.Dismissed)" />}else{<ActionButton Label="Открыть PropertyCase" Tone="secondary" OnClick="() => OpenCase(item.PropertyCaseId)" />}</div></article> }</div> }
}
@if(manualOpen) { <Modal Title="Добавить объявление / предложение" OnClose="() => manualOpen=false"><EditForm Model="manual" FormName="manual-catalog" OnValidSubmit="CreateManualAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field"><span>Источник</span><InputSelect @bind-Value="manual.Source">@foreach(CatalogSource source in manualSources){<option value="@source">@source</option>}</InputSelect></label><label class="field"><span>Название</span><InputText @bind-Value="manual.Title" /></label><label class="field"><span>Локация</span><InputText @bind-Value="manual.Location" /></label><label class="field"><span>Ссылка HTTPS (необязательно)</span><InputText @bind-Value="manual.Url" /></label><label class="field"><span>Цена, ₽</span><InputNumber @bind-Value="manual.Price" /></label><label class="field"><span>Площадь, м²</span><InputNumber @bind-Value="manual.Area" /></label><label class="field"><span>Кадастровый номер</span><InputText @bind-Value="manual.CadastralNumber" /></label><label class="field"><span>Внешний ID (необязательно)</span><InputText @bind-Value="manual.ExternalId" /></label><label class="field" style="grid-column:1/-1"><span>Описание</span><InputTextArea @bind-Value="manual.Description" /></label><label class="field" style="grid-column:1/-1"><span>Комментарий / происхождение</span><InputTextArea @bind-Value="manual.Comment" /></label><div class="form-actions"><ActionButton Label="Отмена" Tone="quiet" OnClick="() => manualOpen=false" /><ActionButton Label="Сохранить во входящие" Type="submit" Busy="Busy" /></div></div></EditForm></Modal> }
@if(takeItem!=null) { <Modal Title="Взять в работу" OnClose="() => takeItem=null"><p><strong>@takeItem.Title</strong></p><p class="subtle">Создайте новый PropertyCase либо подтвердите связь с существующим.</p><label class="field"><span>PropertyCase</span><InputSelect @bind-Value="existingCaseId"><option value="">Создать новый PropertyCase</option>@foreach(CaseLinkTarget target in targets){<option value="@target.CaseId">@target.BusinessNumber · @target.Title</option>}</InputSelect></label><div class="form-actions"><ActionButton Label="Отмена" Tone="quiet" OnClick="() => takeItem=null" /><ActionButton Label="Подтвердить" Busy="Busy" OnClick="TakeAsync" /></div></Modal> }
@code {
    private IncomingCatalogPage? catalogPage; private readonly FilterInput filter=new(); private bool manualOpen; private ManualInput manual=new();
    private CatalogItemView? takeItem; private Guid? existingCaseId; private IReadOnlyList<CaseLinkTarget> targets=[];
    private static readonly CatalogSource[] manualSources=[CatalogSource.Telegram,CatalogSource.Referral,CatalogSource.Agent,CatalogSource.DirectOwner,CatalogSource.Manual,CatalogSource.Other];
    protected override async Task ReadAsync()=>catalogPage=await Workspace.ReadIncomingAsync(CurrentSubject,new(filter.Text,filter.Source,filter.Disposition),CancellationToken.None);
    private async Task CreateManualAsync(){await ExecuteAsync(()=>Workspace.CreateManualAsync(CurrentSubject,new(manual.Source,manual.Title,manual.Location,manual.Price,manual.Area,manual.Url,manual.ExternalId,manual.CadastralNumber,manual.Description,manual.Comment),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null){manualOpen=false;manual=new();}}
    private async Task OpenTakeAsync(CatalogItemView item){takeItem=item;existingCaseId=null;targets=await Workspace.ReadLinkTargetsAsync(CurrentSubject,CancellationToken.None);}
    private async Task TakeAsync(){TakeToWorkResult? result=null;await ExecuteAsync(async()=>result=await Workspace.TakeToWorkAsync(CurrentSubject,new(takeItem!.Id,existingCaseId),Guid.CreateVersion7().ToString(),CancellationToken.None));if(result!=null)Navigation.NavigateTo($"/procurement/{result.CaseId}");}
    private Task DispositionAsync(CatalogItemView item,CatalogDisposition state)=>ExecuteAsync(()=>Workspace.SetDispositionAsync(CurrentSubject,new(item.Id,item.Version,state,state==CatalogDisposition.Monitoring?"Ожидаем изменения условий":"Не соответствует первичному отбору"),Guid.CreateVersion7().ToString(),CancellationToken.None));
    private void OpenCase(Guid? caseId){if(caseId!=null)Navigation.NavigateTo($"/procurement/{caseId}");}
    private static string DispositionLabel(CatalogDisposition value)=>value switch{CatalogDisposition.Incoming=>"Входящее",CatalogDisposition.Monitoring=>"Мониторинг",CatalogDisposition.InWork=>"В работе",CatalogDisposition.Dismissed=>"Не подходит",CatalogDisposition.RemovedAtSource=>"Снято",_=>"Продано"};
    private sealed class FilterInput{public string Text{get;set;}="";public CatalogSource? Source{get;set;}public CatalogDisposition? Disposition{get;set;}=CatalogDisposition.Incoming;}
    private sealed class ManualInput{public CatalogSource Source{get;set;}=CatalogSource.Telegram;[Required,MinLength(3),MaxLength(20000)]public string Title{get;set;}="";public string? Location{get;set;}public decimal? Price{get;set;}public decimal? Area{get;set;}public string? Url{get;set;}public string? ExternalId{get;set;}public string? CadastralNumber{get;set;}public string? Description{get;set;}[Required,MinLength(3),MaxLength(4000)]public string Comment{get;set;}="";}
}
