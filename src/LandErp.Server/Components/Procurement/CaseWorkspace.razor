    private static void ParseOwner(string key,out CaseAttachmentOwner owner,out Guid? id){id=null;if(key.StartsWith("ii:",StringComparison.Ordinal)&&Guid.TryParse(key[3..],out Guid ii)){owner=CaseAttachmentOwner.InspectionItem;id=ii;}else if(key.StartsWith("i:",StringComparison.Ordinal)&&Guid.TryParse(key[2..],out Guid i)){owner=CaseAttachmentOwner.Inspection;id=i;}else if(key.StartsWith("n:",StringComparison.Ordinal)&&Guid.TryParse(key[2..],out Guid n)){owner=CaseAttachmentOwner.Negotiation;id=n;}else if(key.StartsWith("c:",StringComparison.Ordinal)&&Guid.TryParse(key[2..],out Guid c)){owner=CaseAttachmentOwner.Check;id=c;}else owner=CaseAttachmentOwner.Case;}
    private static string InspectionAnswer(InspectionItemView item)=>item.Status==InspectionItemStatus.NotChecked?"Не проверено":item.Status==InspectionItemStatus.Unanswered?"Нет ответа":item.Answer+(item.Unit.Length==0?"":" "+item.Unit);
    private static bool InspectionProblem(InspectionItemView item)=>item.Status==InspectionItemStatus.Answered&&item.NormalAnswer.Length>0&&!string.Equals(item.Answer,item.NormalAnswer,StringComparison.OrdinalIgnoreCase);
    private static string FormatSize(long size)=>size==0?"ссылка":size<1024?$"{size} Б":$"{size/1024d:N1} КБ";
