<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(AppShell)">
            <NotAuthorized>
                <PageState Kind="forbidden" Title="Нет доступа" Description="Войдите в систему или обратитесь к администратору." />
                <a class="btn primary" href="/account/login">Войти</a>
            </NotAuthorized>
            <Authorizing><PageState Kind="loading" Title="Проверяем доступ…" /></Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound><LayoutView Layout="typeof(AppShell)"><PageState Kind="error" Title="Страница не найдена" /></LayoutView></NotFound>
</Router>
