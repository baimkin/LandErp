<Window x:Class="LandErp.ParserSpike.Desktop.PhotoViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Просмотр фотографии" Width="1100" Height="820" MinWidth="720" MinHeight="520"
    WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13.5"
    Foreground="#203047" Background="#111827" KeyDown="ViewerKeyDown">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ParserTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Background="#111827">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <DockPanel Margin="14,10">
            <TextBlock x:Name="ViewerCounter" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right" Text="← → листать · Esc закрыть" Foreground="#CBD5E1" FontSize="12.5" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="12,0">
            <Image x:Name="ViewerImage" Stretch="Uniform"/>
            <Button x:Name="ViewerPreviousButton" Content="‹" Width="46" Height="58" Padding="0"
                    HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="30" FontWeight="SemiBold"
                    Click="ViewerPreviousClick" ToolTip="Предыдущее фото"/>
            <Button x:Name="ViewerNextButton" Content="›" Width="46" Height="58" Padding="0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="30" FontWeight="SemiBold"
                    Click="ViewerNextClick" ToolTip="Следующее фото"/>
        </Grid>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="14,10">
            <ListBox x:Name="ViewerThumbnails" BorderThickness="0" Background="Transparent"
                     SelectionChanged="ViewerThumbnailSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="0,0,6,0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="92" Height="68" Background="#1F2937" CornerRadius="5" ClipToBounds="True">
                            <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</Window>