@using LandErp.Application.Modules.Overview.Contracts

<div class="group-market-prices">
    @if (Value == null)
    {
        <span class="market-empty">@EmptyText</span>
    }
    else
    {
        <div class="market-group" title="@Value.Name">@Value.Name</div>
        <div class="price-line"><span>Медиана</span><b>@DemandTestPrice.Money(Value.MedianPricePerSotka)</b></div>
        <div class="price-line"><span>Средняя</span><b>@DemandTestPrice.Money(Value.AveragePricePerSotka)</b></div>
        <div class="price-line"><span title="Ручной ориентир">Тест спроса</span><DemandTestPrice Value="Value" Subject="Subject" Saved="Saved" /></div>
        <div class="market-caption">₽/сот. · @if (Value.CanReadParticipants) { <a href="@($"/incoming?participants={Value.SearchGroupId}")">В расчёте: @Value.ParticipantCount</a> } else { <span>В расчёте: @Value.ParticipantCount</span> }</div>
    }
</div>

@code {
    [Parameter] public GroupMarketView? Value { get; set; }
    [Parameter, EditorRequired] public Subject Subject { get; set; } = default!;
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public string EmptyText { get; set; } = "Выберите группу поиска или сохранённый фильтр с группой";
}
