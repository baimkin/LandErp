<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <!-- Editor source/toolchain stays out of runtime publish; the checked-in local bundle is under wwwroot. -->
    <Content Remove="ClientAssets\**" />
    <None Remove="ClientAssets\node_modules\**" />
    <!-- Scratch builds inside the project are not application source or public content. -->
    <Compile Remove="artifacts\**" />
    <Content Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <ProjectReference Include="../LandErp.Application/LandErp.Application.csproj" />
    <ProjectReference Include="../LandErp.Infrastructure/LandErp.Infrastructure.csproj" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>
</Project>
