    private GroupMarketView? groupMarket;
    protected override async Task ReadAsync()
    {
        if (participantRoute != ParticipantsGroupId)
        {
            participantRoute = ParticipantsGroupId;
            filter.Reset(); page = 0; preset = criteriaPreset = null;
            selectedSavedPresetId = null; selectedPresetSnapshot = null;
            searchGroupKey = ParticipantsGroupId?.ToString() ?? "";
            incomingMode = ParticipantsGroupId == null ? IncomingCatalogMode.SavedFilters : IncomingCatalogMode.Participants;
        }
        if(OverviewSlice==null && ParticipantsGroupId!=null) appliedOverviewSlice=null;
        if(appliedOverviewSlice != OverviewSlice)
        {
            if(OverviewSlice!=null && ParticipantsGroupId!=null) throw new ArgumentException("Нельзя одновременно открыть участников и срез обзора.");
            var entry=OverviewSlice==null ? null : IncomingOverviewSelection.Filter(OverviewSlice);
            filter.Reset();page=0;searchGroupKey="";selectedSavedPresetId=null;selectedPresetSnapshot=null;
            preset=entry?.WorkingScope?.Slice;criteriaPreset=null;
            incomingMode=entry?.WorkingScope?.Mode??IncomingCatalogMode.SavedFilters;
            filter.AttentionOnly=entry?.Base.AttentionOnly??false;
            appliedOverviewSlice=OverviewSlice;
        }
        effectiveAccess = await AccessV1.ResolveAsync(CurrentSubject, CancellationToken.None);
        Guid? groupId = Guid.TryParse(searchGroupKey, out Guid parsed) ? parsed : null;
        IncomingCatalogFilter baseFilter = new(filter.Text.Trim(), filter.Source, filter.Disposition, filter.Age,
            filter.MinPrice, filter.MaxPrice, ToSquareMeters(filter.MinAreaSotki), ToSquareMeters(filter.MaxAreaSotki),
            filter.AttentionOnly, page * PageSize, PageSize);
        renderedCalculationFilter = new(baseFilter, null, criteriaPreset, sortField, sortDirection, groupId,
            filter.MinPricePerSotka, filter.MaxPricePerSotka, filter.LandTypes.Order().ToArray(),
            new(incomingMode, selectedSavedPresetId, UseDraft: true, Slice: preset, ArchiveState: archiveState), filter.IncludedInMedian);
        catalogPage = await IncomingReads.ReadAsync(CurrentSubject, renderedCalculationFilter, CancellationToken.None);
        groupMarket = await Markets.ReadIncomingAsync(CurrentSubject, renderedCalculationFilter, CancellationToken.None);
        string scope = System.Text.Json.JsonSerializer.Serialize(renderedCalculationFilter with { Base = baseFilter with { Offset = 0 } });
        if (calculationScope != scope) ClearCalculationSelection();
        calculationScope = scope;
        if (allCalculationResults && calculationTotal != catalogPage.Total) { ClearCalculationSelection(); Success = "Состав выдачи изменился — выберите строки заново."; }
        if (allCalculationResults)
        {
            var current = await Calculation.PreviewAsync(CurrentSubject, new(renderedCalculationFilter, ExcludedIds: calculationExcluded.ToArray()), true, CancellationToken.None);
            if (selectedCohortStamp != null && selectedCohortStamp != current.Stamp)
            { ClearCalculationSelection(); Success = "Выбранные объявления изменились — выберите строки заново."; }
            else { selectedCohortStamp = current.Stamp; calculationTotal = current.Total + calculationExcluded.Count; }
        }
        savedPresets = catalogPage.FilterCounts?.Presets ?? [];
    }

