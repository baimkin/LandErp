@page "/incoming"
@attribute [Authorize(Policy = "manager_queue.read")]
@using LandErp.Application.Modules.Catalog.Contracts
@using LandErp.Application.Modules.Catalog.Domain
@using LandErp.Server.Components.Procurement
@inherits WorkspaceComponent
@inject ICatalogWorkspace Workspace
@inject NavigationManager Navigation

<PageTitle>Входящие предложения · LandErp</PageTitle>
<PageHeader Title="Входящие предложения" Breadcrumb="Закупка / Первичный отбор" Description="Общий поток Avito, Cian, Telegram, ручных и других источников.">
    <ActionButton Label="+ Добавить объявление / предложение" OnClick="() => manualOpen=true" />
</PageHeader>

<FilterBar>
    <EditForm Model="filter" FormName="incoming-filter" OnValidSubmit="ApplyFilterAsync">
        <div class="queue-filters">
            <label class="field"><span>Поиск</span><input @bind="filter.Text" placeholder="Название, локация, внешний ID" /></label>
            <label class="field"><span>Источник</span><InputSelect @bind-Value="filter.Source"><option value="">Все источники</option>@foreach(CatalogSource source in Enum.GetValues<CatalogSource>()){<option value="@source">@SourceBadge.Label(source)</option>}</InputSelect></label>
            <label class="field"><span>Состояние</span><InputSelect @bind-Value="filter.Disposition"><option value="">Все состояния</option>@foreach(CatalogDisposition state in Enum.GetValues<CatalogDisposition>()){<option value="@state">@DispositionLabel(state)</option>}</InputSelect></label>
            <label class="field"><span>Возраст</span><InputSelect @bind-Value="filter.Age"><option value="Any">Любой</option><option value="Today">До суток</option><option value="ThreeDays">До 3 дней</option><option value="Week">До недели</option><option value="OlderThanWeek">Старше недели</option></InputSelect></label>
            <label class="field compact-field"><span>Цена от, ₽</span><InputNumber @bind-Value="filter.MinPrice" /></label>
            <label class="field compact-field"><span>Цена до, ₽</span><InputNumber @bind-Value="filter.MaxPrice" /></label>
            <label class="field compact-field"><span>Площадь от, м²</span><InputNumber @bind-Value="filter.MinArea" /></label>
            <label class="field compact-field"><span>Площадь до, м²</span><InputNumber @bind-Value="filter.MaxArea" /></label>
            <label class="check-field"><InputCheckbox @bind-Value="filter.AttentionOnly" /> Требует внимания</label>
            <ActionButton Label="Применить" Type="submit" /><ActionButton Label="Сбросить" Tone="quiet" OnClick="ResetFilterAsync" />
        </div>
    </EditForm>
</FilterBar>

@if(Loading){<PageState Kind="loading" Title="Загружаем входящие…" />}
else if(Forbidden){<PageState Kind="forbidden" Title="Нет доступа ко входящим" />}
else if(Error!=null){<PageState Kind="error" Title="@Error"><ActionButton Label="Повторить" OnClick="ReloadAsync" /></PageState>}
else if(catalogPage!=null)
{
    @if(Success!=null){<PageState Kind="success" Title="@Success" />}
    <div class="metric-grid incoming-metrics">
        <div class="metric"><span>Активные входящие</span><strong>@catalogPage.Summary.Incoming</strong></div>
        <div class="metric"><span>Требуют внимания</span><strong>@catalogPage.Summary.Attention</strong></div>
        <div class="metric"><span>Мониторинг</span><strong>@catalogPage.Summary.Monitoring</strong></div>
        <div class="metric"><span>В работе</span><strong>@catalogPage.Summary.InWork</strong></div>
        <div class="metric"><span>Неполные данные</span><strong>@catalogPage.Summary.Incomplete</strong></div>
    </div>
    <div class="queue-summary"><strong>@catalogPage.Total предложений по фильтру</strong><small>Catalog — общий входящий пул организации</small></div>
    @if(catalogPage.Items.Count==0){<PageState Title="Предложений не найдено" Description="Измените фильтр, добавьте предложение вручную или дождитесь результата источника." />}
    else
    {
        <section class="surface table-surface"><div class="table-wrap"><table class="data-table incoming-table">
            <thead><tr><th>Предложение</th><th>Цена</th><th>Площадь</th><th>Почему в очереди</th><th>Получено</th><th>Источник</th><th></th></tr></thead>
            <tbody>@foreach(CatalogItemView item in catalogPage.Items){<tr class="@(item.AttentionRequired?"attention-row":"")">
                <td><strong>@item.Title</strong><small>@(item.Location??"Местоположение неизвестно") · @(item.ExternalId??"без внешнего ID")</small>@if(item.BusinessNumber!=null){<small><a href="@($"/procurement/{item.PropertyCaseId}")">@item.BusinessNumber</a></small>}</td>
                <td><strong>@ProcurementLabels.Money(item.Price)</strong><small>@(item.PricePerSotka==null?"за сотку неизвестно":ProcurementLabels.Money(item.PricePerSotka)+" / сот.")</small></td>
                <td>@ProcurementLabels.Area(item.AreaSquareMeters)</td>
                <td><StatusBadge Label="@DispositionLabel(item.Disposition)" Tone="@DispositionTone(item.Disposition,item.AttentionRequired)" /><small>@item.QueueReason</small></td>
                <td>@Age(item.ReceivedAt)<small>@ProcurementLabels.Time(item.LastObservedAt??item.ChangedAt)</small></td>
                <td><SourceBadge Source="item.Source" /></td>
                <td><ActionButton Label="Подробнее" Tone="secondary" OnClick="() => OpenDetailAsync(item.Id)" /></td>
            </tr>}</tbody>
        </table></div></section>
        <div class="table-footer"><span>Страница @(page+1)</span><div><ActionButton Label="Назад" Disabled="@(page==0)" Tone="quiet" OnClick="PreviousAsync" /><ActionButton Label="Далее" Disabled="@((page+1)*PageSize>=catalogPage.Total)" Tone="quiet" OnClick="NextAsync" /></div></div>
    }
}

@if(detail!=null)
{
    <Modal Title="@detail.Item.Title" Kind="drawer" OnClose="CloseDetail">
        <div class="incoming-detail">
            <div class="queue-meta"><SourceBadge Source="detail.Item.Source" /><StatusBadge Label="@DispositionLabel(detail.Item.Disposition)" Tone="@DispositionTone(detail.Item.Disposition,detail.Item.AttentionRequired)" />@if(detail.Item.BusinessNumber!=null){<a href="@($"/procurement/{detail.Item.PropertyCaseId}")">@detail.Item.BusinessNumber</a>}</div>
            <section class="surface"><div class="facts-grid"><div><small>Цена</small><strong>@ProcurementLabels.Money(detail.Item.Price)</strong></div><div><small>Цена за сотку</small><strong>@ProcurementLabels.Money(detail.Item.PricePerSotka)</strong></div><div><small>Площадь</small><strong>@ProcurementLabels.Area(detail.Item.AreaSquareMeters)</strong></div><div><small>Локация</small><strong>@(detail.Item.Location??"Не указана")</strong></div><div><small>Кадастровый номер</small><strong>@(detail.Item.CadastralNumber??"Не указан")</strong></div><div><small>Получено</small><strong>@ProcurementLabels.Time(detail.Item.ReceivedAt)</strong></div></div>
                @if(detail.Item.Url!=null){<a href="@detail.Item.Url" target="_blank" rel="noopener noreferrer">Открыть источник ↗</a>}
                @if(detail.Item.Description!=null){<p class="preserve-lines">@detail.Item.Description</p>}
                <p class="subtle">@detail.Item.Provenance@if(detail.IngressComment!=null){<span> · @detail.IngressComment</span>}</p>
            </section>
            <section class="surface"><h3>Мониторинг цены</h3><p class="subtle">Любой заполненный порог возвращает предложение во входящие, когда становится выполнен.</p><EditForm Model="monitoring" FormName="incoming-monitor" OnValidSubmit="SaveMonitoringAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field"><span>Общая цена ≤, ₽</span><InputNumber @bind-Value="monitoring.Total" /></label><label class="field"><span>Цена за сотку ≤, ₽</span><InputNumber @bind-Value="monitoring.PerSotka" /></label><label class="field" style="grid-column:1/-1"><span>Комментарий</span><InputTextArea @bind-Value="monitoring.Reason" /></label><div class="form-actions"><ActionButton Label="Поставить на мониторинг" Type="submit" Busy="Busy" /></div></div></EditForm>
                @if(detail.Monitoring.LastEvaluatedAt!=null){<small>Последняя оценка @ProcurementLabels.Time(detail.Monitoring.LastEvaluatedAt): @ProcurementLabels.Money(detail.Monitoring.LastEvaluatedPrice) · @ProcurementLabels.Money(detail.Monitoring.LastEvaluatedPricePerSotka) / сот.</small>}
            </section>
            <section class="surface"><h3>Решение первичного отбора</h3><div class="decision-actions"><ActionButton Label="Дубль" Tone="quiet" OnClick="() => OpenClassification(CatalogDisposition.Duplicate)" /><ActionButton Label="Фейк" Tone="quiet" OnClick="() => OpenClassification(CatalogDisposition.Fake)" /><ActionButton Label="Снято" Tone="quiet" OnClick="() => OpenClassification(CatalogDisposition.RemovedAtSource)" /><ActionButton Label="Продано" Tone="quiet" OnClick="() => OpenClassification(CatalogDisposition.Sold)" /><ActionButton Label="Не подходит" Tone="danger" OnClick="() => OpenClassification(CatalogDisposition.Dismissed)" /></div><div class="decision-actions incoming-primary-actions">@if(detail.Item.PropertyCaseId==null){<ActionButton Label="Взять в работу" OnClick="() => OpenTakeAsync(detail.Item)" />}else if(detail.Item.Disposition==CatalogDisposition.InWork){<ActionButton Label="Открыть PropertyCase" Tone="secondary" OnClick="() => OpenCase(detail.Item.PropertyCaseId)" />}else{<ActionButton Label="Возобновить существующий PropertyCase" OnClick="ResumeAsync" />}</div></section>
            <section class="surface"><h3>История внимания</h3>@if(detail.Events.Count==0){<p class="subtle">Событий пока нет.</p>}else{<ol class="business-timeline">@foreach(CatalogEventView item in detail.Events){<li><strong>@EventLabel(item.Kind)</strong><small>@ProcurementLabels.Time(item.RecordedAt)</small><p>@item.Message</p></li>}</ol>}</section>
        </div>
    </Modal>
}

@if(manualOpen){<Modal Title="Добавить объявление / предложение" OnClose="() => manualOpen=false"><EditForm Model="manual" FormName="manual-catalog" OnValidSubmit="CreateManualAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field"><span>Источник</span><InputSelect @bind-Value="manual.Source">@foreach(CatalogSource source in manualSources){<option value="@source">@SourceBadge.Label(source)</option>}</InputSelect></label><label class="field"><span>Название</span><InputText @bind-Value="manual.Title" /></label><label class="field"><span>Локация</span><InputText @bind-Value="manual.Location" /></label><label class="field"><span>Ссылка HTTPS (необязательно)</span><InputText @bind-Value="manual.Url" /></label><label class="field"><span>Цена, ₽</span><InputNumber @bind-Value="manual.Price" /></label><label class="field"><span>Площадь, м²</span><InputNumber @bind-Value="manual.Area" /></label><label class="field"><span>Кадастровый номер</span><InputText @bind-Value="manual.CadastralNumber" /></label><label class="field"><span>Внешний ID (необязательно)</span><InputText @bind-Value="manual.ExternalId" /></label><label class="field" style="grid-column:1/-1"><span>Описание</span><InputTextArea @bind-Value="manual.Description" /></label><label class="field" style="grid-column:1/-1"><span>Комментарий / происхождение</span><InputTextArea @bind-Value="manual.Comment" /></label><div class="form-actions"><ActionButton Label="Отмена" Tone="quiet" OnClick="() => manualOpen=false" /><ActionButton Label="Сохранить во входящие" Type="submit" Busy="Busy" /></div></div></EditForm></Modal>}
@if(takeItem!=null){<Modal Title="Взять в работу" OnClose="() => takeItem=null"><p><strong>@takeItem.Title</strong></p><p class="subtle">Создайте новый PropertyCase либо подтвердите связь с существующим.</p><label class="field"><span>PropertyCase</span><InputSelect @bind-Value="existingCaseId"><option value="">Создать новый PropertyCase</option>@foreach(CaseLinkTarget target in targets){<option value="@target.CaseId">@target.BusinessNumber · @target.Title</option>}</InputSelect></label><div class="form-actions"><ActionButton Label="Отмена" Tone="quiet" OnClick="() => takeItem=null" /><ActionButton Label="Подтвердить" Busy="Busy" OnClick="TakeAsync" /></div></Modal>}
@if(classificationOpen){<Modal Title="@DispositionLabel(classification)" OnClose="() => classificationOpen=false"><label class="field"><span>Причина / подтверждение</span><InputTextArea @bind-Value="classificationReason" /></label><div class="form-actions"><ActionButton Label="Отмена" Tone="quiet" OnClick="() => classificationOpen=false" /><ActionButton Label="Подтвердить" Busy="Busy" OnClick="ClassifyAsync" /></div></Modal>}

@code {
    private const int PageSize=25;
    private IncomingCatalogPage? catalogPage; private CatalogItemDetail? detail; private readonly FilterInput filter=new(); private int page;
    private bool manualOpen; private ManualInput manual=new(); private MonitoringInput monitoring=new();
    private CatalogItemView? takeItem; private Guid? existingCaseId; private IReadOnlyList<CaseLinkTarget> targets=[];
    private bool classificationOpen; private CatalogDisposition classification; private string classificationReason="";
    private static readonly CatalogSource[] manualSources=[CatalogSource.Telegram,CatalogSource.Referral,CatalogSource.Agent,CatalogSource.DirectOwner,CatalogSource.Manual,CatalogSource.Other];
    protected override async Task ReadAsync()=>catalogPage=await Workspace.ReadIncomingAsync(CurrentSubject,new(filter.Text,filter.Source,filter.Disposition,filter.Age,filter.MinPrice,filter.MaxPrice,filter.MinArea,filter.MaxArea,filter.AttentionOnly,page*PageSize,PageSize),CancellationToken.None);
    private Task ApplyFilterAsync(){page=0;return ReloadAsync();}
    private Task ResetFilterAsync(){filter.Reset();page=0;return ReloadAsync();}
    private Task PreviousAsync(){page--;return ReloadAsync();} private Task NextAsync(){page++;return ReloadAsync();}
    private async Task OpenDetailAsync(Guid id){detail=await Workspace.ReadItemAsync(CurrentSubject,id,CancellationToken.None);monitoring=new(){Total=detail.Monitoring.TargetTotalPrice,PerSotka=detail.Monitoring.TargetPricePerSotka,Reason=detail.Item.QueueReason};}
    private void CloseDetail()=>detail=null;
    private async Task CreateManualAsync(){await ExecuteAsync(()=>Workspace.CreateManualAsync(CurrentSubject,new(manual.Source,manual.Title,manual.Location,manual.Price,manual.Area,manual.Url,manual.ExternalId,manual.CadastralNumber,manual.Description,manual.Comment),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null){manualOpen=false;manual=new();}}
    private async Task OpenTakeAsync(CatalogItemView item){takeItem=item;existingCaseId=null;targets=await Workspace.ReadLinkTargetsAsync(CurrentSubject,CancellationToken.None);}
    private async Task TakeAsync(){TakeToWorkResult? result=null;await ExecuteAsync(async()=>result=await Workspace.TakeToWorkAsync(CurrentSubject,new(takeItem!.Id,existingCaseId),Guid.CreateVersion7().ToString(),CancellationToken.None));if(result!=null)Navigation.NavigateTo($"/procurement/{result.CaseId}");}
    private async Task SaveMonitoringAsync(){Guid id=detail!.Item.Id;await ExecuteAsync(()=>Workspace.SetMonitoringAsync(CurrentSubject,new(id,detail.Item.Version,monitoring.Total,monitoring.PerSotka,monitoring.Reason),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null)await OpenDetailAsync(id);}
    private void OpenClassification(CatalogDisposition value){classification=value;classificationReason="";classificationOpen=true;}
    private async Task ClassifyAsync(){Guid id=detail!.Item.Id;await ExecuteAsync(()=>Workspace.SetDispositionAsync(CurrentSubject,new(id,detail.Item.Version,classification,classificationReason),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null){classificationOpen=false;await OpenDetailAsync(id);}}
    private async Task ResumeAsync(){TakeToWorkResult? result=null;await ExecuteAsync(async()=>result=await Workspace.ResumeCaseAsync(CurrentSubject,new(detail!.Item.Id,detail.Item.Version),Guid.CreateVersion7().ToString(),CancellationToken.None));if(result!=null)Navigation.NavigateTo($"/procurement/{result.CaseId}");}
    private void OpenCase(Guid? caseId){if(caseId!=null)Navigation.NavigateTo($"/procurement/{caseId}");}
    private static string DispositionLabel(CatalogDisposition value)=>value switch{CatalogDisposition.Incoming=>"Входящее",CatalogDisposition.Monitoring=>"Мониторинг",CatalogDisposition.InWork=>"В работе",CatalogDisposition.Dismissed=>"Не подходит",CatalogDisposition.Duplicate=>"Дубль",CatalogDisposition.Fake=>"Фейк",CatalogDisposition.RemovedAtSource=>"Снято",_=>"Продано"};
    private static string DispositionTone(CatalogDisposition value,bool attention)=>attention?"warning":value switch{CatalogDisposition.Incoming=>"info",CatalogDisposition.InWork=>"success",CatalogDisposition.Fake=>"danger",CatalogDisposition.Sold=>"success",_=>"neutral"};
    private static string EventLabel(CatalogEventKind kind)=>kind switch{CatalogEventKind.SourceChanged=>"Источник изменился",CatalogEventKind.MonitoringStarted=>"Начат мониторинг",CatalogEventKind.MonitoringTriggered=>"Порог достигнут",CatalogEventKind.Classified=>"Классификация",_=>"PropertyCase возобновлён"};
    private static string Age(DateTimeOffset value){TimeSpan age=DateTimeOffset.UtcNow-value;return age.TotalHours<24?$"{Math.Max(0,(int)age.TotalHours)} ч назад":$"{(int)age.TotalDays} дн. назад";}
    private sealed class FilterInput{public string Text{get;set;}="";public CatalogSource? Source{get;set;}public CatalogDisposition? Disposition{get;set;}=CatalogDisposition.Incoming;public CatalogAgeRange Age{get;set;}public decimal? MinPrice{get;set;}public decimal? MaxPrice{get;set;}public decimal? MinArea{get;set;}public decimal? MaxArea{get;set;}public bool AttentionOnly{get;set;}public void Reset(){Text="";Source=null;Disposition=CatalogDisposition.Incoming;Age=CatalogAgeRange.Any;MinPrice=MaxPrice=MinArea=MaxArea=null;AttentionOnly=false;}}
    private sealed class MonitoringInput{public decimal? Total{get;set;}public decimal? PerSotka{get;set;}[Required,MinLength(3),MaxLength(4000)]public string Reason{get;set;}="Ждём достижения целевой цены";}
    private sealed class ManualInput{public CatalogSource Source{get;set;}=CatalogSource.Telegram;[Required,MinLength(3),MaxLength(20000)]public string Title{get;set;}="";public string? Location{get;set;}public decimal? Price{get;set;}public decimal? Area{get;set;}public string? Url{get;set;}public string? ExternalId{get;set;}public string? CadastralNumber{get;set;}public string? Description{get;set;}[Required,MinLength(3),MaxLength(4000)]public string Comment{get;set;}="";}
}
