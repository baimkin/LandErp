    private string MonitoringSummary()
    {
        List<string> parts = [];
        if (monitoring.Total != null) parts.Add($"до {ProcurementLabels.Money(monitoring.Total)}");
        if (monitoring.PerSotka != null) parts.Add($"до {ProcurementLabels.Money(monitoring.PerSotka)} / сот.");
