<Window FontFamily="Segoe UI" FontSize="15" Foreground="#203047" Background="#F4F6FA"
    x:Class="LandErp.ParserSpike.Desktop.WorkspaceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LandErp.ParserSpike.Desktop"
    Title="LandErp Parser" Width="1440" Height="920" MinWidth="1060" MinHeight="720">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ParserTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<DockPanel Margin="24">
<Grid DockPanel.Dock="Top" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="LandErp Parser" Style="{StaticResource Title}"/><TextBlock x:Name="ModeDescription" Style="{StaticResource Hint}"/></StackPanel>
<StackPanel Grid.Column="1" Margin="16,0"><TextBlock Text="Где работать" Style="{StaticResource Hint}"/><ComboBox x:Name="ModeInput" SelectionChanged="ModeChanged"><ComboBoxItem Content="На этом компьютере"/><ComboBoxItem Content="Через сервер"/></ComboBox></StackPanel>
<StackPanel Grid.Column="2" VerticalAlignment="Center"><Button x:Name="AutomationButton" Content="Включить автоработу" Style="{StaticResource Primary}" Click="AutomationClick"/><TextBlock x:Name="ConnectionText" Style="{StaticResource Hint}" MaxWidth="310"/></StackPanel></Grid>
<Border DockPanel.Dock="Bottom" Background="#EAF0FA" CornerRadius="8" Padding="12" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Text="Добавьте поиск или откройте сайт, чтобы настроить фильтры."/></Border>
<TabControl x:Name="Pages" BorderThickness="0" Background="Transparent">
<TabItem Header="Поиски"><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="12"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Группы" FontSize="18" FontWeight="SemiBold" Margin="8"/><Button Content="+ Новая группа" Click="AddGroupClick"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><Button Content="Переименовать" Click="RenameGroupClick"/><Button Content="Архивировать группу" Click="ArchiveGroupClick"/></StackPanel><ListBox x:Name="GroupsList" DisplayMemberPath="Name" BorderThickness="0" SelectionChanged="GroupSelected"/></DockPanel></Border>
<Border Grid.Column="2" Style="{StaticResource Card}"><DockPanel><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button x:Name="AddButton" Content="+ Добавить поиск" Style="{StaticResource Primary}" Click="AddClick"/><Button Content="Открыть сайт" Click="BrowseClick"/><Button Content="Добавить из браузера" Click="CaptureClick"/><Button Content="Обновить" Click="RefreshClick"/></WrapPanel>
<WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button x:Name="StartButton" Content="Запустить выбранный" Click="RunClick"/><Button Content="Изменить" Click="EditClick"/><Button Content="Включить / приостановить" Click="ToggleSearchClick"/><Button x:Name="ArchiveButton" Content="В архив" Click="ArchiveClick"/><Button x:Name="TransferButton" Content="Добавить на сервер…" Click="TransferClick"/></WrapPanel>
<Grid><DataGrid x:Name="LinksGrid"><DataGrid.Columns><DataGridTextColumn Header="Поиск" Binding="{Binding Label}" Width="2*"/><DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="95"/><DataGridTextColumn Header="Расписание" Binding="{Binding ScheduleText}" Width="2*"/><DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="140"/></DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyText" Text="Здесь пока нет поисков. Добавьте ссылку или настройте поиск в браузере." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"/></Grid>
</DockPanel></Border></Grid></TabItem>

<TabItem Header="Работа"><Border Style="{StaticResource Card}" Margin="0,18,0,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Текущая работа и история" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Авторабота запускает местные расписания или принимает задания сервера. Приложение должно оставаться открытым." Style="{StaticResource Hint}"/><WrapPanel><Button Content="Пауза текущего сбора" Click="PauseClick"/><Button Content="Продолжить" Click="ResumeClick"/><Button Content="Остановить всё" Click="StopClick"/></WrapPanel><Border x:Name="NoticePanel" Visibility="Collapsed" Background="#FFF4D7" Padding="14" Margin="0,12"><StackPanel><TextBlock x:Name="NoticeText"/><Button Content="Проверка в браузере выполнена — продолжить" HorizontalAlignment="Left" Click="VerifyClick"/></StackPanel></Border></StackPanel>
<DataGrid x:Name="JobsGrid"><DataGrid.Columns><DataGridTextColumn Header="Поиск" Binding="{Binding Label}" Width="2*"/><DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="100"/><DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="180"/><DataGridTextColumn Header="Прогресс" Binding="{Binding Progress}" Width="220"/><DataGridTextColumn Header="Начало" Binding="{Binding Started}" Width="170"/></DataGrid.Columns></DataGrid>
</DockPanel></Border></TabItem>

<TabItem Header="Результаты"><Border Style="{StaticResource Card}" Margin="0,18,0,0"><DockPanel>
<StackPanel DockPanel.Dock="Top">
<WrapPanel>
<TextBox x:Name="SearchInput" Width="250" ToolTip="Название, адрес, продавец, ID или кадастровый номер" Margin="4"/>
<ComboBox x:Name="SourceFilterInput" Width="125" DisplayMemberPath="Label" ToolTip="Источник"/>
<ComboBox x:Name="SearchFilterInput" Width="210" DisplayMemberPath="Label" ToolTip="Поисковая ссылка"/>
<ComboBox x:Name="RunFilterInput" Width="210" DisplayMemberPath="Label" ToolTip="Запуск"/>
<ComboBox x:Name="QualityFilterInput" Width="210" DisplayMemberPath="Label" ToolTip="Качество данных"/>
<Button Content="Найти" Click="FindClick"/><Button Content="Экспорт CSV" Click="ExportClick"/>
</WrapPanel>
<TextBlock Text="Фильтры применяются по кнопке «Найти». ⚠ в колонке типа означает расхождение между заявленным источником и найденным в тексте." Style="{StaticResource Hint}"/>
</StackPanel>
<WrapPanel DockPanel.Dock="Bottom"><Button Content="Назад" Click="PreviousClick"/><TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="12"/><Button Content="Далее" Click="NextClick"/></WrapPanel>
<Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition x:Name="DetailsGapColumn" Width="20"/><ColumnDefinition x:Name="DetailsColumn" Width="2*"/></Grid.ColumnDefinitions>
<DataGrid x:Name="ListingsGrid" SelectionChanged="ListingSelected" HorizontalScrollBarVisibility="Auto">
<DataGrid.Columns>
<DataGridTextColumn Header="Объявление" Binding="{Binding Title}" Width="2*"/>
<DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="125"/>
<DataGridTextColumn Header="Площадь" Binding="{Binding Area}" Width="95"/>
<DataGridTextColumn Header="₽ / сот." Binding="{Binding PricePerSotka}" Width="125"/>
<DataGridTextColumn Header="Адрес" Binding="{Binding Location}" Width="1.6*"/>
<DataGridTextColumn Header="Тип" Binding="{Binding LandTypes}" Width="150"/>
<DataGridTextColumn Header="!" Binding="{Binding LandTypeIssue}" Width="38"/>
<DataGridTextColumn Header="Опубликовано" Binding="{Binding Published}" Width="135"/>
<DataGridTextColumn Header="Фото" Binding="{Binding PhotoCount}" Width="60"/>
<DataGridTextColumn Header="Кадастровый №" Binding="{Binding CadastralNumber}" Width="145"/>
</DataGrid.Columns>
</DataGrid>
<local:ListingDetailsControl x:Name="DetailsPanel" Grid.Column="2"/>
</Grid>
</DockPanel></Border></TabItem>

<TabItem Header="Настройки"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18" MaxWidth="720" HorizontalAlignment="Left">
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Подключение" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ServerAddressText" Style="{StaticResource Hint}"/><Button Content="Подключить или сменить сервер" HorizontalAlignment="Left" Click="ConnectClick"/><TextBlock Text="Вставьте код, выданный в LandErp. Локальные поиски и группы не отправляются на сервер автоматически." Style="{StaticResource Hint}"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,16"><StackPanel><TextBlock Text="Сбор данных" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Браузер" Margin="0,14,0,0"/><ComboBox x:Name="BrowserInput"><ComboBoxItem Content="Google Chrome"/><ComboBoxItem Content="Microsoft Edge"/></ComboBox><TextBlock Text="Предел страниц для локального сбора"/><TextBox x:Name="MaxPagesInput"/><TextBlock Text="Не повторять свежие результаты при ручном запуске, часов"/><TextBox x:Name="FreshnessInput"/>
<TextBlock Text="Открывать карточку объявления" Margin="0,14,0,0"/><ComboBox x:Name="ListingDetailsModeInput"><ComboBoxItem Content="Справа в рабочем окне"/><ComboBoxItem Content="В отдельном окне"/></ComboBox>
<Button x:Name="SaveSettingsButton" Content="Сохранить настройки" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="SaveSettingsClick"/><TextBlock Text="Расписание выполняется только при открытом приложении и включённой автоработе. Сервер управляет своими расписаниями самостоятельно." Style="{StaticResource Hint}"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Помощь" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Если сбор остановился с ошибкой, сохраните краткий отчёт для разбора." Style="{StaticResource Hint}"/><Button Content="Сохранить диагностику" HorizontalAlignment="Left" Click="DiagnosticsClick"/></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
</TabControl></DockPanel></Window>