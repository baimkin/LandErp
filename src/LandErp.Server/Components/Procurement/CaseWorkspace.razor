@using LandErp.Application.Modules.Procurement.Contracts
@inherits WorkspaceComponent
@inject IProcurementWorkspace Workspace
@if(Loading) { <PageState Kind="loading" Title="Открываем объект…" /> }
else if(Forbidden) { <PageState Kind="forbidden" Title="Нет доступа к объекту" /> }
else if(card!=null)
{
    @if(Error!=null) { <PageState Kind="error" Title="@Error"><ActionButton Label="Обновить карточку" OnClick="ReloadAsync" /></PageState> }
    @if(Success!=null) { <PageState Kind="success" Title="@Success" /> }
    <div class="stack case-workspace" data-case-version="@card.Item.CaseVersion">
        <article class="surface"><div class="case-heading"><div><span class="kicker">@card.Item.BusinessNumber</span><h2>@card.Item.Title</h2></div><div>@foreach(var source in card.Item.Sources) { <SourceBadge Source="source" /> }<StatusBadge Label="@ProcurementLabels.Stage(card.Item.Stage)" Tone="@(card.Item.Stage=="returned" ? "warning" : "neutral")" /></div></div>
            <div class="facts-grid"><div><small>Цена предложения</small><strong>@ProcurementLabels.Money(card.Item.Price)</strong></div><div><small>Площадь</small><strong>@ProcurementLabels.Area(card.Item.Area)</strong></div><div><small>Местоположение</small><strong>@(card.Item.Location??"Неизвестно")</strong></div></div>
            <p class="event-reason">@card.Item.Reason</p>@if(card.Item.UnknownFields.Length>0) { <p class="warning-text">Неизвестно: @string.Join(", ",card.Item.UnknownFields)</p> }
            <div class="list-row"><strong>Рабочие факты PropertyCase</strong><small>Исполнитель: @(card.Item.Assignee??"Не назначен") · срок @ProcurementLabels.Time(card.Item.DueAt)</small></div>
            @if(card.Photos.Length>0) { <div class="photo-strip">@foreach(string photo in card.Photos.Take(12)) { <a href="@photo" target="_blank" rel="noopener noreferrer"><img src="@photo" alt="Фото объекта из объявления" loading="lazy" referrerpolicy="no-referrer" /></a> }</div> }
            <details><summary>Описание и продавец</summary><p class="preserve-lines">@(card.Description??"Описание не получено")</p><p>Продавец: @(card.SellerName??"Данные не получены")</p></details>
        </article>
        <article class="surface"><h2>Следующее действие</h2><div class="decision-actions">
        @if(card.CanManagerDecide) { <ActionButton Label="Наблюдать" Tone="secondary" OnClick='() => Open(ProcurementAction.Monitor,"Наблюдать")' /><ActionButton Label="Уточнить" Tone="secondary" OnClick='() => Open(ProcurementAction.Clarify,"Уточнить")' /><ActionButton Label="Отклонить" Tone="secondary" OnClick='() => Open(ProcurementAction.Reject,"Отклонить")' /><ActionButton Label="Передать руководителю" OnClick='() => Open(ProcurementAction.Forward,"Передать руководителю")' /> }
        else if(card.CanHeadDecide) { <ActionButton Label="Вернуть менеджеру" Tone="secondary" OnClick='() => Open(ProcurementAction.Return,"Вернуть менеджеру")' /><ActionButton Label="Одобрить дальнейшую работу" OnClick='() => Open(ProcurementAction.Approve,"Одобрить")' /><ActionButton Label="Наблюдать" Tone="secondary" OnClick='() => Open(ProcurementAction.Monitor,"Наблюдать")' /><ActionButton Label="Отклонить" Tone="secondary" OnClick='() => Open(ProcurementAction.Reject,"Отклонить")' /> }
        else { <p class="subtle">Решение ожидает текущего исполнителя либо уже завершено. Доступна история.</p> }</div></article>
        @if(card.CanManagerDecide || card.CanHeadDecide) { <article class="surface"><h2>Рабочая заметка / контакт</h2><EditForm Model="note" FormName="note" OnValidSubmit="SaveNoteAsync"><DataAnnotationsValidator /><ValidationSummary /><label class="field"><span>Рабочая заметка</span><textarea @bind="note.Text" @bind:event="oninput" maxlength="4000"></textarea></label><label class="check-field"><InputCheckbox @bind-Value="note.Contact" /> Это ручной контакт с продавцом</label>@if(note.Contact) { <label class="field"><span>Результат контакта</span><textarea @bind="note.Result" @bind:event="oninput"></textarea></label><label class="field"><span>Фактическое время контакта (МСК)</span><input type="datetime-local" value="@note.Effective" @oninput="e => note.Effective=e.Value?.ToString()??string.Empty" /></label> }<ActionButton Label="Сохранить заметку" Type="submit" Busy="Busy" Disabled="@(string.IsNullOrWhiteSpace(note.Text))" /></EditForm></article> }
        <article class="surface"><h2>История работы</h2><BusinessTimeline Items="card.Timeline" /></article>
        <article class="surface"><h2>Источники</h2>@if(card.Sources.Count==0) { <p class="subtle">Внешние источники не связаны. PropertyCase остаётся рабочим.</p> }@foreach(CaseSourceView source in card.Sources) { <div class="list-row"><div class="queue-meta"><SourceBadge Source="source.Source" /><strong>@source.Title</strong><small>@source.Provenance · @(source.ExternalId??"без внешнего ID")</small></div>@if(source.Url!=null) { <a href="@source.Url" target="_blank" rel="noopener noreferrer">Открыть источник ↗</a> }</div> }</article>
        @if(card.Observations.Count>0) { <article class="surface"><h2>Наблюдения автоматических источников</h2>@foreach(ObservationView observation in card.Observations) { <details class="observation"><summary>@ProcurementLabels.Time(observation.ObservedAt) · @observation.Data.Provenance · @observation.Data.AdapterVersion</summary><small>Записано @ProcurementLabels.Time(observation.RecordedAt)</small><p>Изменения: @(observation.Changes.Length==0 ? "Известные данные не изменились / старое наблюдение" : string.Join(", ",observation.Changes))</p><dl><dt>Цена</dt><dd>@observation.Data.Price.Raw · @observation.Data.Price.Parsed · @ProcurementLabels.Presence(observation.Data.Price.Presence)</dd><dt>Площадь</dt><dd>@observation.Data.AreaSquareMeters.Raw · @observation.Data.AreaSquareMeters.Parsed · @ProcurementLabels.Presence(observation.Data.AreaSquareMeters.Presence)</dd><dt>Местоположение</dt><dd>@observation.Data.Location.Raw · @ProcurementLabels.Presence(observation.Data.Location.Presence)</dd></dl>@foreach(string warning in observation.Data.Warnings) { <p class="warning-text">@warning</p> }</details> }</article> }
    </div>
    @if(dialogAction!=null) { <DecisionDialog Card="card" Action="@dialogAction.Value" Title="@dialogTitle" OnConfirm="ConfirmAsync" OnClose="CloseDialog" Busy="Busy" Error="Error" /> }
}
else { <PageState Kind="error" Title="Карточку не удалось загрузить"><ActionButton Label="Повторить" OnClick="ReloadAsync" /></PageState> }
@code {
    [Parameter] public Guid CaseId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private CaseCard? card; private Guid loaded; private ProcurementAction? dialogAction; private string dialogTitle=""; private NoteInput note=new();
    protected override async Task ReadAsync() { card=await Workspace.ReadCardAsync(CurrentSubject,CaseId,CancellationToken.None); loaded=CaseId; }
    protected override async Task OnParametersSetAsync() { if(loaded!=CaseId) await ReloadAsync(); }
    private void Open(ProcurementAction action,string title) { dialogAction=action; dialogTitle=title; }
    private void CloseDialog()=>dialogAction=null;
    private async Task ConfirmAsync(DecisionDraft draft) { await ExecuteAsync(()=>Workspace.DecideAsync(CurrentSubject,new(CaseId,card!.Item.CaseVersion,card.Item.SourceRevision,dialogAction!.Value,draft.Reason,draft.Clarification,draft.Target,ProcurementLabels.ParseLocal(draft.Due)),Guid.CreateVersion7().ToString(),CancellationToken.None)); if(Success!=null) dialogAction=null; await OnChanged.InvokeAsync(); }
    private async Task SaveNoteAsync() { await ExecuteAsync(async()=> { await Workspace.AddNoteAsync(CurrentSubject,new(CaseId,card!.Item.CaseVersion,note.Text,note.Contact,note.Result,ProcurementLabels.ParseLocal(note.Effective)),Guid.CreateVersion7().ToString(),CancellationToken.None); note=new(); }); await OnChanged.InvokeAsync(); }
    private sealed class NoteInput { [Required,MaxLength(4000)] public string Text { get; set; }=""; public bool Contact { get; set; } public string Result { get; set; }=""; public string Effective { get; set; }=""; }
}
