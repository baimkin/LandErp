@if (Success != null)
{
    <div class="v2-toast show" role="status">@Success</div>
}

@code {
    private const int PageSize = 25;
    private const int SearchDebounceMilliseconds = 400;
    private IncomingCatalogReadPage? catalogPage;
    private CatalogItemDetail? detail;
    private IncomingCatalogDetailRead? detailRead;
    private readonly FilterInput filter = new();
    private int page;
    private bool manualOpen;
    private bool historyDemoOpen;
    private bool advancedOpen;
    private bool monitoringOpen;
    private bool openNextAfterDecision = true;
    private IncomingCatalogPreset? preset;
    private IncomingCatalogSortField sortField = IncomingCatalogSortField.ChangedAt;
    private IncomingCatalogSortDirection sortDirection = IncomingCatalogSortDirection.Descending;
    private string searchGroupKey = "";
    private string searchConfigurationKey = "";
    private int searchRevision;
    private ManualInput manual = new();
    private MonitoringInput monitoring = new();
    private CatalogItemView? takeItem;
    private Guid? existingCaseId;
    private IReadOnlyList<CaseLinkTarget> targets = [];
    private bool classificationOpen;
    private CatalogDisposition classification;
    private string classificationCategory = "";
    private string classificationReason = "";
    private readonly Dictionary<string, string> checklistState = [];
    private string[] galleryPhotos = [];
    private int galleryIndex;
    private IReadOnlyList<IncomingFilterPresetView> savedPresets = [];
    private Guid? loadedPresetGroupId;
    private Guid? selectedSavedPresetId;
    private bool savePresetOpen;
    private IncomingFilterPresetView? renamePreset;
    private IncomingFilterPresetView? deletePreset;
    private string presetName = "";

    private static readonly CatalogSource[] manualSources = [CatalogSource.Telegram, CatalogSource.Referral, CatalogSource.Agent, CatalogSource.DirectOwner, CatalogSource.Manual, CatalogSource.Other];
    private static readonly ChecklistItem[] checklist =
    [
        new("price", "Цена", "Вписывается в рабочий диапазон"),
        new("area", "Площадь", "Подходит под стратегию покупки"),
        new("location", "Локация", "Район и удалённость подходят"),
        new("shape", "Пропорции участка", "Форма не выглядит проблемной"),
        new("vri", "Категория / ВРИ", "Допустимы для сценария"),
        new("access", "Подъезд / техническое состояние", "Нет очевидного стоп-фактора")
    ];

    protected override async Task ReadAsync()
    {
        Guid? groupId = SelectedSearchGroupId();
        Guid? searchId = Guid.TryParse(searchConfigurationKey, out Guid parsed) ? parsed : null;
        IncomingCatalogFilter baseFilter = new(filter.Text.Trim(), filter.Source, filter.Disposition, filter.Age,
            filter.MinPrice, filter.MaxPrice, ToSquareMeters(filter.MinAreaSotki), ToSquareMeters(filter.MaxAreaSotki),
            filter.AttentionOnly, page * PageSize, PageSize);
        catalogPage = await IncomingReads.ReadAsync(CurrentSubject,
            new(baseFilter, searchId, preset, sortField, sortDirection, groupId,
                filter.MinPricePerSotka, filter.MaxPricePerSotka, filter.LandTypes.Order().ToArray()), CancellationToken.None);
        if (groupId != loadedPresetGroupId) await ReloadSavedPresetsAsync(groupId);
    }

    private Task ApplyFilterAsync()
    {
        CancelSearchDebounce();
        selectedSavedPresetId = null;
        page = 0;
        return ReloadAsync();
    }

    private Task ResetFilterAsync()
    {
        CancelSearchDebounce();
        filter.Reset();
        searchGroupKey = "";
        searchConfigurationKey = "";
        preset = null;
        selectedSavedPresetId = null;
        savedPresets = [];
        loadedPresetGroupId = null;
        sortField = IncomingCatalogSortField.ChangedAt;
        sortDirection = IncomingCatalogSortDirection.Descending;
        page = 0;
        return ReloadAsync();
    }

    private Task PreviousAsync() { page--; return ReloadAsync(); }
    private Task NextAsync() { page++; return ReloadAsync(); }

    private Task SelectPresetAsync(IncomingCatalogPreset? value)
    {
        CancelSearchDebounce();
        preset = value;
        selectedSavedPresetId = null;
        filter.Disposition = CatalogDisposition.Incoming;
        page = 0;
        return ReloadAsync();
    }

    private Task SearchTextChanged(ChangeEventArgs args)
    {
        filter.Text = args.Value?.ToString() ?? "";
        int revision = ++searchRevision;
        _ = DebouncedSearchAsync(revision);
        return Task.CompletedTask;
    }

    private async Task DebouncedSearchAsync(int revision)
    {
        await Task.Delay(SearchDebounceMilliseconds);
        if (revision != searchRevision) return;
        page = 0;
        await InvokeAsync(ReloadAsync);
    }

    private Task ClearSearchAsync()
    {
        CancelSearchDebounce();
        filter.Text = "";
        page = 0;
        return ReloadAsync();
    }

    private Task SourceChangedAsync(ChangeEventArgs args)
    {
        CancelSearchDebounce();
        string value = args.Value?.ToString() ?? "";
        filter.Source = Enum.TryParse(value, true, out CatalogSource source) ? source : null;
        selectedSavedPresetId = null;
        page = 0;
        return ReloadAsync();
    }

    private Task SearchGroupChangedAsync(ChangeEventArgs args)
    {
        CancelSearchDebounce();
        searchGroupKey = args.Value?.ToString() ?? "";
        searchConfigurationKey = "";
        selectedSavedPresetId = null;
        loadedPresetGroupId = null;
        page = 0;
        return ReloadAsync();
    }

    private Task SearchConfigurationChangedAsync(ChangeEventArgs args)
    {
        CancelSearchDebounce();
        searchConfigurationKey = args.Value?.ToString() ?? "";
        selectedSavedPresetId = null;
        page = 0;
        return ReloadAsync();
    }

    private IEnumerable<IncomingSearchConfigurationView> VisibleSearchConfigurations()
    {
        if (catalogPage == null) return [];
        Guid? groupId = SelectedSearchGroupId();
        return groupId == null ? catalogPage.SearchConfigurations
            : catalogPage.SearchConfigurations.Where(item => item.SearchGroupId == groupId.Value);
    }

    private Task ToggleSortAsync(IncomingCatalogSortField field)
    {
        if (sortField == field)
            sortDirection = sortDirection == IncomingCatalogSortDirection.Descending
                ? IncomingCatalogSortDirection.Ascending : IncomingCatalogSortDirection.Descending;
        else
        {
            sortField = field;
            sortDirection = IncomingCatalogSortDirection.Descending;
        }
        selectedSavedPresetId = null;
        page = 0;
        return ReloadAsync();
    }

    private void ToggleLandType(IncomingLandType type)
    {
        if (!filter.LandTypes.Add(type)) filter.LandTypes.Remove(type);
        selectedSavedPresetId = null;
    }

    private string SortIndicator(IncomingCatalogSortField field) => sortField != field ? "↕"
        : sortDirection == IncomingCatalogSortDirection.Ascending ? "↑" : "↓";
    private string SortClass(IncomingCatalogSortField field) => sortField == field ? "active" : "";

    private IncomingCatalogRowRead? Row(Guid id) => catalogPage != null && catalogPage.Rows.TryGetValue(id, out IncomingCatalogRowRead? row) ? row : null;

    private async Task ReloadSavedPresetsAsync(Guid? groupId = null)
    {
        groupId ??= SelectedSearchGroupId();
        if (groupId == null)
        {
            savedPresets = [];
            loadedPresetGroupId = null;
            return;
        }
        savedPresets = await FilterPresets.ReadAsync(CurrentSubject, groupId.Value, CancellationToken.None);
        loadedPresetGroupId = groupId;
        if (selectedSavedPresetId != null && savedPresets.All(item => item.Id != selectedSavedPresetId.Value)) selectedSavedPresetId = null;
    }

    private void OpenSavePreset()
    {
        if (SelectedSearchGroupId() == null) return;
        presetName = "";
        savePresetOpen = true;
    }

    private void OpenRenamePreset(IncomingFilterPresetView value)
    {
        renamePreset = value;
        presetName = value.Name;
    }

    private async Task SavePresetAsync()
    {
        Guid? groupId = SelectedSearchGroupId();
        if (groupId == null) return;
        IncomingFilterPresetView? created = null;
        await ExecuteAsync(async () => created = await FilterPresets.CreateAsync(CurrentSubject,
            new(groupId.Value, presetName, CurrentPresetCriteria()), CancellationToken.None));
        if (created != null)
        {
            savePresetOpen = false;
            selectedSavedPresetId = created.Id;
            await ReloadSavedPresetsAsync(groupId);
        }
    }

    private async Task RenamePresetAsync()
    {
        if (renamePreset == null) return;
        Guid? groupId = SelectedSearchGroupId();
        IncomingFilterPresetView? updated = null;
        await ExecuteAsync(async () => updated = await FilterPresets.RenameAsync(CurrentSubject,
            new(renamePreset.Id, renamePreset.Version, presetName), CancellationToken.None));
        if (updated != null)
        {
            renamePreset = null;
            await ReloadSavedPresetsAsync(groupId);
        }
    }

    private async Task DeletePresetAsync()
    {
        if (deletePreset == null) return;
        Guid deletedId = deletePreset.Id;
        Guid? groupId = SelectedSearchGroupId();
        await ExecuteAsync(() => FilterPresets.DeleteAsync(CurrentSubject,
            new(deletePreset.Id, deletePreset.Version), CancellationToken.None));
        if (Success != null)
        {
            deletePreset = null;
            if (selectedSavedPresetId == deletedId) selectedSavedPresetId = null;
            await ReloadSavedPresetsAsync(groupId);
        }
    }

    private Task ApplySavedPresetAsync(IncomingFilterPresetView saved)
    {
        IncomingFilterPresetCriteriaV1 criteria = saved.Criteria;
        CancelSearchDebounce();
        preset = null;
        filter.Source = criteria.Source;
        filter.Disposition = criteria.Disposition;
        filter.Age = criteria.Age;
        filter.MinPrice = criteria.MinTotalPrice;
        filter.MaxPrice = criteria.MaxTotalPrice;
        filter.MinPricePerSotka = criteria.MinPricePerSotka;
        filter.MaxPricePerSotka = criteria.MaxPricePerSotka;
        filter.MinAreaSotki = ToSotki(criteria.MinAreaSquareMeters);
        filter.MaxAreaSotki = ToSotki(criteria.MaxAreaSquareMeters);
        filter.AttentionOnly = criteria.AttentionOnly;
        filter.LandTypes.Clear();
        foreach (IncomingLandType type in criteria.LandTypes ?? []) filter.LandTypes.Add(type);
        searchConfigurationKey = criteria.SearchConfigurationId?.ToString() ?? "";
        sortField = criteria.SortField;
        sortDirection = criteria.SortDirection;
        selectedSavedPresetId = saved.Id;
        page = 0;
        return ReloadAsync();
    }

    private IncomingFilterPresetCriteriaV1 CurrentPresetCriteria() => new(1, filter.Source,
        Guid.TryParse(searchConfigurationKey, out Guid searchId) ? searchId : null, filter.Disposition, filter.Age,
        filter.MinPrice, filter.MaxPrice, filter.MinPricePerSotka, filter.MaxPricePerSotka,
        ToSquareMeters(filter.MinAreaSotki), ToSquareMeters(filter.MaxAreaSotki), filter.LandTypes.Order().ToArray(),
        filter.AttentionOnly, sortField, sortDirection);

    private Guid? SelectedSearchGroupId() => Guid.TryParse(searchGroupKey, out Guid id) ? id : null;
    private string SelectedSearchGroupName() => catalogPage?.SearchGroups.FirstOrDefault(item => item.Id == SelectedSearchGroupId())?.Name ?? "не выбрана";
    private string SavedPresetContext() => SelectedSearchGroupId() == null ? "Выберите группу поиска" : $"Группа: {SelectedSearchGroupName()}";

    private async Task OpenDetailAsync(Guid id)
    {
        detailRead = await IncomingReads.ReadDetailAsync(CurrentSubject, id, CancellationToken.None);
        detail = detailRead.Detail;
        monitoring = new()
        {
            Total = detail.Monitoring.TargetTotalPrice,
            PerSotka = detail.Monitoring.TargetPricePerSotka,
            Reason = detail.Item.QueueReason
        };
        monitoringOpen = false;
        checklistState.Clear();
        foreach (ChecklistItem item in checklist) checklistState[item.Key] = "unknown";
    }

    private void CloseDetail() { CloseGallery(); detail = null; detailRead = null; monitoringOpen = false; }
    private void DrawerKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") CloseDetail(); }

    private async Task OpenGalleryForItemAsync(Guid id)
    {
        IncomingCatalogDetailRead read = detailRead != null && detail?.Item.Id == id
            ? detailRead : await IncomingReads.ReadDetailAsync(CurrentSubject, id, CancellationToken.None);
        OpenGallery(read.PhotoUrls);
    }

    private void OpenDetailGallery()
    {
        if (detailRead != null) OpenGallery(detailRead.PhotoUrls);
    }

    private void OpenGallery(IReadOnlyList<string> photos)
    {
        string[] usable = photos.Where(value => !string.IsNullOrWhiteSpace(value)).ToArray();
        if (usable.Length == 0) return;
        galleryPhotos = usable;
        galleryIndex = 0;
    }

    private void CloseGallery() { galleryPhotos = []; galleryIndex = 0; }
    private void PreviousPhoto() { if (galleryPhotos.Length > 0) galleryIndex = (galleryIndex - 1 + galleryPhotos.Length) % galleryPhotos.Length; }
    private void NextPhoto() { if (galleryPhotos.Length > 0) galleryIndex = (galleryIndex + 1) % galleryPhotos.Length; }
    private void GalleryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseGallery();
        else if (args.Key == "ArrowLeft") PreviousPhoto();
        else if (args.Key == "ArrowRight") NextPhoto();
    }

    private async Task CreateManualAsync()
    {
        await ExecuteAsync(() => Workspace.CreateManualAsync(CurrentSubject,
            new(manual.Source, manual.Title, manual.Location, manual.Price, manual.Area, manual.Url, manual.ExternalId, manual.CadastralNumber, manual.Description, manual.Comment),
            Guid.CreateVersion7().ToString(), CancellationToken.None));
        if (Success != null) { manualOpen = false; manual = new(); }
    }

    private async Task OpenTakeAsync(CatalogItemView item)
    {
        takeItem = item;
        existingCaseId = null;
        targets = await Workspace.ReadLinkTargetsAsync(CurrentSubject, CancellationToken.None);
    }

    private async Task TakeAsync()
    {
        TakeToWorkResult? result = null;
        await ExecuteAsync(async () => result = await Workspace.TakeToWorkAsync(CurrentSubject,
            new(takeItem!.Id, existingCaseId), Guid.CreateVersion7().ToString(), CancellationToken.None));
        if (result != null) Navigation.NavigateTo($"/procurement/{result.CaseId}");
    }

    private async Task SaveMonitoringAsync()
    {
        Guid id = detail!.Item.Id;
        int currentIndex = CurrentItemIndex(id);
        Guid? preferredNextId = NextItemId(id);
        await ExecuteAsync(() => Workspace.SetMonitoringAsync(CurrentSubject,
            new(id, detail.Item.Version, monitoring.Total, monitoring.PerSotka, monitoring.Reason), Guid.CreateVersion7().ToString(), CancellationToken.None));
        if (Success != null)
        {
            if (openNextAfterDecision) await OpenNextAfterDecisionAsync(id, currentIndex, preferredNextId);
            else await OpenDetailAsync(id);
        }
    }

    private void OpenClassification(CatalogDisposition value)
    {
        classification = value;
        classificationReason = "";
        classificationCategory = value switch
        {
            CatalogDisposition.Dismissed => "Другое",
            CatalogDisposition.Fake => "Другое",
            _ => ""
        };
        classificationOpen = true;
    }

    private async Task ClassifyAsync()
    {
        Guid id = detail!.Item.Id;
        int currentIndex = CurrentItemIndex(id);
        Guid? preferredNextId = NextItemId(id);
        string reason = BuildClassificationReason();
        await ExecuteAsync(() => Workspace.SetDispositionAsync(CurrentSubject,
            new(id, detail.Item.Version, classification, reason), Guid.CreateVersion7().ToString(), CancellationToken.None));
        if (Success != null)
        {
            classificationOpen = false;
            if (openNextAfterDecision) await OpenNextAfterDecisionAsync(id, currentIndex, preferredNextId);
            else await OpenDetailAsync(id);
        }
    }

    private async Task OpenNextAfterDecisionAsync(Guid handledId, int previousIndex, Guid? preferredNextId)
    {
        if (catalogPage == null) { CloseDetail(); return; }
        if (preferredNextId != null && catalogPage.Items.Any(item => item.Id == preferredNextId.Value))
        {
            await OpenDetailAsync(preferredNextId.Value);
            return;
        }

        bool handledStillPresent = catalogPage.Items.Any(item => item.Id == handledId);
        if (!handledStillPresent && previousIndex >= 0 && previousIndex < catalogPage.Items.Count)
        {
            await OpenDetailAsync(catalogPage.Items[previousIndex].Id);
            return;
        }
        CloseDetail();
    }

    private int CurrentItemIndex(Guid id)
    {
        if (catalogPage == null) return -1;
        for (int index = 0; index < catalogPage.Items.Count; index++)
            if (catalogPage.Items[index].Id == id) return index;
        return -1;
    }

    private Guid? NextItemId(Guid id)
    {
        int index = CurrentItemIndex(id);
        return catalogPage != null && index >= 0 && index + 1 < catalogPage.Items.Count ? catalogPage.Items[index + 1].Id : null;
    }

    private string BuildClassificationReason()
    {
        string note = classificationReason.Trim();
        if (!string.IsNullOrWhiteSpace(classificationCategory))
            return string.IsNullOrWhiteSpace(note) ? classificationCategory : $"{classificationCategory}: {note}";
        return note;
    }

    private async Task ResumeAsync()
    {
        TakeToWorkResult? result = null;
        await ExecuteAsync(async () => result = await Workspace.ResumeCaseAsync(CurrentSubject,
            new(detail!.Item.Id, detail.Item.Version), Guid.CreateVersion7().ToString(), CancellationToken.None));
        if (result != null) Navigation.NavigateTo($"/procurement/{result.CaseId}");
    }

