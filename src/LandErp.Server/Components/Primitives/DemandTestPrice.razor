@using System.Globalization
@using LandErp.Application.Modules.Overview.Contracts
@using Microsoft.EntityFrameworkCore
@inject IGroupMarketService Markets

<div class="demand-price">
    @if (editing)
    {
        <div class="demand-input">
            <NumberInput Money="true" @bind-Value="draft" aria-label="@($"{FieldLabel}, рублей за сотку")" disabled="@saving" @onkeydown="KeyDown" />
            <button type="button" disabled="@saving" @onclick="SaveAsync" title="@("Сохранить " + FieldLabel.ToLowerInvariant())" aria-label="@("Сохранить " + FieldLabel.ToLowerInvariant())">✓</button>
            <button type="button" disabled="@saving" @onclick="Cancel" title="Отмена" aria-label="Отмена">×</button>
        </div>
        <small>Пустое поле — убрать ориентир</small>
    }
    else
    {
        <span title="@FieldHint">@Money(CurrentValue)</span>
        @if (Value.CanEditDemand)
        {
            <button type="button" class="edit-demand" @onclick="Edit" title="@("Изменить " + FieldLabel.ToLowerInvariant())" aria-label="@("Изменить " + FieldLabel.ToLowerInvariant())">✎</button>
        }
    }
    @if (error != null) { <small class="demand-error" role="alert">@error</small> }
</div>

@code {
    [Parameter, EditorRequired] public GroupMarketView Value { get; set; } = default!;
    [Parameter, EditorRequired] public Subject Subject { get; set; } = default!;
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public bool PurchaseTarget { get; set; }
    private Guid groupId;
    private long version;
    private bool purchaseMode;
    private decimal? draft;
    private bool editing, saving;
    private string? error;
    private decimal? CurrentValue => PurchaseTarget ? Value.TargetPurchasePricePerSotka : Value.DemandTestPricePerSotka;
    private string FieldLabel => PurchaseTarget ? "Желаемая цена покупки" : "Ориентир теста спроса";
    private string FieldHint => PurchaseTarget
        ? "Ручной ориентир нужной цены покупки за сотку; не цена объявления и не цена сделки"
        : "Ручной ориентир теста спроса; не измеренный спрос и не цена сделки";
    public static string Money(decimal? price) => (price==null?null:NumberFormat.Money(price.Value)) + (price.HasValue ? " ₽" : "—");
    protected override void OnParametersSet()
    {
        if (groupId == Value.SearchGroupId && version == Value.Version && purchaseMode == PurchaseTarget) return;
        groupId = Value.SearchGroupId; version = Value.Version; purchaseMode = PurchaseTarget; editing = false; error = null;
    }
    private void Edit() { draft = CurrentValue; version = Value.Version; error = null; editing = true; }
    private void Cancel() { editing = false; error = null; }
    private async Task KeyDown(KeyboardEventArgs args) { if (saving) return; if (args.Key == "Escape") Cancel(); else if (args.Key == "Enter") await SaveAsync(); }
    private async Task SaveAsync()
    {
        if (saving) return;
        saving = true; error = null;
        bool committed = false;
        try
        {
            if (PurchaseTarget)
                await Markets.SaveTargetPurchaseAsync(Subject, new(Value.SearchGroupId, version, draft), Guid.NewGuid().ToString("N"), CancellationToken.None);
            else
                await Markets.SaveDemandAsync(Subject, new(Value.SearchGroupId, version, draft), Guid.NewGuid().ToString("N"), CancellationToken.None);
            committed = true; editing = false;
            await Saved.InvokeAsync();
        }
        catch (DbUpdateConcurrencyException) { error = "Цена уже изменена. Обновите экран и повторите."; }
        catch (AccessDeniedException) { error = "Недостаточно прав или группа недоступна."; }
        catch (ArgumentException exception) { error = exception.Message; }
        catch (Exception) { error = committed ? "Сохранено. Обновите экран для актуальных значений." : "Не удалось сохранить. Обновите экран перед повтором."; }
        finally { saving = false; }
    }
}
