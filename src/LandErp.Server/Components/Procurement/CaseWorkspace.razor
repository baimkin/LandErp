    private void SelectFile(InputFileChangeEventArgs args){selectedFile=args.File;if(string.IsNullOrWhiteSpace(attachment.Label))attachment.Label=Path.GetFileNameWithoutExtension(selectedFile.Name);}
    private void SelectRetryFile(InputFileChangeEventArgs args)=>retryFile=args.File;
    private static bool UploadFileTooLarge(IBrowserFile? file)=>file?.Size>FileUploadLimits.MaxRawFileBytes;
    private static async Task<byte[]> ReadUploadAsync(IBrowserFile file){FileUploadLimits.EnsureRawFileSize(file.Size);await using Stream input=file.OpenReadStream(FileUploadLimits.MaxRawFileBytes);using MemoryStream buffer=new();await input.CopyToAsync(buffer);return buffer.ToArray();}
    private static bool AttachmentCanRetry(AttachmentView item)=>item.Status is StoredFileStatus.PendingUpload or StoredFileStatus.UploadFailed;
    private AttachmentView? RetryAttachmentView()=>retryAttachmentId is Guid id?card?.Attachments.FirstOrDefault(x=>x.Id==id):null;
    private void BeginAttachmentRetry(Guid id){if(Busy)return;ClearFeedback();retryAttachmentId=id;retryFile=null;}
    private void CloseAttachmentRetry(){if(!Busy){retryAttachmentId=null;retryFile=null;}}
    private async Task RetryAttachmentAsync(){if(retryAttachmentId==null||retryFile==null)return;Guid id=retryAttachmentId.Value;IBrowserFile file=retryFile;bool committed=await ExecuteConfirmedAsync(async()=>{byte[] content=await ReadUploadAsync(file);await Workspace.RetryAttachmentAsync(CurrentSubject,new(CaseId,id,file.Name,file.ContentType,content),OperationId,CancellationToken.None);});if(committed){Success="Файл загружен повторно";CloseAttachmentRetry();}}

    private void OpenAttachment(Guid? requirementId){ClearFeedback();attachment=new(){RequirementKey=requirementId?.ToString()??""};UseDocumentRequirement();selectedFile=null;attachmentOpen=true;}
    private void OpenInspectionAttachment(string ownerKey){ClearFeedback();attachment=new(){OwnerKey=ownerKey,Kind=CaseAttachmentKind.Photo};selectedFile=null;attachmentOpen=true;}
    private void CloseAttachment(){attachmentOpen=false;attachment=new();selectedFile=null;}
    private void UseDocumentRequirement(){if(Guid.TryParse(attachment.RequirementKey,out Guid id)&&card!.DocumentRequirements.FirstOrDefault(x=>x.Id==id) is { } item){attachment.Kind=CaseAttachmentKind.Document;attachment.OwnerKey="case";if(string.IsNullOrWhiteSpace(attachment.Label))attachment.Label=item.Title;}}
    private async Task SaveAttachmentAsync()
    {
        await ExecuteAsync(async ()=>
        {
            byte[]? content=null;string name="",type="";
            if(attachment.Kind!=CaseAttachmentKind.Link)
            {
                if(selectedFile==null)throw new ArgumentException("Выберите файл.");
                content=await ReadUploadAsync(selectedFile);name=selectedFile.Name;type=selectedFile.ContentType;
            }
            ParseOwner(attachment.OwnerKey,out CaseAttachmentOwner owner,out Guid? ownerId);
            Guid? requirementId=Guid.TryParse(attachment.RequirementKey,out Guid requirement)?requirement:null;
            await Workspace.AddAttachmentAsync(CurrentSubject,new(CaseId,owner,ownerId,attachment.Kind,attachment.Label,attachment.Description,name,type,content,attachment.Kind==CaseAttachmentKind.Link?attachment.Url:null,requirementId),OperationId,CancellationToken.None);
        },"Материал добавлен");
        if(Success!=null)CloseAttachment();
    }

