<UserControl x:Class="LandErp.ParserSpike.Desktop.ListingDetailsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Выберите объявление" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="MetaText" Margin="0,3,0,8" FontSize="12.5" Foreground="#74839A" TextWrapping="Wrap"/>
            <Border x:Name="ConflictPanel" Visibility="Collapsed" Background="#FFF4D7" CornerRadius="7" Padding="9" Margin="0,0,0,8">
                <TextBlock x:Name="ConflictText" TextWrapping="Wrap"/>
            </Border>
            <TabControl BorderThickness="0" Background="Transparent">
                <TabItem Header="Карточка">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock x:Name="FactsText" LineHeight="19" TextWrapping="Wrap"/>
                        <TextBlock Text="Тип участка" FontWeight="SemiBold" Margin="0,12,0,3"/>
                        <TextBlock x:Name="DeclaredText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="InferredText" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="Описание" FontWeight="SemiBold" Margin="0,12,0,3"/>
                        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" LineHeight="19"/>
                        <TextBlock x:Name="PhotoCountText" FontWeight="SemiBold" Margin="0,12,0,5"/>
                        <Border x:Name="PhotoPanel" Visibility="Collapsed" CornerRadius="7" ClipToBounds="True" Background="#EEF2F7">
                            <Image x:Name="PhotoPreview" Height="180" Stretch="UniformToFill"/>
                        </Border>
                        <Button x:Name="OpenButton" Content="Открыть объявление" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenClick" IsEnabled="False"/>
                        <TextBlock Text="Контекст сбора" FontWeight="SemiBold" Margin="0,12,0,3"/>
                        <TextBlock x:Name="ContextText" TextWrapping="Wrap" FontSize="12.5" Foreground="#74839A"/>
                        <TextBlock Text="История наблюдений" FontWeight="SemiBold" Margin="0,12,0,3"/>
                        <TextBlock x:Name="HistoryText" TextWrapping="Wrap" FontSize="12.5" Foreground="#74839A"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Технические данные">
                    <TextBox x:Name="TechnicalText" Margin="0,8,0,0" IsReadOnly="True" BorderThickness="0"
                        Background="Transparent" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                        AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>