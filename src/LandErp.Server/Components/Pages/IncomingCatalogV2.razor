    private RenderFragment HighlightText(string? value) => builder =>
    {
        string text = value ?? "";
        string[] terms = filter.Text.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase).Take(12).ToArray();
        if (text.Length == 0 || terms.Length == 0) { builder.AddContent(0, text); return; }
        bool[] highlighted = new bool[text.Length];
        foreach (string term in terms)
        {
            int start = 0;
            while (start < text.Length)
            {
                int index = text.IndexOf(term, start, StringComparison.OrdinalIgnoreCase);
                if (index < 0) break;
                for (int offset = index; offset < Math.Min(text.Length, index + term.Length); offset++) highlighted[offset] = true;
                start = index + Math.Max(1, term.Length);
            }
        }
        int position = 0;
        while (position < text.Length)
        {
            bool mark = highlighted[position];
            int end = position + 1;
            while (end < text.Length && highlighted[end] == mark) end++;
            string fragment = text[position..end];
            if (mark)
            {
                builder.OpenElement(0, "mark");
                builder.AddAttribute(1, "class", "v2-search-hit");
                builder.AddContent(2, fragment);
                builder.CloseElement();
            }
            else builder.AddContent(3, fragment);
            position = end;
        }
    };

    private static string RowTone(IncomingCatalogRowRead? row)
    {
        if (row?.PossibleDuplicate == true) return "duplicate";
        return row?.RowState switch
    {
        IncomingCatalogRowState.Incomplete => "incomplete",
        IncomingCatalogRowState.PriceChanged => "changed",
        IncomingCatalogRowState.ReturnedFromMonitoring => "changed",
        _ => ""
        };
    }

    private string PageRangeText()
    {
        if (catalogPage == null || catalogPage.Total == 0) return "0 предложений";
        int from = page * PageSize + 1;
        int to = Math.Min((page + 1) * PageSize, catalogPage.Total);
        return $"{from}–{to} из {catalogPage.Total}";
    }

