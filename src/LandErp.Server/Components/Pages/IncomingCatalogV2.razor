    private void DrawerKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") CloseDetail(); }

    private async Task OpenGalleryForItemAsync(Guid id)
    {
        if (detailRead != null && detail?.Item.Id == id)
        {
            OpenGallery(detailRead.PhotoUrls);
            return;
        }
        if (!await RegisterViewedForUiAsync(id)) return;
        IncomingCatalogDetailRead read = await IncomingReads.ReadDetailAsync(CurrentSubject, id, CancellationToken.None);
        OpenGallery(read.PhotoUrls);
    }

    private void OpenDetailGallery()
    {
        if (detailRead != null) OpenGallery(detailRead.PhotoUrls);
    }

    private void OpenGallery(IReadOnlyList<string> photos)
    {
        string[] usable = photos.Where(value => !string.IsNullOrWhiteSpace(value)).ToArray();
        if (usable.Length == 0) return;
        galleryPhotos = usable;
        galleryIndex = 0;
    }

    private void CloseGallery() { galleryPhotos = []; galleryIndex = 0; }
    private void PreviousPhoto() { if (galleryPhotos.Length > 0) galleryIndex = (galleryIndex - 1 + galleryPhotos.Length) % galleryPhotos.Length; }
    private void NextPhoto() { if (galleryPhotos.Length > 0) galleryIndex = (galleryIndex + 1) % galleryPhotos.Length; }
    private void GalleryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseGallery();
        else if (args.Key == "ArrowLeft") PreviousPhoto();
        else if (args.Key == "ArrowRight") NextPhoto();
    }

    private async Task OpenGroupMemberAsync(Guid id)
    {
        if (detail?.Item.Id == id) return;
        await OpenDetailAsync(id);
    }

    private async Task OpenDuplicateCompareAsync(IncomingDuplicateCandidateView candidate)
    {
        duplicateCompareCandidate = candidate;
        manualDuplicateTarget = null;
        duplicateCompareError = null;
        try
        {
            duplicateCompareRead = await IncomingReads.ReadDetailAsync(
                CurrentSubject, candidate.CandidateListingId, CancellationToken.None);
        }
        catch (Exception exception)
        {
            duplicateCompareRead = null;
            duplicateCompareCandidate = null;
            duplicateCompareError = ReadFailure(exception, "Не удалось загрузить второе объявление для сравнения.");
        }
    }

    private async Task OpenManualDuplicateCompareAsync(IncomingDuplicateLinkTargetView target)
    {
        duplicateSearchOpen = false;
        duplicateCompareCandidate = null;
        manualDuplicateTarget = target;
        duplicateCompareError = null;
        try
        {
            duplicateCompareRead = await IncomingReads.ReadDetailAsync(
                CurrentSubject, target.CatalogItemId, CancellationToken.None);
        }
        catch (Exception exception)
        {
            duplicateCompareRead = null;
            manualDuplicateTarget = null;
            duplicateCompareError = ReadFailure(exception, "Не удалось загрузить второе объявление для сравнения.");
        }
    }

    private void CloseDuplicateCompare()
    {
        duplicateCompareRead = null;
        duplicateCompareError = null;
        duplicateCompareCandidate = null;
        manualDuplicateTarget = null;
    }

    private async Task RejectComparedCandidateAsync()
    {
        if (duplicateCompareCandidate == null) return;
        IncomingDuplicateCandidateView candidate = duplicateCompareCandidate;
        CloseDuplicateCompare();
        await ReviewDuplicateAsync(candidate, false);
    }

    private async Task ConfirmComparedSameObjectAsync()
    {
        if (detail == null || duplicateCompareRead == null) return;
        if (duplicateCompareCandidate != null)
        {
            IncomingDuplicateCandidateView candidate = duplicateCompareCandidate;
            CloseDuplicateCompare();
            await ReviewDuplicateAsync(candidate, true);
            return;
        }
        if (manualDuplicateTarget == null) return;

        Guid id = detail.Item.Id;
        Guid targetId = manualDuplicateTarget.CatalogItemId;
        bool saved = await ExecuteConfirmedAsync(() => Workspace.LinkCatalogItemsAsSameObjectAsync(CurrentSubject,
            new(id, detail.Item.Version, targetId, "Подтверждено менеджером после сравнения"),
            Guid.CreateVersion7().ToString(), CancellationToken.None));
        if (!saved) return;
        CloseDuplicateCompare();
        CloseDuplicateSearch();
        await LoadDetailAsync(id);
    }

    private async Task OpenDuplicateSearchAsync()
    {
        duplicateSearchOpen = true;
        duplicateSearchText = "";
        await SearchDuplicateTargetsAsync();
    }

    private void CloseDuplicateSearch()
    {
        duplicateSearchOpen = false;
        duplicateSearchText = "";
        duplicateSearchResults = [];
        duplicateSearchError = null;
    }

    private async Task SearchDuplicateTargetsAsync()
    {
        if (detail == null) return;
        duplicateSearchError = null;
        try
        {
            duplicateSearchResults = await IncomingReads.SearchDuplicateTargetsAsync(
                CurrentSubject, detail.Item.Id, duplicateSearchText, CancellationToken.None);
        }
        catch (Exception exception)
        {
            duplicateSearchResults = [];
            duplicateSearchError = ReadFailure(exception, "Не удалось найти объявления для связывания.");
        }
    }

    private void OpenUnlinkObjectGroup()
    {
        unlinkObjectGroupReason = "";
        unlinkObjectGroupOpen = true;
    }

    private void CloseUnlinkObjectGroup()
    {
        unlinkObjectGroupOpen = false;
        unlinkObjectGroupReason = "";
    }

    private async Task UnlinkObjectGroupAsync()
    {
        if(!CanProcessIncoming)throw new AccessDeniedException();
        if (detail == null) return;
        Guid id = detail.Item.Id;
        bool saved = await ExecuteConfirmedAsync(() => Workspace.UnlinkCatalogItemFromObjectGroupAsync(CurrentSubject,
            new(id, detail.Item.Version, unlinkObjectGroupReason),
            Guid.CreateVersion7().ToString(), CancellationToken.None));
        if (!saved) return;
        CloseUnlinkObjectGroup();
        await LoadDetailAsync(id);
    }

    private async Task CreateManualAsync()
    {
        if(!CanProcessIncoming)throw new AccessDeniedException();
        await ExecuteAsync(() => Workspace.CreateManualAsync(CurrentSubject,
            new(manual.Source, manual.Title, manual.Location, manual.Price, manual.Area, manual.Url, manual.ExternalId, manual.CadastralNumber, manual.Description, manual.Comment),
            Guid.CreateVersion7().ToString(), CancellationToken.None));
        if (Success != null) { manualOpen = false; manual = new(); }
    }

    private async Task OpenTransferAsync(CatalogItemView item)
    {
        if(!CanProcessIncoming)throw new AccessDeniedException();
        transferItem=item;
        procurementTargets=(await Workspace.ReadProcurementTargetsAsync(CurrentSubject,CancellationToken.None))
            .Where(target=>effectiveAccess==null||target.EmployeeId!=effectiveAccess.EmployeeId)
            .ToArray();
        transferTargetKey=procurementTargets.FirstOrDefault()?.EmployeeId.ToString()??"";
        transferOpen=true;
    }

    private void CloseTransfer(){if(Busy)return;transferOpen=false;transferItem=null;transferTargetKey="";procurementTargets=[];}

    private async Task TransferToProcurementAsync()
    {
        if(transferItem==null||!Guid.TryParse(transferTargetKey,out Guid targetId))return;
        Guid itemId=transferItem.Id;
        TakeToWorkResult? result=null;
        bool committed=await ExecuteConfirmedAsync(async()=>result=await Workspace.TransferToProcurementAsync(
            CurrentSubject,new(itemId,targetId),OperationId,CancellationToken.None));
        if(!committed)return;
        CloseTransfer();
        if(detail?.Item.Id==itemId)await RefreshDetailAsync(itemId);
        Success=result==null?"Передано в закупку":$"Передано в закупку · {result.BusinessNumber}";
    }

    private async Task OpenTakeAsync(CatalogItemView item)
    {
        if(!CanProcessIncoming||!CanManageProcurement)throw new AccessDeniedException();
        takeItem = item;
        existingCaseId = null;
        targets = await Workspace.ReadLinkTargetsAsync(CurrentSubject, CancellationToken.None);
    }

    private async Task TakeAsync()
    {
        TakeToWorkResult? result = null;
        await ExecuteAsync(async () => result = await Workspace.TakeToWorkAsync(CurrentSubject,
            new(takeItem!.Id, existingCaseId), Guid.CreateVersion7().ToString(), CancellationToken.None));
        if (result != null) Navigation.NavigateTo($"/procurement/{result.CaseId}");
    }

    private async Task ReviewDuplicateAsync(IncomingDuplicateCandidateView candidate, bool confirmed)
    {
        if(!CanProcessIncoming)throw new AccessDeniedException();
        if (detail == null) return;
        Guid id = detail.Item.Id;
        int currentIndex = CurrentItemIndex(id);
        Guid? preferredNextId = NextItemId(id);
        await ExecuteAsync(() => Workspace.ReviewDuplicateCandidateAsync(CurrentSubject,
            new(candidate.Id, candidate.Version, confirmed), Guid.CreateVersion7().ToString(), CancellationToken.None));
        if (Success == null) return;

        if (confirmed)
        {
            await RefreshDetailAsync(id);
            if (detailRead?.DuplicateCandidates is { Count: > 0 }) return;
            if (openNextAfterDecision) await OpenNextAfterDecisionAsync(id, currentIndex, preferredNextId);
            return;
        }

        bool stillPresent = catalogPage?.Items.Any(item => item.Id == id) == true;
        if (!stillPresent)
            await OpenNextAfterDecisionAsync(id, currentIndex, preferredNextId);
        else
            await RefreshDetailAsync(id);
    }

    private async Task SaveMonitoringAsync()
    {
        if(!CanProcessIncoming)throw new AccessDeniedException();
        Guid id = detail!.Item.Id;
        int currentIndex = CurrentItemIndex(id);
        Guid? preferredNextId = NextItemId(id);
        await ExecuteAsync(() => Workspace.SetMonitoringAsync(CurrentSubject,
            new(id, detail.Item.Version, monitoring.Total, monitoring.PerSotka, monitoring.Reason), Guid.CreateVersion7().ToString(), CancellationToken.None));
        if (Success != null)
        {
            if (openNextAfterDecision) await OpenNextAfterDecisionAsync(id, currentIndex, preferredNextId);
            else await RefreshDetailAsync(id);
        }
    }

    private void OpenClassification(CatalogDisposition value)
    {
        classification = value;
        classificationReason = "";
        classificationCategory = value switch
        {
            CatalogDisposition.Dismissed => "Другое",
            CatalogDisposition.Fake => "Другое",
            _ => ""
        };
        classificationOpen = true;
    }

    private async Task ClassifyAsync()
    {
        if(!CanProcessIncoming)throw new AccessDeniedException();
        Guid id = detail!.Item.Id;
        int currentIndex = CurrentItemIndex(id);
        Guid? preferredNextId = NextItemId(id);
        string reason = BuildClassificationReason();
        await ExecuteAsync(() => Workspace.SetDispositionAsync(CurrentSubject,
            new(id, detail.Item.Version, classification, reason), Guid.CreateVersion7().ToString(), CancellationToken.None));
        if (Success != null)
        {
            classificationOpen = false;
            if (openNextAfterDecision) await OpenNextAfterDecisionAsync(id, currentIndex, preferredNextId);
            else await RefreshDetailAsync(id);
        }
    }

    private async Task OpenNextAfterDecisionAsync(Guid handledId, int previousIndex, Guid? preferredNextId)
    {
        if (catalogPage == null) { CloseDetail(); return; }
        if (preferredNextId != null && catalogPage.Items.Any(item => item.Id == preferredNextId.Value))
        {
            await OpenDetailAsync(preferredNextId.Value);
            return;
        }

        bool handledStillPresent = catalogPage.Items.Any(item => item.Id == handledId);
        if (!handledStillPresent && previousIndex >= 0 && previousIndex < catalogPage.Items.Count)
        {
            await OpenDetailAsync(catalogPage.Items[previousIndex].Id);
            return;
        }
        CloseDetail();
    }

    private int CurrentItemIndex(Guid id)
    {
        if (catalogPage == null) return -1;
        for (int index = 0; index < catalogPage.Items.Count; index++)
            if (catalogPage.Items[index].Id == id) return index;
        return -1;
    }

    private Guid? NextItemId(Guid id)
    {
        int index = CurrentItemIndex(id);
        return catalogPage != null && index >= 0 && index + 1 < catalogPage.Items.Count ? catalogPage.Items[index + 1].Id : null;
    }

    private string BuildClassificationReason()
    {
        string note = classificationReason.Trim();
        if (!string.IsNullOrWhiteSpace(classificationCategory))
            return string.IsNullOrWhiteSpace(note) ? classificationCategory : $"{classificationCategory}: {note}";
        return note;
    }

