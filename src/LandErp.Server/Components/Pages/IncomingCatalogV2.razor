    private string PageRangeText()
    {
        if (catalogPage == null || catalogPage.Total == 0) return "0 предложений";
        int from = page * PageSize + 1;
        int to = Math.Min((page + 1) * PageSize, catalogPage.Total);
        return $"{from}–{to} из {catalogPage.Total}";
    }

