@using System.ComponentModel.DataAnnotations
@using LandErp.Application.Modules.Procurement.Contracts
@using LandErp.Application.Modules.Procurement.Domain
@using Microsoft.AspNetCore.Components.Forms
@inherits WorkspaceComponent
@inject IProcurementWorkspace Workspace

@if(Loading) { <PageState Kind="loading" Title="Открываем объект…" /> }
else if(Forbidden) { <PageState Kind="forbidden" Title="Нет доступа к объекту" /> }
else if(card!=null)
{
    @if(Error!=null) { <PageState Kind="error" Title="@Error"><ActionButton Label="Обновить карточку" OnClick="ReloadAsync" /></PageState> }
    @if(Success!=null) { <PageState Kind="success" Title="@Success" /> }
    <div class="stack case-workspace" data-case-version="@card.Item.CaseVersion">
        <section class="case-titlebar">
            <div><span class="kicker">@card.Item.BusinessNumber</span><h2>@card.Item.Title</h2><p>@(card.Item.Location??"Местоположение уточняется") · @(card.Item.Assignee??"Ответственный не назначен")</p></div>
            <div class="case-title-actions">@foreach(var source in card.Item.Sources) { <SourceBadge Source="source" /> }<StatusBadge Label="@ProcurementLabels.Stage(card.Item.Stage)" Tone="@(card.Item.Stage=="returned" ? "warning" : "info")" /></div>
        </section>

        <section class="case-hero">
            <article class="surface case-object-card">
                @if(card.Photos.Length>0) { <a class="case-cover" href="@card.Photos[0]" target="_blank" rel="noopener noreferrer"><img src="@card.Photos[0]" alt="Фото объекта из источника" referrerpolicy="no-referrer" /></a> }
                else { <div class="case-cover empty">Фото объекта пока нет</div> }
                <div class="case-object-facts"><h3>Рабочие факты</h3><div class="facts-grid"><div><small>Площадь</small><strong>@ProcurementLabels.Area(card.Item.Area)</strong></div><div><small>Кадастровый номер</small><strong>@Cadastral()</strong></div><div><small>Источники</small><strong>@SourceSummary()</strong></div></div>
                @if(card.Item.Changed) { <p class="case-warning">Источник изменился. Рабочие факты не перезаписаны — проверьте вкладку «Источники».</p> }</div>
            </article>
            <div class="case-side-stack">
                <article class="surface"><h3>Цена и торг</h3><div class="price-grid"><div><small>Старт / рабочая</small><strong>@ProcurementLabels.Money(card.Item.Price)</strong></div><div><small>Продавец</small><strong>@NegotiationMoney(NegotiationPriceType.SellerOffer)</strong></div><div><small>Мы</small><strong>@NegotiationMoney(NegotiationPriceType.BuyerOffer)</strong></div><div><small>Согласовано</small><strong>@NegotiationMoney(NegotiationPriceType.Agreed)</strong></div></div><p class="subtle">Согласованная цена не является фактом покупки.</p></article>
                <article class="surface"><h3>Следующее действие</h3><strong>@NextAction()</strong><p class="subtle">Срок: @ProcurementLabels.Time(card.Item.DueAt)</p></article>
            </div>
        </section>

        <nav class="case-tabs" aria-label="Разделы карточки">@foreach((string id,string label) in Tabs) { <button type="button" class="case-tab @(tab==id?"active":"")" @onclick="()=>tab=id">@label</button> }</nav>

        @if(tab=="overview")
        {
            <section class="case-dashboard"><div class="stack">
                <article class="surface"><div class="section-heading"><h3>Последние переговоры</h3><button class="btn quiet" @onclick='()=>tab="negotiations"'>Все переговоры</button></div>@if(card.Negotiations.Count==0){<p class="subtle">Контакты ещё не зафиксированы.</p>}@foreach(var item in card.Negotiations.Take(3)){<div class="dossier-row"><strong>@ProcurementLabels.Negotiation(item.PriceType) · @ProcurementLabels.Money(item.Amount)</strong><small>@item.Outcome · @ProcurementLabels.Time(item.EffectiveAt)</small></div>}</article>
                <article class="surface"><div class="section-heading"><h3>Проверки</h3><button class="btn quiet" @onclick='()=>tab="checks"'>Открыть</button></div><div class="check-summary"><div><strong>Базовые · @card.Checks.Count(x=>x.Level==CaseCheckLevel.Quick)</strong><small>@CheckSummary(CaseCheckLevel.Quick)</small></div><div><strong>Глубокие · @card.Checks.Count(x=>x.Level==CaseCheckLevel.Deep)</strong><small>@CheckSummary(CaseCheckLevel.Deep)</small></div></div>@foreach(var blocker in card.Checks.Where(x=>x.Blocker)){<p class="case-problem">@blocker.Title: @blocker.Result</p>}</article>
                <article class="surface"><h3>Осмотр</h3><p class="subtle">Результат полевого осмотра появится здесь после Phase 5. Сейчас вкладка остаётся read-only.</p></article>
            </div><div class="stack">
                <article class="surface"><h3>Документы</h3><strong>@card.Attachments.Count(x=>x.Kind==CaseAttachmentKind.Document) вложений</strong><p class="subtle">Доступ наследуется от owning PropertyCase.</p></article>
                <article class="surface"><h3>Последние события</h3><BusinessTimeline Items="card.Timeline.Take(5).ToArray()" /></article>
                <article class="surface"><h3>Следующее решение</h3><div class="decision-actions">@if(card.CanManagerDecide){<ActionButton Label="Наблюдать" Tone="secondary" OnClick='()=>Open(ProcurementAction.Monitor,"Наблюдать")' /><ActionButton Label="Уточнить" Tone="secondary" OnClick='()=>Open(ProcurementAction.Clarify,"Уточнить")' /><ActionButton Label="Отклонить" Tone="secondary" OnClick='()=>Open(ProcurementAction.Reject,"Отклонить")' /><ActionButton Label="Передать руководителю" OnClick='()=>Open(ProcurementAction.Forward,"Передать руководителю")' />}else if(card.CanHeadDecide){<ActionButton Label="Вернуть менеджеру" Tone="secondary" OnClick='()=>Open(ProcurementAction.Return,"Вернуть менеджеру")' /><ActionButton Label="Продолжить работу" OnClick='()=>Open(ProcurementAction.Approve,"Одобрить")' /><ActionButton Label="Наблюдать" Tone="secondary" OnClick='()=>Open(ProcurementAction.Monitor,"Наблюдать")' /><ActionButton Label="Отклонить" Tone="secondary" OnClick='()=>Open(ProcurementAction.Reject,"Отклонить")' />}else{<p class="subtle">Решение ожидает текущего исполнителя либо этап уже завершён.</p>}</div></article>
                @if(card.CanManagerDecide || card.CanHeadDecide){<article class="surface"><h3>Рабочая заметка</h3><EditForm Model="note" FormName="case-note" OnValidSubmit="SaveNoteAsync"><DataAnnotationsValidator /><ValidationSummary /><label class="field"><span>Комментарий</span><textarea @bind="note.Text" maxlength="4000"></textarea></label><ActionButton Label="Сохранить заметку" Type="submit" Busy="Busy" Disabled="@(string.IsNullOrWhiteSpace(note.Text))" /></EditForm></article>}
            </div></section>
        }
        else if(tab=="negotiations")
        {
            <section class="stack"><article class="surface"><div class="section-heading"><div><h3>Переговоры</h3><p class="subtle">Публичная цена, цена продавца, наше предложение и согласованная цена хранятся отдельно.</p></div></div>@if(card.Negotiations.Count==0){<PageState Kind="empty" Title="Переговоров пока нет" />}@foreach(var item in card.Negotiations){<div class="dossier-row"><div><strong>@ProcurementLabels.Negotiation(item.PriceType) · @ProcurementLabels.Money(item.Amount)</strong><small>@item.Channel · @item.Contact · @item.Author · @ProcurementLabels.Time(item.EffectiveAt)</small><p>@item.Outcome</p>@if(item.Conditions.Length>0){<p class="subtle">Условия: @item.Conditions</p>}<p class="subtle">Следующий шаг: @item.NextStep</p></div></div>}</article>
            @if(card.CanManageDossier){<article class="surface"><h3>Добавить контакт</h3><EditForm Model="negotiation" FormName="negotiation" OnValidSubmit="SaveNegotiationAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field"><span>Тип цены</span><InputSelect @bind-Value="negotiation.PriceType">@foreach(var value in Enum.GetValues<NegotiationPriceType>()){<option value="@value">@ProcurementLabels.Negotiation(value)</option>}</InputSelect></label><label class="field"><span>Цена, ₽</span><InputNumber @bind-Value="negotiation.Amount" /></label><label class="field"><span>Канал</span><input @bind="negotiation.Channel" /></label><label class="field"><span>Контакт</span><input @bind="negotiation.Contact" /></label><label class="field"><span>Результат</span><textarea @bind="negotiation.Outcome"></textarea></label><label class="field"><span>Условия</span><textarea @bind="negotiation.Conditions"></textarea></label><label class="field"><span>Следующий шаг</span><input @bind="negotiation.NextStep" /></label><label class="field"><span>Фактическое время (МСК)</span><input type="datetime-local" value="@negotiation.Effective" @oninput="e=>negotiation.Effective=e.Value?.ToString()??string.Empty" /></label><label class="field dossier-wide"><span>Комментарий</span><textarea @bind="negotiation.Comment"></textarea></label><div class="form-actions"><ActionButton Label="Добавить контакт" Type="submit" Busy="Busy" /></div></div></EditForm></article>}
            </section>
        }
        else if(tab=="checks")
        {
            <section class="stack"><div class="check-columns">@foreach(var level in Enum.GetValues<CaseCheckLevel>()){<article class="surface"><h3>@ProcurementLabels.CheckLevel(level)</h3><p class="subtle">@(level==CaseCheckLevel.Quick?"Ранний структурированный скрининг.":"Юридические и иные углублённые проверки после решения руководителя.")</p>@foreach(var item in card.Checks.Where(x=>x.Level==level)){<div class="dossier-row @(item.Blocker?"blocker":"")"><strong>@item.Title · @ProcurementLabels.CheckStatus(item.Status)</strong><small>@(item.Responsible??"Ответственный не назначен") · @ProcurementLabels.Time(item.DueAt)</small><p>@item.Result</p>@if(card.CanManageDossier){<button class="btn quiet" @onclick="()=>EditCheck(item)">Изменить</button>}</div>}@if(!card.Checks.Any(x=>x.Level==level)){<p class="subtle">Записей пока нет.</p>}</article>}</div>
            @if(card.CanManageDossier){<article class="surface"><h3>@(check.Id==null?"Добавить проверку":"Обновить проверку")</h3><EditForm Model="check" FormName="case-check" OnValidSubmit="SaveCheckAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field"><span>Уровень</span><InputSelect @bind-Value="check.Level">@foreach(var value in Enum.GetValues<CaseCheckLevel>()){<option value="@value">@ProcurementLabels.CheckLevel(value)</option>}</InputSelect></label><label class="field"><span>Статус</span><InputSelect @bind-Value="check.Status">@foreach(var value in Enum.GetValues<CaseCheckStatus>()){<option value="@value">@ProcurementLabels.CheckStatus(value)</option>}</InputSelect></label><label class="field dossier-wide"><span>Название</span><input @bind="check.Title" /></label><label class="field dossier-wide"><span>Результат / заключение</span><textarea @bind="check.Result"></textarea></label><label class="field"><span>Срок (МСК)</span><input type="datetime-local" value="@check.Due" @oninput="e=>check.Due=e.Value?.ToString()??string.Empty" /></label><label class="field"><span>Стоимость, ₽</span><InputNumber @bind-Value="check.Cost" /></label><label class="check-field dossier-wide"><InputCheckbox @bind-Value="check.Blocker" disabled="@(!card.CanManageBlockers)" /> Блокирует дальнейшее решение (только руководитель)</label><div class="form-actions"><button type="button" class="btn secondary" @onclick="ResetCheck">Очистить</button><ActionButton Label="Сохранить проверку" Type="submit" Busy="Busy" /></div></div></EditForm></article>}
            </section>
        }
        else if(tab=="inspection")
        { <article class="surface"><h3>Осмотр</h3><PageState Kind="empty" Title="Осмотр ещё не проведён"><p class="subtle">Read-only результат мобильного осмотра появится в Phase 5. Ввод и offline draft сейчас не реализуются.</p></PageState></article> }
        else if(tab=="documents")
        {
            <section class="stack"><article class="surface"><h3>Документы и вложения</h3>@if(card.Attachments.Count==0){<PageState Kind="empty" Title="Вложений пока нет" />}@foreach(var item in card.Attachments){<div class="dossier-row"><div><strong>@item.Label</strong><small>@ProcurementLabels.AttachmentKind(item.Kind) · @item.OwnerType · @ProcurementLabels.FileStatus(item.Status) · @FormatSize(item.SizeBytes)</small></div>@if(item.Status==LandErp.Application.Foundation.Files.StoredFileStatus.Available){<a class="btn secondary" href="/api/procurement/attachments/@item.Id" target="_blank" rel="noopener">Открыть ↗</a>}</div>}</article>
            @if(card.CanManageDossier){<article class="surface"><h3>Добавить вложение</h3><EditForm Model="attachment" FormName="attachment" OnValidSubmit="SaveAttachmentAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field"><span>Владелец</span><select @bind="attachment.OwnerKey"><option value="case">PropertyCase</option>@foreach(var item in card.Negotiations){<option value="n:@item.Id">Переговоры · @ProcurementLabels.Time(item.EffectiveAt)</option>}@foreach(var item in card.Checks){<option value="c:@item.Id">Проверка · @item.Title</option>}</select></label><label class="field"><span>Тип</span><InputSelect @bind-Value="attachment.Kind">@foreach(var value in Enum.GetValues<CaseAttachmentKind>()){<option value="@value">@ProcurementLabels.AttachmentKind(value)</option>}</InputSelect></label><label class="field dossier-wide"><span>Название</span><input @bind="attachment.Label" /></label>@if(attachment.Kind==CaseAttachmentKind.Link){<label class="field dossier-wide"><span>HTTPS-ссылка</span><input type="url" @bind="attachment.Url" /></label>}else{<label class="field dossier-wide"><span>Файл до 8 МБ</span><InputFile OnChange="SelectFile" accept="@ProcurementLabels.Accept(attachment.Kind)" /><small>@(selectedFile?.Name??"Файл не выбран")</small></label>}<div class="form-actions"><ActionButton Label="Добавить вложение" Type="submit" Busy="Busy" /></div></div></EditForm></article>}
            </section>
        }
        else if(tab=="history") { <article class="surface"><h3>История PropertyCase</h3><p class="subtle">Бизнес-хронология не заменяет системный аудит.</p><BusinessTimeline Items="card.Timeline" /></article> }
        else if(tab=="sources")
        {
            <section class="stack"><article class="surface"><h3>Источники</h3>@if(card.Sources.Count==0){<p class="subtle">PropertyCase существует без внешних источников.</p>}@foreach(var source in card.Sources){<div class="dossier-row"><div><SourceBadge Source="source.Source" /><strong>@source.Title</strong><small>@source.Provenance · @(source.ExternalId??"без внешнего ID") · @ProcurementLabels.Money(source.Price)</small></div>@if(source.Url!=null){<a class="btn secondary" href="@source.Url" target="_blank" rel="noopener noreferrer">Открыть источник ↗</a>}</div>}</article>
            <article class="surface"><h3>Расхождения с рабочими фактами</h3><p class="subtle">Источник никогда не перезаписывает подтверждённое значение автоматически.</p>@foreach(var item in card.Discrepancies.Where(x=>x.Different)){<div class="dossier-row"><div><strong>@ProcurementLabels.Fact(item.Field) · @item.Source</strong><small>Рабочее: @item.WorkingValue · источник: @item.SourceValue</small></div>@if(card.CanManageDossier){<button class="btn secondary" @onclick="()=>ApplyFactAsync(item)">Применить явно</button>}</div>}@if(!card.Discrepancies.Any(x=>x.Different)){<p class="subtle">Расхождений нет.</p>}</article></section>
        }
    </div>
    @if(dialogAction!=null) { <DecisionDialog Card="card" Action="@dialogAction.Value" Title="@dialogTitle" OnConfirm="ConfirmAsync" OnClose="CloseDialog" Busy="Busy" Error="Error" /> }
}
else { <PageState Kind="error" Title="Карточку не удалось загрузить"><ActionButton Label="Повторить" OnClick="ReloadAsync" /></PageState> }

@code {
    [Parameter] public Guid CaseId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private static readonly (string Id,string Label)[] Tabs=[("overview","Основное"),("negotiations","Переговоры"),("checks","Проверки"),("inspection","Осмотр"),("documents","Документы"),("history","История"),("sources","Источники")];
    private CaseCard? card; private Guid loaded; private string tab="overview"; private ProcurementAction? dialogAction; private string dialogTitle="";
    private NoteInput note=new(); private NegotiationInput negotiation=new(); private CheckInput check=new(); private AttachmentInput attachment=new(); private IBrowserFile? selectedFile;
    protected override async Task ReadAsync(){card=await Workspace.ReadCardAsync(CurrentSubject,CaseId,CancellationToken.None);loaded=CaseId;}
    protected override async Task OnParametersSetAsync(){if(loaded!=CaseId)await ReloadAsync();}
    private string Cadastral()=>card!.Discrepancies.FirstOrDefault(x=>x.Field==CaseFactField.CadastralNumber)?.WorkingValue??"Не указан";
    private string SourceSummary()=>card!.Sources.Count==0?"Нет связанных":string.Join(" + ",card.Sources.Select(x=>ProcurementLabels.Source(x.Source)).Distinct());
    private string NegotiationMoney(NegotiationPriceType type)=>ProcurementLabels.Money(card!.Negotiations.FirstOrDefault(x=>x.PriceType==type)?.Amount);
    private string CheckSummary(CaseCheckLevel level)=>card!.Checks.Any(x=>x.Level==level&&x.Blocker)?"Есть блокирующие вопросы":card.Checks.Any(x=>x.Level==level)?"Проверки зафиксированы":"Не начаты";
    private string NextAction()=>card!.Item.Stage=="pending_head"?"Решение руководителя":card.Item.Stage=="returned"?"Доработать замечания":"Продолжить работу по кейсу";
    private void Open(ProcurementAction action,string title){dialogAction=action;dialogTitle=title;} private void CloseDialog()=>dialogAction=null;
    private async Task ConfirmAsync(DecisionDraft draft){await ExecuteAsync(()=>Workspace.DecideAsync(CurrentSubject,new(CaseId,card!.Item.CaseVersion,card.Item.SourceRevision,dialogAction!.Value,draft.Reason,draft.Clarification,draft.Target,ProcurementLabels.ParseLocal(draft.Due)),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null)dialogAction=null;await OnChanged.InvokeAsync();}
    private async Task SaveNoteAsync(){await ExecuteAsync(()=>Workspace.AddNoteAsync(CurrentSubject,new(CaseId,card!.Item.CaseVersion,note.Text,false,"",null),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null)note=new();}
    private async Task SaveNegotiationAsync(){await ExecuteAsync(()=>Workspace.AddNegotiationAsync(CurrentSubject,new(CaseId,card!.Item.CaseVersion,negotiation.PriceType,negotiation.Amount,negotiation.Channel,negotiation.Contact,negotiation.Outcome,negotiation.Conditions,negotiation.Comment,negotiation.NextStep,ProcurementLabels.ParseLocal(negotiation.Effective)??DateTimeOffset.UtcNow),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null)negotiation=new();}
    private async Task SaveCheckAsync(){await ExecuteAsync(()=>Workspace.SaveCheckAsync(CurrentSubject,new(CaseId,check.Id,card!.Item.CaseVersion,check.Version,check.Level,check.Title,check.Status,null,ProcurementLabels.ParseLocal(check.Due),check.Cost,check.Result,check.Blocker),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null)check=new();}
    private void EditCheck(CheckView item)=>check=new(){Id=item.Id,Version=item.Version,Level=item.Level,Title=item.Title,Status=item.Status,Due=ProcurementLabels.LocalInput(item.DueAt),Cost=item.Cost,Result=item.Result,Blocker=item.Blocker}; private void ResetCheck()=>check=new();
    private void SelectFile(InputFileChangeEventArgs args)=>selectedFile=args.File;
    private async Task SaveAttachmentAsync(){byte[]? content=null;string name="";string type="";if(attachment.Kind!=CaseAttachmentKind.Link){if(selectedFile==null){await ExecuteAsync(()=>Task.FromException(new ArgumentException("Выберите файл.")));return;}await using Stream input=selectedFile.OpenReadStream(8*1024*1024);using MemoryStream buffer=new();await input.CopyToAsync(buffer);content=buffer.ToArray();name=selectedFile.Name;type=selectedFile.ContentType;}ParseOwner(attachment.OwnerKey,out CaseAttachmentOwner owner,out Guid? ownerId);await ExecuteAsync(()=>Workspace.AddAttachmentAsync(CurrentSubject,new(CaseId,owner,ownerId,attachment.Kind,attachment.Label,name,type,content,attachment.Kind==CaseAttachmentKind.Link?attachment.Url:null),Guid.CreateVersion7().ToString(),CancellationToken.None));if(Success!=null){attachment=new();selectedFile=null;}}
    private async Task ApplyFactAsync(SourceDiscrepancyView item)=>await ExecuteAsync(()=>Workspace.ApplySourceFactAsync(CurrentSubject,new(CaseId,item.CatalogItemId,card!.Item.CaseVersion,item.Field),Guid.CreateVersion7().ToString(),CancellationToken.None));
    private static void ParseOwner(string key,out CaseAttachmentOwner owner,out Guid? id){id=null;if(key.StartsWith("n:",StringComparison.Ordinal)&&Guid.TryParse(key[2..],out Guid n)){owner=CaseAttachmentOwner.Negotiation;id=n;}else if(key.StartsWith("c:",StringComparison.Ordinal)&&Guid.TryParse(key[2..],out Guid c)){owner=CaseAttachmentOwner.Check;id=c;}else owner=CaseAttachmentOwner.Case;}
    private static string FormatSize(long size)=>size==0?"ссылка":size<1024?$"{size} Б":$"{size/1024d:N1} КБ";
    private sealed class NoteInput{[Required,MaxLength(4000)]public string Text{get;set;}="";}
    private sealed class NegotiationInput{public NegotiationPriceType PriceType{get;set;}=NegotiationPriceType.SellerOffer;[Range(1,double.MaxValue)]public decimal Amount{get;set;}[Required]public string Channel{get;set;}="Звонок";[Required]public string Contact{get;set;}="Продавец";[Required]public string Outcome{get;set;}="";public string Conditions{get;set;}="";public string Comment{get;set;}="";[Required]public string NextStep{get;set;}="";public string Effective{get;set;}=ProcurementLabels.LocalInput(DateTimeOffset.UtcNow);}
    private sealed class CheckInput{public Guid? Id{get;set;}public long? Version{get;set;}public CaseCheckLevel Level{get;set;}public CaseCheckStatus Status{get;set;}[Required]public string Title{get;set;}="";public string Result{get;set;}="";public string Due{get;set;}="";public decimal? Cost{get;set;}public bool Blocker{get;set;}}
    private sealed class AttachmentInput{public string OwnerKey{get;set;}="case";public CaseAttachmentKind Kind{get;set;}=CaseAttachmentKind.Document;[Required]public string Label{get;set;}="";public string Url{get;set;}="";}
}
