    private string[] RightComparisonPhotos=>(duplicateCompareRead?.PhotoUrls??[]).Concat(duplicateCompareCandidate?.PhotoEvidence.Select(x=>x.RightUrl)??[]).Distinct().ToArray();
    private void SelectPhotoPair(int index){var pairs=duplicateCompareCandidate?.PhotoEvidence;if(pairs==null||pairs.Count<=index)return;evidenceIndex=index;leftComparisonPhoto=pairs[index].LeftUrl;rightComparisonPhoto=pairs[index].RightUrl;}
    private string PhotoMatchHint(bool left){var current=left?leftComparisonPhoto:rightComparisonPhoto;var other=left?RightComparisonPhotos:LeftComparisonPhotos;var pairs=duplicateCompareCandidate?.PhotoEvidence.Where(x=>(left?x.LeftUrl:x.RightUrl)==current).ToArray()??[];return pairs.Length==0?"Для этого фото совпадение не найдено":string.Join("; ",pairs.Select(x=>$"{(x.Exact?"Совпадает":"Похоже")} с фото № {Array.IndexOf(other,left?x.RightUrl:x.LeftUrl)+1} другого объявления"));}
    private Guid? takenCaseId;
    [Parameter, SupplyParameterFromQuery(Name = "participants")] public Guid? ParticipantsGroupId { get; set; }
