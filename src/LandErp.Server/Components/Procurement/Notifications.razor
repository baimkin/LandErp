@using LandErp.Application.Modules.Procurement.Contracts
@inherits WorkspaceComponent
@inject IProcurementWorkspace Workspace
<article class="surface"><h2>Уведомления</h2>
@if(Loading) { <PageState Kind="loading" Title="Загружаем уведомления…" /> }
else if(Error!=null) { <PageState Kind="error" Title="@Error" /> }
else if(items.Count==0) { <p class="subtle">Новых назначений и возвратов пока нет.</p> }
else { @foreach(var item in items) { <div class="list-row"><div><a href="@($"/procurement/listings/{item.ListingId}")">@item.Title</a><small>@ProcurementLabels.Time(item.RecordedAt)</small></div>@if(!item.Read) { <ActionButton Label="Прочитано" Tone="quiet" OnClick="() => MarkReadAsync(item.Id)" /> }</div> } }
</article>
@code {
    private IReadOnlyList<NotificationView> items=[];
    protected override async Task ReadAsync()=>items=await Workspace.ReadNotificationsAsync(CurrentSubject,CancellationToken.None);
    private Task MarkReadAsync(Guid id)=>ExecuteAsync(()=>Workspace.MarkNotificationReadAsync(CurrentSubject,id,CancellationToken.None));
}
