@using LandErp.Application.Modules.Procurement.Contracts
@using LandErp.Application.Modules.Procurement.Domain
@using LandErp.Application.Modules.IdentityAccess.Contracts
            <div class="check-columns">
                @foreach(var level in Enum.GetValues<CaseCheckLevel>())
                {
                    <article class="surface">
                        <div class="section-heading"><h3>@ProcurementLabels.CheckLevel(level)</h3>
                            @if(CanEditCheck(level)){<button class="btn quiet" disabled="@(newLevel!=null)" @onclick="()=>newLevel=level">＋ Проверка</button>}
                        </div>
                        @if(!CanEditCheck(level) && Card.CanManageDossier){<p class="subtle">@(Card.Item.Stage is "acquired" or "rejected" or "monitor" ? "Проверки доступны только для чтения в текущем состоянии объекта." : "Нет права редактировать проверки объекта.")</p>}
                        @foreach(var item in Card.Checks.Where(x=>x.Level==level))
                        {
                            <CaseCheckEntry @key="item.Id" CaseId="CaseId" Level="level" Value="item" Card="Card" Subject="Subject" CanEdit="CanEditCheck(level)" Refresh="Refresh" />
                        }
                        @if(!Card.Checks.Any(x=>x.Level==level)){<p class="subtle">Записей пока нет.</p>}
                        <CaseCheckNotes @key="(CaseId, level)" CaseId="CaseId" Section="@(level == CaseCheckLevel.Quick ? CaseNoteSection.QuickChecks : CaseNoteSection.DeepChecks)" Subject="Subject" Card="Card" Refresh="Refresh" />
                    </article>
                }
            </div>

@if(newLevel is { } newCheckLevel)
{
    <CaseModal Title="Новая проверка" OnClose="CloseNewCheck">
        <CaseCheckEntry @ref="newEntry" @key="newCheckLevel" CaseId="CaseId" Level="newCheckLevel" Card="Card" Subject="Subject" CanEdit="CanEditCheck(newCheckLevel)" Refresh="Refresh" Committed="_=>newLevel=null" Cancelled="()=>newLevel=null" />
    </CaseModal>
}

@code {
    [Parameter] public Guid CaseId { get; set; }
    [Parameter] public CaseCard Card { get; set; } = default!;
    [Parameter] public Subject Subject { get; set; } = default!;
    [Parameter] public EventCallback Refresh { get; set; }
    private CaseCheckLevel? newLevel;
    private CaseCheckEntry? newEntry;
    private Task CloseNewCheck()=>newEntry?.CancelAsync()??Task.CompletedTask;
    private bool CanEditCheck(CaseCheckLevel level) => Card.CanManageDossier && Card.Item.Stage is not ("acquired" or "rejected" or "monitor");
    private CaseRichNoteView? RichNote(CaseNoteSection section) => Card.RichNotes.SingleOrDefault(item=>item.Section==section);
}
