    private static string PriceChangeSummary(decimal previous, decimal current) =>
        $"Цена: {ProcurementLabels.Money(previous)} → {ProcurementLabels.Money(current)} · {SignedMoney(current - previous)}{PercentPart(previous, current)}";

    private static string PricePerSotkaChangeSummary(decimal previous, decimal current) =>
        $"Цена за сотку: {ProcurementLabels.Money(previous)} → {ProcurementLabels.Money(current)} · {SignedMoney(current - previous)}{PercentPart(previous, current)}";

    private static string SignedMoney(decimal value) =>
        value > 0 ? $"+{ProcurementLabels.Money(value)}"
        : value < 0 ? $"−{ProcurementLabels.Money(Math.Abs(value))}"
        : ProcurementLabels.Money(0m);

    private static string PercentPart(decimal previous, decimal current)
    {
        if (previous == 0) return "";
        decimal value = (current - previous) / previous * 100m;
        string sign = value > 0 ? "+" : value < 0 ? "−" : "";
        return $" · {sign}{Math.Abs(value).ToString("0.#", RuCulture)}%";
    }

