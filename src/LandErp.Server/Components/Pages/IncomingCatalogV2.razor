    private string BuildPresetName()
    {
        List<string> parts = [];
        if (catalogPage != null && Guid.TryParse(searchGroupKey, out Guid searchId))
        {
            IncomingSearchGroupView? search = catalogPage.SearchGroups.FirstOrDefault(item => item.Id == searchId);
            if (search != null) parts.Add(ShortPresetPart(search.Name));
        }
        if (parts.Count < 3 && filter.LandTypes.Count == 1) parts.Add(LandTypeFilterLabel(filter.LandTypes.Single()));
        if (parts.Count < 3 && (filter.MinAreaSotki != null || filter.MaxAreaSotki != null))
            parts.Add(RangePart(filter.MinAreaSotki, filter.MaxAreaSotki, " сот.", FormatPlain));
        if (parts.Count < 3 && (filter.MinPricePerSotka != null || filter.MaxPricePerSotka != null))
            parts.Add(RangePart(filter.MinPricePerSotka, filter.MaxPricePerSotka, " /сот.", FormatCompactAmount));
        if (parts.Count < 3 && (filter.MinPrice != null || filter.MaxPrice != null))
            parts.Add(RangePart(filter.MinPrice, filter.MaxPrice, " ₽", FormatCompactAmount));
        if (parts.Count < 3 && preset != null) parts.Add(PresetNamePart(preset.Value));
        if (parts.Count < 3 && filter.AttentionOnly) parts.Add("требует внимания");
        if (parts.Count < 3 && filter.Disposition is { } disposition && disposition != CatalogDisposition.Incoming)
            parts.Add(DispositionLabel(disposition));
        if (parts.Count < 3 && filter.Source != null) parts.Add(SourceBadge.Label(filter.Source.Value));
        return parts.Count == 0 ? "Сохранённый фильтр" : string.Join(" · ", parts.Take(3));
    }

    private static string ShortPresetPart(string value)
    {
        string text = value.Trim();
        return text.Length <= 34 ? text : $"{text[..33].TrimEnd()}…";
    }

    private static string RangePart(decimal? min, decimal? max, string suffix, Func<decimal, string> formatter)
    {
        if (min != null && max != null) return $"{formatter(min.Value)}–{formatter(max.Value)}{suffix}";
        if (min != null) return $"от {formatter(min.Value)}{suffix}";
        return $"до {formatter(max!.Value)}{suffix}";
    }

    private static string FormatPlain(decimal value) => value.ToString("0.#", RuCulture);
    private static string FormatCompactAmount(decimal value)
    {
        decimal absolute = Math.Abs(value);
        if (absolute >= 1_000_000m) return $"{(value / 1_000_000m).ToString("0.#", RuCulture)} млн";
        if (absolute >= 1_000m) return $"{(value / 1_000m).ToString("0.#", RuCulture)} тыс";
        return value.ToString("0.#", RuCulture);
    }

    private static string PresetNamePart(IncomingCatalogPreset value) => value switch
    {
        IncomingCatalogPreset.New => "новые",
        IncomingCatalogPreset.PriceChanged => "цена изменилась",
        IncomingCatalogPreset.PossibleDuplicate => "возможный дубль",
        IncomingCatalogPreset.Incomplete => "неполные данные",
        IncomingCatalogPreset.ProcessedToday => "обработано сегодня",
        _ => "из мониторинга"
    };

