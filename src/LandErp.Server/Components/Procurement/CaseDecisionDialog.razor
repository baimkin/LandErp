@using LandErp.Application.Modules.Procurement.Contracts
<CaseModal Error="@Error" Busy="Busy" Title="@Title" OnClose="OnClose"><p class="subtle">@Card.Item.BusinessNumber · @Card.Item.Title</p>
<EditForm Model="draft" FormName="decision" OnValidSubmit="() => OnConfirm.InvokeAsync(draft)"><DataAnnotationsValidator /><ValidationSummary />
    <label class="field"><span>Причина / результат анализа</span><textarea @bind="draft.Reason" @bind:event="oninput" maxlength="4000"></textarea></label>
    @if(Action is ProcurementAction.Return or ProcurementAction.Clarify) { <label class="field"><span>Что исправить или уточнить</span><textarea @bind="draft.Clarification" @bind:event="oninput" maxlength="4000"></textarea></label> }
    @if(Action is ProcurementAction.Forward or ProcurementAction.Return) { <label class="field"><span>@(Action==ProcurementAction.Forward ? "Руководитель закупки" : "Кому вернуть")</span><InputSelect aria-label="@(Action==ProcurementAction.Forward ? "Руководитель закупки" : "Кому вернуть")" @bind-Value="draft.Target"><option value="">Выберите сотрудника</option>@foreach(DecisionTarget target in Action==ProcurementAction.Forward ? Card.Heads : Card.Managers) { <option value="@target.EmployeeId">@target.Name</option> }</InputSelect></label> }
    <label class="field"><span>Срок (МСК), при необходимости</span><input type="datetime-local" value="@draft.Due" @oninput="e => draft.Due=e.Value?.ToString()??string.Empty" /></label>

    <div class="form-actions"><ActionButton Label="Отмена" Tone="secondary" OnClick="OnClose" /><ActionButton Label="Подтвердить решение" Type="submit" Busy="Busy" Disabled="@(string.IsNullOrWhiteSpace(draft.Reason) || (Action is ProcurementAction.Forward or ProcurementAction.Return) && draft.Target==null)" /></div>
</EditForm></CaseModal>
@code {
    [Parameter,EditorRequired] public CaseCard Card { get; set; }=default!;
    [Parameter] public ProcurementAction Action { get; set; }
    [Parameter] public string Title { get; set; }="";
    [Parameter] public EventCallback<DecisionDraft> OnConfirm { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    private DecisionDraft draft=new(); private bool initialized;
    protected override void OnParametersSet() { if(!initialized) { initialized=true; draft=new() { Target=Action==ProcurementAction.Return ? Card.ManagerEmployeeId : null }; } }
}
