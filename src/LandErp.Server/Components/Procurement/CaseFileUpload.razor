@using LandErp.Application.Foundation.Files
@using Microsoft.AspNetCore.Components.Forms

<div class="stack" aria-busy="@batch.Busy">
    @* Keep InputFile mounted: IBrowserFile streams depend on this DOM element during every retry. *@
        <label class="upload"><strong>＋ Выбрать файлы</strong><small>Галерея или файлы · до @FileUploadLimits.MaxBatchFiles файлов по @FileUploadLimits.MaxRawFileMegabytes МБ</small>
            <InputFile OnChange="SelectFiles" accept="@Accept" multiple disabled="@(Disabled||batch.Started)" />
        </label>
        @if (Camera)
        {
            <label class="upload"><strong>Снять фото / видео</strong>
                <InputFile OnChange="SelectFiles" accept="@CameraAccept" capture="environment" disabled="@(Disabled||batch.Started)" />
            </label>
        }
    @if (error != null) { <p role="alert">@error</p> }
    @if (batch.Items.Count > 0)
    {
        <ul aria-live="polite">
            @foreach (var item in batch.Items)
            {
                <li @key="item.UploadId" data-upload-state="@(item.Complete ? "complete" : item.Error != null ? "failed" : "pending")">@item.File.Name — @(item.Complete ? "Загружен" : item.TooLarge ? FileUploadLimits.TooLargeMessage : item.Error ?? (batch.Busy ? "Ожидает загрузки" : "Готов к загрузке"))</li>
            }
        </ul>
        <button type="button" class="btn primary" disabled="@(Disabled || batch.Busy || !batch.HasPending)" @onclick="UploadAsync">
            @(batch.Busy ? "Загрузка…" : batch.Started ? "Повторить незагруженные" : "Загрузить выбранные")
        </button>
        @if (batch.Started && !batch.Busy && batch.Items.All(item => item.Complete)) { <p role="status">Все файлы загружены.</p> }
    }
</div>

@code {
    [Parameter] public string Accept { get; set; } = "image/*,video/*,audio/*,.pdf";
    [Parameter] public bool Camera { get; set; }
    [Parameter] public string CameraAccept { get; set; } = "image/*,video/*";
    [Parameter] public bool Disabled { get; set; }
    [Parameter, EditorRequired] public Func<IBrowserFile, Guid, Task> OnUpload { get; set; } = default!;
    [Parameter] public EventCallback<bool> OnBusyChanged { get; set; }
    private readonly CaseUploadBatch batch = new();
    private string? error;

    private void SelectFiles(InputFileChangeEventArgs args)
    {
        error = null;
        try { batch.Select(args.GetMultipleFiles(FileUploadLimits.MaxBatchFiles)); }
        catch (InvalidOperationException) { error = $"Выберите не больше {FileUploadLimits.MaxBatchFiles} файлов за один раз."; }
    }

    private async Task UploadAsync()
    {
        if (Disabled || batch.Busy) return;
        await OnBusyChanged.InvokeAsync(true);
        try { await batch.RunAsync(item => OnUpload(item.File, item.UploadId), changed: () => InvokeAsync(StateHasChanged)); }
        finally { await OnBusyChanged.InvokeAsync(false); }
    }
}
