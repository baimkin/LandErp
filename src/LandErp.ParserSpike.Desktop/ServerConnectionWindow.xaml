<Window FontFamily="Segoe UI" FontSize="15" Foreground="#203047" Background="#F4F6FA" x:Class="LandErp.ParserSpike.Desktop.ServerConnectionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Подключение к LandErp" Width="600" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ParserTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <StackPanel Margin="24">
  <TextBlock Text="Подключение к серверу" FontSize="22" FontWeight="SemiBold"/>
  <TextBlock Text="Создайте код в LandErp в разделе парсеров и вставьте его сюда." Style="{StaticResource Hint}" Margin="0,12"/>
  <TextBlock Text="Код подключения"/>
  <PasswordBox x:Name="ConnectionCodeBox" AutomationProperties.Name="Код подключения" Padding="12" Margin="0,8"/>
  <TextBlock x:Name="SavedText" Style="{StaticResource Hint}"/>
  <TextBlock Text="Подключение сохраняется для вашего пользователя Windows. Локальные поиски и группы на сервер не отправляются." Style="{StaticResource Hint}"/>
  <TextBlock x:Name="ErrorText" Foreground="#B42318" Margin="0,12"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="CancelButton" Content="Отмена" IsCancel="True"/>
   <Button x:Name="ConnectButton" Content="Подключиться" IsDefault="True" Style="{StaticResource Primary}" Click="ConnectClick"/>
  </StackPanel>
 </StackPanel>
</Window>
