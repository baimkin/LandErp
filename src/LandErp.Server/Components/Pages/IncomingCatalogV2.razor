@page "/incoming"
@page "/incoming-v2"
@attribute [Authorize]
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using LandErp.Application.Modules.Catalog.Contracts
@using LandErp.Application.Modules.Catalog.Domain
@using LandErp.Application.Modules.IdentityAccess.Contracts
@using LandErp.Server.Components.Procurement
@inherits WorkspaceComponent
@inject ICatalogWorkspace Workspace
@inject IIncomingCatalogReadService IncomingReads
@inject IIncomingFilterPresetService FilterPresets
@inject ICatalogCalculationService Calculation
@inject IEmployeeAccessService AccessV1
@inject NavigationManager Navigation
@using LandErp.Application.Modules.Overview.Contracts
@inject IGroupMarketService Markets

<PageTitle>@(IsParticipants ? "Участники расчёта" : IsArchive ? "Архив объявлений" : "Входящие предложения") · LandErp</PageTitle>

<div class="incoming-v2">
    <div class="v2-head">
        <div>
            <div class="v2-eyebrow">Первичный отбор</div>
            <h1>@(IsParticipants ? "Участники расчёта" : IsArchive ? "Архив объявлений" : "Входящие объявления")</h1>
            <p class="v2-lead">@(IsParticipants ? "Отмеченные пригодные источники выбранной группы, включая проданные. Один подтверждённый объект — один участник." : IsArchive ? "Не подходит, подтверждённые дубли, снятые, фейки и проданные. Данные и история доступны в прежнем просмотре." : "Новые и изменившиеся предложения. Просмотрите объявление и решите, брать ли объект в работу.")</p>
        </div>
        <div class="v2-head-actions">
            @if (IsParticipants) { <a class="v2-btn" href="/">← К обзору</a><a class="v2-btn" href="/incoming">Все входящие</a> }
            else { <button type="button" class="v2-btn" disabled="@(Busy || Loading)" @onclick="() => ChangeArchiveAsync(!IsArchive)">@(IsArchive ? "← Во входящие" : "Архив")</button> }
            @* TODO-BACKEND-INCOMING: page-level decision history read model is not available. *@
            <button type="button" class="v2-btn" data-todo-backend="TODO-BACKEND-INCOMING" @onclick="() => historyDemoOpen = true">История решений</button>
            @if(CanProcessIncoming){<button type="button" class="v2-btn primary" @onclick="() => manualOpen = true">+ Добавить ссылку вручную</button>}
        </div>
    </div>

    @if (Loading)
    {
        <PageState Kind="loading" Title="Загружаем входящие…" />
    }
    else if (Forbidden)
    {
        <PageState Kind="forbidden" Title="Нет доступа ко входящим" />
    }
    else
    {
        @if (Error != null)
        {
            <PageState Kind="error" Title="@Error"><ActionButton Label="Повторить" OnClick="ReloadAsync" /></PageState>
        }

        @if (catalogPage != null)
        {
            @if (!IsArchive && !IsParticipants)
            {
            <div class="v2-presets" role="group" aria-label="Режим входящих">
                <button type="button" class="v2-preset @(incomingMode == IncomingCatalogMode.SavedFilters ? "active" : "")" aria-pressed="@(incomingMode == IncomingCatalogMode.SavedFilters ? "true" : "false")" @onclick="() => ChangeModeAsync(IncomingCatalogMode.SavedFilters)">По сохранённым фильтрам</button>
                <button type="button" class="v2-preset @(incomingMode == IncomingCatalogMode.AllListings ? "active" : "")" aria-pressed="@(incomingMode == IncomingCatalogMode.AllListings ? "true" : "false")" @onclick="() => ChangeModeAsync(IncomingCatalogMode.AllListings)">Все объявления</button>
                <button type="button" class="processed-today-link" aria-pressed="@(preset == IncomingCatalogPreset.ProcessedToday)" @onclick="() => SelectMetricAsync(IncomingCatalogPreset.ProcessedToday)">Обработано сегодня: @catalogPage.Summary.ProcessedToday</button>
            </div>
            @if (savedPresets.Any(item => item.CompatibilityIssue != null))
            {
                <div role="alert" class="subtle">
                    Рабочий отбор неполон: следующие фильтры требуют исправления и не участвуют в выдаче.
                    @foreach (var unavailable in savedPresets.Where(item => item.CompatibilityIssue != null))
                    {
                        <details><summary>@unavailable.Name — требует исправления</summary><p>@unavailable.CompatibilityIssue</p></details>
                    }
                </div>
            }
            <div class="v2-stats">
                <button type="button" class="v2-stat v2-stat-action @(preset == IncomingCatalogPreset.New ? "active" : "")" aria-pressed="@(preset == IncomingCatalogPreset.New ? "true" : "false")" @onclick="() => SelectMetricAsync(IncomingCatalogPreset.New)"><label>Новые</label><strong>@catalogPage.Summary.New</strong><span>ещё не просматривали</span></button>
                <button type="button" class="v2-stat v2-stat-action @(preset == IncomingCatalogPreset.PriceChanged ? "active" : "")" aria-pressed="@(preset == IncomingCatalogPreset.PriceChanged)" @onclick="() => SelectMetricAsync(IncomingCatalogPreset.PriceChanged)"><label>Цена изменилась</label><strong>@catalogPage.Summary.PriceChanged</strong><span>реальные изменения цены</span></button>
                <button type="button" class="v2-stat v2-stat-action warn @(preset == IncomingCatalogPreset.PossibleDuplicate ? "active" : "")" aria-pressed="@(preset == IncomingCatalogPreset.PossibleDuplicate)" @onclick="() => SelectMetricAsync(IncomingCatalogPreset.PossibleDuplicate)"><label>Возможный дубль</label><strong>@catalogPage.Summary.PossibleDuplicate</strong><span>есть совпадающие признаки</span></button>
                <button type="button" class="v2-stat v2-stat-action risk @(preset == IncomingCatalogPreset.Incomplete ? "active" : "")" aria-pressed="@(preset == IncomingCatalogPreset.Incomplete)" @onclick="() => SelectMetricAsync(IncomingCatalogPreset.Incomplete)"><label>Не хватает данных</label><strong>@catalogPage.Summary.Incomplete</strong><span>цена / площадь / локация</span></button>
                <div class="v2-stat market-stat"><GroupMarketPrices Value="groupMarket" Subject="CurrentSubject" Saved="ReloadAsync" /></div>
            </div>

            }

            @if(preset==IncomingCatalogPreset.New && incomingMode==IncomingCatalogMode.SavedFilters && selectedSavedPresetId==null){<p class="v2-lead">Непросмотренные входящие · объединение сохранённых фильтров · объявлений: @catalogPage.Total</p>}
            @if(filter.AttentionOnly && incomingMode==IncomingCatalogMode.AllListings){<p class="v2-lead">Входящие с отметкой внимания · все объявления · объявлений: @catalogPage.Total</p>}
            <section class="v2-surface">
                <EditForm Model="filter" FormName="incoming-v2-filter" OnValidSubmit="ApplyFilterAsync">
                    <div class="v2-tools">
                        <div class="v2-searchbox">
                            <span class="v2-search-icon" aria-hidden="true">⌕</span>
                            <input value="@filter.Text" @oninput="SearchTextChanged" placeholder="Адрес, населённый пункт, ID, кадастровый номер…" aria-label="Поиск по входящим" autocomplete="off" />
                            @if (!string.IsNullOrWhiteSpace(filter.Text))
                            {
                                <button type="button" class="v2-search-clear" title="Очистить поиск" aria-label="Очистить поиск" @onclick="ClearSearchAsync">×</button>
                            }
                        </div>
                        @if (!IsArchive && !IsParticipants)
                        {
                        <select value="@(filter.Source?.ToString() ?? "")" @onchange="SourceChangedAsync" aria-label="Источник">
                            <option value="">Все источники</option>
                            @foreach (CatalogSource source in Enum.GetValues<CatalogSource>())
                            {
                                <option value="@source">@SourceBadge.Label(source)</option>
                            }
                        </select>
                        }
                        <select disabled="@IsParticipants" value="@searchGroupKey" @onchange="SearchGroupChangedAsync" aria-label="Группа поиска">
                            <option value="">Все группы</option>
                            @foreach (IncomingSearchGroupView group in catalogPage.SearchGroups)
                            {
                                <option value="@group.Id">@group.Name</option>
                            }
                        </select>
                        <a class="v2-btn sm quiet" href="/collectors">Управление зонами</a>
                        @if (!IsArchive && !IsParticipants)
                        {
                        <select value="@(selectedSavedPresetId?.ToString() ?? "")" @onchange="SavedPresetChangedAsync" aria-label="Сохранённые фильтры">
                            <option value="">Все сохранённые фильтры (@catalogPage.FilterCounts?.AllPresetsCount)</option>
                            @if (savedPresets.Any(item => item.SearchGroupId == null))
                            {
                                <optgroup label="@($"Без группы ({catalogPage.FilterCounts?.UngroupedCount ?? 0})")">
                                    @foreach (IncomingFilterPresetView saved in savedPresets.Where(item => item.SearchGroupId == null))
                                    {
                                        <option value="@saved.Id">@SavedPresetLabel(saved)</option>
                                    }
                                </optgroup>
                            }
                            @foreach (IncomingSearchGroupView group in catalogPage.SearchGroups)
                            {
                                if (savedPresets.Any(item => item.SearchGroupId == group.Id))
                                {
                                    <optgroup label="@($"{group.Name} ({catalogPage.FilterCounts?.GroupCounts.GetValueOrDefault(group.Id) ?? 0})")">
                                        @foreach (IncomingFilterPresetView saved in savedPresets.Where(item => item.SearchGroupId == group.Id))
                                        {
                                            <option value="@saved.Id">@SavedPresetLabel(saved)</option>
                                        }
                                    </optgroup>
                                }
                            }
                            @if (savedPresets.Any(item => item.SearchGroupId != null && catalogPage.SearchGroups.All(group => group.Id != item.SearchGroupId)))
                            {
                                <optgroup label="Другие группы">
                                    @foreach (IncomingFilterPresetView saved in savedPresets.Where(item => item.SearchGroupId != null && catalogPage.SearchGroups.All(group => group.Id != item.SearchGroupId)))
                                    {
                                        <option value="@saved.Id">@SavedPresetLabel(saved)</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        @if(CanProcessIncoming)
                        {
                            <button class="v2-btn sm quiet" type="button" disabled="@(SelectedSavedPreset() == null)" title="Редактировать выбранный фильтр" aria-label="Редактировать выбранный фильтр" @onclick="OpenEditSelectedPreset">✎</button>
                            <button class="v2-btn sm quiet" type="button" disabled="@(SelectedSavedPreset() == null)" title="Удалить выбранный фильтр" aria-label="Удалить выбранный фильтр" @onclick="OpenDeleteSelectedPreset">×</button>
                        }
                        <button class="v2-btn sm quiet" type="button" aria-expanded="@advancedOpen" @onclick="ToggleAdvanced">Фильтры</button>
                        }
                        <button class="v2-btn sm quiet v2-reset" type="button" @onclick="ResetFilterAsync">Сбросить</button>
                    </div>

                    @if (SelectedSavedPreset() is { } selectedFilter)
                    {
                        <div class="v2-context-info">
                        <p class="subtle" role="status">Выбран общий фильтр «@selectedFilter.Name». Изменения условий применяются разово, пока вы не нажмёте «Сохранить изменения».</p>
                        @if (selectedFilter.CompatibilityIssue != null) { <p role="alert">@selectedFilter.CompatibilityIssue Фильтр не применяется; выдача пуста.</p> }

                        </div>
                    }
                    @if (advancedOpen && !IsArchive && !IsParticipants)
                    {
                        <div class="v2-advanced">
                            <label class="v2-filter-field"><span>Состояние</span><InputSelect @bind-Value="filter.Disposition"><option value="">Все состояния</option>@foreach (CatalogDisposition state in Enum.GetValues<CatalogDisposition>()) { <option value="@state">@DispositionLabel(state)</option> }</InputSelect></label>
                            <label class="v2-filter-field"><span>Возраст</span><InputSelect @bind-Value="filter.Age"><option value="Any">Любой</option><option value="Today">До суток</option><option value="ThreeDays">До 3 дней</option><option value="Week">До недели</option><option value="OlderThanWeek">Старше недели</option></InputSelect></label>
                            <label class="v2-filter-field"><span>Цена объекта от, ₽</span><NumberInput @bind-Value="filter.MinPrice"  Money="true" /></label>
                            <label class="v2-filter-field"><span>Цена объекта до, ₽</span><NumberInput @bind-Value="filter.MaxPrice"  Money="true" /></label>
                            <label class="v2-filter-field"><span>Цена за сотку от, ₽</span><NumberInput @bind-Value="filter.MinPricePerSotka"  Money="true" /></label>
                            <label class="v2-filter-field"><span>Цена за сотку до, ₽</span><NumberInput @bind-Value="filter.MaxPricePerSotka"  Money="true" /></label>
                            <label class="v2-filter-field"><span>Площадь от, сот.</span><NumberInput @bind-Value="filter.MinAreaSotki"  /></label>
                            <label class="v2-filter-field"><span>Площадь до, сот.</span><NumberInput @bind-Value="filter.MaxAreaSotki"  /></label>
                            <label class="v2-filter-field"><span>В медиане</span><select value="@(filter.IncludedInMedian?.ToString().ToLowerInvariant()??"")" @onchange="e=>filter.IncludedInMedian=bool.TryParse(e.Value?.ToString(),out var included)?included:null"><option value="">Все</option><option value="true">Учитываются</option><option value="false">Не учитываются</option></select></label>
                            <div class="attention-filter"><label class="v2-check"><InputCheckbox @bind-Value="filter.AttentionOnly" /> <span>Требует внимания</span></label><span class="attention-help" tabindex="0" aria-label="Что значит требует внимания" aria-describedby="attention-help-text">?<span id="attention-help-text" class="attention-tip" role="tooltip">Показывает объявления, требующие обработки: новые, с изменениями в источнике, вернувшиеся из мониторинга или на повторное рассмотрение. Простой просмотр не снимает отметку — нужно принять решение по объявлению. Фильтр не влияет на участие в медиане.</span></span></div>
                            <div class="v2-land-types">
                                <span class="v2-filter-caption">Тип участка <small>заявлено источником или найдено в тексте; не подтверждённый ВРИ</small></span>
                                <div class="v2-land-type-options">
                                    @foreach (IncomingLandType type in Enum.GetValues<IncomingLandType>())
                                    {
                                        <button type="button" class="v2-land-type-option @(filter.LandTypes.Contains(type) ? "active" : "")" @onclick="() => ToggleLandType(type)">@LandTypeFilterLabel(type)</button>
                                    }
                                </div>
                            </div>
                            <div class="v2-advanced-actions" style="gap:8px">
                                <button class="v2-btn sm primary" type="submit">Применить</button><button type="button" class="v2-btn sm" @onclick="ResetFilterAsync">Сбросить</button>@if(CanProcessIncoming){<button type="button" class="v2-btn sm" @onclick="()=>{OpenSavePreset();presetDialogOpen=true;}">Сохранить фильтр</button>}

                            </div>
                        </div>
                    }
                </EditForm>

                @if (IsArchive)
                {
                    <div class="v2-presets" role="group" aria-label="Состояние архива">
                        <button type="button" class="v2-preset @(archiveState == null ? "active" : "")" aria-pressed="@(archiveState == null)" @onclick="() => SelectArchiveStateAsync(null)">Все</button>
                        @foreach (var state in IncomingCatalogArchive.States)
                        {
                            <button type="button" class="v2-preset @(archiveState == state ? "active" : "")" aria-pressed="@(archiveState == state)" @onclick="() => SelectArchiveStateAsync(state)">@ArchiveLabel(state)</button>
                        }
                    </div>
                }
                else if (!IsParticipants)
                {
                <div class="v2-presets">
                    <button type="button" class="v2-preset @(preset == null ? "active" : "")" @onclick="() => SelectPresetAsync(null)">Все @catalogPage.Summary.Incoming</button>
                    <button type="button" class="v2-preset @(preset == IncomingCatalogPreset.New ? "active" : "")" @onclick="() => SelectPresetAsync(IncomingCatalogPreset.New)">Новые @catalogPage.Summary.New</button>
                    <button type="button" class="v2-preset @(preset == IncomingCatalogPreset.PriceChanged ? "active" : "")" @onclick="() => SelectPresetAsync(IncomingCatalogPreset.PriceChanged)">Изменилась цена @catalogPage.Summary.PriceChanged</button>
                    <button type="button" class="v2-preset @(preset == IncomingCatalogPreset.PossibleDuplicate ? "active" : "")" @onclick="() => SelectPresetAsync(IncomingCatalogPreset.PossibleDuplicate)">Возможный дубль @catalogPage.Summary.PossibleDuplicate</button>
                    <button type="button" class="v2-preset @(preset == IncomingCatalogPreset.Incomplete ? "active" : "")" @onclick="() => SelectPresetAsync(IncomingCatalogPreset.Incomplete)">Неполные данные @catalogPage.Summary.Incomplete</button>
                    <button type="button" class="v2-preset @(preset == IncomingCatalogPreset.ReturnedFromMonitoring ? "active" : "")" @onclick="() => SelectPresetAsync(IncomingCatalogPreset.ReturnedFromMonitoring)">Вернулись из мониторинга @catalogPage.Summary.ReturnedFromMonitoring</button>
                </div>

                }
                @if (CanManageCurrentZoneCalculation && CalculationCount > 0)
                {
                    <div class="v2-presets selection-actions" role="group" aria-label="Действия с выбранными">
                        <strong>Выбрано: @CalculationCount</strong>
                        @if (!allCalculationResults) { <button type="button" class="v2-btn sm quiet" @onclick="SelectAllCalculation">Выбрать все @catalogPage.Total результатов</button> }
                        <button class="v2-btn sm" type="button" disabled="@(Busy || calculationPreviewBusy)" @onclick="() => PreviewCalculationAsync(true)">Включить в медиану…</button>
                        <button class="v2-btn sm" type="button" disabled="@(Busy || calculationPreviewBusy)" @onclick="() => PreviewCalculationAsync(false)">@(allCalculationResults && calculationExcluded.Count==0?"Исключить найденные из расчёта…":"Исключить выбранные из расчёта…")</button>
                        <button class="v2-btn sm quiet" type="button" @onclick="ClearCalculationSelection">Снять выбор</button>
                    </div>
                }
                <div class="v2-context-info v2-result-summary">
                @if (IsParticipants)
                {
                    <p class="subtle" role="status">Группа: @catalogPage.SearchGroups.FirstOrDefault(g => g.Id == ParticipantsGroupId)?.Name · В расчёте: @catalogPage.ParticipantTotal · Найдено по поиску: @catalogPage.Total</p>
                    <p class="subtle">Исключение снимает отметку объявления во всех группах. Другой отмеченный пригодный источник того же объекта может стать представителем. Цена проданного объявления — цена источника, не подтверждённая цена сделки.</p>
                }
                else { <p class="subtle" role="status">Найдено: @catalogPage.Total</p> }
                </div>
                @if (incomingMode == IncomingCatalogMode.SavedFilters && catalogPage.FilterCounts?.ApplicableCount == 0)
                {
                    <div class="v2-empty">
                        <strong>@(savedPresets.Count == 0 ? "Создайте фильтр для рабочего отбора" : "Нет применимых фильтров для рабочего отбора")</strong>
                        <span>Рабочий режим не заменяется всей базой автоматически.</span>
                        <button type="button" class="v2-btn" @onclick="() => ChangeModeAsync(IncomingCatalogMode.AllListings)">Показать все объявления</button>
                    </div>
                }
                else if (catalogPage.Items.Count == 0)
                {
                    <div class="v2-empty"><strong>Предложений не найдено</strong><span>Измените фильтр, добавьте предложение вручную или дождитесь результата источника.</span></div>
                }
                else
                {
                    <div class="v2-table-wrap">
                        <table class="v2-table">
                            <colgroup>
                                @if (CanManageCurrentZoneCalculation) { <col class="col-select" /> }
                                <col class="col-object" /><col class="col-participation" /><col class="col-price" /><col class="col-unit-price" />
                                <col class="col-area" /><col class="col-land" /><col class="col-reason" /><col class="col-quality" /><col class="col-date" /><col class="col-source" />
                            </colgroup>
                            <thead>
                                <tr>
                                    @if (CanManageCurrentZoneCalculation) { <th class="selection-head"><label class="selection-hit"><input type="checkbox" class="page-selection" aria-label="Выбрать страницу" aria-checked="@(PageAllSelected ? "true" : PageSomeSelected ? "mixed" : "false")" data-indeterminate="@(PageSomeSelected && !PageAllSelected ? "true" : "false")" checked="@PageAllSelected" disabled="@Busy" @onchange="ToggleCalculationPage" /></label></th> }
                                    <th>Объявление</th><th>В медиане</th>
                                    <th aria-sort="@SortAria(IncomingCatalogSortField.Price)"><button type="button" class="v2-sort @SortClass(IncomingCatalogSortField.Price)" @onclick="() => ToggleSortAsync(IncomingCatalogSortField.Price)">Цена <span>@SortIndicator(IncomingCatalogSortField.Price)</span></button></th>
                                    <th aria-sort="@SortAria(IncomingCatalogSortField.PricePerSotka)"><button type="button" class="v2-sort @SortClass(IncomingCatalogSortField.PricePerSotka)" @onclick="() => ToggleSortAsync(IncomingCatalogSortField.PricePerSotka)">Цена за сотку <span>@SortIndicator(IncomingCatalogSortField.PricePerSotka)</span></button></th>
                                    <th aria-sort="@SortAria(IncomingCatalogSortField.Area)"><button type="button" class="v2-sort @SortClass(IncomingCatalogSortField.Area)" @onclick="() => ToggleSortAsync(IncomingCatalogSortField.Area)">Площадь <span>@SortIndicator(IncomingCatalogSortField.Area)</span></button></th>
                                    <th>Тип участка</th><th>Почему в очереди</th><th>Данные</th><th>Найдено</th><th>Источник</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (CatalogItemView item in catalogPage.Items)
                                {
                                    IncomingCatalogRowRead? row = Row(item.Id);
                                    int completeness = Math.Clamp(row?.CompletenessPercent ?? 0, 0, 100);
                                    <tr class="@RowTone(row) @(IsCalculationSelected(item.Id) ? "selected" : "")" @onclick="() => OpenDetailAsync(item.Id)">
                                        @if (CanManageCurrentZoneCalculation)
                                        {
                                            <td class="selection-cell" @onclick:stopPropagation="true"><label class="selection-hit"><input type="checkbox" aria-label="@($"Выбрать {item.Title}")" checked="@IsCalculationSelected(item.Id)" disabled="@Busy" @onchange="e => SelectCalculationItem(item, e.Value is true)" /></label></td>
                                        }
                                        <td>
                                            <div class="v2-object-cell">
                                                @if (!string.IsNullOrWhiteSpace(row?.ThumbnailUrl))
                                                {
                                                    <button type="button" class="v2-thumb" title="Открыть фотографии" aria-label="Открыть фотографии объявления" @onclick:stopPropagation="true" @onclick="() => OpenGalleryForItemAsync(item.Id)">
                                                        <img src="@row!.ThumbnailUrl" alt="" loading="lazy" />
                                                        @if (row!.PhotoCount > 1) { <span>@row.PhotoCount</span> }
                                                    </button>
                                                }
                                                else
                                                {
                                                    <div class="v2-thumb empty" aria-hidden="true">▧</div>
                                                }
                                                <div class="v2-object">
                                                    <strong>@HighlightText(item.Title)</strong>
                                                    <span class="v2-review-state @(row?.Reviewed == true ? "reviewed" : "new")">@(row?.Reviewed == true ? "Просмотрено" : "Новое")</span>
                                                    @if (row?.PossibleDuplicate == true) { <span class="v2-badge violet v2-duplicate-badge">Возможный дубль</span> }
                                                    @if (row?.ObjectGroupMemberCount > 1) { <span class="v2-badge violet v2-duplicate-badge">Один объект · @row!.ObjectGroupMemberCount источника</span> }
                                                    <div class="v2-sub">@HighlightText(item.Location ?? "Местоположение неизвестно") <span>·</span> @HighlightText(item.ExternalId ?? "без внешнего ID")</div>
                                                    @if (!string.IsNullOrWhiteSpace(item.CadastralNumber) || !string.IsNullOrWhiteSpace(row?.SearchConfigurationLabel) || item.BusinessNumber != null)
                                                    {
                                                        <div class="v2-sub v2-object-context">
                                                            @if (!string.IsNullOrWhiteSpace(item.CadastralNumber)) { <span>Кадастр: @HighlightText(item.CadastralNumber)</span> }
                                                            @if (!string.IsNullOrWhiteSpace(item.CadastralNumber) && (!string.IsNullOrWhiteSpace(row?.SearchConfigurationLabel) || item.BusinessNumber != null)) { <span> · </span> }
                                                            @if (!string.IsNullOrWhiteSpace(row?.SearchConfigurationLabel)) { <span>@row!.SearchConfigurationLabel</span> }
                                                            @if (!string.IsNullOrWhiteSpace(row?.SearchConfigurationLabel) && item.BusinessNumber != null) { <span> · </span> }
                                                            @if (item.BusinessNumber != null) { <a href="@($"/procurement/{item.PropertyCaseId}")" @onclick:stopPropagation="true">@item.BusinessNumber</a> }
                                                        </div>
                                                    }
                                                    @if (row?.SearchMatchedField == IncomingCatalogMatchField.SellerName && !string.IsNullOrWhiteSpace(row.SearchMatchedValue))
                                                    {
                                                        <div class="v2-search-match">Совпадение: продавец — <strong>@row.SearchMatchedValue</strong></div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td @onclick:stopPropagation="true">
                                            <button type="button" role="switch" class="median-switch" aria-checked="@(item.IncludeInCalculation ? "true" : "false")"
                                                aria-label="@($"Участие в медиане: {item.Title}")" title="@(CalculationSwitchTitle(item))"
                                                disabled="@(!CanManageCurrentZoneCalculation || Busy || (!item.IncludeInCalculation && item.CalculationIneligibility != null))"
                                                @onclick="() => ToggleCalculationAsync(item)"><span></span></button>
                                            @if (item.CalculationIneligibility != null) { <details class="median-reason"><summary>Недоступно</summary>@item.CalculationIneligibility</details> }
                                        </td>
                                        <td><div class="v2-price">@ProcurementLabels.Money(item.Price)</div></td>
                                        <td><div class="v2-price">@ProcurementLabels.Money(item.PricePerSotka)</div></td>
                                        <td><strong class="v2-area">@AreaSotki(item.AreaSquareMeters)</strong></td>
                                        <td>
                                            @if (row != null && RowLandTypes(row).Length > 0)
                                            {
                                                <div class="v2-land-type-badges">@foreach (IncomingLandType type in RowLandTypes(row)) { <span class="v2-land-type-badge">@LandTypeResultLabel(type)</span> }</div>
                                                @if (row.LandTypeConflict) { <span class="v2-badge warn" title="Заявленный тип участка расходится с текстом объявления">Расхождение</span> }
                                            }
                                            else
                                            {
                                                <span class="v2-muted">Не определён</span>
                                            }
                                        </td>
                                        <td><strong class="v2-reason">@item.QueueReason</strong><div class="v2-sub">@DispositionLabel(item.Disposition)</div></td>
                                        <td>
                                            <div class="v2-completeness">
                                                <span class="v2-badge @(completeness < 60 ? "warn" : "ok")">@completeness%</span>
                                                <span class="v2-progress" aria-hidden="true"><span style="@($"width:{completeness}%")"></span></span>
                                            </div>
                                        </td>
                                        <td>@Age(item.ReceivedAt)<div class="v2-sub">@ProcurementLabels.Time(item.LastObservedAt ?? item.ChangedAt)</div></td>
                                        <td><span class="v2-badge">@SourceBadge.Label(item.Source)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="v2-table-footer">
                    <span>@PageRangeText()</span>
                    <div><button type="button" class="v2-btn sm quiet" disabled="@(page == 0)" @onclick="PreviousAsync">Назад</button><button type="button" class="v2-btn sm quiet" disabled="@((page + 1) * PageSize >= catalogPage.Total)" @onclick="NextAsync">Далее</button></div>
                </div>
            </section>
        }
    }
</div>

@if (detail != null)
{
    <div class="v2-overlay open" @onclick="CloseDetail"></div>
    <aside class="v2-drawer open" role="dialog" aria-modal="true" aria-label="Карточка входящего предложения" tabindex="0" @onkeydown="DrawerKeyDown">
        <div class="v2-drawer-head">
            <div class="v2-drawer-main">
                <h2>@detail.Item.Title</h2>
                <div class="v2-sub">@(detail.Item.Location ?? "Местоположение неизвестно")</div>
                <div class="v2-sub">@SourceBadge.Label(detail.Item.Source) · @DispositionLabel(detail.Item.Disposition)@if (detail.Item.BusinessNumber != null) { <span> · <a href="@($"/procurement/{detail.Item.PropertyCaseId}")">@detail.Item.BusinessNumber</a></span> }</div>
            </div>
            @if (detail.Item.Url != null) { <a class="v2-btn sm" href="@detail.Item.Url" target="_blank" rel="noopener noreferrer">Открыть источник ↗</a> }
            <button type="button" class="v2-btn sm" aria-label="Закрыть" @onclick="CloseDetail">×</button>
        </div>

        <div class="v2-drawer-body">
            <section class="v2-card v2-hero">
                @if (detailRead?.PhotoUrls.Count > 0)
                {
                    <button type="button" class="v2-photo" title="Открыть галерею" @onclick="OpenDetailGallery">
                        <img src="@detailRead.PhotoUrls[0]" alt="Фото объекта" />
                        @if (detailRead.PhotoUrls.Count > 1) { <span class="v2-photo-count">1 / @detailRead.PhotoUrls.Count</span> }
                    </button>
                }
                else
                {
                    <div class="v2-photo"><span>Фото отсутствует</span></div>
                }
                <div class="v2-facts">
                    <div class="v2-fact full"><label>Цена</label><strong>@ProcurementLabels.Money(detail.Item.Price)</strong></div>
                    <div class="v2-fact"><label>Площадь</label><strong>@AreaSotki(detail.Item.AreaSquareMeters)</strong></div>
                    <div class="v2-fact"><label>₽ / сот.</label><strong>@ProcurementLabels.Money(detail.Item.PricePerSotka)</strong></div>
                    <div class="v2-fact"><label>Кадастровый номер</label><strong>@(detail.Item.CadastralNumber ?? "Не указан")</strong></div>
                    <div class="v2-fact"><label>Получено</label><strong>@ProcurementLabels.Time(detail.Item.ReceivedAt)</strong></div>
                    <div class="v2-fact"><label>Опубликовано источником</label><strong>@(detailRead?.SourcePublishedAt is { } published ? ProcurementLabels.Time(published) : "Не указано")</strong></div>
                    <div class="v2-fact"><label>Координаты WGS84</label><strong>@CoordinatesText(detailRead?.Latitude, detailRead?.Longitude)</strong></div>
                    <div class="v2-fact full v2-land-type-fact"><label>Заявлено источником <span>не юридически подтверждённый ВРИ</span></label>
                        @if (detailRead?.DeclaredLandTypes is { Length: > 0 } declaredLandTypes)
                        {
                            <div class="v2-land-type-badges">@foreach (IncomingLandType type in declaredLandTypes) { <span class="v2-land-type-badge">@LandTypeResultLabel(type)</span> }</div>
                        }
                        else
                        {
                            <strong>Нет структурированных данных</strong>
                        }
                    </div>
                    <div class="v2-fact full v2-land-type-fact"><label>Найдено в тексте объявления</label>
                        @if (detailRead is { LandTypes.Length: > 0 })
                        {
                            <div class="v2-land-type-badges">@foreach (IncomingLandType type in detailRead.LandTypes) { <span class="v2-land-type-badge">@LandTypeResultLabel(type)</span> }</div>
                        }
                        else
                        {
                            <strong>Не определено</strong>
                        }
                        @if (detailRead?.LandTypeConflict == true)
                        {
                            <span class="v2-badge warn">Есть расхождение между заявленным типом и текстом</span>
                        }
                    </div>
                    <div class="v2-fact full"><label>Поиск</label><strong>@(detailRead?.SearchConfigurationLabel ?? "Не из поисковой конфигурации")</strong></div>
                </div>
            </section>

            @if (detailRead?.Contacts is { Count: > 0 } contacts)
            {
                <section class="v2-card">
                    <h3>Контакты продавца</h3>
                    <div class="v2-facts">
                        @foreach (IncomingListingContactView contact in contacts)
                        {
                            <div class="v2-fact">
                                <label>@ContactTypeLabel(contact.Type) @if (contact.IsPrimary) { <span>· основной</span> }</label>
                                <strong>@contact.DisplayValue</strong>
                                <span class="v2-sub">Последний раз найден: @ProcurementLabels.Time(contact.LastObservedAt)</span>
                            </div>
                        }
                    </div>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(detail.Item.Description) || !string.IsNullOrWhiteSpace(detail.IngressComment))
            {
                <section class="v2-card v2-description-card">
                    <h3>Описание объявления</h3>
                    @if (!string.IsNullOrWhiteSpace(detail.Item.Description)) { <p class="v2-description">@detail.Item.Description</p> }
                    @if (!string.IsNullOrWhiteSpace(detail.IngressComment))
                    {
                        <div class="v2-ingress-comment"><strong>Комментарий при добавлении</strong><span>@detail.IngressComment</span></div>
                    }
                    <p class="v2-provenance">@detail.Item.Provenance</p>
                </section>
            }

            @if (detailRead?.ObjectGroup is { } objectGroup)
            {
                <section class="v2-card v2-object-group-card">
                    <div class="v2-object-group-head">
                        <div>
                            <h3>Один физический объект</h3>
                            <p class="v2-provenance">@objectGroup.MemberCount связанных источника. Главного объявления в группе нет.</p>
                        </div>
                        <span class="v2-badge violet">@objectGroup.MemberCount источника</span>
                    </div>
                    <div class="v2-object-group-members">
                        @foreach (IncomingObjectGroupMemberView member in objectGroup.Members)
                        {
                            bool current = member.CatalogItemId == detail.Item.Id;
                            <div class="v2-object-group-member @(current ? "current" : "")">
                                <button type="button" class="v2-object-group-open" disabled="@current" @onclick="() => OpenGroupMemberAsync(member.CatalogItemId)">
                                    <strong>@SourceBadge.Label(member.Source) · @member.Title</strong>
                                    <span>@(member.Location ?? "Локация не указана") · @ProcurementLabels.Money(member.Price) · @AreaSotki(member.AreaSquareMeters)</span>
                                    @if (member.BusinessNumber != null) { <span>Связан с @member.BusinessNumber</span> }
                                </button>
                                @if (current) { <span class="v2-badge">Открыто</span> }
                                @if (member.Url != null) { <a href="@member.Url" target="_blank" rel="noopener noreferrer">Источник ↗</a> }
                            </div>
                        }
                    </div>
                    <div class="v2-object-group-actions">
                        <button type="button" class="v2-btn sm danger-text" disabled="@(!CanProcessIncoming || Busy)" @onclick="OpenUnlinkObjectGroup">
                            Исключить открытое объявление из группы
                        </button>
                    </div>
                </section>
            }

            @if (detailRead?.DuplicateCandidates is { Count: > 0 } duplicateCandidates)
            {
                <section class="v2-card v2-duplicate-card">
                    <h3>Возможные совпадения</h3>
                    <p class="v2-provenance">Система нашла похожие объявления. Перед связыванием можно сравнить исходные данные рядом.</p>
                    @foreach (IncomingDuplicateCandidateView candidate in duplicateCandidates)
                    {
                        <article class="v2-duplicate-candidate">
                            <div class="v2-duplicate-candidate-head">
                                <div>
                                    <strong>@candidate.Title</strong>
                                    <span>@SourceBadge.Label(candidate.Source) · @(candidate.Location ?? "Локация не указана") · совпадение @candidate.Score/100</span>
                                </div>
                                @if (candidate.Url != null) { <a href="@candidate.Url" target="_blank" rel="noopener noreferrer">Источник ↗</a> }
                            </div>
                            <div class="v2-duplicate-facts">
                                <span>@ProcurementLabels.Money(candidate.Price)</span>
                                <span>@AreaSotki(candidate.AreaSquareMeters)</span>
                                @if (candidate.CadastralNumber != null) { <span>@candidate.CadastralNumber</span> }
                            </div>
                            @if (candidate.Reasons.Count > 0)
                            {
                                <ul class="v2-duplicate-reasons">@foreach (string reason in candidate.Reasons) { <li>@reason</li> }</ul>
                            }
                            <div class="v2-duplicate-actions">
                                <button type="button" class="v2-btn sm" disabled="@(!CanProcessIncoming || Busy)" @onclick="() => ReviewDuplicateAsync(candidate, false)">Не дубль</button>
                                <button type="button" class="v2-btn sm duplicate" disabled="@(!CanProcessIncoming || Busy)" @onclick="() => OpenDuplicateCompareAsync(candidate)">Сравнить и решить</button>
                            </div>
                        </article>
                    }
                </section>
            }

            @* TODO-BACKEND-INCOMING: short checklist has no persistence contract. State below is local to this drawer only. *@
            <section class="v2-card" data-todo-backend="TODO-BACKEND-INCOMING">
                <h3>Первичный чек-лист</h3>
                @foreach (ChecklistItem item in checklist)
                {
                    <div class="v2-checkrow">
                        <div><strong>@item.Title</strong><span>@item.Description</span></div>
                        <div class="v2-segmented">
                            <button type="button" class="@(CheckClass(item.Key, "ok"))" disabled="@(!CanProcessIncoming)" @onclick="() => SetCheckOk(item.Key)">✓ Подходит</button>
                            <button type="button" class="@(CheckClass(item.Key, "issue"))" disabled="@(!CanProcessIncoming)" @onclick="() => SetCheckIssue(item.Key)">! Проблема</button>
                            <button type="button" class="@(CheckClass(item.Key, "unknown"))" disabled="@(!CanProcessIncoming)" @onclick="() => SetCheckUnknown(item.Key)">? Не проверено</button>
                        </div>
                    </div>
                }
            </section>

            <section class="v2-card v2-history">
                <h3>История изменений и решений</h3>
                @if (detail.Events.Count == 0)
                {
                    <p class="v2-provenance">Событий пока нет.</p>
                }
                else
                {
                    <CaseActivityFeed Items="@detail.Events.Select(item => CaseFeedFormat.From(item, EventLabel(item.Kind))).ToArray()" />
                }
            </section>

            @if(CanProcessIncoming)
            {
                <label class="v2-next-option">
                    <input type="checkbox" @bind="openNextAfterDecision" />
                    <span><strong>После отклонения или решения о дубле открыть следующее</strong><small>Ускоряет последовательный разбор входящих.</small></span>
                </label>
            }
        </div>

        <div class="v2-monitor-shell">
            @if(CanProcessIncoming)
            {
                <button type="button" class="v2-monitor-toggle" aria-expanded="@monitoringOpen" @onclick="() => monitoringOpen = !monitoringOpen">
                    <span><strong>Мониторинг цены</strong><small>@MonitoringSummary()</small></span>
                    <span class="v2-monitor-chevron">@(monitoringOpen ? "⌃" : "⌄")</span>
                </button>
                @if (monitoringOpen)
                {
                    <EditForm Model="monitoring" FormName="incoming-v2-monitor" OnValidSubmit="SaveMonitoringAsync">
                        <DataAnnotationsValidator />
                        <div class="v2-monitor">
                            <div class="v2-monitor-grid">
                                <div><label>Цена объявления ≤</label><div class="v2-money"><NumberInput @bind-Value="monitoring.Total"  Money="true" /><span>₽</span></div></div>
                                <div class="v2-or">или</div>
                                <div><label>Цена за сотку ≤</label><div class="v2-money"><NumberInput @bind-Value="monitoring.PerSotka"  Money="true" /><span>₽</span></div></div>
                                <button type="submit" class="v2-btn" disabled="@Busy">Поставить на мониторинг</button>
                            </div>
                            <div class="v2-monitor-reason"><label>Комментарий к мониторингу</label><InputText @bind-Value="monitoring.Reason" /></div>
                            <ValidationSummary />
                            @if (detail.Monitoring.LastEvaluatedAt != null) { <div class="v2-monitor-last">Последняя оценка @ProcurementLabels.Time(detail.Monitoring.LastEvaluatedAt): @ProcurementLabels.Money(detail.Monitoring.LastEvaluatedPrice) · @ProcurementLabels.Money(detail.Monitoring.LastEvaluatedPricePerSotka) / сот.</div> }
                        </div>
                    </EditForm>
                }
            }
            else
            {
                <div class="v2-monitor-toggle"><span><strong>Мониторинг цены</strong><small>@MonitoringSummary() · только просмотр</small></span></div>
            }
        </div>

        <div class="v2-drawer-foot">
            @if(CanProcessIncoming)
            {
                <div class="v2-classify">

                    <button type="button" class="v2-btn danger-text" disabled="@Busy" @onclick="() => OpenClassification(CatalogDisposition.Fake)">Фейк</button>
                    <button type="button" class="v2-btn" disabled="@Busy" @onclick="() => OpenClassification(CatalogDisposition.RemovedAtSource)">Снято</button>
                    <button type="button" class="v2-btn sold" disabled="@Busy" @onclick="() => OpenClassification(CatalogDisposition.Sold)">Продано</button>
                </div>
            }
            <div class="v2-take-actions">@if(CanProcessIncoming){<button type="button" class="v2-btn danger" disabled="@Busy" @onclick="() => OpenClassification(CatalogDisposition.Dismissed)">Не подходит</button>}
            @if(detail.Item.PropertyCaseId != null)
            {
                <span class="subtle">Объявление уже связано с объектом закупки.</span>
            }
            else if(CanProcessIncoming && CanManageProcurement)
            {
                <button type="button" class="v2-btn primary" disabled="@Busy" @onclick="() => OpenTakeAsync(detail.Item)">Взять в работу</button>
            }
            else
            {
                <span class="subtle">Нет права взять объявление в работу.</span>
            }
            </div>
        </div>
    </aside>
}

@if (galleryPhotos.Length > 0)
{
    <div class="v2-gallery-overlay" role="dialog" aria-modal="true" aria-label="Галерея фотографий" tabindex="0" @onclick="CloseGallery" @onkeydown="GalleryKeyDown">
        <div class="v2-gallery-shell" @onclick:stopPropagation="true">
            <button type="button" class="v2-gallery-close" aria-label="Закрыть галерею" title="Закрыть" @onclick="CloseGallery">×</button>
            @if (galleryPhotos.Length > 1)
            {
                <button type="button" class="v2-gallery-nav prev" aria-label="Предыдущее фото" @onclick="PreviousPhoto">‹</button>
                <button type="button" class="v2-gallery-nav next" aria-label="Следующее фото" @onclick="NextPhoto">›</button>
            }
            <img class="v2-gallery-main" src="@galleryPhotos[galleryIndex]" alt="Фото объекта @(galleryIndex + 1)" />
            <div class="v2-gallery-count">@(galleryIndex + 1) / @galleryPhotos.Length</div>
            @if (galleryPhotos.Length > 1)
            {
                <div class="v2-gallery-thumbs">
                    @for (int index = 0; index < galleryPhotos.Length; index++)
                    {
                        int photoIndex = index;
                        <button type="button" class="@(photoIndex == galleryIndex ? "active" : "")" @onclick="() => galleryIndex = photoIndex"><img src="@galleryPhotos[photoIndex]" alt="" loading="lazy" /></button>
                    }
                </div>
            }
        </div>
    </div>
}

@if ((duplicateCompareRead != null || duplicateCompareError != null) && detailRead != null && detail != null)
{
    <Modal Title="Сравнение объявлений" Kind="compare" OnClose="CloseDuplicateCompare">
        @if (duplicateCompareError != null)
        {
            <p class="v2-search-error">@duplicateCompareError</p>
            <div class="form-actions">
                <ActionButton Label="Закрыть" Tone="quiet" OnClick="CloseDuplicateCompare" />
            </div>
        }
        else if (duplicateCompareRead != null)
        {
            @if (duplicateCompareRead.ObjectGroup is { MemberCount: > 1 } targetGroup)
            {
                <div class="v2-compare-group-note">
                    Кандидат уже входит в группу одного объекта из <strong>@targetGroup.MemberCount</strong> источников.
                    Подтверждение добавит текущее объявление в эту группу.
                </div>
            }
            <div class="v2-compare-grid">
                <section class="v2-compare-column">
                    <div class="v2-compare-label">Текущее объявление</div>
                    <PhotoGallery @key="detail.Item.Id" Urls="LeftComparisonPhotos" InitialUrl="@leftComparisonPhoto" Changed="url=>leftComparisonPhoto=url" />
                    <p class="comparison-photo-hint">@PhotoMatchHint(true)</p><h3>@detail.Item.Title</h3>
                    <div class="v2-compare-facts">
                        <span><small>Источник</small><strong>@SourceBadge.Label(detail.Item.Source)</strong></span>
                        <span><small>Цена</small><strong>@ProcurementLabels.Money(detail.Item.Price)</strong></span>
                        <span><small>₽ / сот.</small><strong>@(detail.Item.PricePerSotka == null ? "—" : ProcurementLabels.Money(detail.Item.PricePerSotka) + " / сот.")</strong></span>
                        <span><small>Площадь</small><strong>@AreaSotki(detail.Item.AreaSquareMeters)</strong></span>
                        <span><small>Кадастр</small><strong>@(detail.Item.CadastralNumber ?? "—")</strong></span>
                        <span><small>Продавец</small><strong>@(detail.SellerName ?? "—")</strong></span>
                        <span class="wide"><small>Локация</small><strong>@(detail.Item.Location ?? "—")</strong></span>
                    </div>
                    <div class="v2-compare-description"><small>Описание</small><p>@(detail.Item.Description ?? "Описание отсутствует")</p></div>
                </section>
                <section class="v2-compare-column">
                    <div class="v2-compare-label">Сравниваемое объявление</div>
                    <PhotoGallery @key="duplicateCompareRead.Detail.Item.Id" Urls="RightComparisonPhotos" InitialUrl="@rightComparisonPhoto" Changed="url=>rightComparisonPhoto=url" />
                    <p class="comparison-photo-hint">@PhotoMatchHint(false)</p><h3>@duplicateCompareRead.Detail.Item.Title</h3>
                    <div class="v2-compare-facts">
                        <span><small>Источник</small><strong>@SourceBadge.Label(duplicateCompareRead.Detail.Item.Source)</strong></span>
                        <span><small>Цена</small><strong>@ProcurementLabels.Money(duplicateCompareRead.Detail.Item.Price)</strong></span>
                        <span><small>₽ / сот.</small><strong>@(duplicateCompareRead.Detail.Item.PricePerSotka == null ? "—" : ProcurementLabels.Money(duplicateCompareRead.Detail.Item.PricePerSotka) + " / сот.")</strong></span>
                        <span><small>Площадь</small><strong>@AreaSotki(duplicateCompareRead.Detail.Item.AreaSquareMeters)</strong></span>
                        <span><small>Кадастр</small><strong>@(duplicateCompareRead.Detail.Item.CadastralNumber ?? "—")</strong></span>
                        <span><small>Продавец</small><strong>@(duplicateCompareRead.Detail.SellerName ?? "—")</strong></span>
                        <span class="wide"><small>Локация</small><strong>@(duplicateCompareRead.Detail.Item.Location ?? "—")</strong></span>
                    </div>
