@page "/employees"
@attribute [Authorize(Policy = "users.read")]
@inherits WorkspaceComponent
@inject IOrganizationWorkspace Workspace
<PageTitle>Сотрудники · LandErp</PageTitle>
<PageHeader Title="Сотрудники" Breadcrumb="Команда / Сотрудники" Description="Назначения, руководитель и область доступа к рабочим данным." />
@if (Loading) { <PageState Kind="loading" Title="Загружаем сотрудников…" /> }
else if (Forbidden) { <PageState Kind="forbidden" Title="Нет доступа к данным команды" /> }
else
{
    @if (Error != null) { <PageState Kind="error" Title="@Error"><ActionButton Label="Повторить" OnClick="ReloadAsync" /></PageState> }
    @if (Success != null) { <PageState Kind="success" Title="@Success" /> }
    @if (invitation != null)
    {
        <article class="surface"><h2>Приглашение создано</h2><p>Передайте сотруднику ID и одноразовый код безопасным способом. Код показан только в текущем сеансе и действует 48 часов.</p>
            <label class="field"><span>ID приглашения</span><input value="@invitation.InvitationId" readonly /></label>
            <label class="field"><span>Одноразовый код</span><input value="@invitation.OneTimeToken" readonly /></label>
            <a href="/account/activate">Страница активации</a><ActionButton Label="Скрыть код" Tone="secondary" OnClick="() => invitation = null" />
        </article>
    }
    @if (view != null)
    {
        <div class="surface filter-bar"><label class="field"><span>Поиск сотрудников</span><input @bind="filter" @bind:event="oninput" placeholder="Имя или адрес" /></label></div>
        @if (Filtered.Count == 0) { <PageState Title="Сотрудники не найдены" Description="Измените поиск или пригласите сотрудника." /> }
        else
        {
            <article class="surface table-surface"><div class="table-toolbar"><strong>@Filtered.Count сотрудников</strong><span class="subtle">Видимость ограничена вашей областью</span></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Сотрудник</th><th>Подразделение / должность</th><th>Доступ</th><th>Состояние</th><th></th></tr></thead><tbody>
                @foreach (EmployeeView item in Filtered.Skip(page * 20).Take(20))
                {
                    <tr><td><strong>@item.Name</strong><small>@item.Login</small></td><td>@Name(view.Departments,item.DepartmentId)<small>@Name(view.Positions,item.PositionId)</small></td><td>@item.Role<small>@item.Scope</small></td><td><StatusBadge Tone="@(item.Active ? "success" : "warning")" Label="@(item.Active ? "Активен" : "Ждёт активации")" /></td>
                        <td><AuthorizeView Policy="roles.manage"><ActionButton Tone="quiet" Label="Назначение" OnClick="() => Edit(item)" /></AuthorizeView></td></tr>
                }
            </tbody></table></div><div class="table-footer"><span>Страница @(page + 1)</span><div><ActionButton Tone="quiet" Label="Назад" Disabled="@(page == 0)" OnClick="() => page--" /><ActionButton Tone="quiet" Label="Далее" Disabled="@((page + 1) * 20 >= Filtered.Count)" OnClick="() => page++" /></div></div></article>
        }
        <AuthorizeView Policy="users.manage"><article class="surface" style="margin-top:var(--space-5)"><h2>@(editing == null ? "Пригласить сотрудника" : "Изменить назначение")</h2>
            <EditForm Model="input" FormName="employee" Context="employeeForm" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid">
                <label class="field"><span>Имя сотрудника</span><input @bind="input.Name" @bind:event="oninput" disabled="@(editing != null)" /></label>
                <label class="field"><span>Электронная почта</span><input type="email" @bind="input.Login" @bind:event="oninput" disabled="@(editing != null)" /></label>
                <label class="field"><span>Подразделение</span><InputSelect aria-label="Подразделение" @bind-Value="input.DepartmentId"><option value="">Не назначено</option>@foreach(NamedItem item in view.Departments) { <option value="@item.Id">@item.Name</option> }</InputSelect></label>
                <label class="field"><span>Должность</span><InputSelect aria-label="Должность" @bind-Value="input.PositionId"><option value="">Не назначена</option>@foreach(NamedItem item in view.Positions) { <option value="@item.Id">@item.Name</option> }</InputSelect></label>
                <label class="field"><span>Команда</span><InputSelect aria-label="Команда" @bind-Value="input.TeamId"><option value="">Не назначена</option>@foreach(NamedItem item in view.Teams) { <option value="@item.Id">@item.Name</option> }</InputSelect></label>
                <label class="field"><span>Руководитель</span><InputSelect aria-label="Руководитель" @bind-Value="input.ManagerId"><option value="">Не назначен</option>@foreach(EmployeeView item in view.Employees.Where(item => item.Active && item.Id != editing?.Id)) { <option value="@item.Id">@item.Name</option> }</InputSelect></label>
                <label class="field"><span>Роль</span><InputSelect aria-label="Роль" @bind-Value="input.RoleId"><option value="">Выберите роль</option>@foreach(NamedItem item in view.Roles) { <option value="@item.Id">@item.Name</option> }</InputSelect></label>
                <label class="field"><span>Область доступа</span><InputSelect aria-label="Область доступа" @bind-Value="input.Scope">@foreach(AccessScope scope in Enum.GetValues<AccessScope>()) { <option value="@scope">@scope</option> }</InputSelect><small>Team и Department требуют соответствующего назначения.</small></label>
                <div class="form-actions"><ActionButton Tone="quiet" Label="Отмена" OnClick="Cancel" /><ActionButton Type="submit" Label="@(editing == null ? "Создать приглашение" : "Сохранить назначение")" Disabled="@(input.RoleId == Guid.Empty || string.IsNullOrWhiteSpace(input.Login) || string.IsNullOrWhiteSpace(input.Name))" Busy="Busy" /></div>
            </div></EditForm>
        </article></AuthorizeView>
    }
}
@code {
    private OrganizationView? view; private string filter = ""; private int page;
    private EmployeeInput input = new(); private EmployeeView? editing; private InvitationResult? invitation;
    private IReadOnlyList<EmployeeView> Filtered => view?.Employees.Where(item => item.Name.Contains(filter,StringComparison.OrdinalIgnoreCase) || item.Login.Contains(filter,StringComparison.OrdinalIgnoreCase)).ToArray() ?? [];
    protected override async Task ReadAsync() => view = await Workspace.ReadAsync(CurrentSubject, CancellationToken.None);
    private static string Name(IReadOnlyList<NamedItem> list,Guid? id) => list.FirstOrDefault(item => item.Id == id)?.Name ?? "Не назначено";
    private void Edit(EmployeeView employee) { editing = employee; input = new() { Name=employee.Name, Login=employee.Login, DepartmentId=employee.DepartmentId, PositionId=employee.PositionId, TeamId=employee.TeamId, ManagerId=employee.ManagerId, RoleId=employee.RoleId, Scope=employee.Scope }; }
    private void Cancel() { editing = null; input = new(); }
    private Task SaveAsync() => ExecuteAsync(async () =>
    {
        if (editing == null) invitation = await Workspace.InviteAsync(CurrentSubject, new(input.Name,input.Login,input.DepartmentId,input.PositionId,input.TeamId,input.ManagerId,input.RoleId,input.Scope),Guid.CreateVersion7().ToString(),CancellationToken.None);
        else await Workspace.ChangeAssignmentAsync(CurrentSubject,new(editing.Id,input.DepartmentId,input.PositionId,input.TeamId,input.ManagerId,input.RoleId,input.Scope,editing.Version),Guid.CreateVersion7().ToString(),CancellationToken.None);
        Cancel();
    });
    private sealed class EmployeeInput
    {
        [Required,MaxLength(200)] public string Name { get; set; } = "";
        [Required,EmailAddress] public string Login { get; set; } = "";
        public Guid? DepartmentId { get; set; } public Guid? PositionId { get; set; }
        public Guid? TeamId { get; set; } public Guid? ManagerId { get; set; }
        public Guid RoleId { get; set; } public AccessScope Scope { get; set; } = AccessScope.Own;
    }
}
