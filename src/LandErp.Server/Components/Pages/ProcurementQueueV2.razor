@page "/procurement-v2"
@attribute [Authorize(Policy = "manager_queue.read")]
@using System.Globalization
@using LandErp.Application.Modules.Catalog.Domain
@using LandErp.Application.Modules.Procurement.Contracts
@using LandErp.Application.Modules.Procurement.Domain
@using LandErp.Server.Components.Procurement
@inherits WorkspaceComponent
@inject IProcurementQueueV2ReadService ReadModel
@inject IProcurementWorkspace Workspace
@inject NavigationManager Navigation

<PageTitle>Очередь закупки · LandErp</PageTitle>

<section class="pq2-reference">
    <main class="main">
        <div class="head">
            <div>
                <span class="kicker">Рабочие объекты закупки</span>
                <h1>Очередь закупки</h1>
                <p>Только уже выбранные PropertyCase. В очереди — минимум информации; детали открываются справа.</p>
            </div>
            <button type="button" class="btn primary" aria-disabled="true" title="Требуется отдельное подключение ручного создания PropertyCase">+ Создать объект вручную</button>
        </div>

        @if (Loading)
        {
            <div class="state"><strong>Загружаем очередь закупки…</strong></div>
        }
        else if (Forbidden)
        {
            <div class="state"><strong>Нет доступа к очереди закупки</strong></div>
        }
        else
        {
            @if (Error != null)
            {
                <div class="state error"><strong>@Error</strong><button type="button" class="btn" @onclick="ReloadAsync">Повторить</button></div>
            }

            @if (queuePage != null)
            {
                <div class="stats" aria-label="Сводка очереди">
                    <button type="button" class="stat @(dueTodayOnly ? "selected" : "")" @onclick="ToggleDueTodayAsync">
                        <span>Сегодня</span><b>@(queuePage.Summary.DueToday)</b><small>действий</small>
                    </button>
                    <button type="button" class="stat danger @(overdueOnly ? "selected" : "")" @onclick="ToggleOverdueAsync">
                        <span>Просрочено</span><b>@(queuePage.Summary.Overdue)</b><small>нужна реакция</small>
                    </button>
                    <button type="button" class="stat warning @(stageFilter == "returned" ? "selected" : "")" @onclick="ShowReturnedAsync">
                        <span>Возвращены</span><b>@(queuePage.Summary.Returned)</b><small>руководителем</small>
                    </button>
                    <div class="stat unavailable" title="Текущий V2 read model не отдаёт отдельный server-side count состояния «На проверке»">
                        <span>На проверке</span><b>—</b><small>нужен backend count</small>
                    </div>
                    <div class="stat unavailable" title="Текущий V2 read model не отдаёт отдельный server-side count состояния «У руководителя»">
                        <span>У руководителя</span><b>—</b><small>нужен backend count</small>
                    </div>
                </div>

                <section class="box">
                    <div class="tools">
                        <input value="@searchDraft"
                               @oninput="e => searchDraft = e.Value?.ToString() ?? string.Empty"
                               @onchange="SearchChangedAsync"
                               @onkeydown="SearchKeyDownAsync"
                               placeholder="Адрес, PropertyCase, кадастровый номер, продавец…" />
                        <select value="@stageFilter" @onchange="StageChangedAsync" aria-label="Этап">
                            <option value="">Все этапы</option>
                            @foreach (string stage in queuePage.Stages)
                            {
                                <option value="@stage">@ProcurementLabels.Stage(stage)</option>
                            }
                        </select>
                        <select value="@assigneeFilter" @onchange="AssigneeChangedAsync" aria-label="Ответственный">
                            <option value="">Все ответственные</option>
                            @foreach (ProcurementQueueV2Assignee assignee in queuePage.Assignees)
                            {
                                <option value="@assignee.Id">@assignee.Name</option>
                            }
                        </select>
                        @if (HasFilters)
                        {
                            <button type="button" class="btn reset" @onclick="ClearFiltersAsync">Сбросить</button>
                        }
                    </div>

                    <div class="chips">
                        <button type="button" class="chipbtn @(!HasOperationalFilter ? "on" : "")" @onclick="ClearOperationalFiltersAsync">Все <b>@(queuePage.Total)</b></button>
                        <button type="button" class="chipbtn @(dueTodayOnly ? "on" : "")" @onclick="ToggleDueTodayAsync">Сегодня <b>@(queuePage.Summary.DueToday)</b></button>
                        <button type="button" class="chipbtn @(overdueOnly ? "on" : "")" @onclick="ToggleOverdueAsync">Просрочено <b>@(queuePage.Summary.Overdue)</b></button>
                        <button type="button" class="chipbtn @(stageFilter == "returned" ? "on" : "")" @onclick="ShowReturnedAsync">Возвращены <b>@(queuePage.Summary.Returned)</b></button>
                        <button type="button" class="chipbtn unavailable" aria-disabled="true" title="Сейчас сервер сообщает только об изменении source revision, а не именно цены">Изменилась цена <b>—</b></button>
                        <button type="button" class="chipbtn unavailable" aria-disabled="true" title="Нужен отдельный server-side count/filter состояния руководителя">У руководителя <b>—</b></button>
                    </div>

                    <div class="table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Объект</th>
                                    <th>Этап</th>
                                    <th>Цена / площадь</th>
                                    <th>Следующее действие</th>
                                    <th>Проверка</th>
                                    <th>Последний контакт</th>
                                    <th>Ответственный</th>
                                    <th>Источники</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (queuePage.Items.Count == 0)
                                {
                                    <tr><td colspan="8" class="empty">По выбранным условиям объектов нет.</td></tr>
                                }
                                @foreach (ProcurementQueueV2Row item in queuePage.Items)
                                {
                                    <tr @key="item.CaseId" class="@RowClass(item.RowState)" @onclick="() => OpenDrawerAsync(item.CaseId)">
                                        <td class="obj">
                                            <div class="objline">
                                                @if (!string.IsNullOrWhiteSpace(item.ThumbnailUrl))
                                                {
                                                    <img class="thumb" src="@item.ThumbnailUrl" alt="" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <span class="thumb fallback" aria-hidden="true">⌂</span>
                                                }
                                                <div>
                                                    <b>@item.Title</b>
                                                    <div class="sub">@item.BusinessNumber@if (!string.IsNullOrWhiteSpace(item.CadastralNumber)) { <text> · @item.CadastralNumber</text> }</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge @StageBadge(item.Stage)">@ProcurementLabels.Stage(item.Stage)</span></td>
                                        <td class="price"><b>@MoneyCompact(item.WorkingPrice)</b><div class="sub">@AreaSotki(item.AreaSquareMeters)</div></td>
                                        <td><b>@ValueOrDash(item.NextActionTitle)</b><div class="sub @DueCss(item.DueState)">@DueCompact(item.DueAt, item.DueState)</div></td>
                                        <td><span class="badge @CheckBadge(item.QuickChecks)">@CheckRatio(item.QuickChecks)</span></td>
                                        <td>
                                            @if (item.LatestContact == null)
                                            {
                                                <span>Нет контакта</span><div class="sub">переговоров нет</div>
                                            }
                                            else
                                            {
                                                <span>@ContactTime(item.LatestContact.EffectiveAt)</span><div class="sub">@ContactCaption(item.LatestContact)</div>
                                            }
                                        </td>
                                        <td><div class="ass"><span class="av">@Initials(item.AssigneeName)</span><span>@item.AssigneeName</span></div></td>
                                        <td><span class="badge neutral">@SourcesText(item.Sources)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <footer class="pager">
                        <span>@PageCaption</span>
                        <div>
                            <button type="button" class="btn" @onclick="PreviousPageAsync" disabled="@(queuePage.Offset == 0)">‹</button>
                            <span class="page-number">@(queuePage.Total == 0 ? 1 : queuePage.Offset / queuePage.Size + 1)</span>
                            <button type="button" class="btn" @onclick="NextPageAsync" disabled="@(queuePage.Offset + queuePage.Size >= queuePage.Total)">›</button>
                        </div>
                    </footer>
                </section>
            }
        }
    </main>
</section>

@if (selectedCaseId != null)
{
    <div class="overlay on" @onclick="CloseDrawer"></div>
    <aside class="drawer on" @onclick:stopPropagation="true" aria-label="Карточка объекта">
        @if (drawerLoading)
        {
            <div class="dh"><div class="grow"><b>Карточка объекта</b></div><button class="btn" type="button" @onclick="CloseDrawer">×</button></div>
            <div class="db"><div class="state"><strong>Загружаем объект…</strong></div></div>
        }
        else if (drawerError != null)
        {
            <div class="dh"><div class="grow"><b>Карточка объекта</b></div><button class="btn" type="button" @onclick="CloseDrawer">×</button></div>
            <div class="db"><div class="state error"><strong>@drawerError</strong></div></div>
        }
        else if (detail != null)
        {
            <div class="dh">
                <div class="grow"><b>@detail.Title</b><div class="sub">@detail.BusinessNumber@if (!string.IsNullOrWhiteSpace(detail.CadastralNumber)) { <text> · @detail.CadastralNumber</text> }</div></div>
                <button class="btn" type="button" @onclick="OpenFullCase">Открыть полную карточку ↗</button>
                <button class="btn" type="button" @onclick="CloseDrawer">×</button>
            </div>
            <div class="db">
                <div class="card hero">
                    @if (!string.IsNullOrWhiteSpace(detail.ThumbnailUrl))
                    {
                        <img class="photo" src="@detail.ThumbnailUrl" alt="" />
                    }
                    else
                    {
                        <div class="photo fallback" aria-hidden="true">⌂</div>
                    }
                    <div class="facts">
                        <div class="fact"><label>Объект</label><b>@detail.Title</b><small>@ValueOrDash(detail.CadastralNumber)</small></div>
                        <div class="fact"><label>Площадь</label><b>@AreaSotki(detail.AreaSquareMeters)</b></div>
                        <div class="fact"><label>Этап</label><b>@ProcurementLabels.Stage(detail.Stage)</b></div>
                        <div class="fact"><label>Ответственный</label><b>@detail.AssigneeName</b></div>
                    </div>
                </div>

                <div class="card">
                    <div class="ct"><b>Цена и торг</b><button class="btn" type="button" aria-disabled="true" title="Полная история цены и переговоров пока не выдаётся V2 read model">История цены и переговоров</button></div>
                    <div class="prices">
                        <div class="p"><label>Цена источника</label><b>@MoneyCompact(detail.CurrentSourceAsk)</b><small>@ValueOrDash(detail.CurrentSourceLabel)</small></div>
                        <div class="p good"><label>Сейчас продавец</label><b>@MoneyCompact(detail.LatestSellerOffer)</b></div>
                        <div class="p ours"><label>Наше последнее</label><b>@MoneyCompact(detail.LatestBuyerOffer)</b></div>
                        <div class="p good"><label>Согласовано</label><b>@MoneyCompact(detail.LatestAgreedPrice)</b></div>
                    </div>
                </div>

                <div class="card">
                    <div class="ct"><b>Следующее действие</b><span class="badge @DueBadge(detail.DueState)">@DueCompact(detail.DueAt, detail.DueState)</span></div>
                    <div class="next"><b>@ValueOrDash(detail.NextActionTitle)</b></div>
                </div>

                <div class="card">
                    <div class="ct"><b>Переговоры</b><div><span class="badge info">Показано @detail.Negotiations.Count</span><button class="btn" type="button" aria-disabled="true" title="Read model отдаёт только три последних контакта">Все переговоры</button> @if (detail.CanManageDossier) { <button class="btn primary" type="button" @onclick="OpenNegotiation">+ Добавить</button> }</div></div>
                    <div class="neg-summary">
                        <div class="neg-summary-main">
                            @if (detail.Negotiations.Count == 0)
                            {
                                <b>Переговоры ещё не начаты</b>
                                <p>Зафиксируйте первый контакт с владельцем.</p>
                            }
                            else
                            {
                                <b>@NegotiationTitle(detail.Negotiations[0])</b>
                                @if (!string.IsNullOrWhiteSpace(detail.Negotiations[0].Comment))
                                {
                                    <p>@detail.Negotiations[0].Comment</p>
                                }
                                else
                                {
                                    <p>Последний контакт · @ShortDateTime(detail.Negotiations[0].EffectiveAt)</p>
                                }
                            }
                        </div>
                    </div>
                    @if (detail.Negotiations.Count > 0)
                    {
                        <div class="neg">
                            @foreach (ProcurementQueueV2Negotiation item in detail.Negotiations)
                            {
                                <div class="negrow">
                                    <b>@NegotiationTitle(item)</b>
                                    @if (!string.IsNullOrWhiteSpace(item.Comment)) { <p>@item.Comment</p> }
                                    <div class="meta">
                                        @if (!string.IsNullOrWhiteSpace(item.Channel)) { <span class="tag">@item.Channel</span> }
                                        @if (item.SellerPrice != null) { <span class="tag ok">Продавец @MoneyCompact(item.SellerPrice)</span> }
                                        @if (item.BuyerOffer != null) { <span class="tag info">Мы @MoneyCompact(item.BuyerOffer)</span> }
                                        @if (item.AgreedPrice != null) { <span class="tag ok">Согласовано @MoneyCompact(item.AgreedPrice)</span> }
                                        <span class="tag">@ShortDateTime(item.EffectiveAt)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="card">
                    <div class="ct"><b>Проверки</b><button class="btn" type="button" @onclick="OpenFullCase">Открыть проверки</button></div>
                    <div class="checks">
                        <div class="check"><div class="check-line"><b>Базовые проверки</b><span class="badge @CheckBadge(detail.QuickChecks)">@CheckRatio(detail.QuickChecks)</span></div><p>@CheckLevelDescription(detail.QuickChecks)</p></div>
                        <div class="check"><div class="check-line"><b>Глубокая проверка / DD</b><span class="badge @CheckBadge(detail.DeepChecks)">@CheckRatio(detail.DeepChecks)</span></div><p>@CheckLevelDescription(detail.DeepChecks)</p></div>
                    </div>
                </div>

                <div class="card">
                    <div class="ct"><b>Осмотр участка</b>@if (detail.Inspection.Exists || detail.CanManageDossier) { <button class="btn" type="button" @onclick="OpenInspection">@(detail.Inspection.Exists ? "Открыть осмотр" : "Начать осмотр")</button> }</div>
                    @if (!detail.Inspection.Exists)
                    {
                        <div class="inspection empty-inspection">
                            <div class="inspection-top"><div><b>Осмотр ещё не проводился</b><p>Полевой чек-лист, фото, видео и аудио появятся здесь после начала осмотра.</p></div><span class="badge neutral">Нет данных</span></div>
                        </div>
                    }
                    else
                    {
                        <div class="inspection">
                            <div class="inspection-top">
                                <div><b>@(detail.Inspection.Status == InspectionStatus.Completed ? "Осмотр завершён" : "Осмотр начат") · @ShortDate(detail.Inspection.Date)</b>@if (!string.IsNullOrWhiteSpace(detail.Inspection.Conclusion)) { <p>@detail.Inspection.Conclusion</p> }</div>
                                <span class="badge @(detail.Inspection.Problems > 0 ? "warn" : "ok")">@(detail.Inspection.Problems > 0 ? "Есть замечания" : "Без проблем")</span>
                            </div>
                            <div class="inspection-stats">
                                <span class="inspection-stat"><b>@detail.Inspection.CheckedItems</b> из @detail.Inspection.TotalItems пунктов</span>
                                <span class="inspection-stat"><b>@detail.Inspection.Problems</b> проблем</span>
                                <span class="inspection-stat"><b>@detail.Inspection.MaterialCount</b> материалов</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="card">
                    <div class="ct"><b>Последние события</b><button class="btn" type="button" @onclick="OpenFullCase">Вся история</button></div>
                    @if (detail.Timeline.Count == 0)
                    {
                        <div class="muted">Событий пока нет.</div>
                    }
                    else
                    {
                        <div class="timeline-list">
                            @foreach (ProcurementTimelineSummary item in detail.Timeline)
                            {
                                <div class="timeline-row"><b>@item.Title</b>@if (!string.IsNullOrWhiteSpace(item.Body)) { <p>@item.Body</p> }<span>@ShortDateTime(item.RecordedAt) · @item.Actor</span></div>
                            }
                        </div>
                    }
                </div>

                <div class="card">
                    <div class="ct"><b>Источники</b><span class="badge neutral">@detail.Sources.Count</span></div>
                    @if (detail.Sources.Count == 0)
                    {
                        <div class="muted">Case создан без внешних источников.</div>
                    }
                    else
                    {
                        <div class="source-list">
                            @foreach (ProcurementSourceDetail source in detail.Sources)
                            {
                                <div class="source-row">
                                    <div><b>@ProcurementLabels.Source(source.Source)</b><span>@ValueOrDash(source.ExternalId)</span></div>
                                    @if (!string.IsNullOrWhiteSpace(source.Url)) { <a href="@source.Url" target="_blank" rel="noopener noreferrer">Открыть ↗</a> }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="df">
                @if (detail.CanHeadDecide)
                {
                    <button class="btn bad" type="button" disabled="@Busy" @onclick="() => OpenDecisionAsync(ProcurementAction.Return)">Вернуть</button>
                    <button class="btn primary" type="button" disabled="@Busy" @onclick="() => OpenDecisionAsync(ProcurementAction.Approve)">Продолжить</button>
                }
                else if (detail.CanManagerDecide)
                {
                    <button class="btn bad" type="button" disabled="@Busy" @onclick="() => OpenDecisionAsync(ProcurementAction.Reject)">Не подходит</button>
                    <button class="btn primary" type="button" disabled="@Busy" @onclick="() => OpenDecisionAsync(ProcurementAction.Forward)">Передать руководителю</button>
                }
                else
                {
                    <span></span><button class="btn primary" type="button" @onclick="OpenFullCase">Открыть карточку</button>
                }
            </div>
        }
    </aside>
}

@if (decisionCard != null)
{
    <DecisionDialog Card="decisionCard" Action="decisionAction" Title="@DecisionTitle(decisionAction)" Busy="@Busy" Error="@Error"
                    OnConfirm="ConfirmDecisionAsync" OnClose="CloseDecision" />
}

@if (negotiationOpen && detail != null)
{
    <div class="modalBack on" @onclick="CloseNegotiation">
        <div class="modal add-modal" @onclick:stopPropagation="true">
            <div class="mh"><div class="grow"><b>Добавить контакт</b><div class="sub">Переговоры по @detail.BusinessNumber</div></div><button class="btn" type="button" @onclick="CloseNegotiation">×</button></div>
            <EditForm Model="negotiation" FormName="procurement-v2-negotiation" OnValidSubmit="SaveNegotiationAsync">
                <DataAnnotationsValidator />
                <div class="mb">
                    <ValidationSummary />
                    <div class="form">
                        <div class="field"><label>Тип</label><select @bind="negotiation.Channel"><option>Телефон</option><option>Сообщение</option><option>Встреча</option></select></div>
                        <div class="field"><label>Результат</label><input @bind="negotiation.Outcome" maxlength="500" /></div>
                        <div class="field"><label>Цена продавца</label><InputNumber @bind-Value="negotiation.SellerPrice" /></div>
                        <div class="field"><label>Наше предложение</label><InputNumber @bind-Value="negotiation.BuyerOffer" /></div>
                        <div class="field full"><label>Комментарий</label><textarea @bind="negotiation.Comment" maxlength="4000"></textarea></div>
                        <div class="field full"><label>Вложения</label><div class="attachment-placeholder"><button class="btn" type="button" aria-disabled="true">📎 Файл</button><button class="btn" type="button" aria-disabled="true">📷 Фото</button><button class="btn" type="button" aria-disabled="true">🎙 Аудио</button></div><small>Atomic attachment save требует расширения backend-контракта.</small></div>
                    </div>
                </div>
                <div class="mf"><button class="btn" type="button" @onclick="CloseNegotiation">Отмена</button><button class="btn primary" type="submit" disabled="@Busy">Сохранить</button></div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "stage")] public string? InitialStage { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "mine")] public bool MineOnly { get; set; }
    private static readonly CultureInfo Ru = CultureInfo.GetCultureInfo("ru-RU");
    private ProcurementQueueV2Page? queuePage;
    private ProcurementQueueV2Detail? detail;
    private Guid? selectedCaseId;
    private bool drawerLoading;
    private string? drawerError;

    private string searchDraft = "";
    private string search = "";
    private string stageFilter = "";
    private string assigneeFilter = "";
    private bool dueTodayOnly;
    private bool overdueOnly;
    private bool queryInitialized;
    private int offset;
    private const int PageSize = 30;

    private CaseCard? decisionCard;
    private ProcurementAction decisionAction;
    private bool negotiationOpen;
    private NegotiationDraft negotiation = new();

    protected override void OnParametersSet()
    {
        if (queryInitialized) return;
        stageFilter = InitialStage ?? "";
        queryInitialized = true;
    }

    protected override async Task ReadAsync()
    {
        queuePage = await ReadModel.ReadPageAsync(CurrentSubject, BuildFilter(), CancellationToken.None);
        if (selectedCaseId is Guid caseId)
            detail = await ReadModel.ReadDetailAsync(CurrentSubject, caseId, CancellationToken.None);
    }

    private ProcurementQueueV2Filter BuildFilter()
    {
        Guid? assignee = Guid.TryParse(assigneeFilter, out Guid assigneeId) ? assigneeId : null;
        return new(search, stageFilter, assignee, null, false, dueTodayOnly, overdueOnly,
            ProcurementQueueV2CheckFilter.Any, ProcurementQueueV2Sort.RecordedAt, true, offset, PageSize, MineOnly);
    }

    private bool HasFilters => search.Length > 0 || stageFilter.Length > 0 || assigneeFilter.Length > 0 || dueTodayOnly || overdueOnly;
    private bool HasOperationalFilter => stageFilter.Length > 0 || dueTodayOnly || overdueOnly;
    private string PageCaption => queuePage == null || queuePage.Total == 0 ? "Показано 0 объектов" : $"Показано {queuePage.Offset + 1}–{Math.Min(queuePage.Offset + queuePage.Size, queuePage.Total)} из {queuePage.Total} объектов";

    private async Task ApplySearchAsync() { search = searchDraft.Trim(); offset = 0; await ReloadAsync(); }
    private async Task SearchChangedAsync(ChangeEventArgs e) { searchDraft = e.Value?.ToString() ?? ""; await ApplySearchAsync(); }
    private async Task SearchKeyDownAsync(KeyboardEventArgs args) { if (args.Key == "Enter") await ApplySearchAsync(); }
    private async Task StageChangedAsync(ChangeEventArgs e) { stageFilter = e.Value?.ToString() ?? ""; dueTodayOnly = overdueOnly = false; offset = 0; await ReloadAsync(); }
    private async Task AssigneeChangedAsync(ChangeEventArgs e) { assigneeFilter = e.Value?.ToString() ?? ""; offset = 0; await ReloadAsync(); }
    private async Task ToggleDueTodayAsync() { dueTodayOnly = !dueTodayOnly; if (dueTodayOnly) { overdueOnly = false; stageFilter = ""; } offset = 0; await ReloadAsync(); }
    private async Task ToggleOverdueAsync() { overdueOnly = !overdueOnly; if (overdueOnly) { dueTodayOnly = false; stageFilter = ""; } offset = 0; await ReloadAsync(); }
    private async Task ShowReturnedAsync() { stageFilter = stageFilter == "returned" ? "" : "returned"; dueTodayOnly = overdueOnly = false; offset = 0; await ReloadAsync(); }
    private async Task ClearOperationalFiltersAsync() { stageFilter = ""; dueTodayOnly = overdueOnly = false; offset = 0; await ReloadAsync(); }
    private async Task ClearFiltersAsync() { search = searchDraft = stageFilter = assigneeFilter = ""; dueTodayOnly = overdueOnly = false; offset = 0; await ReloadAsync(); }
    private async Task PreviousPageAsync() { offset = Math.Max(0, offset - PageSize); await ReloadAsync(); }
    private async Task NextPageAsync() { if (queuePage != null && offset + PageSize < queuePage.Total) { offset += PageSize; await ReloadAsync(); } }

    private async Task OpenDrawerAsync(Guid caseId)
    {
        selectedCaseId = caseId; detail = null; drawerError = null; drawerLoading = true;
        try { detail = await ReadModel.ReadDetailAsync(CurrentSubject, caseId, CancellationToken.None); }
        catch (AccessDeniedException) { drawerError = "Нет доступа к этому объекту."; }
        catch (Exception) { drawerError = "Не удалось загрузить объект. Повторите после восстановления соединения."; }
        finally { drawerLoading = false; }
    }

    private void CloseDrawer() { selectedCaseId = null; detail = null; drawerError = null; decisionCard = null; negotiationOpen = false; }
    private void OpenFullCase() { if (detail != null) Navigation.NavigateTo($"/procurement/{detail.CaseId}"); }
    private void OpenInspection() { if (detail != null) Navigation.NavigateTo($"/procurement/{detail.CaseId}/inspection"); }

    private async Task OpenDecisionAsync(ProcurementAction action)
    {
        if (detail == null) return;
        drawerError = null;
        try { decisionAction = action; decisionCard = await Workspace.ReadCardAsync(CurrentSubject, detail.CaseId, CancellationToken.None); }
        catch (AccessDeniedException) { drawerError = "Нет права на это решение."; }
        catch (Exception) { drawerError = "Не удалось подготовить действие."; }
    }

    private void CloseDecision() => decisionCard = null;

    private async Task ConfirmDecisionAsync(DecisionDraft draft)
    {
        if (decisionCard == null) return;
        CaseCard card = decisionCard;
        await ExecuteAsync(() => Workspace.DecideAsync(CurrentSubject,
            new DecisionCommand(card.Item.CaseId, card.Item.CaseVersion, card.Item.SourceRevision, decisionAction,
                draft.Reason, draft.Clarification, draft.Target, ProcurementLabels.ParseLocal(draft.Due)),
            Correlation(), CancellationToken.None));
        if (Error == null) decisionCard = null;
    }

    private void OpenNegotiation()
    {
        if (detail == null || !detail.CanManageDossier) return;
        negotiation = new() { Effective = ProcurementLabels.LocalInput(DateTimeOffset.UtcNow) };
        negotiationOpen = true;
    }

    private void CloseNegotiation() => negotiationOpen = false;

    private async Task SaveNegotiationAsync()
    {
        if (detail == null) return;
        Guid caseId = detail.CaseId;
        long version = detail.CaseVersion;
        await ExecuteAsync(async () =>
        {
            DateTimeOffset effective = ProcurementLabels.ParseLocal(negotiation.Effective) ?? DateTimeOffset.UtcNow;
            await Workspace.AddNegotiationAsync(CurrentSubject,
                new AddNegotiation(caseId, version, negotiation.SellerPrice, negotiation.BuyerOffer, null,
                    negotiation.Channel, "", negotiation.Outcome, "", negotiation.Comment, "", null, effective),
                Correlation(), CancellationToken.None);
        });
        if (Error == null) negotiationOpen = false;
    }

    private static string Correlation() => $"procurement-v2-{Guid.NewGuid():N}";
    private static string DecisionTitle(ProcurementAction action) => action switch
    {
        ProcurementAction.Forward => "Передать руководителю",
        ProcurementAction.Return => "Вернуть менеджеру",
        ProcurementAction.Approve => "Продолжить работу",
        ProcurementAction.Reject => "Не подходит",
        _ => "Решение"
    };

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string MoneyCompact(decimal? value)
    {
        if (value == null) return "—";
        if (Math.Abs(value.Value) >= 1_000_000m) return $"{(value.Value / 1_000_000m).ToString("0.#", Ru)} млн ₽";
        return $"{value.Value.ToString("N0", Ru)} ₽";
    }
    private static string AreaSotki(decimal? squareMeters) => squareMeters == null ? "—" : $"{(squareMeters.Value / 100m).ToString("0.##", Ru)} сот.";
    private static string ShortDate(DateTimeOffset? value) => value == null ? "—" : ProcurementLabels.Time(value).Split(' ')[0];
    private static string ShortDateTime(DateTimeOffset value) => ProcurementLabels.Time(value).Replace(" МСК", "", StringComparison.Ordinal);
    private static string ContactCaption(ProcurementLatestContact item) => string.Join(" · ", new[] { item.Channel, item.Outcome }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private static string ContactTime(DateTimeOffset value) => ProcurementLabels.Time(value).Replace(" МСК", "", StringComparison.Ordinal);
    private static string Initials(string name)
    {
        string[] parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return string.Concat(parts.Take(2).Select(item => char.ToUpperInvariant(item[0])));
    }
    private static string SourcesText(IReadOnlyList<ProcurementSourceTypeSummary> sources) => sources.Count == 0
        ? "Нет источников"
        : string.Join(" · ", sources.Select(item => item.Count > 1 ? $"{ProcurementLabels.Source(item.Source)} ×{item.Count}" : ProcurementLabels.Source(item.Source)));
    private static string SourcesText(IReadOnlyList<ProcurementSourceDetail> sources) => sources.Count == 0
        ? "Нет источников"
        : string.Join(" · ", sources.Select(item => ProcurementLabels.Source(item.Source)).Distinct(StringComparer.Ordinal));
    private static string StageBadge(string stage) => stage switch
    {
        "negotiation" => "violet",
        "pending_head" => "warn",
        "approved" or "acquired" => "ok",
        "rejected" or "returned" => "bad",
        "analysis" or "clarify" => "info",
        _ => "neutral"
    };
    private static string CheckBadge(ProcurementQuickCheckSummary check) => check.Issues > 0 ? "warn" : check.Total > 0 && check.Completed == check.Total ? "ok" : "info";
    private static string CheckBadge(ProcurementCheckLevelSummary check) => check.Issues > 0 ? "warn" : check.Total > 0 && check.Completed == check.Total ? "ok" : "info";
    private static string CheckRatio(ProcurementQuickCheckSummary check) => check.Total == 0 ? "Не начат" : $"{check.Completed} / {check.Total}";
    private static string CheckRatio(ProcurementCheckLevelSummary check) => check.Total == 0 ? "не начат" : $"{check.Completed}/{check.Total}";
    private static string CheckLevelDescription(ProcurementCheckLevelSummary check) => check.Total == 0
        ? "Проверки ещё не начаты."
        : check.Issues > 0 ? $"Есть проблем: {check.Issues}. Осталось: {check.Remaining}." : $"Осталось: {check.Remaining}.";
    private static string DueCss(ProcurementDueState state) => state == ProcurementDueState.Overdue ? "text-bad" : state == ProcurementDueState.Today ? "text-warn" : "";
    private static string DueBadge(ProcurementDueState state) => state == ProcurementDueState.Overdue ? "bad" : state == ProcurementDueState.Today ? "warn" : "neutral";
    private static string DueCompact(DateTimeOffset? value, ProcurementDueState state)
    {
        if (value == null) return "Срок не задан";
        string time = ProcurementLabels.Time(value).Replace(" МСК", "", StringComparison.Ordinal);
        string hhmm = time.Length >= 16 ? time[^5..] : time;
        return state switch
        {
            ProcurementDueState.Today => $"Сегодня {hhmm}",
            ProcurementDueState.Overdue => $"Просрочено · {time[..Math.Min(10, time.Length)]}",
            _ => time
        };
    }
    private static string RowClass(ProcurementQueueV2RowState state) => state switch
    {
        ProcurementQueueV2RowState.Overdue => "row-overdue",
        ProcurementQueueV2RowState.DueToday => "row-today",
        ProcurementQueueV2RowState.CheckIssue => "row-check",
        ProcurementQueueV2RowState.SourceChanged => "row-source",
        _ => ""
    };
    private static string NegotiationTitle(ProcurementQueueV2Negotiation item)
    {
        if (!string.IsNullOrWhiteSpace(item.Outcome)) return item.Outcome;
        if (item.SellerPrice != null) return $"Продавец: {MoneyCompact(item.SellerPrice)}";
        if (item.BuyerOffer != null) return $"Наше предложение: {MoneyCompact(item.BuyerOffer)}";
        return string.IsNullOrWhiteSpace(item.Channel) ? "Контакт" : item.Channel;
    }

    private sealed class NegotiationDraft
    {
        [Required, MaxLength(100)] public string Channel { get; set; } = "Телефон";
        [MaxLength(500)] public string Outcome { get; set; } = "";
        [MaxLength(4000)] public string Comment { get; set; } = "";
        public decimal? SellerPrice { get; set; }
        public decimal? BuyerOffer { get; set; }
        public string Effective { get; set; } = "";
    }
}
