@page "/collectors"
@attribute [Authorize(Policy = "collection.read")]
@inherits WorkspaceComponent
@using LandErp.Application.Modules.Collection.Contracts
@using LandErp.Application.Modules.Collection.Domain
@using LandErp.Application.Modules.Catalog.Domain
@using LandErp.Collector.Contracts.V1
@inject ICollectionAdministration Administration
@inject NavigationManager Navigation

<PageTitle>Поиски и парсинг · LandErp</PageTitle>
<div class="collectors-page">
<PageHeader Title="Поиски и парсинг" Breadcrumb="Данные / Поиски и парсинг" Description="Поиски, расписания, общая очередь и состояние локальных парсеров.">
    <AuthorizeView Policy="searches.manage"><div class="header-actions"><button class="btn secondary" @onclick="OpenGroups">Группы</button><button class="btn primary" @onclick="() => OpenSearch()">+ Добавить поиск</button></div></AuthorizeView>
</PageHeader>
@if (Loading) { <PageState Kind="loading" Title="Загружаем поиски и парсеры…" /> }
else if (Forbidden) { <PageState Kind="forbidden" Title="Нет доступа" /> }
else if (view is not null)
{
    @if (Error is not null) { <PageState Kind="error" Title="@Error"><ActionButton Label="Повторить" OnClick="ReloadAsync" /></PageState> }
    <section class="metrics" aria-label="Состояние сбора данных">
        <article><strong>@view.ActiveSearches</strong><span>активных поисков</span><small>из @view.Searches.Count всего</small></article>
        <article><strong>@view.OnlineAgents</strong><span>парсеров на связи</span><small>@view.BusyAgents сейчас работают</small></article>
        <article><strong>@view.PendingJobs</strong><span>в общей очереди</span><small>работу возьмёт свободный парсер</small></article>
        <article class="@(AttentionCount > 0 ? "attention" : "")"><strong>@AttentionCount</strong><span>требуют внимания</span><small>@(AttentionCount > 0 ? "откройте детали ниже" : "всё работает штатно")</small></article>
    </section>
    @if (AttentionCount > 0) { <section class="attention-panel" role="status"><b>!</b><div><strong>Нужно внимание</strong><p>@AttentionSummary</p></div><button class="text-action" @onclick="ShowAttention">Показать</button></section> }

    <section class="workspace-card searches-card">
        <div class="section-heading"><div><h2>Список поисков</h2><p>Поиски выполняются любым свободным совместимым парсером.</p></div><AuthorizeView Policy="searches.manage"><button class="btn primary compact" @onclick="() => OpenSearch()">+ Добавить поиск</button></AuthorizeView></div>
        <div class="filters"><label class="search-box"><span class="sr-only">Найти поиск</span><input placeholder="Найти по названию или ссылке" @bind="query" @bind:event="oninput" /></label><label><span class="sr-only">Группа</span><select @bind="groupFilter"><option value="all">Все группы</option><option value="none">Без группы</option>@foreach(var group in view.Groups.Where(x=>x.Active).OrderBy(x=>x.SortOrder)){<option value="@group.Id">@group.Name</option>}</select></label><label><span class="sr-only">Статус</span><select @bind="statusFilter"><option value="all">Все статусы</option><option value="active">Активные</option><option value="paused">Приостановленные</option><option value="attention">Требуют внимания</option></select></label>@if(HasFilters){<button class="text-action" @onclick="ResetFilters">Сбросить</button>}</div>
        @if (FilteredSections.Count == 0) { <div class="empty"><strong>Поиски не найдены</strong><span>Измените фильтры или добавьте новый поиск.</span></div> }
        else { <div class="search-table" role="table"><div class="table-head"><span>Поиск</span><span>Расписание</span><span>Последний запуск</span><span>Результат</span><span>Следующий</span><span></span></div>
        @foreach(var groupSection in FilteredSections)
        {
            <div class="group-row"><button class="group-toggle" @onclick="() => ToggleGroup(groupSection.Key)" aria-expanded="@IsExpanded(groupSection.Key)"><i>@(IsExpanded(groupSection.Key)?"⌄":"›")</i><span><strong>@groupSection.Name</strong><small>@groupSection.Searches.Count поисков · @groupSection.ActiveCount активных</small></span></button><span>@groupSection.Sources</span><span>@Time(groupSection.LastRunAt)</span><span class="aggregate"><b>@groupSection.Processed</b><small>обработано</small><b>+@groupSection.NewListings</b><small>новых</small></span><span>@Time(groupSection.NextRunAt)</span><AuthorizeView Policy="searches.manage"><button class="icon-action" title="Добавить поиск в группу" @onclick="() => OpenSearch(groupSection.GroupId)">+</button></AuthorizeView></div>
            @if(IsExpanded(groupSection.Key)) { @foreach(var search in groupSection.Searches) { <div class="search-row @(NeedsAttention(search)?"needs-attention":"")"><div class="search-name"><i class="source">@SourceShort(search.Source)</i><span><strong>@search.Label</strong><small>@search.Source · до @search.MaxPages стр.</small></span></div><div><strong>@search.Schedule</strong><small>@(search.Enabled?"Активен":"Приостановлен")</small></div><div><strong>@LastRunTitle(search.LastRun)</strong><small>@Time(search.LastRun?.CompletedAt ?? search.LastRun?.CreatedAt)</small></div><div class="run-result">@if(search.LastRun is null){<span>—</span>}else{<b>@search.LastRun.ProcessedCount</b><small> обработано</small><em>+@search.LastRun.NewListingsCount / ~@search.LastRun.ChangedListingsCount</em>}</div><div><strong>@Time(search.NextRunAt)</strong>@if(!search.Enabled){<small>не запланирован</small>}</div><div class="row-actions"><StatusBadge Label="@(search.Enabled?"Активен":"Пауза")" Tone="@(search.Enabled?"success":"neutral")" /><AuthorizeView Policy="searches.manage"><button class="icon-action" title="Запустить сейчас" disabled="@Busy" @onclick="() => EnqueueAsync(search.Id)">▶</button><button class="icon-action" title="Изменить" @onclick="() => OpenEditSearch(search)">⋯</button></AuthorizeView></div></div> } }
        }</div>}
    </section>

    <section class="workspace-card"><div class="section-heading"><div><h2>Локальные парсеры</h2><p>Подключённые компьютеры сами забирают подходящую работу из общей очереди.</p></div><AuthorizeView Policy="agents.manage"><button class="btn secondary compact" @onclick="OpenConnection">+ Подключить парсер</button></AuthorizeView></div>
        <div class="scheduler"><i class="@(view.Scheduler.State=="Работает"?"ok":"warn")"></i><strong>Расписания: @view.Scheduler.State.ToLowerInvariant()</strong><span>Последний цикл @Time(view.Scheduler.LastSucceededAt) · добавлено: @view.Scheduler.LastQueuedCount</span></div>
        @if(view.Agents.Count==0){<div class="empty"><strong>Парсеры ещё не подключены</strong><span>Создайте код подключения и вставьте его в LandErp Parser.</span></div>}
        else { <div class="agent-grid">@foreach(var agent in view.Agents.OrderByDescending(x=>x.Online).ThenBy(x=>x.Name)){<article class="agent-card @AgentTone(agent)"><div class="agent-title"><div><i></i><strong>@agent.Name</strong></div><StatusBadge Label="@agent.OperationalStatus" Tone="@AgentBadgeTone(agent)" /></div><p>@agent.Version · @Capabilities(agent.Capabilities)</p>@if(agent.CurrentSearch is not null){<div class="agent-work"><span>Выполняет</span><strong>@agent.CurrentSearch</strong><div class="progress"><i style="width:@Progress(agent)%"></i></div><small>@ProgressLabel(agent)</small></div>}else{<div class="agent-work idle"><span>@(agent.Online?"Готов к следующему заданию":"Ожидаем подключение приложения")</span></div>}<footer><span>Связь: @Time(agent.LastHeartbeatAt)</span><span>@(agent.CanManageSearches?"Может добавлять поиски":"Только выполняет задания")</span></footer><AuthorizeView Policy="agents.manage"><button class="card-menu" @onclick="() => OpenAgent(agent)" aria-label="Настройки @agent.Name">⋯</button></AuthorizeView></article>}</div>}
    </section>

    <section class="workspace-card"><div class="section-heading"><div><h2>История запусков</h2><p>Последние задания и результаты обработки.</p></div><span class="muted">@FilteredJobs.Count записей</span></div><div class="filters"><label class="search-box"><span class="sr-only">Найти запуск</span><input placeholder="Поиск или парсер" @bind="historyQuery" @bind:event="oninput" /></label><label><span class="sr-only">Результат</span><select @bind="historyFilter"><option value="all">Все результаты</option><option value="completed">Успешные</option><option value="attention">Требуют внимания</option><option value="running">В работе</option></select></label></div>
        @if(FilteredJobs.Count==0){<div class="empty"><strong>Запусков пока нет</strong><span>Запустите поиск вручную или дождитесь расписания.</span></div>}else{<div class="history-wrap"><table><thead><tr><th>Поиск</th><th>Парсер</th><th>Начало</th><th>Статус</th><th>Обработано</th><th>Новых</th><th>Изменено</th><th></th></tr></thead><tbody>@foreach(var job in PagedJobs){<tr><td><strong>@job.Label</strong></td><td>@(job.Agent??"Ещё не назначен")</td><td>@Time(job.ScheduledFor??job.CreatedAt)</td><td><StatusBadge Label="@JobLabel(job.State)" Tone="@JobTone(job.State)" /></td><td>@job.ProcessedCount</td><td class="positive">+@job.NewListingsCount</td><td>@job.ChangedListingsCount</td><td><button class="icon-action" @onclick="() => selectedJob=job">›</button></td></tr>}</tbody></table></div>@if(HistoryPages>1){<div class="pager"><button disabled="@(historyPage==1)" @onclick="() => historyPage--">Назад</button><span>@historyPage из @HistoryPages</span><button disabled="@(historyPage==HistoryPages)" @onclick="() => historyPage++">Далее</button></div>}}
    </section>
}
</div>

@if(showSearchModal && view is not null){<Modal Title="@(editingSearch is null?"Добавить поиск":"Настроить поиск")" OnClose="CloseSearch"><EditForm Model="searchInput" FormName="collector-search" OnValidSubmit="SaveSearchAsync"><DataAnnotationsValidator/><ValidationSummary/><label class="field"><span>Название</span><input autofocus @bind="searchInput.Label" @bind:event="oninput" /></label><div class="modal-grid"><label class="field"><span>Источник</span><InputSelect @bind-Value="searchInput.Source"><option value="Avito">Avito</option><option value="Cian">Cian</option></InputSelect></label><label class="field"><span>Группа</span><InputSelect @bind-Value="searchInput.GroupId"><option value="">Без группы</option>@foreach(var group in view.Groups.Where(x=>x.Active).OrderBy(x=>x.SortOrder)){<option value="@group.Id">@group.Name</option>}</InputSelect></label></div><label class="field"><span>Ссылка поиска</span><input type="url" @bind="searchInput.Url" /></label><div class="modal-grid"><label class="field"><span>Расписание</span><InputSelect @bind-Value="searchInput.ScheduleKind"><option value="Manual">Только вручную</option><option value="Interval">Через интервал</option><option value="FixedTimes">В заданное время</option></InputSelect></label><label class="field"><span>Предел страниц</span><InputNumber @bind-Value="searchInput.MaxPages" /></label></div>@if(searchInput.ScheduleKind==CollectionScheduleKind.Interval){<label class="field"><span>Интервал, минут</span><InputNumber @bind-Value="searchInput.IntervalMinutes" /></label>}@if(searchInput.ScheduleKind==CollectionScheduleKind.FixedTimes){<label class="field"><span>Время запуска</span><input @bind="searchInput.FixedTimes" placeholder="09:00, 18:00" /></label>}@if(editingSearch is not null){<label class="check-field"><InputCheckbox @bind-Value="searchInput.Enabled"/><span>Поиск активен</span></label>}<p class="form-note">Работу возьмёт свободный совместимый парсер.</p><div class="modal-actions">@if(editingSearch is not null){<button type="button" class="btn quiet" @onclick="ToggleEditedSearchAsync">@(searchInput.Enabled?"Приостановить":"Включить")</button>}<span></span><button type="button" class="btn secondary" @onclick="CloseSearch">Отмена</button><button type="submit" class="btn primary" disabled="@Busy">Сохранить</button></div></EditForm></Modal>}
@if(showConnectionModal){<Modal Title="Подключить новый парсер" OnClose="CloseConnection">@if(connectionCode is null){<EditForm Model="agentInput" FormName="collector-connection" OnValidSubmit="CreateAgentAsync"><DataAnnotationsValidator/><ValidationSummary/><label class="field"><span>Название компьютера</span><input autofocus @bind="agentInput.Name" @bind:event="oninput" /></label><p class="form-note">Право добавлять поиски по умолчанию выключено.</p><div class="modal-actions"><span></span><button type="button" class="btn secondary" @onclick="CloseConnection">Отмена</button><button type="submit" class="btn primary" disabled="@(Busy||string.IsNullOrWhiteSpace(agentInput.Name))">Создать код</button></div></EditForm>}else{<div class="connection-success"><b>✓</b><h3>Код готов</h3><p>Вставьте его в LandErp Parser. Код действует до @Time(connectionCode.ExpiresAt).</p><label class="field"><span>Код подключения</span><textarea readonly rows="4">@ConnectionCode(connectionCode)</textarea></label><div class="modal-actions"><span></span><button class="btn primary" @onclick="CloseConnection">Готово</button></div></div>}</Modal>}
@if(showGroupsModal && view is not null){<Modal Title="Группы поисков" OnClose="CloseGroups"><EditForm Model="groupInput" FormName="collector-group" OnValidSubmit="CreateGroupAsync"><DataAnnotationsValidator/><div class="inline-form"><label class="field"><span>Новая группа</span><input @bind="groupInput.Name" /></label><label class="field"><span>Порядок</span><InputNumber @bind-Value="groupInput.SortOrder" /></label><button type="submit" class="btn primary" disabled="@(Busy||string.IsNullOrWhiteSpace(groupInput.Name))">Добавить</button></div></EditForm><div class="group-list">@foreach(var group in view.Groups.OrderBy(x=>x.SortOrder)){<div><span><strong>@group.Name</strong><small>@group.SearchCount поисков · @(group.Active?"активна":"архив")</small></span>@if(group.Active){<button class="text-action danger-text" @onclick="() => ArchiveGroupAsync(group)">В архив</button>}</div>}</div><div class="modal-actions"><span></span><button class="btn secondary" @onclick="CloseGroups">Закрыть</button></div></Modal>}
@if(selectedAgent is not null){<Modal Title="Настройки парсера" OnClose="CloseAgent"><div class="dialog-head"><strong>@selectedAgent.Name</strong><StatusBadge Label="@selectedAgent.OperationalStatus" Tone="@AgentBadgeTone(selectedAgent)" /></div><div class="setting"><div><strong>Добавление групп и поисков</strong><p>Разрешить этому Parser создавать серверные поиски.</p></div><button class="switch @(selectedAgent.CanManageSearches?"on":"")" role="switch" aria-checked="@selectedAgent.CanManageSearches" @onclick="() => ToggleAgentSearchManagementAsync(selectedAgent)"><span></span></button></div><div class="setting"><div><strong>Новый токен</strong><p>Старый токен сразу перестанет работать.</p></div><button class="btn secondary" @onclick="() => RotateAsync(selectedAgent)">Перевыпустить</button></div>@if(credential?.AgentId==selectedAgent.Id){<label class="field"><span>Новый токен — сохраните сейчас</span><textarea readonly rows="3">@credential.Token</textarea></label>}@if(selectedAgent.Enabled){<div class="setting danger-zone"><div><strong>Отключить парсер</strong><p>Он больше не сможет получать задания.</p></div><button class="btn danger" @onclick="() => RevokeAsync(selectedAgent)">Отключить</button></div>}<div class="modal-actions"><span></span><button class="btn secondary" @onclick="CloseAgent">Закрыть</button></div></Modal>}
@if(selectedJob is not null){<Modal Title="Результат запуска" OnClose="() => selectedJob=null"><div class="dialog-head"><div><strong>@selectedJob.Label</strong><small>@(selectedJob.Agent??"Парсер не назначен")</small></div><StatusBadge Label="@JobLabel(selectedJob.State)" Tone="@JobTone(selectedJob.State)" /></div><dl class="details"><div><dt>Создано</dt><dd>@Time(selectedJob.CreatedAt)</dd></div><div><dt>Завершено</dt><dd>@Time(selectedJob.CompletedAt)</dd></div><div><dt>Обработано</dt><dd>@selectedJob.ProcessedCount</dd></div><div><dt>Принято</dt><dd>@selectedJob.AcceptedCount</dd></div><div><dt>Новых</dt><dd>+@selectedJob.NewListingsCount</dd></div><div><dt>Изменено</dt><dd>@selectedJob.ChangedListingsCount</dd></div></dl>@if(!string.IsNullOrWhiteSpace(selectedJob.ResultCode)){<p class="form-note">Код результата: @selectedJob.ResultCode</p>}<div class="modal-actions"><span></span><button class="btn secondary" @onclick="() => selectedJob=null">Закрыть</button></div></Modal>}

@code{
private const int PageSize=10; private CollectionAdminView? view; private AgentConnectionCode? connectionCode; private AgentCredential? credential; private AgentView? selectedAgent; private CollectionJobView? selectedJob; private SearchView? editingSearch; private AgentInput agentInput=new(); private SearchInput searchInput=new(); private GroupInput groupInput=new(); private bool showSearchModal,showConnectionModal,showGroupsModal; private string query="",groupFilter="all",statusFilter="all",historyQuery="",historyFilter="all"; private int historyPage=1; private readonly HashSet<string> collapsed=[];
protected override async Task ReadAsync()=>view=await Administration.ReadAsync(CurrentSubject,CancellationToken.None);
private int AttentionCount=>(view?.AttentionJobs??0)+(view?.Agents.Count(AgentNeedsAttention)??0)+(view?.Scheduler.State=="Работает"?0:1);
private string AttentionSummary{get{var p=new List<string>();var a=view?.Agents.Count(AgentNeedsAttention)??0;if(a>0)p.Add($"{a} парсеров ждут действия");if(view?.AttentionJobs>0)p.Add($"{view.AttentionJobs} заданий завершились с проблемой");if(view?.Scheduler.State!="Работает")p.Add("планировщик требует проверки");return string.Join("; ",p)+".";}}
private bool HasFilters=>query.Length>0||groupFilter!="all"||statusFilter!="all";
private IReadOnlyList<GroupSection> FilteredSections{get{if(view is null)return[];var f=view.Searches.Where(Matches).ToArray();var r=new List<GroupSection>();foreach(var g in view.Groups.Where(x=>x.Active).OrderBy(x=>x.SortOrder)){var s=f.Where(x=>x.GroupId==g.Id).ToArray();if(s.Length>0)r.Add(Build(g.Id.ToString(),g.Id,g.Name,s));}var u=f.Where(x=>x.GroupId is null).ToArray();if(u.Length>0)r.Add(Build("none",null,"Без группы",u));return r;}}
private List<CollectionJobView> FilteredJobs=>view?.Jobs.Where(j=>(historyQuery.Length==0||j.Label.Contains(historyQuery,StringComparison.OrdinalIgnoreCase)||(j.Agent?.Contains(historyQuery,StringComparison.OrdinalIgnoreCase)??false))&&(historyFilter=="all"||historyFilter=="completed"&&j.State=="Completed"||historyFilter=="running"&&j.State is "Pending" or "Leased"||historyFilter=="attention"&&j.State is not("Pending" or "Leased" or "Completed"))).ToList()??[];
private int HistoryPages=>Math.Max(1,(int)Math.Ceiling(FilteredJobs.Count/(double)PageSize)); private IEnumerable<CollectionJobView> PagedJobs{get{if(historyPage>HistoryPages)historyPage=HistoryPages;return FilteredJobs.Skip((historyPage-1)*PageSize).Take(PageSize);}}
private bool Matches(SearchView s)=>(query.Length==0||s.Label.Contains(query,StringComparison.OrdinalIgnoreCase)||s.Url.Contains(query,StringComparison.OrdinalIgnoreCase))&&(groupFilter=="all"||groupFilter=="none"&&s.GroupId is null||Guid.TryParse(groupFilter,out var id)&&s.GroupId==id)&&(statusFilter=="all"||statusFilter=="active"&&s.Enabled||statusFilter=="paused"&&!s.Enabled||statusFilter=="attention"&&NeedsAttention(s));
private static GroupSection Build(string key,Guid? id,string name,SearchView[] s){var runs=s.Where(x=>x.LastRun is not null).Select(x=>x.LastRun!).ToArray();return new(key,id,name,s,s.Count(x=>x.Enabled),string.Join(", ",s.Select(x=>x.Source).Distinct()),runs.Length==0?null:runs.Max(x=>x.CompletedAt??x.CreatedAt),s.Where(x=>x.Enabled).Select(x=>x.NextRunAt).Where(x=>x.HasValue).DefaultIfEmpty().Min(),runs.Sum(x=>x.ProcessedCount),runs.Sum(x=>x.NewListingsCount));}
private void OpenSearch(Guid? id=null){editingSearch=null;searchInput=new(){GroupId=id};showSearchModal=true;} private void OpenEditSearch(SearchView s){editingSearch=s;searchInput=new(){Label=s.Label,Source=s.Source,Url=s.Url,MaxPages=s.MaxPages,GroupId=s.GroupId,ScheduleKind=s.ScheduleKind,IntervalMinutes=s.IntervalMinutes,FixedTimes=string.Join(", ",s.FixedTimes),Enabled=s.Enabled};showSearchModal=true;} private void CloseSearch(){showSearchModal=false;editingSearch=null;} private void OpenConnection(){agentInput=new();connectionCode=null;showConnectionModal=true;}private void CloseConnection(){showConnectionModal=false;connectionCode=null;}private void OpenGroups(){groupInput=new();showGroupsModal=true;}private void CloseGroups()=>showGroupsModal=false;private void OpenAgent(AgentView a){credential=null;selectedAgent=a;}private void CloseAgent(){credential=null;selectedAgent=null;}private void ResetFilters(){query="";groupFilter="all";statusFilter="all";}private void ShowAttention(){query="";groupFilter="all";statusFilter="attention";}private void ToggleGroup(string k){if(!collapsed.Add(k))collapsed.Remove(k);}private bool IsExpanded(string k)=>!collapsed.Contains(k);
private Task CreateAgentAsync()=>ExecuteAsync(async()=>connectionCode=await Administration.CreateConnectionCodeAsync(CurrentSubject,agentInput.Name,Guid.CreateVersion7().ToString(),CancellationToken.None));
private async Task SaveSearchAsync(){var schedule=new CollectionSchedule(searchInput.ScheduleKind,searchInput.IntervalMinutes,searchInput.FixedTimes.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries));await ExecuteAsync(async()=>{if(editingSearch is null)await Administration.CreateSearchAsync(CurrentSubject,new(searchInput.Label,searchInput.Source,searchInput.Url,searchInput.MaxPages,searchInput.GroupId,schedule),Guid.CreateVersion7().ToString(),CancellationToken.None);else await Administration.UpdateSearchAsync(CurrentSubject,new(editingSearch.Id,editingSearch.Revision,searchInput.Label,searchInput.Source,searchInput.Url,searchInput.MaxPages,searchInput.GroupId,schedule,searchInput.Enabled),Guid.CreateVersion7().ToString(),CancellationToken.None);});if(Error is null)CloseSearch();}private Task ToggleEditedSearchAsync(){searchInput.Enabled=!searchInput.Enabled;return SaveSearchAsync();}
private async Task CreateGroupAsync(){await ExecuteAsync(async()=>{await Administration.CreateGroupAsync(CurrentSubject,groupInput.Name,groupInput.SortOrder,Guid.CreateVersion7().ToString(),CancellationToken.None);groupInput=new();});}private Task ArchiveGroupAsync(SearchGroupView g)=>ExecuteAsync(()=>Administration.ArchiveGroupAsync(CurrentSubject,g.Id,g.Revision,Guid.CreateVersion7().ToString(),CancellationToken.None));private Task EnqueueAsync(Guid id)=>ExecuteAsync(()=>Administration.EnqueueAsync(CurrentSubject,id,Guid.CreateVersion7().ToString(),CancellationToken.None));private async Task ToggleAgentSearchManagementAsync(AgentView a){await ExecuteAsync(()=>Administration.SetAgentSearchManagementAsync(CurrentSubject,a.Id,a.Revision,!a.CanManageSearches,Guid.CreateVersion7().ToString(),CancellationToken.None));selectedAgent=view?.Agents.FirstOrDefault(x=>x.Id==a.Id);}private async Task RotateAsync(AgentView a){await ExecuteAsync(async()=>credential=await Administration.RotateCredentialAsync(CurrentSubject,a.Id,a.Revision,Guid.CreateVersion7().ToString(),CancellationToken.None));selectedAgent=view?.Agents.FirstOrDefault(x=>x.Id==a.Id);}private async Task RevokeAsync(AgentView a){await ExecuteAsync(()=>Administration.RevokeAgentAsync(CurrentSubject,a.Id,a.Revision,Guid.CreateVersion7().ToString(),CancellationToken.None));selectedAgent=view?.Agents.FirstOrDefault(x=>x.Id==a.Id);}
