@using LandErp.Application.Foundation.Files
@using LandErp.Application.Modules.Procurement.Contracts
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js

<section class="attachment-gallery @(Compact?"compact":"") @(Featured?"featured":"")" @ref="root">
    @if(!Compact){<div class="gallery-heading"><div><h3>@Title</h3>@if(!Featured){<p>Фото и видео можно открыть для просмотра</p>}</div><span class="gallery-count">@(Featured?Media.Count:Ready.Count)</span></div>}
    @if(Featured&&FeaturedFile is {} active)
    {
        <div class="featured-main">
            <div class="featured-stage" @key="active.Id">
                @if(featuredError){<div class="featured-error"><strong>Предпросмотр недоступен</strong><span>Попробуйте открыть материал или скачать оригинал.</span></div>}
                else if(AttachmentMediaTypes.IsVideo(active.ContentType)){<video class="featured-video" src="@MediaUrl(active)" controls playsinline preload="metadata" @onerror="()=>featuredError=true"></video>}
                else{<button type="button" class="featured-photo" aria-label="Открыть: @active.Label" @onclick="()=>OpenAsync(active)"><img src="@MediaUrl(active)" alt="@active.Label" @onerror="()=>featuredError=true"/></button>}
                <span class="featured-position">@(AttachmentMediaTypes.IsVideo(active.ContentType)?"Видео":"Фото") · @(FeaturedIndex+1) / @Media.Count</span>
                <button type="button" class="featured-expand" title="Открыть крупнее" aria-label="@(AttachmentMediaTypes.IsVideo(active.ContentType)||featuredError?$"Открыть: {active.Label}":"Открыть крупнее")" @onclick="()=>OpenAsync(active)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg></button>
                @if(Media.Count>1){<button type="button" class="featured-nav featured-prev" aria-label="Предыдущий кадр" @onclick="()=>StepFeaturedAsync(-1)">‹</button><button type="button" class="featured-nav featured-next" aria-label="Следующий кадр" @onclick="()=>StepFeaturedAsync(1)">›</button>}
            </div>
            <div class="featured-toolbar"><div class="featured-file"><strong title="@active.OriginalName">@active.Label</strong><small>@Size(active.SizeBytes)</small></div><div class="featured-actions"><a href="@DownloadUrl(active)" class="btn quiet" download><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M4 16v5h16v-5"/></svg>Скачать</a>@if(CanDelete){<button type="button" class="btn quiet featured-delete" title="Удалить выбранный материал" aria-label="Удалить выбранный материал" disabled="@Disabled" @onclick="()=>OnDelete.InvokeAsync(active)"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7"/></svg></button>}</div></div>
        </div>
        <div class="featured-filmstrip"><button type="button" class="filmstrip-step" aria-label="Прокрутить миниатюры влево" @onclick="()=>ScrollThumbsAsync(-1)">‹</button><div class="featured-thumbnails" role="group" aria-label="Миниатюры материалов">
        @foreach(var file in Media)
        {
            <button type="button" class="featured-thumb" @key="file.Id" data-active="@(file.Id==active.Id?"true":"false")" aria-pressed="@(file.Id==active.Id)" aria-label="Выбрать: @file.Label" title="@file.Label" @onclick="()=>SelectFeaturedAsync(file)">
                @if(previewErrors.Contains(file.Id)){<span class="thumb-placeholder" aria-hidden="true">@(AttachmentMediaTypes.IsVideo(file.ContentType)?"▶":"▧")</span>}
                else if(AttachmentMediaTypes.IsVideo(file.ContentType)){<video data-preview="@MediaUrl(file)" preload="metadata" muted playsinline tabindex="-1" aria-hidden="true" @onerror="()=>PreviewError(file.Id)"></video><span class="thumb-video" aria-hidden="true">▶</span>}
                else{<img src="@MediaUrl(file)" alt="" loading="lazy" decoding="async" @onerror="()=>PreviewError(file.Id)"/>}
            </button>
        }
        </div><button type="button" class="filmstrip-step" aria-label="Прокрутить миниатюры вправо" @onclick="()=>ScrollThumbsAsync(1)">›</button></div>
    }
    @if(!Featured&&Media.Count>0)
    {
        <div class="media-grid">
        @foreach(var file in Media)
        {
            bool video=AttachmentMediaTypes.IsVideo(file.ContentType);
            <article class="media-card" @key="file.Id">
                <button type="button" class="media-preview" aria-label="Открыть: @file.Label" @onclick="()=>OpenAsync(file)">
                    @if(previewErrors.Contains(file.Id)){<span class="preview-placeholder">@(video?"▶":"▧")<small>Открыть материал</small></span>}
                    else if(video){<video data-preview="@MediaUrl(file)" preload="metadata" muted playsinline tabindex="-1" aria-hidden="true" @onerror="()=>PreviewError(file.Id)"></video><span class="play-mark" aria-hidden="true">▶</span>}
                    else{<img src="@MediaUrl(file)" alt="" loading="lazy" decoding="async" @onerror="()=>PreviewError(file.Id)"/>}
                    <span class="media-kind">@(video?"Видео":"Фото")</span>
                </button>
                <div class="media-caption"><strong title="@file.OriginalName">@file.Label</strong><small>@Size(file.SizeBytes)</small></div>
                <div class="media-actions"><a href="@DownloadUrl(file)" class="btn quiet" download>Скачать</a>@if(CanDelete){<button type="button" class="btn quiet delete-action" disabled="@Disabled" @onclick="()=>OnDelete.InvokeAsync(file)">Удалить</button>}</div>
            </article>
        }
        </div>
    }
    @foreach(var file in Ready.Where(x=>!AttachmentMediaTypes.IsPreviewable(x.ContentType)||x.External))
    {
        <div class="gallery-file"><span class="file-symbol" aria-hidden="true">▤</span><div><strong>@file.Label</strong><small>@(file.External?"Ссылка":Size(file.SizeBytes))</small></div><a class="btn quiet" href="@DownloadUrl(file)" target="_blank" rel="noopener">@(file.External?"Открыть ссылку":"Скачать")</a>@if(CanDelete){<button type="button" class="btn quiet delete-action" disabled="@Disabled" @onclick="()=>OnDelete.InvokeAsync(file)">Удалить</button>}</div>
    }
    @if(Failed.Count>0)
    {
        <details class="failed-uploads"><summary><span class="failure-mark" aria-hidden="true">!</span>Не завершено <span class="failure-count">@Failed.Count</span></summary>
            <p>Загрузка не была подтверждена. Для повтора выберите исходный файл — новое вложение не создаётся.</p>
            @foreach(var file in Failed){<div class="failed-file"><div><strong>@file.OriginalName</strong><small>@ProcurementLabels.FileStatus(file.Status) · @Size(file.SizeBytes)</small></div>@if(CanRetry?.Invoke(file)==true){<button type="button" class="btn secondary" disabled="@Disabled" @onclick="()=>OnRetry.InvokeAsync(file.Id)">Повторить загрузку</button>}</div>}
        </details>
    }
    @foreach(var file in Files.Where(x=>x.Status is StoredFileStatus.Quarantined or StoredFileStatus.Rejected)){<p class="gallery-notice">@file.Label · @ProcurementLabels.FileStatus(file.Status)</p>}
    @if(!Files.Any(x=>x.Status!=StoredFileStatus.Deleted)&&!Compact){<div class="gallery-empty"><span aria-hidden="true">▧</span><p>Материалов пока нет</p><small>Загруженные фото, видео и документы появятся здесь.</small></div>}
</section>
@if(Selected is {} selected)
{
    <dialog class="media-viewer" @ref="viewer" aria-label="Просмотр материалов">
        <div class="viewer-shell">
            <header><div><strong>@selected.Label</strong><small>@selected.OriginalName · @Size(selected.SizeBytes) · @(SelectedIndex+1) из @Media.Count</small></div><button type="button" class="viewer-close" aria-label="Закрыть просмотр" @onclick="CloseAsync">×</button></header>
            <div class="viewer-stage">
                @if(Media.Count>1){<button type="button" class="viewer-arrow previous" aria-label="Предыдущий материал" @onclick="()=>NavigateAsync(-1)">‹</button>}
                <div class="viewer-content" @key="selected.Id">
                    @if(viewerError){<div class="viewer-error" role="alert"><strong>Не удалось открыть материал</strong><p>Возможно, браузер не поддерживает формат или доступ к файлу изменился.</p><a class="btn secondary" href="@DownloadUrl(selected)" download>Скачать оригинал</a></div>}
                    else if(AttachmentMediaTypes.IsVideo(selected.ContentType)){<video src="@MediaUrl(selected)" controls playsinline preload="metadata" @onerror="()=>viewerError=true"></video>}
                    else{<div class="photo-viewport"><div class="photo-canvas" style="width:@(zoom*100)%;height:@(zoom*100)%"><img class="viewer-photo" src="@MediaUrl(selected)" alt="@selected.Label" @ondblclick="()=>{zoom=zoom>1?1:2;centerPhoto=true;}" @onerror="()=>viewerError=true"/></div></div>}
                </div>
                @if(Media.Count>1){<button type="button" class="viewer-arrow next" aria-label="Следующий материал" @onclick="()=>NavigateAsync(1)">›</button>}
            </div>
            <footer><div class="zoom-actions">@if(AttachmentMediaTypes.IsImage(selected.ContentType)&&!viewerError){<button type="button" aria-label="Уменьшить фото" disabled="@(zoom<=1)" @onclick="()=>Zoom(-1)">−</button><button type="button" aria-label="Сбросить увеличение" @onclick="()=>zoom=1">@((int)(zoom*100))%</button><button type="button" aria-label="Увеличить фото" disabled="@(zoom>=3)" @onclick="()=>Zoom(1)">+</button>}</div><div class="viewer-actions"><a class="btn secondary" href="@DownloadUrl(selected)" download>Скачать</a>@if(CanDelete){<button type="button" class="btn secondary" disabled="@Disabled" @onclick="()=>DeleteSelectedAsync(selected)">Удалить</button>}</div></footer>
        </div>
    </dialog>
}
@code {
    [Parameter] public IReadOnlyList<AttachmentView> Files{get;set;}=[];
    [Parameter] public string Title{get;set;}="Материалы";
    [Parameter] public bool Compact{get;set;}
    [Parameter] public bool Featured{get;set;}
    [Parameter] public bool CanDelete{get;set;}
    [Parameter] public bool Disabled{get;set;}
    [Parameter] public Func<AttachmentView,bool>? CanRetry{get;set;}
    [Parameter] public EventCallback<AttachmentView> OnDelete{get;set;}
    [Parameter] public EventCallback<Guid> OnRetry{get;set;}
    private ElementReference root,viewer;
    private IJSObjectReference? module;
    private Task<IJSObjectReference>? moduleLoading;
    private async Task<IJSObjectReference> ModuleAsync()=>module??=await(moduleLoading??=Js.InvokeAsync<IJSObjectReference>("import","./js/attachment-gallery.js").AsTask());
    private DotNetObjectReference<AttachmentGallery>? receiver;
    private Guid? selectedId,featuredId;
    private bool featuredError,revealThumb;
    private readonly HashSet<Guid> previewErrors=[];
    private double zoom=1;
    private bool viewerError,attached,centerPhoto;
    private List<AttachmentView> Ready=>Files.Where(x=>x.Status==StoredFileStatus.Available).ToList();
    private List<AttachmentView> Media=>Ready.Where(x=>!x.External&&AttachmentMediaTypes.IsPreviewable(x.ContentType)).ToList();
    private List<AttachmentView> Failed=>Files.Where(x=>x.Status is StoredFileStatus.UploadFailed or StoredFileStatus.PendingUpload).ToList();
    private AttachmentView? FeaturedFile=>Media.FirstOrDefault(x=>x.Id==featuredId);
    private int FeaturedIndex=>Media.FindIndex(x=>x.Id==featuredId);
    private async Task SelectFeaturedAsync(AttachmentView file)
    {
        if(featuredId==file.Id)return;
        await(await ModuleAsync()).InvokeVoidAsync("stopFeatured",root);
        featuredId=file.Id;featuredError=false;revealThumb=true;await InvokeAsync(StateHasChanged);
    }
    private Task StepFeaturedAsync(int direction){var items=Media;return items.Count==0?Task.CompletedTask:SelectFeaturedAsync(items[(FeaturedIndex+Math.Sign(direction)+items.Count)%items.Count]);}
    private async Task ScrollThumbsAsync(int direction){revealThumb=false;await(await ModuleAsync()).InvokeVoidAsync("scrollThumbs",root,direction);}
    private AttachmentView? Selected=>Media.FirstOrDefault(x=>x.Id==selectedId);
    private int SelectedIndex=>Media.FindIndex(x=>x.Id==selectedId);
    private static string MediaUrl(AttachmentView file)=>$"/api/procurement/attachments/{file.Id}/media";
    private static string DownloadUrl(AttachmentView file)=>$"/api/procurement/attachments/{file.Id}";
    private static string Size(long bytes)=>bytes>=1024*1024?$"{bytes/(1024d*1024):0.0} МБ":bytes>0?$"{bytes/1024d:0.#} КБ":"Размер не подтверждён";
    private void PreviewError(Guid id)=>previewErrors.Add(id);
    protected override async Task OnParametersSetAsync(){if(Featured&&!Media.Any(x=>x.Id==featuredId)){featuredId=(Media.FirstOrDefault(x=>AttachmentMediaTypes.IsImage(x.ContentType))??Media.FirstOrDefault())?.Id;featuredError=false;revealThumb=featuredId!=null;}if(selectedId!=null&&Selected==null)await CloseAsync();}
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        module=await ModuleAsync();
        await module.InvokeVoidAsync("observe",root);
        if(revealThumb){revealThumb=false;await module.InvokeVoidAsync("revealThumb",root);}
        if(centerPhoto&&attached){await module.InvokeVoidAsync("center",viewer);centerPhoto=false;}
        if(Selected!=null&&!attached){receiver??=DotNetObjectReference.Create(this);await module.InvokeVoidAsync("open",viewer,receiver);attached=true;}
    }
    private async Task OpenAsync(AttachmentView file){if(Featured)await(await ModuleAsync()).InvokeVoidAsync("pauseFeatured",root);if(Selected!=null)await CloseAsync();selectedId=file.Id;zoom=1;viewerError=false;}
    [JSInvokable] public async Task CloseAsync(){if(module!=null&&attached)await module.InvokeVoidAsync("close",viewer);selectedId=null;attached=false;await InvokeAsync(StateHasChanged);}
    [JSInvokable] public async Task NavigateAsync(int direction){if(module!=null)await module.InvokeVoidAsync("stop",viewer);var items=Media;if(items.Count>0){int index=(SelectedIndex+direction+items.Count)%items.Count;selectedId=items[index].Id;zoom=1;viewerError=false;await InvokeAsync(StateHasChanged);}}
    [JSInvokable] public Task ZoomAsync(int direction){Zoom(direction);return InvokeAsync(StateHasChanged);}
    private void Zoom(int direction){zoom=Math.Clamp(zoom+direction*0.5,1,3);centerPhoto=true;}
    private async Task DeleteSelectedAsync(AttachmentView file){await CloseAsync();await OnDelete.InvokeAsync(file);}
    public async ValueTask DisposeAsync(){if(module!=null){try{if(attached)await module.InvokeVoidAsync("close",viewer);if(Featured)await module.InvokeVoidAsync("stopFeatured",root);await module.InvokeVoidAsync("disconnect",root);await module.DisposeAsync();}catch(JSDisconnectedException){}}receiver?.Dispose();}
}