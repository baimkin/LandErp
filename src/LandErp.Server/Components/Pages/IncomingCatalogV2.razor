            <label class="field"><span>Причина</span><select @bind="classificationCategory"><option>Цена</option><option>Площадь</option><option>Локация</option><option>Пропорции</option><option>Категория / ВРИ</option><option>Технические проблемы</option><option>Другое</option></select></label>
        }
        else if (classification == CatalogDisposition.Fake)
        {
            <label class="field"><span>Причина</span><select @bind="classificationCategory"><option>Нереальная цена</option><option>Фото/описание не соответствует</option><option>Объект не существует</option><option>Другое</option></select></label>
        }
        else if (classification == CatalogDisposition.Duplicate)
        {
            @* TODO-BACKEND-INCOMING: duplicate target matching/linking contract is absent. This selector is UI-only and disabled. *@
            <label class="field" data-todo-backend="TODO-BACKEND-INCOMING"><span>Дубль чего</span><select disabled><option>PC-0187 · Сходня · 10 сот.</option><option>Найти другой объект…</option></select></label>
        }
        else if (classification == CatalogDisposition.RemovedAtSource)
        {
            @* TODO-BACKEND-INCOMING: structured removed-at date is not supported by the current classification command. *@
            <p>Фиксируется только состояние объявления. Это не означает продажу объекта.</p><label class="field" data-todo-backend="TODO-BACKEND-INCOMING"><span>Дата</span><input type="date" disabled /></label>
        }
        else if (classification == CatalogDisposition.Sold)
        {
            @* TODO-BACKEND-INCOMING: confirmation source / sale date / sale price have no structured persistence contract. Fields are disabled and never sent. *@
            <div data-todo-backend="TODO-BACKEND-INCOMING"><p>Подтверждённый человеком факт о реальном объекте.</p><label class="field"><span>Дата подтверждения</span><input type="date" disabled /></label><label class="field"><span>Источник</span><select disabled><option>Со слов продавца</option><option>Со слов агента</option><option>Другой подтверждённый источник</option></select></label><label class="field"><span>Цена сделки, ₽ (необязательно)</span><input inputmode="numeric" disabled /></label></div>
        }
        <label class="field"><span>Причина / подтверждение</span><InputTextArea @bind-Value="classificationReason" /></label>
        <div class="form-actions"><ActionButton Label="Отмена" Tone="quiet" OnClick="() => classificationOpen = false" /><ActionButton Label="Подтвердить" Busy="Busy" OnClick="ClassifyAsync" /></div>
    </Modal>
}

