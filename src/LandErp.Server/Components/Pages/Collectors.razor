@page "/collectors"
@attribute [Authorize]
@inherits WorkspaceComponent
@using LandErp.Application.Foundation
@using LandErp.Application.Foundation.Files
@using LandErp.Application.Modules.Collection.Contracts
@using LandErp.Application.Modules.Collection.Domain
@using LandErp.Application.Modules.Catalog.Domain
@using LandErp.Collector.Contracts.V1
@inject ICollectionAdministration Administration
@inject IEmployeeAccessService AccessV1
@inject IDatabaseStatus DatabaseStatus
@inject IFileStorageHealth StorageStatus
@inject NavigationManager Navigation

<PageTitle>Поиски и парсинг · LandErp</PageTitle>
<div class="collectors-page" @ref="listsRoot" data-lists-tab="@activeTab" data-list-ready="@(listsMounted ? "true" : "false")">
<PageHeader Title="Поиски и парсинг" Breadcrumb="Данные / Поиски и парсинг" Description="Сбор объявлений, зоны поиска и работа парсеров.">
    @if(CanManageCollection){<button class="btn primary" disabled="@Busy" @onclick="() => OpenSearch()">+ Добавить поиск</button>}
</PageHeader>
@if (CanShowWorkspace)
{
    <div class="workspace-tabs" role="tablist" aria-label="Разделы поисков и парсинга">
        @foreach(int value in VisibleTabs)
        {
            int index = value;
            <button @ref="tabButtons[index]" id="@($"parsing-tab-{TabKeys[index]}")" role="tab" aria-selected="@(activeTab == TabKeys[index] ? "true" : "false")" aria-controls="parsing-panel" tabindex="@(activeTab == TabKeys[index] ? 0 : -1)" @onclick="() => SelectTab(TabKeys[index])" @onkeydown="e => TabKeyAsync(e, index)">
                <ParsingIcon Name="@(index switch {1 => "zones", 2 => "search", 3 => "history", _ => "home"})" />@TabLabels[index]
                @if(index == 0 && IssueSearches.Length > 0){<span class="tab-count danger">@IssueSearches.Length</span>}
                @if(index == 1){<span class="tab-count">@view!.Groups.Count</span>}
                @if(index == 2){<span class="tab-count">@view!.Searches.Count</span>}
            </button>
        }
    </div>
}
<div class="refresh-line"><span>Обновлено @Time(refreshedAt) · @ZoneLabel · каждые 15 с</span><button type="button" class="text-action" disabled="@(Busy || Loading)" @onclick="ReloadAsync"><ParsingIcon Name="refresh" /> Обновить</button></div>
@if(refreshMessage is not null){<p role="status" class="form-note">@refreshMessage</p>}
@if(Error is not null && !HasOpenDialog){<PageState Kind="error" Title="@Error" />}
@if(Success is not null && !HasOpenDialog){<p role="status" class="success-notice">@Success</p>}
@if(Loading){<PageState Kind="loading" Title="Загружаем поиски и парсеры…" />}
else if(Forbidden){<PageState Kind="forbidden" Title="Нет доступа" />}
else if(!databaseReady){<PageState Kind="error" Title="База данных недоступна"><p>Не удалось получить рабочие данные. Проверьте подключение и повторите обновление.</p></PageState>}
else if(view is not null)
{
<div id="parsing-panel" role="tabpanel" aria-labelledby="@($"parsing-tab-{activeTab}")" tabindex="0">
@if(activeTab == "home" && view.CanReadCollection)
{
    <section class="workspace-card ops-health" aria-label="Состояние системы">
        <div class="section-heading"><h2>Состояние системы</h2><span class="muted">@(SchedulerHealthy && WorkerHealthy && StorageHealthy ? "Сервисы доступны" : "Есть состояния для проверки")</span></div>
        <div class="ops-health-grid">
            <article class="health-item ok"><i></i><div><strong>Сайт</strong><small>Отвечает на запросы</small></div></article>
            <article class="health-item @HealthTone(databaseReady)"><i></i><div><strong>База данных</strong><small>@(databaseReady ? "Соединение установлено" : "Недоступна")</small></div></article>
            <article class="health-item @HealthTone(WorkerHealthy)"><i></i><div><strong>Фоновая служба</strong><small>@WorkerState · @Time(view.Scheduler.LastStartedAt)</small></div></article>
            <article class="health-item @HealthTone(SchedulerHealthy)"><i></i><div><strong>Планировщик</strong><small>@view.Scheduler.State · @Time(view.Scheduler.LastSucceededAt)</small></div></article>
            <article class="health-item @(StaleAgents + OfflineAgents > 0 ? "warn" : "ok")"><i></i><div><strong>Парсеры</strong><small>@view.OnlineAgents на связи · @StaleAgents давно не отвечают · @OfflineAgents не на связи</small></div></article>
            <article class="health-item @(BacklogCount > 0 ? "warn" : "ok")"><i></i><div><strong>Очередь</strong><small>@view.PendingJobs ожидают запуска · @ExpiredLeaseCount доступны для переназначения</small></div></article>
            <article class="health-item @(ExpiredLeaseCount > 0 ? "bad" : "ok")"><i></i><div><strong>Просроченные задания</strong><small>@ExpiredLeaseCount · @(ExpiredLeaseCount == 0 ? "все назначения актуальны" : "ожидают свободный парсер")</small></div></article>
            <article class="health-item @HealthTone(StorageHealthy)"><i></i><div><strong>Хранилище</strong><small>@(StorageHealthy ? "Доступно для файлов" : StorageLabel(storageHealth))</small></div></article>
        </div>
    </section>
    <section class="workspace-card issue-panel" aria-label="Проблемные поиски">
        <div class="section-heading"><div><h2>Требуют внимания <span class="tab-count danger">@IssueSearches.Length</span></h2><p>Проблемы последних запусков и действия для их устранения.</p></div></div>
        <div class="chips">@foreach(string category in new[]{"all", "area", "access", "collection"}){<button class="chip" aria-pressed="@(issueFilter == category ? "true" : "false")" @onclick="() => issueFilter = category">@IssueFilterLabel(category) <span>@IssueCount(category)</span></button>}</div>
        @if(!VisibleIssues.Any()) { <div class="empty"><strong>@(IssueSearches.Length == 0 ? "Проблемных запусков нет" : "В этой категории проблем нет")</strong><span>Состояние обновляется автоматически.</span></div> }
        else
        {
            <div class="data-wrap issue-wrap"><table class="workspace-table issue-table"><thead><tr><th>Зона и источник</th><th>Результат и причина</th><th>Последний запуск</th><th><span class="sr-only">Действия</span></th></tr></thead><tbody>
            @foreach(var search in VisibleIssues)
            {
                var run = IssueRun(search); var result = Result(run);
                <tr @key="search.Id" data-search="@search.Id" data-row-key="@search.Id">
                    <td><strong>@DisplayName(search)</strong><div class="subline">@search.Source · <a href="@search.Url" target="_blank" rel="noopener noreferrer">Ссылка поиска ↗</a></div>@if(search.Label != DisplayName(search)){<small>@search.Label</small>}</td>
                    <td class="result-cell"><StatusBadge Label="@result.Label" Tone="@result.Tone" /><p>@result.Help</p>@if(Active(search)){<small class="active-state">@Result(search.ActiveRun).Label · повтор уже запущен</small>}</td>
                    <td class="issue-time"><span>@Time(run?.CompletedAt ?? run?.CreatedAt)</span><small>@SavedCount(run)</small><small>@(run?.Agent ?? "Парсер не назначен")</small>@if(run?.RetryAt is not null){<small>Автоповтор: @Time(run.RetryAt)</small>}</td>
                    <td><div class="row-actions">@if(CanManageCollection){<button class="btn secondary compact" title="@RunDisabledReason(search)" disabled="@(!CanRun(search))" @onclick="() => EnqueueAsync(search.Id)"><ParsingIcon Name="refresh" /> Повторить</button><button class="icon-action" title="Изменить ссылку" aria-label="Изменить ссылку поиска @search.Label" disabled="@(!CanEdit(search))" @onclick="() => OpenLinkEdit(search)"><ParsingIcon Name="edit" /></button>}</div></td>
                </tr>
            }
            </tbody></table></div>
        }
        <div class="panel-foot"><span>Проблема снимается после успешной проверки повторного запуска.</span><button class="text-action" @onclick='() => SelectTab("history")'>История запусков ›</button></div>
    </section>
    <section aria-label="Локальные парсеры">
        <div class="section-heading outside"><div><h2>Локальные парсеры</h2><p>@view.OnlineAgents на связи · @view.BusyAgents выполняют задания</p></div>@if(CanManageCollection){<button class="btn secondary" disabled="@Busy" @onclick="OpenConnection">+ Подключить парсер</button>}</div>
        @if(view.Agents.Count == 0){<div class="workspace-card empty"><strong>Парсеры ещё не подключены</strong><span>Создайте код подключения и вставьте его в LandErp Parser.</span></div>}
        else {<div class="agent-grid">@foreach(var agent in view.Agents.OrderByDescending(a => AgentNeedsAttention(a)).ThenByDescending(a => a.Online).ThenBy(a => a.Name)){
            <article class="agent-card @AgentTone(agent)"><div class="agent-title"><div class="agent-name"><span class="agent-device"><ParsingIcon Name="computer" /></span><span><strong>@agent.Name</strong><small>@Capabilities(agent.Capabilities)</small></span></div><StatusBadge Label="@agent.OperationalStatus" Tone="@AgentBadgeTone(agent)" /></div>
                <div class="agent-work"><small>@(AgentNeedsAttention(agent) ? "Требует внимания" : agent.CurrentSearch is not null ? "Сейчас выполняет" : agent.Online ? "Готов к работе" : "Нет активного подключения")</small><strong>@(agent.CurrentSearch ?? (agent.Enabled ? "Ожидает следующее задание" : "Парсер отключён"))</strong>
                @if(AgentNeedsAttention(agent)){<p>Откройте локальный Parser и проверьте вкладку источника.</p>}
                @if(agent.CurrentSearch is not null){<div class="progress"><i style="width:@Progress(agent)%"></i></div><small>@ProgressLabel(agent)</small>}</div>
                <footer><span>Связь: @Time(agent.LastHeartbeatAt)</span>@if(CanManageCollection){<button class="text-action" @onclick="() => OpenAgent(agent)" aria-label="Настройки @agent.Name">Настройки</button>}</footer>
            </article>
        }</div>}
    </section>
}
@{
    <section class="workspace-card zones-card list-panel" hidden="@(activeTab != "zones")"><div class="section-heading"><div><h2>Зоны поиска <span class="tab-count">@view.Groups.Count</span></h2><p>Зоны объединяют поиски и задают контекст рыночных расчётов.</p></div>@if(CanManageSearchGroups){<button class="btn secondary" disabled="@Busy" @onclick="OpenGroups">+ Добавить зону</button>}</div>
        <div class="filters"><label class="search-box"><span class="sr-only">Найти зону</span><input placeholder="Найти зону" @bind="zoneQuery" @bind:event="oninput" @bind:after='() => ResetListPosition("zones")' /></label><label><span class="sr-only">Состояние зон</span><select aria-label="Состояние зон" @bind="zoneState" @bind:after='() => ResetListPosition("zones")'><option value="active">Действующие зоны</option><option value="archived">Архив</option><option value="all">Все зоны</option></select></label></div>
        <div class="data-wrap list-viewport" data-scroll-list="zones" tabindex="0" role="region" aria-label="Таблица зон поиска"><table class="workspace-table zones-table"><thead><tr><th>Зона</th><th>Поиски</th><th>Состояние</th><th>Владелец</th><th><span class="sr-only">Действия</span></th></tr></thead><tbody>
        @foreach(var group in WorkspaceZones){<tr @key="group.Id" data-row-key="@group.Id"><td><strong>@group.Name</strong></td><td>@if(view.CanReadCollection){<button class="text-action" @onclick="() => ShowZoneSearches(group.Id)">@group.SearchCount поисков ›</button>}else{<span>@group.SearchCount поисков</span>}</td><td><StatusBadge Label="@(group.Active ? "Активна" : "Архив")" Tone="@(group.Active ? "success" : "neutral")" />@if(ZoneIssueCount(group.Id) > 0){<small class="danger-text">Проблемных поисков: @ZoneIssueCount(group.Id)</small>}</td><td>@(group.OwnerName ?? "Административная зона")</td><td><div class="row-actions">@if(group.CanManage){<button class="icon-action" aria-label="Изменить зону @group.Name" title="Изменить зону" disabled="@Busy" @onclick="() => EditGroup(group)"><ParsingIcon Name="edit" /></button>@if(group.Active){<button class="text-action danger-text" disabled="@Busy" @onclick="() => ArchiveGroupAsync(group)">В архив</button>}}</div></td></tr>}
        </tbody></table></div>
        @if(WorkspaceZones.Length == 0){<div class="empty"><strong>Зоны не найдены</strong><span>Измените фильтр или добавьте зону.</span></div>}
        <div class="list-footer"><span>Найдено @WorkspaceZones.Length из @view.Groups.Count зон</span></div>
    </section>
}
@if(view.CanReadCollection)
{
    <section class="workspace-card searches-card list-panel" hidden="@(activeTab != "searches")"><div class="section-heading"><div><h2>Список поисков <span class="tab-count">@view.Searches.Count</span></h2><p>Ссылки, расписания и результаты последних запусков.</p></div></div>
        <div class="filters"><label class="search-box"><span class="sr-only">Найти поиск</span><input placeholder="Найти по зоне, названию или ссылке" @bind="query" @bind:event="oninput" @bind:after='() => ResetListPosition("searches")' /></label><label><span class="sr-only">Зона</span><select aria-label="Зона" @bind="groupFilter" @bind:after='() => ResetListPosition("searches")'><option value="all">Все зоны</option><option value="none">Без зоны</option>@foreach(var group in view.Groups){<option value="@group.Id">@group.Name</option>}</select></label><label><span class="sr-only">Источник</span><select aria-label="Источник" @bind="sourceFilter" @bind:after='() => ResetListPosition("searches")'><option value="all">Все источники</option><option value="Avito">Avito</option><option value="Cian">Циан</option></select></label><label><span class="sr-only">Статус поиска</span><select aria-label="Статус поиска" @bind="statusFilter" @bind:after='() => ResetListPosition("searches")'><option value="all">Все статусы</option><option value="active">Активные</option><option value="paused">Приостановленные</option><option value="attention">Требуют внимания</option></select></label><label><span class="sr-only">Архив зон</span><select aria-label="Архив зон" @bind="groupVisibility" @bind:after='() => ResetListPosition("searches")'><option value="active">Действующие зоны</option><option value="archived">Архив зон</option><option value="all">Включая архив</option></select></label>@if(HasFilters){<button class="text-action" @onclick="ResetFilters">Сбросить</button>}</div>
        <div class="data-wrap list-viewport" data-scroll-list="searches" tabindex="0" role="region" aria-label="Таблица поисков"><table class="workspace-table search-table"><thead><tr><th>Зона и источник</th><th>Расписание</th><th>Результат и причина</th><th>Последний запуск</th><th>Локальный парсер</th><th><span class="sr-only">Действия</span></th></tr></thead><tbody>
        @foreach(var search in WorkspaceSearches){var result = Result(search.LastRun);<tr @key="search.Id" data-search="@search.Id" data-row-key="@search.Id"><td><strong>@DisplayName(search)</strong><div class="subline">@search.Source · <a href="@search.Url" target="_blank" rel="noopener noreferrer">Ссылка ↗</a></div>@if(search.Label != DisplayName(search)){<small>@search.Label</small>}</td><td>@search.Schedule<small>@(search.Enabled ? search.NextRunAt is null ? "Запуск вручную" : $"Следующий — {Time(search.NextRunAt)}" : "Приостановлен")</small></td><td class="result-cell"><StatusBadge Label="@result.Label" Tone="@result.Tone" /><p>@result.Help</p>@if(search.ActiveRun is not null){<small class="active-state">@Result(search.ActiveRun).Label · @Result(search.ActiveRun).Help</small>}@if(search.LastRun?.RetryAt is not null){<small>Автоповтор: @Time(search.LastRun.RetryAt)</small>}</td><td>@Time(search.LastRun?.CompletedAt ?? search.LastRun?.CreatedAt)<small>@SavedCount(search.LastRun)</small></td><td>@(search.LastRun?.Agent ?? "—")</td><td><div class="row-actions">@if(CanManageCollection){<button class="btn secondary compact" title="@RunDisabledReason(search)" disabled="@(!CanRun(search))" @onclick="() => EnqueueAsync(search.Id)"><ParsingIcon Name="refresh" /> Запустить</button><button class="icon-action" aria-label="Настроить поиск @search.Label" title="Редактировать поиск" disabled="@(!CanEdit(search))" @onclick="() => OpenEditSearch(search)"><ParsingIcon Name="edit" /></button>}</div></td></tr>}
        </tbody></table></div>
        @if(WorkspaceSearches.Length == 0){<div class="empty"><strong>Поиски не найдены</strong><span>Измените фильтры или добавьте поиск.</span></div>}
        <div class="list-footer"><span>Найдено @WorkspaceSearches.Length из @view.Searches.Count поисков</span></div>
    </section>
}
@if(view.CanReadCollection)
{
    <section class="workspace-card history-card list-panel" hidden="@(activeTab != "history")"><div class="section-heading"><div><h2>История запусков</h2><p>Вся история · @ZoneLabel. Загружается по 50 записей.</p></div><span class="muted">Найдено @historyTotal записей</span></div>
        <div class="filters"><label class="search-box"><span class="sr-only">Найти запуск</span><input placeholder="Найти запуск по названию или парсеру" @bind="historyQuery" @bind:event="oninput" @bind:after="HistoryFiltersChangedAsync" /></label><label><span class="sr-only">Результат запуска</span><select aria-label="Результат запуска" @bind="historyFilter" @bind:after="HistoryFiltersChangedAsync"><option value="all">Все результаты</option><option value="completed">Завершённые (включая лимит)</option><option value="attention">Требуют внимания</option><option value="running">В работе</option></select></label><label><span class="sr-only">Источник запуска</span><select aria-label="Источник запуска" @bind="historySource" @bind:after="HistoryFiltersChangedAsync"><option value="all">Все источники</option><option value="Avito">Avito</option><option value="Cian">Циан</option></select></label></div>
        @if(historyError is not null){<p role="alert" class="form-error">@historyError <button class="text-action" disabled="@historyLoading" @onclick="() => LoadHistoryAsync()">Повторить</button></p>}
        <div class="data-wrap list-viewport" data-scroll-list="history" tabindex="0" role="region" aria-label="История запусков"><table class="workspace-table history-table"><thead><tr><th>Поиск</th><th>Время запуска</th><th>Результат и причина</th><th>Сохранено</th><th>Локальный парсер</th><th>Изменения</th><th><span class="sr-only">Действия</span></th></tr></thead><tbody>
        @foreach(var job in historyRows){var result = Result(job);var search = FindSearch(job.SearchId);<tr @key="job.Id" data-row-key="@job.Id"><td><strong>@job.Label</strong><small>@search?.Source</small></td><td>@Time(job.CreatedAt)<small>@(job.CompletedAt is null ? "" : $"Завершён {Time(job.CompletedAt)}")</small></td><td class="result-cell"><StatusBadge Label="@result.Label" Tone="@result.Tone" /><p>@result.Help</p>@if(job.RetryAt is not null){<small>Автоповтор: @Time(job.RetryAt)</small>}@if(job.Coverage is not null){<small>@CoverageText(job.Coverage)</small>}</td><td>@(Finished(job.State) ? job.AcceptedCount.ToString() : "—")<small>Обработано: @job.ProcessedCount</small></td><td>@(job.Agent ?? "Ещё не назначен")</td><td><span class="positive">+@job.NewListingsCount новых</span><small>@job.ChangedListingsCount изменено</small></td><td>@if(CanManageCollection && search is not null){<button class="icon-action" aria-label="Изменить текущий поиск @search.Label" title="Изменить текущий поиск" disabled="@(!CanEdit(search))" @onclick="() => OpenEditSearch(search)"><ParsingIcon Name="edit" /></button>}</td></tr>}
        </tbody></table></div>
        @if(historyRows.Count == 0 && !historyLoading && historyError is null){<div class="empty"><strong>Запуски не найдены</strong><span>Измените фильтры или запустите поиск.</span></div>}
        <div class="list-footer"><span>Показано @historyRows.Count из @historyTotal</span>
            @if(historyLoading){<span role="status">Загружаем историю…</span>}
            @if(historyNext is not null){<button class="btn secondary" disabled="@(historyLoading || Busy)" @onclick="() => LoadHistoryAsync(append: true)">Загрузить ещё</button>}
            else if(historyRows.Count > 0 && !historyLoading){<span class="muted">Все найденные запуски показаны</span>}
        </div>
    </section>
}
</div>
}
</div>

@if(CanManageCollection && showSearchModal && view is not null)
{
    <Modal Title="@(editingSearch is null ? "Добавить поиск" : saveAndRun ? "Изменить ссылку и повторить" : "Настроить поиск")" OnClose="CloseSearch">
        @if(Error is not null){<p role="alert" class="form-error">@Error</p>}
        <EditForm Model="searchInput" FormName="collector-search" OnValidSubmit="SaveSearchAsync">
            <DataAnnotationsValidator /><ValidationSummary />
            <fieldset disabled="@Busy" class="search-form-fields">
                <label class="field"><span>Название</span><InputText @bind-Value="searchInput.Label" /></label>
                <label class="field"><span>Ссылка на результаты поиска</span><InputText type="url" @bind-Value="searchInput.Url" /></label>
                <div class="modal-grid">
                    <label class="field"><span>Источник</span><InputSelect @bind-Value="searchInput.Source"><option value="Avito">Avito</option><option value="Cian">Cian</option></InputSelect></label>
                    <label class="field"><span>Зона</span><InputSelect @bind-Value="searchInput.GroupId"><option value="">Без зоны</option>@foreach(var group in view.Groups.Where(g=>g.Active || g.Id==searchInput.GroupId).OrderBy(g=>g.SortOrder)){<option value="@group.Id">@group.Name@(!group.Active ? " (архив)" : "")</option>}</InputSelect></label>
                </div>
                @if(CanManageSearchGroups){<button type="button" class="text-action" @onclick="() => showQuickGroup=!showQuickGroup">@(showQuickGroup ? "Отменить новую зону" : "+ Новая зона")</button>}
                @if(CanManageSearchGroups && showQuickGroup)
                {
                    <div class="quick-group"><label class="field"><span>Название новой зоны</span><input @bind="quickGroupName" @bind:event="oninput" maxlength="200" /></label><button type="button" class="btn secondary" disabled="@(Busy || string.IsNullOrWhiteSpace(quickGroupName))" @onclick="QuickCreateGroupAsync">Создать и выбрать</button></div>
                }
                <section class="schedule-editor">
                    <h3>Когда запускать</h3>
                    <p class="form-note">Часовой пояс: @ZoneLabel</p>
                    <label class="field"><span>Повторение</span><InputSelect @bind-Value="searchInput.ScheduleKind" @bind-Value:after="UpdatePreviewAsync"><option value="Manual">Только вручную</option><option value="Interval">Через интервал</option><option value="FixedTimes">Ежедневно в указанное время</option></InputSelect></label>
                    @if(searchInput.ScheduleKind==CollectionScheduleKind.Interval)
                    {
                        <div class="interval-fields"><label class="field"><span>Каждые</span><NumberInput @bind-Value="searchInput.IntervalValue" @bind-Value:after="UpdatePreviewAsync"  /></label><label class="field"><span>Единицы</span><InputSelect @bind-Value="searchInput.IntervalUnit" @bind-Value:after="UpdatePreviewAsync"><option value="1">минут</option><option value="60">часов</option><option value="1440">дней</option></InputSelect></label></div>
                        <p class="form-note">От 5 минут до 7 дней. Интервал отсчитывается от постановки планового задания, а не от завершения сбора.</p>
                    }
                    @if(searchInput.ScheduleKind==CollectionScheduleKind.FixedTimes)
                    {
                        <div class="time-rows">
                            @foreach(var row in searchInput.Times)
                            {
                                <div class="time-row" @key="row"><label class="field"><span>Время запуска</span><input type="text" inputmode="numeric" data-time-entry="true" placeholder="HH:mm" maxlength="5" value="@row.Value" @oninput="async e => { row.Value = e.Value?.ToString() ?? string.Empty; await UpdatePreviewAsync(); }" /></label><button type="button" class="icon-action" aria-label="Удалить время запуска" disabled="@(searchInput.Times.Count==1)" @onclick="async () => { searchInput.Times.Remove(row); await UpdatePreviewAsync(); }">×</button></div>
                            }
                        </div>
                        <button type="button" class="text-action" disabled="@(searchInput.Times.Count>=12)" @onclick="AddTime">+ Добавить время</button>
                        <p class="form-note">Например, 09:00 и 16:00 — два сбора каждый день.</p>
                    }
                    @if(editingSearch is null)
                    {
                        <label class="check-field"><InputCheckbox @bind-Value="searchInput.RunImmediately" /><span>Запустить первый сбор после сохранения</span></label>
                        <p class="form-note">@(searchInput.RunImmediately ? "Первое задание попадёт в очередь сразу. Последующие — по расписанию." : "Сохранение не запускает сбор. Он начнётся по расписанию или по кнопке «Запустить».")</p>
                    }
                    else
                    {
                        <label class="check-field"><InputCheckbox @bind-Value="searchInput.Enabled" @bind-Value:after="UpdatePreviewAsync" /><span>Поиск активен</span></label>
                    }
                    <p class="schedule-preview" role="status">@previewText</p>
                </section>
                <label class="field"><span>Предел страниц за один сбор</span><NumberInput @bind-Value="searchInput.MaxPages"  /><small>От 1 до 100. Достижение лимита — завершение сбора, а не ошибка.</small></label>
                <p class="form-note">В указанное время задание поступает в общую очередь. Сбор начнётся, когда освободится совместимый парсер.</p>
                @if(!SchedulerHealthy && searchInput.ScheduleKind!=CollectionScheduleKind.Manual){<p class="form-warning">Служба расписаний сейчас не подтверждает работу. До её восстановления доступен ручной запуск.</p>}
                <div class="modal-actions"><span></span><button type="button" class="btn secondary" @onclick="CloseSearch">Отмена</button><button type="submit" class="btn primary" disabled="@Busy">@(Busy ? "Сохраняем…" : saveAndRun && searchInput.Enabled ? "Сохранить и запустить" : "Сохранить")</button></div>
            </fieldset>
        </EditForm>
    </Modal>
}
@if(CanManageCollection && showConnectionModal){<Modal Title="Подключить новый парсер" OnClose="CloseConnection">@if(Error is not null){<p role="alert" class="form-error">@Error</p>}@if(connectionCode is null){<EditForm Model="agentInput" FormName="collector-connection" OnValidSubmit="CreateAgentAsync"><DataAnnotationsValidator/><ValidationSummary/><label class="field"><span>Название компьютера</span><input autofocus @bind="agentInput.Name" @bind:event="oninput" /></label><p class="form-note">Право добавлять поиски по умолчанию выключено.</p><div class="modal-actions"><span></span><button type="button" class="btn secondary" @onclick="CloseConnection">Отмена</button><button type="submit" class="btn primary" disabled="@(Busy||string.IsNullOrWhiteSpace(agentInput.Name))">Создать код</button></div></EditForm>}else{<div class="connection-success"><b>✓</b><h3>Код готов</h3><p>Вставьте его в LandErp Parser. Код действует до @Time(connectionCode.ExpiresAt).</p><label class="field"><span>Код подключения</span><textarea readonly rows="4">@ConnectionCode(connectionCode)</textarea></label><div class="modal-actions"><span></span><button class="btn primary" @onclick="CloseConnection">Готово</button></div></div>}</Modal>}
@if(CanManageSearchGroups && showGroupsModal && view is not null){<Modal Title="@(editingGroup is null ? "Добавить зону" : "Изменить зону")" OnClose="CloseGroups">@if(Error is not null){<p role="alert" class="form-error">@Error</p>}<EditForm Model="groupInput" FormName="collector-group" OnValidSubmit="SaveGroupAsync"><DataAnnotationsValidator/><div class="inline-form"><label class="field"><span>@(editingGroup is null?"Новая зона":"Название зоны")</span><input @bind="groupInput.Name" /></label><label class="field"><span>Порядок</span><NumberInput @bind-Value="groupInput.SortOrder"  /></label><button type="submit" class="btn primary" disabled="@(Busy||string.IsNullOrWhiteSpace(groupInput.Name))">@(editingGroup is null?"Добавить":"Сохранить")</button>@if(editingGroup is not null){<button type="button" class="btn secondary" @onclick="CloseGroups">Отмена</button>}</div></EditForm><div class="modal-actions"><span></span><button class="btn secondary" @onclick="CloseGroups">Закрыть</button></div></Modal>}
@if(CanManageCollection && selectedAgent is not null){<Modal Title="Настройки парсера" OnClose="CloseAgent">@if(Error is not null){<p role="alert" class="form-error">@Error</p>}<div class="dialog-head"><strong>@selectedAgent.Name</strong><StatusBadge Label="@selectedAgent.OperationalStatus" Tone="@AgentBadgeTone(selectedAgent)" /></div><div class="setting"><div><strong>Добавление зон и поисков</strong><p>Разрешить этому Parser создавать серверные зоны и поиски.</p></div><button class="switch @(selectedAgent.CanManageSearches?"on":"")" disabled="@Busy" role="switch" aria-checked="@selectedAgent.CanManageSearches" @onclick="() => ToggleAgentSearchManagementAsync(selectedAgent)"><span></span></button></div><div class="setting"><div><strong>Новый токен</strong><p>Старый токен сразу перестанет работать.</p></div><button class="btn secondary" disabled="@Busy" @onclick="() => RotateAsync(selectedAgent)">Перевыпустить</button></div>@if(credential?.AgentId==selectedAgent.Id){<label class="field"><span>Новый токен — сохраните сейчас</span><textarea readonly rows="3">@credential.Token</textarea></label>}@if(selectedAgent.Enabled){<div class="setting danger-zone"><div><strong>Отключить парсер</strong><p>Он больше не сможет получать задания.</p></div><button class="btn danger" disabled="@Busy" @onclick="() => RevokeAsync(selectedAgent)">Отключить</button></div>}<div class="modal-actions"><span></span><button class="btn secondary" @onclick="CloseAgent">Закрыть</button></div></Modal>}
