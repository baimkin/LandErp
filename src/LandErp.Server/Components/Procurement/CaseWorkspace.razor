    private int ReadyDocuments()=>card!.DocumentRequirements.Count(x=>x.Status is CaseDocumentStatus.Received or CaseDocumentStatus.Verified);
    private int MissingDocuments()=>card!.DocumentRequirements.Count-ReadyDocuments();
    private int ReadinessPercent(){int parts=0,total=3;if(card!.Checks.Count>0&&CompletedChecks()==card.Checks.Count)parts++;if(card.DocumentRequirements.Count>0&&ReadyDocuments()==card.DocumentRequirements.Count)parts++;if(card.Inspection?.Status==InspectionStatus.Completed)parts++;return parts*100/total;}
