@page "/account/change-password"
@layout AccountLayout
@attribute [Authorize]
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@using LandErp.Infrastructure.Modules.IdentityAccess
@using LandErp.Infrastructure.Persistence
@inject UserManager<LandErpUser> Users
@inject SignInManager<LandErpUser> SignIn
@inject LandErpDbContext Db
@inject NavigationManager Navigation
<PageTitle>Смена временного пароля · LandErp</PageTitle>
<span class="kicker">Безопасность</span><h1>Смените временный пароль</h1>
<p class="subtle">До смены пароля остальные разделы LandErp недоступны.</p>
@if(error!=null){<PageState Kind="error" Title="Не удалось сменить пароль" Description="@error" />}
<EditForm Model="Input" method="post" FormName="change-temporary-password" OnValidSubmit="ChangeAsync">
    <DataAnnotationsValidator /><ValidationSummary />
    <label class="field"><span>Текущий временный пароль</span><InputText @bind-Value="Input.CurrentPassword" type="password" autocomplete="current-password" /></label>
    <label class="field"><span>Новый пароль</span><InputText @bind-Value="Input.NewPassword" type="password" autocomplete="new-password" /></label>
    <label class="field"><span>Повторите новый пароль</span><InputText @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" /></label>
    <ActionButton Type="submit" Label="Сменить пароль" />
</EditForm>
@code{
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private ChangeInput Input { get; set; } = default!;
    private string? error;
    protected override void OnInitialized()=>Input??=new();
    private async Task ChangeAsync()
    {
        LandErpUser user=await Users.GetUserAsync(HttpContext.User)??throw new InvalidOperationException();
        IdentityResult result=await Users.ChangePasswordAsync(user,Input.CurrentPassword,Input.NewPassword);
        if(!result.Succeeded){error="Проверьте временный пароль и требования к новому паролю.";Input.CurrentPassword="";Input.NewPassword="";Input.ConfirmPassword="";return;}
        user.MustChangePassword=false;
        result=await Users.UpdateAsync(user);
        if(!result.Succeeded){error="Не удалось сохранить новое состояние учётной записи.";return;}
        await AccountAudit.RecordAsync(Db,user.Id,"TemporaryPasswordChanged");
        await SignIn.SignOutAsync();
        Navigation.NavigateTo("/account/login",forceLoad:true);
    }
    private sealed class ChangeInput
    {
        [Required] public string CurrentPassword{get;set;}="";
        [Required,MinLength(12)] public string NewPassword{get;set;}="";
        [Compare(nameof(NewPassword))] public string ConfirmPassword{get;set;}="";
    }
}
