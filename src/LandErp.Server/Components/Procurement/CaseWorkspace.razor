@using LandErp.Application.Modules.Overview.Contracts
@inject IGroupMarketService Markets
@using System.ComponentModel.DataAnnotations
@using LandErp.Application.Foundation.Files
@using LandErp.Application.Modules.Catalog.Contracts
@using LandErp.Application.Modules.Procurement.Contracts
@using LandErp.Application.Modules.Procurement.Domain
@using Microsoft.AspNetCore.Components.Forms
@inherits CaseWorkspaceComponent
@inject ICatalogWorkspace CatalogWorkspace
@inject IProcurementWorkspace Workspace

@if(Loading && (card == null || loaded != CaseId)) { <PageState Kind="loading" Title="Открываем объект…" /> }
else if(Forbidden && dialogAction==null && !managerOpen) { <PageState Kind="forbidden" Title="Нет доступа к объекту" /> }
else if(card!=null && loaded == CaseId)
{
    <CaseToast Message="@Success" />
    @if(Error!=null&&!AnyDialog){<div class="case-feedback" role="alert">@Error <button class="btn secondary" @onclick="ReloadAsync">Обновить карточку</button></div>}
    @if(RefreshWarning!=null){<div class="case-feedback" role="status">@RefreshWarning <button class="btn secondary" @onclick="ReloadAsync">Обновить</button></div>}
    <div class="stack case-workspace" data-case-version="@card.Item.CaseVersion">
        <CaseSourceChangesNotice @key="CaseId" @ref="sourceNotice" CaseId="CaseId" />
        <section class="case-titlebar">
            <div class="case-identity">
                <div class="case-breadcrumb">@if(FullPage){<a href="/procurement">← Очередь закупки</a><span aria-hidden="true">/</span>}<span>@card.Item.BusinessNumber</span></div>
                @if(FullPage){<h1>@card.Item.Title</h1>}else{<h2>@card.Item.Title</h2>}
                <p>@(card.Item.Location??"Местоположение уточняется")</p>
            </div>
            <div class="case-title-right"><div class="case-title-actions"><CaseSourceLinks Items="card.Sources.Select(x=>new CaseSourceLinkItem(x.Source,x.Title,x.Url)).ToArray()"/><StatusBadge Label="@ProcurementLabels.Stage(card.Item.Stage)" Tone="@(card.Item.Stage=="acquired" ? "success" : card.Item.Stage=="returned" ? "warning" : "info")" />@if(card.CanManageDossier){<button class="btn secondary" @onclick="()=>{ClearFeedback();noteOpen=true;}">＋ Заметка</button>}@if(CaseDecisionPresentation.HasActions(card)){<button class="btn secondary" @onclick="()=>{ClearFeedback();decisionsOpen=true;}">Решение по объекту</button>}</div><div class="case-manager"><span>Ответственный:</span>@if(card.CanReassignManager){<button type="button" @onclick="OpenManager" title="Сменить ответственного">@card.ManagerName</button>}else{<span>@card.ManagerName</span>}</div></div>
        </section>

        @if(card.Item.Stage=="acquired")
        {
            <section class="surface case-acquired-banner">
                <div><span class="kicker">Закупка завершена</span><h3>Объект куплен</h3></div>
                <div><small>Фактическая цена</small><strong>@ProcurementLabels.Money(card.AcquisitionPrice)</strong></div>
                <div><small>Дата покупки / регистрации</small><strong>@(card.AcquisitionDate?.ToString("dd.MM.yyyy")??"Не указана")</strong></div>
                @if(!string.IsNullOrWhiteSpace(card.AcquisitionComment)){<p>@card.AcquisitionComment</p>}
                @if(card.CanConfirmPurchase){<button class="btn secondary" @onclick="OpenCorrection">Исправить данные покупки</button>}
            </section>
        }

        @if(tab!="overview"){<CaseDecisionState Card="card" ShowActions="false" OnSection="OpenDecisionSection" />}
        <nav class="case-tabs" aria-label="Разделы карточки">
            @foreach((string id,string label) in Tabs)
            {
                <button type="button" class="case-tab @(tab==id?"active":"")" aria-current="@(tab==id?"page":null)" @onclick="()=>tab=id">@label</button>
            }
        </nav>

            <section class="case-hero" hidden="@(tab != "overview")">
                <div class="case-primary-stack">
                <article class="surface case-object-card">
                    <div class="case-gallery">
                        @if(card.Photos.Length>0)
                        {
                            <div class="case-cover">
                                <button class="photo-open" @onclick="()=>galleryOpen=true" aria-label="Открыть галерею"><img src="@card.Photos[photoIndex]" alt="Фото объекта" referrerpolicy="no-referrer" /></button>
                                @if(card.Photos.Length>1){<button class="photo-arrow prev" @onclick="()=>MovePhoto(-1)" aria-label="Предыдущее фото">‹</button><button class="photo-arrow next" @onclick="()=>MovePhoto(1)" aria-label="Следующее фото">›</button>}
                                <span class="case-photo-caption">@(photoIndex+1) / @card.Photos.Length ⤢</span>
                            </div>
                        }
                        else
                        {
                            <div class="case-cover empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8" cy="9" r="1.5"/><path d="m3 17 5-5 4 4 3-3 6 6"/></svg><strong>Фото пока нет</strong><span>Основные сведения об объекте — рядом</span></div>
                        }
                    </div>
                    <div class="case-object-facts">
                        <div class="section-heading"><h3>Об объекте</h3>@if(card.CanManageDossier){<button class="btn quiet" @onclick="OpenFactCorrection">Исправить рабочие данные</button>}</div>
                        <dl class="case-facts">
                            <div><dt>Площадь</dt><dd>@AreaInSotki()<small>@ProcurementLabels.Area(card.Item.Area)</small></dd></div>
                            <div><dt>Кадастровый номер</dt><dd>@(string.IsNullOrWhiteSpace(card.CadastralNumber)?"Не указан":card.CadastralNumber)</dd></div>
                            
                            <div><dt>Источники</dt><dd>@SourceSummary()</dd></div>
                        </dl>

                        <CaseDescription Text="@card.Description" />
                    </div>
                </article>

                <article class="surface"><CaseRichNoteBlock @key="(CaseId, CaseNoteSection.Working)" CaseId="CaseId" Section="CaseNoteSection.Working" Title="Рабочие заметки и расчёты" Subject="CurrentSubject" Attachments="card.Attachments" CanEdit="card.CanManageDossier" Value="@RichNote(CaseNoteSection.Working)" Saved="ReloadAsync" /></article>
                <article class="surface"><div class="section-heading"><h2>Ход работы</h2><div class="form-actions">@if(card.CanManageDossier){<button class="btn quiet" @onclick="()=>{ClearFeedback();noteOpen=true;}">Заметка</button>}@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<button class="btn secondary" @onclick="OpenNegotiation">Записать общение</button>}</div></div>
                    @if(card.Timeline.Count==0){<div class="case-empty"><strong>История работы начинается здесь</strong><p>Запишите общение или добавьте заметку об объекте.</p></div>}
                    <CaseActivityFeed OnOpenTask="OpenRelatedTask" Items="card.Timeline.Take(6).Select(CaseFeedFormat.From).ToArray()" />
                    <button class="btn quiet" @onclick='()=>tab="history"'>Вся история →</button>
                </article>
                
                </div>
                <div class="case-side-stack">
                    <article class="surface case-pricing">
                        <div class="section-heading"><h3>Цена и торг</h3><button class="btn quiet" @onclick='()=>tab="negotiations"'>Переговоры →</button></div>
                        <div class="case-price-top"><div class="case-price-working"><div class="case-main-price"><span>Цена в объявлении</span><strong>@ProcurementLabels.Money(card.Item.Price)</strong></div>
                        <div class="price-grid">
                            <div><small>Продавец</small><strong>@OptionalPrice(card.Negotiations.Select(x=>x.SellerPrice).FirstOrDefault(x=>x!=null))</strong></div>
                            <div><small>Наше предложение</small><strong>@OptionalPrice(card.Negotiations.Select(x=>x.BuyerOffer).FirstOrDefault(x=>x!=null))</strong></div>
                            <div><small>@(card.Item.Stage=="acquired"?"Куплено за":"Согласовано")</small><strong>@OptionalPrice(card.Item.Stage=="acquired"?card.AcquisitionPrice:card.Negotiations.Select(x=>x.AgreedPrice).FirstOrDefault(x=>x!=null))</strong></div>
                        </div>
                        
</div>
                            <div class="case-group-market">
                                <GroupMarketPrices Value="SelectedMarket" Subject="CurrentSubject" Saved="ReloadAsync" EmptyText="Для сравнения выберите группу поиска во входящих" PurchaseMode="true" />
                                @if (caseMarkets.Count > 1)
                                {
                                    <details><summary>Ещё @(caseMarkets.Count - 1) групп</summary><select value="@SelectedMarket?.SearchGroupId" @onchange="ChangeMarketGroup" aria-label="Группа рынка объекта">@foreach(var group in caseMarkets){<option value="@group.SearchGroupId">@group.Name</option>}</select></details>
                                }
                            </div>
</div>
                    </article>
                    <article class="surface case-next-action">
                        @if(tab=="overview"){<CaseNextAction @ref="taskPanel" @key="(CaseId,card.Item.CaseVersion)" CaseId="CaseId" OnSaved="NextActionSaved"/>}
                    </article>
<article class="surface"><h2>Контроль объекта</h2>
                    <button type="button" class="control-row" @onclick='()=>tab="checks"'><span><strong>Проверки</strong><small>@(card.Checks.Count==0?"Ещё не назначены":"Результаты и открытые вопросы")</small></span><span class="control-count">@CompletedChecks() / @card.Checks.Count →</span></button>
                    <button type="button" class="control-row" @onclick='()=>tab="documents"'><span><strong>Документы</strong><small>Получено из необходимых</small></span><span class="control-count">@ReadyDocuments() / @VisibleDocumentRequirements.Count →</span></button>
                    <button type="button" class="control-row" @onclick='()=>tab="inspection"'><span><strong>Осмотр</strong><small>@(card.Inspection==null?"Не назначен":card.Inspection.Status==InspectionStatus.Completed?"Завершён":card.Inspection.StartedAt==null?"Назначен":"В работе")</small></span><span class="control-count">Открыть →</span></button>
                    @if(OpenRisks()>0){<p class="case-problem">Открытых блокирующих вопросов: @OpenRisks()</p>}
                </article><article class="surface case-decision-summary"><h3>Решение по объекту</h3><CaseDecisionState Card="card" ShowActions="false" OnSection="OpenDecisionSection" />@if(CaseDecisionPresentation.HasActions(card)){<button class="btn primary" @onclick="()=>{ClearFeedback();decisionsOpen=true;}">Выбрать решение</button>}@if(CaseDecisionPresentation.CanPurchase(card)||card.CanConfirmPurchase&&card.Item.Stage=="acquired"){<button class="btn quiet" @onclick="@(card.Item.Stage=="acquired"?OpenCorrection:OpenPurchase)">@(card.Item.Stage=="acquired"?"Данные покупки":"Оформить покупку")</button>}</article>
                </div>
            </section>
        @if(tab!="overview")
        {
            <section class="case-context" aria-label="Краткая сводка объекта">
                <div><small>Цена в объявлении</small><strong>@ProcurementLabels.Money(card.Item.Price)</strong></div>
                <div><small>Площадь</small><strong>@AreaInSotki()</strong></div>
                <div><small>Ответственный</small><strong>@(card.Item.Assignee??"Не назначен")</strong></div>
                <div><small>Следующее действие</small><strong>@NextAction()</strong><small>@(card.Item.DueAt==null?"Срок не назначен":LandErp.Application.Modules.Workflow.Domain.WorkTaskDeadline.Format(card.Item.DueAt,card.Item.DueHasTime))</small></div>
            </section>
        }

        @if(tab=="negotiations")
        {
            <section class="stack"><article class="surface"><div class="section-heading"><div><h3>Переговоры</h3><p class="subtle">Контакты, предложения по цене и договорённости по объекту.</p></div>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<button class="btn primary" @onclick="OpenNegotiation">Записать общение</button>}</div>@if(card.Negotiations.Count==0){<PageState Kind="empty" Title="Переговоров пока нет" />}<CaseActivityFeed OnOpenTask="OpenRelatedTask" Items="card.Negotiations.Select(CaseFeedFormat.From).ToArray()"/></article>
            </section>
        }
        <section class="stack" hidden="@(tab != "checks")">
            <div class="section-heading"><div><h2>Проверки объекта</h2><p class="subtle">Запишите, что проверили, результат и открытые вопросы.</p></div></div>
            <CaseChecks @key="CaseId" CaseId="CaseId" Card="card" Subject="CurrentSubject" Refresh="ReloadAsync" />
            @if(card.CanManageTemplates){<button class="btn quiet" @onclick="()=>{ClearFeedback();templatesOpen=true;}">Настроить типовые проверки</button>}
        </section>
        @if(tab=="inspection")
        { <article class="surface"><div class="section-heading"><h3>Осмотр</h3>@if((card.CanAssignInspections||card.CanPerformInspections)&&card.Item.Stage!="acquired"){<div class="form-actions">@if(card.Inspection!=null&&card.CanPerformInspections){<button class="btn secondary" @onclick='()=>OpenInspectionAttachment($"i:{card.Inspection.Id}")'>Добавить общий материал</button>}<a class="btn primary" href="/procurement/@CaseId/inspection">@(card.Inspection==null?"Назначить осмотр":card.CanPerformInspections?"Открыть форму осмотра":"Открыть назначение")</a></div>}</div>@if(card.Inspection==null){<PageState Kind="empty" Title="Осмотр ещё не проведён" />}else{<p><strong>@(card.Inspection.Status==InspectionStatus.Completed?"Завершён":card.Inspection.StartedAt==null?"Назначен":"В работе")</strong> · @card.Inspection.Inspector · @ProcurementLabels.Time(card.Inspection.CompletedAt??card.Inspection.StartedAt)</p><p>@card.Inspection.OverallConclusion</p>@foreach(var media in card.Attachments.Where(x=>x.OwnerType==CaseAttachmentOwner.Inspection)){<div class="form-actions"><small>@media.Label · @ProcurementLabels.FileStatus(media.Status)</small>@if(media.Status==StoredFileStatus.Available){<a class="btn quiet" href="/api/procurement/attachments/@media.Id" target="_blank" rel="noopener">Открыть ↗</a>}else if(card.CanPerformInspections&&AttachmentCanRetry(media)){<button class="btn quiet" @onclick="()=>BeginAttachmentRetry(media.Id)">Восстановить загрузку</button>}</div>}<div class="inspection-results">@foreach(var group in card.Inspection.Items.GroupBy(InspectionGroup)){<section class="inspection-result-group"><h4>@group.Key</h4>@foreach(var item in group){<div class="inspection-answer-row"><div><div class="inspection-answer"><strong>@item.Title</strong><span>@InspectionAnswer(item)</span>@if(InspectionProblem(item)){<span class="inspection-flag" title="Отклонение по чек-листу" aria-label="Отклонение по чек-листу">!</span>}</div>@if(item.Note.Length>0){<p>@item.Note</p>}@foreach(var media in card.Attachments.Where(x=>x.OwnerType==CaseAttachmentOwner.InspectionItem&&x.OwnerId==item.Id)){<div class="form-actions"><small>@media.Label · @ProcurementLabels.AttachmentKind(media.Kind) · @ProcurementLabels.FileStatus(media.Status)</small>@if(media.Status==StoredFileStatus.Available){<a class="btn quiet" href="/api/procurement/attachments/@media.Id" target="_blank" rel="noopener">Открыть ↗</a>}else if(card.CanPerformInspections&&AttachmentCanRetry(media)){<button class="btn quiet" @onclick="()=>BeginAttachmentRetry(media.Id)">Восстановить загрузку</button>}</div>}</div>@if(card.CanPerformInspections&&card.Item.Stage!="acquired"&&item.AllowAttachments){<button class="btn secondary" @onclick='()=>OpenInspectionAttachment($"ii:{item.Id}")'>Добавить материал</button>}</div>}</section>}</div>@if(card.Inspection.Items.Any(InspectionProblem)){<p class="inspection-legend">! — отклонение, отмеченное в чек-листе. Замечания приведены под соответствующими значениями.</p>}}</article> }
        else if(tab=="documents")
        {
            <section class="stack"><article class="surface"><div class="section-heading"><div><h2>Документы</h2><p class="subtle">Файлы и их проверка — отдельные состояния</p></div>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<button class="btn primary" @onclick="()=>OpenAttachment(null)">＋ Добавить документ</button>}</div>
                <div class="document-table-wrap"><table class="document-table"><thead><tr><th>Документ / файл</th><th>Статус</th><th>Обновлено</th><th>Действия</th></tr></thead><tbody>
                @foreach(var item in VisibleDocumentRequirements)
                {
                    <tr><td><strong>@item.Title</strong><small>@item.Description</small>
                    @foreach(var file in card.Attachments.Where(x=>item.AttachmentIds.Contains(x.Id))){<div class="document-file"><span>@file.Label · @FormatSize(file.SizeBytes)</span>@if(file.Status==StoredFileStatus.Available){<a href="/api/procurement/attachments/@file.Id" target="_blank" rel="noopener">Открыть ↗</a>}else{<small>@ProcurementLabels.FileStatus(file.Status)</small>@if(AttachmentCanRetry(file)){<button class="btn quiet" @onclick="()=>BeginAttachmentRetry(file.Id)">Восстановить загрузку</button>}}</div>}
                    @if(item.Note.Length>0){<small>@item.Note</small>}</td><td><StatusBadge Label="@ProcurementLabels.DocumentStatus(item.Status)" Tone="@(item.Status==CaseDocumentStatus.Verified?"success":"neutral")"/></td><td><small>@item.UpdatedBy<br/>@ProcurementLabels.Time(item.UpdatedAt)</small>@if(item.DueAt!=null){<small>Срок: @ProcurementLabels.Time(item.DueAt)</small>}</td><td>@if(card.CanManageDossier&&card.Item.Stage!="acquired"){<div class="document-actions"><button class="btn secondary" @onclick="()=>OpenAttachment(item.Id)">Прикрепить</button><button class="btn quiet" @onclick="()=>EditDocumentRequirement(item)">Статус</button></div>}</td></tr>
                }
                </tbody></table></div>
                @if(VisibleDocumentRequirements.Count==0){<div class="case-empty">Обязательные документы не заданы. Добавленные файлы доступны ниже.</div>}
            </article>
            <article class="surface"><h3>Прочие вложения</h3>@foreach(var item in card.Attachments.Where(x=>x.DocumentRequirementId==null)){<div class="dossier-row"><div><strong>@item.Label</strong><small>@item.OwnerLabel · @ProcurementLabels.AttachmentKind(item.Kind) · @ProcurementLabels.FileStatus(item.Status) · @FormatSize(item.SizeBytes)</small>@if(item.Description.Length>0){<p>@item.Description</p>}</div>@if(item.Status==StoredFileStatus.Available){<a class="btn secondary" href="/api/procurement/attachments/@item.Id" target="_blank" rel="noopener">Открыть ↗</a>}else if(AttachmentCanRetry(item)){<button class="btn secondary" @onclick="()=>BeginAttachmentRetry(item.Id)">Восстановить загрузку</button>}</div>}@if(!card.Attachments.Any(x=>x.DocumentRequirementId==null)){<p class="subtle">Прочих вложений нет.</p>}</article>
            </section>
        }
        else if(tab=="history") { <article class="surface"><h3>История объекта</h3><p class="subtle">Контакты, документы и решения по объекту.</p><BusinessTimeline OnOpenTask="OpenRelatedTask" Items="card.Timeline" /></article> }
        else if(tab=="sources")
        {
            <section class="stack"><article class="surface"><h3>Источники</h3>@if(card.Sources.Count==0){<p class="subtle">Объект создан без внешних источников.</p>}@foreach(var source in card.Sources){<div class="dossier-row"><div><SourceBadge Source="source.Source" /><strong>@source.Title</strong><small>@source.Provenance · @(source.ExternalId??"без внешнего ID") · @ProcurementLabels.Money(source.Price)</small></div><div class="form-actions">@if(CaseSourceLinks.SafeUrl(source.Url) is string sourceUrl){<a class="btn secondary" href="@sourceUrl" target="_blank" rel="noopener noreferrer">Открыть источник ↗</a>}<SourceChangesButton @key="(CaseId,source.CatalogItemId)" CaseId="CaseId" CatalogItemId="source.CatalogItemId" OnViewed="RefreshSourceNotices" />@if(card.CanCorrectSourceLinks){<button class="btn quiet" disabled="@Busy" @onclick="()=>OpenSourceLinkCorrectionAsync(source)">Исправить связь</button>}</div></div>}</article>
            <article class="surface"><h3>Изменения в источниках</h3>@if(card.Observations.Count==0){<p class="subtle">Наблюдений пока нет.</p>}@foreach(var item in card.Observations.Take(20)){<div class="dossier-row"><div><strong>@ProcurementLabels.Time(item.ObservedAt)</strong><small>@(item.Changes.Length==0?"Первое наблюдение":string.Join(" · ",item.Changes))</small><p>@(item.Data.Title.Raw??"Без названия") · @ProcurementLabels.Money(item.Data.Price.Parsed)</p></div></div>}</article>
            <article class="surface"><h3>Расхождения с рабочими фактами</h3><p class="subtle">Источник никогда не перезаписывает подтверждённое значение автоматически.</p>@foreach(var item in card.Discrepancies.Where(x=>x.Different)){<div class="dossier-row"><div><strong>@ProcurementLabels.Fact(item.Field) · @item.Source</strong><small>Рабочее: @item.WorkingValue · источник: @item.SourceValue</small></div>@if(card.CanManageDossier){<button class="btn secondary" @onclick="()=>{ClearFeedback();pendingFact=item;}">Применить явно</button>}</div>}@if(!card.Discrepancies.Any(x=>x.Different)){<p class="subtle">Расхождений нет.</p>}</article></section>
        }
    </div>
    @if(pendingFact is {} fact){<CaseModal Title="Сравнить сведения источника" Subtitle="Изменится только выбранное рабочее поле" Error="@Error" Busy="Busy" OnClose="()=>pendingFact=null"><h3>@ProcurementLabels.Fact(fact.Field)</h3><div class="form-grid"><div><small>В карточке</small><p>@fact.WorkingValue</p></div><div><small>В источнике</small><p>@fact.SourceValue</p></div></div><div class="form-actions"><ActionButton Label="Принять значение источника" OnClick="()=>ApplyFactAsync(fact)" Busy="Busy"/></div></CaseModal>}
    @if(galleryOpen&&card.Photos.Length>0){<CaseGallery Photos="card.Photos" InitialIndex="photoIndex" OnClose="()=>galleryOpen=false" />}
    @* A linked task can open above another tab; the list remains on the overview. *@
    @if(tab!="overview"){<CaseNextAction @ref="taskPanel" CaseId="CaseId" ShowList="false" OnSaved="NextActionSaved" />}
    @if(decisionsOpen){<CaseModal Title="Решение по объекту" Error="@Error" Busy="Busy" OnClose="()=>decisionsOpen=false"><CaseDecisionState Card="card" Busy="Busy" OnAction="OpenDecision" OnSection="OpenDecisionSection" /></CaseModal>}
    @if(templatesOpen&&card.CanManageTemplates){<CaseModal Title="Типовые проверки" Error="@Error" Busy="Busy" OnClose="()=>templatesOpen=false">@foreach(var item in card.CheckTemplates){<div class="dossier-row"><div><strong>@item.Title</strong><small>@ProcurementLabels.CheckLevel(item.Level) · порядок @item.SortOrder · @(item.Active?"активна":"неактивна")</small><p>@item.Description</p></div><button class="btn quiet" @onclick="()=>EditCheckTemplate(item)">Изменить</button></div>}<EditForm Model="checkTemplate" FormName="check-template" OnValidSubmit="SaveCheckTemplateAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field dossier-wide"><span>Название</span><input @bind="checkTemplate.Title" /></label><label class="field"><span>Уровень</span><InputSelect @bind-Value="checkTemplate.Level"><option value="Quick">Базовая</option><option value="Deep">Глубокая</option></InputSelect></label><label class="field"><span>Порядок</span><NumberInput @bind-Value="checkTemplate.SortOrder"  /></label><label class="field dossier-wide"><span>Описание</span><textarea @bind="checkTemplate.Description"></textarea></label><label class="check-field"><InputCheckbox @bind-Value="checkTemplate.Active" /> Активна</label><div class="form-actions"><ActionButton Label="Сохранить в справочник" Type="submit" Busy="Busy" /></div></div></EditForm></CaseModal>}
    @if(noteOpen){<CaseModal Title="Рабочая заметка" Subtitle="Внутренний комментарий для команды" Error="@Error" Busy="Busy" OnClose="()=>noteOpen=false"><EditForm Model="note" OnValidSubmit="SaveNoteAsync"><DataAnnotationsValidator/><ValidationSummary/><label class="field"><span>Текст заметки</span><InputTextArea @bind-Value="note.Text"/><ValidationMessage For="()=>note.Text"/></label><div class="form-actions"><ActionButton Label="Добавить заметку" Type="submit" Busy="Busy"/></div></EditForm></CaseModal>}
    @if(dialogAction!=null) { <CaseDecisionDialog Card="card" Action="@dialogAction.Value" Title="@dialogTitle" OnConfirm="ConfirmAsync" OnClose="CloseDialog" Busy="Busy" Error="@Error" NeedsRefresh="decisionNeedsRefresh" OnRefresh="RefreshDecisionAsync" /> }
    @if(negotiationOpen){<CaseCommunication CaseId="CaseId" OnClose="()=>negotiationOpen=false" OnSaved="CommunicationSaved"/>}
    @if(attachmentOpen){<CaseModal Error="@Error" Busy="Busy" Title="Добавить материал" OnClose="CloseAttachment"><EditForm Model="attachment" FormName="attachment" OnValidSubmit="SaveAttachmentAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid">@if(attachment.Kind==CaseAttachmentKind.Link){<label class="field dossier-wide"><span>HTTPS-ссылка</span><input type="url" @bind="attachment.Url" /></label>}else{<label class="upload dossier-wide"><strong>@(selectedFile?.Name??"＋ Выберите или перетащите файл")</strong><small>@(selectedFile==null?$"До {FileUploadLimits.MaxRawFileMegabytes} МБ · файл будет сохранён в хранилище":FormatSize(selectedFile.Size)+" · нажмите, чтобы заменить")</small><InputFile OnChange="SelectFile" accept="@ProcurementLabels.Accept(attachment.Kind)" />@if(UploadFileTooLarge(selectedFile)){<small class="case-problem">@FileUploadLimits.TooLargeMessage</small>}</label>}<label class="field dossier-wide"><span>Название</span><input @bind="attachment.Label" /></label><label class="field dossier-wide"><span>Описание / комментарий</span><textarea @bind="attachment.Description"></textarea></label><details class="dossier-wide"><summary>Назначение и связь</summary><div class="form-grid"><label class="field dossier-wide"><span>Пункт документов (необязательно)</span><select @bind="attachment.RequirementKey" @bind:after="UseDocumentRequirement"><option value="">Не относится к обязательному документу</option>@foreach(var item in VisibleDocumentRequirements){<option value="@item.Id">@item.Title · @ProcurementLabels.DocumentStatus(item.Status)</option>}</select></label><label class="field"><span>Связь</span><select @bind="attachment.OwnerKey"><option value="case">Весь объект</option>@foreach(var item in card.Negotiations){<option value="n:@item.Id">Переговоры · @ProcurementLabels.Time(item.EffectiveAt)</option>}@foreach(var item in card.Checks){<option value="c:@item.Id">Проверка · @item.Title</option>}@if(card.Inspection!=null){<option value="i:@card.Inspection.Id">Осмотр целиком</option>@foreach(var item in card.Inspection.Items.Where(x=>x.AllowAttachments)){<option value="ii:@item.Id">Пункт осмотра · @item.Title</option>}}</select></label><label class="field"><span>Тип</span><InputSelect @bind-Value="attachment.Kind">@foreach(var value in Enum.GetValues<CaseAttachmentKind>()){<option value="@value">@ProcurementLabels.AttachmentKind(value)</option>}</InputSelect></label></div></details><div class="form-actions"><button type="button" class="btn secondary" @onclick="CloseAttachment">Отмена</button><ActionButton Label="Добавить материал" Type="submit" Busy="Busy" Disabled="@(attachment.Kind!=CaseAttachmentKind.Link&&(selectedFile==null||UploadFileTooLarge(selectedFile)))" /></div></div></EditForm></CaseModal>}
    @if(documentRequirementOpen){<CaseModal Error="@Error" Busy="Busy" Title="Статус документа" OnClose="()=>documentRequirementOpen=false"><EditForm Model="documentRequirement" FormName="document-requirement" OnValidSubmit="SaveDocumentRequirementAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><div class="dossier-wide"><strong>@documentRequirement.Title</strong><p class="subtle">@documentRequirement.Description</p></div><label class="field"><span>Статус</span><InputSelect @bind-Value="documentRequirement.Status"><option value="Missing">Нет</option><option value="Requested">Запрошен</option>@if(documentRequirement.HasAttachment){<option value="Received">Получен</option><option value="Verified">Проверен</option>}</InputSelect></label><label class="field"><span>Срок (МСК)</span><LocalDateTimeInput @bind-Value="documentRequirement.Due" /></label><label class="field dossier-wide"><span>Комментарий</span><textarea @bind="documentRequirement.Note" maxlength="2000"></textarea></label><div class="form-actions"><button type="button" class="btn secondary" @onclick="()=>documentRequirementOpen=false">Отмена</button><ActionButton Label="Сохранить статус" Type="submit" Busy="Busy" /></div></div></EditForm></CaseModal>}
    @if(purchaseOpen){<CaseModal Error="@Error" Busy="Busy" Title="Отметить объект как купленный" OnClose="()=>purchaseOpen=false"><EditForm Model="purchase" FormName="acquire-case" OnValidSubmit="AcquireAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field"><span>Фактическая цена покупки, ₽</span><NumberInput @bind-Value="purchase.Price"  Money="true" /></label><label class="field"><span>Дата покупки / регистрации</span><InputDate @bind-Value="purchase.Date" /></label><label class="field dossier-wide"><span>Комментарий (необязательно)</span><textarea @bind="purchase.Comment"></textarea></label><p class="subtle dossier-wide">После подтверждения объект останется доступным со всей историей. Укажите фактическую цену и дату покупки.</p><div class="form-actions"><button type="button" class="btn secondary" @onclick="()=>purchaseOpen=false">Отмена</button><ActionButton Label="Подтвердить покупку" Type="submit" Busy="Busy" /></div></div></EditForm></CaseModal>}
    @if(correctionOpen){<CaseModal Error="@Error" Busy="Busy" Title="Исправить данные покупки" OnClose="()=>correctionOpen=false"><EditForm Model="correction" FormName="correct-acquisition" OnValidSubmit="CorrectAcquisitionAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field"><span>Фактическая цена, ₽</span><NumberInput @bind-Value="correction.Price"  Money="true" /></label><label class="field"><span>Дата покупки / регистрации</span><InputDate @bind-Value="correction.Date" /></label><label class="field dossier-wide"><span>Комментарий</span><textarea @bind="correction.Comment"></textarea></label><label class="field dossier-wide"><span>Причина исправления</span><textarea @bind="correction.Reason" maxlength="1000"></textarea></label><p class="subtle dossier-wide">Предыдущие значения, причина и автор останутся в истории и системном аудите.</p><div class="form-actions"><button type="button" class="btn secondary" @onclick="()=>correctionOpen=false">Отмена</button><ActionButton Label="Сохранить исправление" Type="submit" Busy="Busy" /></div></div></EditForm></CaseModal>}
    @if(factCorrectionOpen){<CaseModal Title="Исправить рабочие данные" Busy="Busy" OnClose="CloseFactCorrection"><EditForm Model="factCorrection" FormName="correct-case-fact" OnValidSubmit="SaveFactCorrectionAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><label class="field dossier-wide"><span>Поле</span><InputSelect @bind-Value="factCorrection.Field" @bind-Value:after="UseFactCorrectionField">@foreach(var value in Enum.GetValues<CaseFactField>()){<option value="@value">@ProcurementLabels.Fact(value)</option>}</InputSelect></label><div class="correction-preview dossier-wide"><div><small>Сейчас</small><strong>@FactCurrentDisplay()</strong></div><div><small>После исправления</small><strong>@FactProposedDisplay()</strong></div></div>@if(FactUsesText()){<label class="field dossier-wide"><span>Новое значение</span><InputText @bind-Value="factCorrection.TextValue" maxlength="@FactTextMaxLength()" /></label>}else{<label class="field dossier-wide"><span>@(factCorrection.Field==CaseFactField.Price?"Новое значение, ₽":"Новое значение, м²")</span><NumberInput Money="@(factCorrection.Field==CaseFactField.Price)" @bind-Value="factCorrection.NumericValue"  /></label><p class="subtle dossier-wide">Пустое значение очистит этот рабочий факт.</p>}@if(factCorrection.Field is CaseFactField.Location or CaseFactField.CadastralNumber){<p class="subtle dossier-wide">Пустое значение очистит этот рабочий факт.</p>}<label class="field dossier-wide"><span>Причина исправления</span><InputTextArea @bind-Value="factCorrection.Reason" maxlength="4000" /></label><p class="subtle dossier-wide">Меняется только рабочий факт карточки. Значения исходных источников не переписываются.</p>@if(Error!=null){<div class="correction-error dossier-wide"><p class="case-problem">@Error</p><button type="button" class="btn secondary" disabled="@Busy" @onclick="RefreshCorrectionAsync">Обновить данные</button></div>}<div class="form-actions dossier-wide"><button type="button" class="btn secondary" disabled="@Busy" @onclick="CloseFactCorrection">Отмена</button><ActionButton Label="Сохранить исправление" Type="submit" Busy="Busy" /></div></div></EditForm></CaseModal>}
    @if(sourceLinkOpen){<CaseModal Title="Исправить связь источника" Busy="Busy" OnClose="CloseSourceLinkCorrection">@if(sourceLinkLoading){<p class="subtle">Загружаем доступные объекты…</p>}else if(sourceLinkLoadError!=null){<div class="correction-error"><p class="case-problem">@sourceLinkLoadError</p><button type="button" class="btn secondary" @onclick="RefreshCorrectionAsync">Обновить данные</button></div>}else{<EditForm Model="sourceLinkCorrection" FormName="correct-source-link" OnValidSubmit="SaveSourceLinkCorrectionAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="form-grid"><div class="dossier-wide"><strong>@sourceLinkCorrection.SourceTitle</strong><p class="subtle">Исправление связи не меняет данные самого источника.</p></div><div class="correction-preview dossier-wide"><div><small>Текущая связь</small><strong>@sourceLinkCorrection.CurrentBusinessNumber</strong></div><div><small>После исправления</small><strong>@SourceLinkTargetDisplay()</strong></div></div><label class="field dossier-wide"><span>Новая связь</span><InputSelect @bind-Value="sourceLinkCorrection.TargetCaseId"><option value="">Только отвязать — вернуть источник во входящие</option>@foreach(var target in sourceLinkTargets){<option value="@target.CaseId">@target.BusinessNumber · @target.Title</option>}</InputSelect></label><label class="field dossier-wide"><span>Причина исправления</span><InputTextArea @bind-Value="sourceLinkCorrection.Reason" maxlength="4000" /></label><p class="subtle dossier-wide">Старая связь останется в истории. Подтверждённой станет только выбранная связь.</p>@if(Error!=null){<div class="correction-error dossier-wide"><p class="case-problem">@Error</p><button type="button" class="btn secondary" disabled="@Busy" @onclick="RefreshCorrectionAsync">Обновить данные</button></div>}<div class="form-actions dossier-wide"><button type="button" class="btn secondary" disabled="@Busy" @onclick="CloseSourceLinkCorrection">Отмена</button><ActionButton Label="Сохранить связь" Type="submit" Busy="Busy" /></div></div></EditForm>}</CaseModal>}
    @if(retryAttachmentId!=null){<CaseModal Title="Восстановить загрузку" Busy="Busy" OnClose="CloseAttachmentRetry"><p><strong>@(RetryAttachmentView()?.Label??"Вложение")</strong></p><p class="subtle">Текущее состояние: @ProcurementLabels.FileStatus(RetryAttachmentView()?.Status??StoredFileStatus.PendingUpload). Повтор продолжит это же вложение и не создаст новую запись. Выберите исходный файл повторно.</p><InputFile OnChange="SelectRetryFile" accept="@ProcurementLabels.Accept(RetryAttachmentView()?.Kind??CaseAttachmentKind.Document)" /><small>@(retryFile?.Name??"Файл не выбран")</small>@if(UploadFileTooLarge(retryFile)){<p class="case-problem">@FileUploadLimits.TooLargeMessage</p>}@if(Error!=null){<p class="case-problem">@Error</p>}<div class="form-actions"><button type="button" class="btn secondary" disabled="@Busy" @onclick="CloseAttachmentRetry">Отмена</button><ActionButton Label="Повторить в это вложение" OnClick="RetryAttachmentAsync" Busy="Busy" Disabled="@(retryFile==null||UploadFileTooLarge(retryFile))" /></div></CaseModal>}
}
else { <PageState Kind="error" Title="Карточку не удалось загрузить"><ActionButton Label="Повторить" OnClick="ReloadAsync" /></PageState> }

@if(managerOpen && card!=null)
{
    <CaseModal Title="Сменить ответственного" Busy="Busy" Error="@Error" OnClose="()=>{if(!Busy)managerOpen=false;}">
        <label class="field"><span>Ответственный за объект</span><select @bind="managerTarget" disabled="@Busy">@foreach(var target in card.ReassignmentManagers){<option value="@target.EmployeeId">@target.Name</option>}</select></label>
        <p class="subtle">Ответственные по существующим задачам сохранятся.</p>
        @if(LastWriteWasConflict){<button type="button" class="btn secondary" @onclick="RefreshManager">Обновить данные</button>}
        <div class="form-actions"><button type="button" class="btn secondary" disabled="@Busy" @onclick="()=>managerOpen=false">Отмена</button><button type="button" class="btn primary" disabled="@(Busy||LastWriteWasConflict||managerTarget==Guid.Empty||managerTarget==card.ManagerEmployeeId)" @onclick="SaveManager">Сохранить</button></div>
    </CaseModal>
}
@code {
    private bool managerOpen;
    private Guid managerTarget;
    private long managerVersion;
    private void OpenManager(){if(card==null||!card.CanReassignManager)return;ClearFeedback();managerTarget=card.ManagerEmployeeId;managerVersion=card.Item.CaseVersion;managerOpen=true;}
    private async Task RefreshManager(){await ReloadAsync();managerOpen=false;}
    private async Task SaveManager(){if(card==null)return;bool committed=await ExecuteConfirmedAsync(()=>Workspace.ReassignManagerAsync(CurrentSubject,new(CaseId,managerVersion,managerTarget),OperationId,CancellationToken.None));if(committed){managerOpen=false;if(!NeedsRefresh)Success="Ответственный изменён";await OnChanged.InvokeAsync();}}
    private CaseNextAction? taskPanel;
    private Task OpenRelatedTask(Guid taskId)=>taskPanel?.OpenTaskAsync(taskId)??Task.CompletedTask;
    private CaseSourceChangesNotice? sourceNotice;
    private Task RefreshSourceNotices()=>sourceNotice?.Refresh()??Task.CompletedTask;
    [Parameter] public Guid CaseId { get; set; }
    [Parameter] public bool FullPage { get; set; }
    [Parameter] public string? InitialTab { get; set; }
    private string? appliedTab;
    private Guid tabCase;
    private SourceDiscrepancyView? pendingFact;
    private async Task NextActionSaved(){await ReloadAsync();Success="Задачи обновлены";}
    private int photoIndex; private bool galleryOpen, noteOpen, decisionsOpen, templatesOpen;
    private bool AnyDialog => managerOpen|| pendingFact!=null||galleryOpen||noteOpen||decisionsOpen||templatesOpen||negotiationOpen||attachmentOpen||documentRequirementOpen||purchaseOpen||correctionOpen||factCorrectionOpen||sourceLinkOpen||retryAttachmentId!=null||dialogAction!=null;
    private void MovePhoto(int step) => photoIndex=(photoIndex+step+card!.Photos.Length)%card.Photos.Length;
    private string AreaInSotki() => card!.Item.Area is {} area ? (area/100m).ToString("0.##",System.Globalization.CultureInfo.GetCultureInfo("ru-RU"))+" сот." : "Не указана";
    private static string OptionalPrice(decimal? price) => price is null ? "Не указано" : ProcurementLabels.Money(price);
    [Parameter] public EventCallback OnChanged { get; set; }
    private static readonly (string Id,string Label)[] Tabs=[("overview","Основное"),("negotiations","Переговоры"),("checks","Проверки"),("inspection","Осмотр"),("documents","Документы"),("history","История"),("sources","Источники")];
    private CaseRichNoteView? RichNote(CaseNoteSection section) => card?.RichNotes.SingleOrDefault(item => item.Section == section);
    private CaseCard? card; private Guid loaded; private string tab="overview"; private ProcurementAction? dialogAction; private string dialogTitle=""; private bool negotiationOpen; private bool attachmentOpen; private bool documentRequirementOpen; private bool purchaseOpen; private bool correctionOpen; private bool factCorrectionOpen; private bool sourceLinkOpen; private bool sourceLinkLoading;
    private string? sourceLinkLoadError; private IReadOnlyList<CaseLinkTarget> sourceLinkTargets=[];
    private NoteInput note=new(); private CheckTemplateInput checkTemplate=new(); private AttachmentInput attachment=new(); private DocumentRequirementInput documentRequirement=new(); private PurchaseInput purchase=new(); private CorrectionInput correction=new(); private FactCorrectionInput factCorrection=new(); private SourceLinkCorrectionInput sourceLinkCorrection=new(); private IBrowserFile? selectedFile; private Guid? retryAttachmentId; private IBrowserFile? retryFile;
    private IReadOnlyList<GroupMarketView> caseMarkets = [];
    private Guid? selectedMarketGroup;
    private GroupMarketView? SelectedMarket => caseMarkets.FirstOrDefault(item => item.SearchGroupId == selectedMarketGroup) ?? caseMarkets.FirstOrDefault();
    private void ChangeMarketGroup(ChangeEventArgs args) => selectedMarketGroup = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
    protected override async Task ReadAsync(){card=await Workspace.ReadCardAsync(CurrentSubject,CaseId,CancellationToken.None);caseMarkets=await Markets.ReadCaseAsync(CurrentSubject,CaseId,CancellationToken.None);if(loaded!=CaseId)selectedMarketGroup=null;photoIndex=loaded==CaseId?Math.Clamp(photoIndex,0,Math.Max(0,card.Photos.Length-1)):0;if(loaded!=CaseId){factCorrectionOpen=false;sourceLinkOpen=false;sourceLinkTargets=[];}loaded=CaseId;}
    protected override async Task OnParametersSetAsync()
    {
        if(loaded!=CaseId)await ReloadAsync();
        if(tabCase!=CaseId || appliedTab!=InitialTab)
        {
            // Переход открывает только существующую вкладку, не меняя её доступность.
            tab=Tabs.Any(x=>x.Id==InitialTab)?InitialTab!:"overview";
            tabCase=CaseId;appliedTab=InitialTab;
        }
    }
    private string SourceSummary()=>card!.Sources.Count==0?"Нет связанных":string.Join(" + ",card.Sources.Select(x=>ProcurementLabels.Source(x.Source)).Distinct());
    private static string NegotiationTitle(NegotiationView item)=>item.AgreedPrice!=null?"Согласована цена":item.BuyerOffer!=null?"Наше предложение":item.SellerPrice!=null?"Цена продавца":item.Outcome.Length>0?item.Outcome:"Событие коммуникации";
    private static string Meta(params string?[] values)=>string.Join(" · ",values.Where(x=>!string.IsNullOrWhiteSpace(x)));
    private string CheckSummary(CaseCheckLevel level)=>card!.Checks.Any(x=>x.Level==level&&x.Blocker)?"Есть блокирующие вопросы":card.Checks.Any(x=>x.Level==level)?"Проверки зафиксированы":"Не начаты";
    private string NextAction()=>card!.Item.Stage=="acquired"?"Закупка завершена":string.IsNullOrWhiteSpace(card.Item.NextActionTitle)?"Следующее действие не назначено":card.Item.NextActionTitle;
    private int CompletedChecks()=>card!.Checks.Count(x=>x.Status is CaseCheckStatus.Passed or CaseCheckStatus.Issue);
    private int OpenRisks()=>card!.Checks.Count(x=>x.Blocker&&x.Status!=CaseCheckStatus.Passed);
    private IReadOnlyList<DocumentRequirementView> VisibleDocumentRequirements => card?.DocumentRequirements
        .Where(x=>x.Code is not ("access_scheme" or "cadastral_plan")).ToArray() ?? [];
    private int ReadyDocuments()=>VisibleDocumentRequirements.Count(x=>x.Status is CaseDocumentStatus.Received or CaseDocumentStatus.Verified);
    private int MissingDocuments()=>VisibleDocumentRequirements.Count-ReadyDocuments();
    private int ReadinessPercent(){int parts=0,total=3;if(card!.Checks.Count>0&&CompletedChecks()==card.Checks.Count)parts++;if(VisibleDocumentRequirements.Count>0&&ReadyDocuments()==VisibleDocumentRequirements.Count)parts++;if(card.Inspection?.Status==InspectionStatus.Completed)parts++;return parts*100/total;}
    private void OpenNegotiation(){ClearFeedback();negotiationOpen=true;}
    private void OpenPurchase(){ClearFeedback();purchase=new(){Price=card!.Negotiations.Select(x=>x.AgreedPrice).FirstOrDefault(x=>x!=null)??card.Item.Price??0,Date=DateOnly.FromDateTime(DateTime.Today)};purchaseOpen=true;}
    private void OpenCorrection(){ClearFeedback();correction=new(){Price=card!.AcquisitionPrice??0,Date=card.AcquisitionDate??DateOnly.FromDateTime(DateTime.Today),Comment=card.AcquisitionComment??""};correctionOpen=true;}
    private void OpenFactCorrection(){if(Busy||card==null)return;ClearFeedback();factCorrection=new(){Field=CaseFactField.Title,CaseVersion=card.Item.CaseVersion};UseFactCorrectionField();factCorrectionOpen=true;}
    private void CloseFactCorrection(){if(!Busy){factCorrectionOpen=false;factCorrection=new();}}
    private void UseFactCorrectionField(){if(card==null)return;factCorrection.TextValue="";factCorrection.NumericValue=null;switch(factCorrection.Field){case CaseFactField.Title:factCorrection.TextValue=card.Item.Title;break;case CaseFactField.Price:factCorrection.NumericValue=card.Item.Price;break;case CaseFactField.AreaSquareMeters:factCorrection.NumericValue=card.Item.Area;break;case CaseFactField.Location:factCorrection.TextValue=card.Item.Location??"";break;case CaseFactField.CadastralNumber:factCorrection.TextValue=card.CadastralNumber??"";break;}}
    private bool FactUsesText()=>factCorrection.Field is CaseFactField.Title or CaseFactField.Location or CaseFactField.CadastralNumber;
    private int FactTextMaxLength()=>factCorrection.Field==CaseFactField.CadastralNumber?128:20000;
    private string FactCurrentDisplay()=>factCorrection.Field switch{CaseFactField.Title=>card!.Item.Title,CaseFactField.Price=>ProcurementLabels.Money(card!.Item.Price),CaseFactField.AreaSquareMeters=>ProcurementLabels.Area(card!.Item.Area),CaseFactField.Location=>card!.Item.Location??"Не указано",CaseFactField.CadastralNumber=>card!.CadastralNumber??"Не указано",_=>"—"};
    private string FactProposedDisplay()=>factCorrection.Field switch{CaseFactField.Title=>string.IsNullOrWhiteSpace(factCorrection.TextValue)?"Введите новое значение":factCorrection.TextValue,CaseFactField.Price=>factCorrection.NumericValue==null?"Будет очищено":ProcurementLabels.Money(factCorrection.NumericValue),CaseFactField.AreaSquareMeters=>factCorrection.NumericValue==null?"Будет очищено":ProcurementLabels.Area(factCorrection.NumericValue),CaseFactField.Location=>string.IsNullOrWhiteSpace(factCorrection.TextValue)?"Будет очищено":factCorrection.TextValue,CaseFactField.CadastralNumber=>string.IsNullOrWhiteSpace(factCorrection.TextValue)?"Будет очищено":factCorrection.TextValue,_=>"—"};
    private async Task SaveFactCorrectionAsync(){string? text=FactUsesText()?factCorrection.TextValue:null;decimal? number=FactUsesText()?null:factCorrection.NumericValue;bool committed=await ExecuteConfirmedAsync(()=>Workspace.CorrectCaseFactAsync(CurrentSubject,new(CaseId,factCorrection.CaseVersion,factCorrection.Field,text,number,factCorrection.Reason),OperationId,CancellationToken.None));if(committed){factCorrectionOpen=false;factCorrection=new();Success="Рабочие данные исправлены";await OnChanged.InvokeAsync();}}
    private async Task OpenSourceLinkCorrectionAsync(CaseSourceView source){if(Busy||card==null||!card.CanCorrectSourceLinks)return;ClearFeedback();sourceLinkOpen=true;sourceLinkLoading=true;sourceLinkLoadError=null;sourceLinkTargets=[];sourceLinkCorrection=new(){CatalogItemId=source.CatalogItemId,ExpectedCaseId=CaseId,CurrentBusinessNumber=card.Item.BusinessNumber,SourceTitle=source.Title};try{CatalogItemDetail detail=await CatalogWorkspace.ReadItemAsync(CurrentSubject,source.CatalogItemId,CancellationToken.None);if(detail.Item.PropertyCaseId!=CaseId){sourceLinkLoadError="Связь уже изменилась. Обновите карточку перед исправлением.";return;}sourceLinkCorrection.CatalogVersion=detail.Item.Version;sourceLinkTargets=(await CatalogWorkspace.ReadLinkTargetsAsync(CurrentSubject,CancellationToken.None)).Where(x=>x.CaseId!=CaseId).ToArray();}catch(Exception exception){sourceLinkLoadError=ReadFailure(exception,"Не удалось загрузить варианты связи. Обновите данные и повторите.");}finally{sourceLinkLoading=false;}}
    private void CloseSourceLinkCorrection(){if(!Busy){sourceLinkOpen=false;sourceLinkLoadError=null;sourceLinkTargets=[];sourceLinkCorrection=new();}}
    private string SourceLinkTargetDisplay()=>sourceLinkCorrection.TargetCaseId is Guid id&&sourceLinkTargets.FirstOrDefault(x=>x.CaseId==id) is { } target?$"{target.BusinessNumber} · {target.Title}":"Без связи — вернуть во входящие";
    private async Task SaveSourceLinkCorrectionAsync(){bool committed=await ExecuteConfirmedAsync(()=>CatalogWorkspace.CorrectCaseLinkAsync(CurrentSubject,new(sourceLinkCorrection.CatalogItemId,sourceLinkCorrection.CatalogVersion,sourceLinkCorrection.ExpectedCaseId,sourceLinkCorrection.TargetCaseId,sourceLinkCorrection.Reason),OperationId,CancellationToken.None));if(committed){sourceLinkOpen=false;sourceLinkTargets=[];sourceLinkCorrection=new();Success="Связь источника исправлена";await OnChanged.InvokeAsync();}}
    private async Task RefreshCorrectionAsync(){if(Busy)return;factCorrectionOpen=false;sourceLinkOpen=false;sourceLinkLoadError=null;sourceLinkTargets=[];await ReloadAsync();}
    private long decisionCaseVersion, decisionSourceRevision;
    private bool decisionNeedsRefresh;
    private void OpenDecision(ProcurementAction action)
    {
        if (Busy || card==null || CaseDecisionPresentation.Blocked(card,action)!=null) return;
        ClearFeedback(); decisionNeedsRefresh=false; decisionsOpen=false; dialogAction=action; dialogTitle=CaseDecisionPresentation.Title(action);
        decisionCaseVersion=card.Item.CaseVersion; decisionSourceRevision=card.Item.SourceRevision;
    }
    private void OpenDecisionSection(string section) { decisionsOpen=false; tab=section; }
    private void CloseDialog() { if(!Busy) dialogAction=null; }
    private async Task RefreshDecisionAsync()
    {
        await ReloadAsync();
        if(card!=null && !Forbidden && Error==null) { decisionNeedsRefresh=false; decisionCaseVersion=card.Item.CaseVersion; decisionSourceRevision=card.Item.SourceRevision; }
    }
    private async Task ConfirmAsync(DecisionDraft draft)
    {
        if(dialogAction==null || NeedsRefresh || decisionNeedsRefresh) return;
        bool committed=await ExecuteConfirmedAsync(()=>Workspace.DecideAsync(CurrentSubject,new(CaseId,decisionCaseVersion,decisionSourceRevision,dialogAction.Value,draft.Reason,draft.Clarification,draft.Target,CaseFormValues.ParseLocal(draft.Due)),OperationId,CancellationToken.None));
        decisionNeedsRefresh=!committed && (LastWriteWasConflict || Forbidden || WriteOutcome==WorkspaceWriteOutcome.Unknown);
        if(committed) { dialogAction=null; if(!NeedsRefresh) Success="Решение сохранено"; await OnChanged.InvokeAsync(); }
    }
    private async Task SaveNoteAsync(){await ExecuteAsync(()=>Workspace.AddNoteAsync(CurrentSubject,new(CaseId,card!.Item.CaseVersion,note.Text,false,"",null,note.CommandId),OperationId,CancellationToken.None),"Заметка добавлена");if(Success!=null){note=new();noteOpen=false;}}
    private async Task CommunicationSaved(string message){negotiationOpen=false;await ReloadAsync();Success=message;}
