@page "/procurement-v2"
@attribute [Authorize(Policy = "manager_queue.read")]
@using LandErp.Application.Modules.Catalog.Domain
@using LandErp.Application.Modules.Procurement.Contracts
@using LandErp.Application.Modules.Procurement.Domain
@using LandErp.Server.Components.Procurement
@inherits WorkspaceComponent
@inject IProcurementQueueV2ReadService ReadModel
@inject IProcurementWorkspace Workspace
@inject NavigationManager Navigation

<PageTitle>Очередь закупки · LandErp</PageTitle>

<section class="pq2-page">
    <header class="pq2-head">
        <div>
            <div class="pq2-eyebrow">Закупка / Очередь объектов</div>
            <h1>Очередь закупки</h1>
            <p>Только выбранные PropertyCase. Подробности открываются справа.</p>
        </div>
        <button type="button" class="pq2-button pq2-button-secondary" @onclick="ReloadAsync" disabled="@Busy">Обновить</button>
    </header>

    @if (Loading)
    {
        <PageState Kind="loading" Title="Загружаем очередь закупки…" />
    }
    else if (Forbidden)
    {
        <PageState Kind="forbidden" Title="Нет доступа к очереди закупки" />
    }
    else
    {
        @if (Error != null)
        {
            <PageState Kind="error" Title="@Error"><ActionButton Label="Повторить" OnClick="ReloadAsync" /></PageState>
        }

        @if (page != null)
        {
            <div class="pq2-kpis" aria-label="Сводка очереди">
                <button type="button" class="pq2-kpi" @onclick="ResetOperationalFiltersAsync">
                    <span>В работе</span><strong>@page.Summary.InWork</strong><small>активных объектов</small>
                </button>
                <button type="button" class="pq2-kpi @(dueTodayOnly ? "is-active" : "")" @onclick="ToggleDueTodayAsync">
                    <span>Сегодня</span><strong>@page.Summary.DueToday</strong><small>требуют действия</small>
                </button>
                <button type="button" class="pq2-kpi pq2-kpi-danger @(overdueOnly ? "is-active" : "")" @onclick="ToggleOverdueAsync">
                    <span>Просрочено</span><strong>@page.Summary.Overdue</strong><small>по следующему действию</small>
                </button>
                <button type="button" class="pq2-kpi pq2-kpi-warn @(sourceChangedOnly ? "is-active" : "")" @onclick="ToggleSourceChangedAsync">
                    <span>Источники изменились</span><strong>@page.Summary.SourceChanged</strong><small>есть новая source revision</small>
                </button>
                <button type="button" class="pq2-kpi @(stageFilter == "returned" ? "is-active" : "")" @onclick="ShowReturnedAsync">
                    <span>Возвращены</span><strong>@page.Summary.Returned</strong><small>реальный Case state</small>
                </button>
            </div>

            <div class="pq2-filters">
                <div class="pq2-search">
                    <span aria-hidden="true">⌕</span>
                    <input value="@searchDraft" @oninput="e => searchDraft = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="SearchKeyDownAsync" placeholder="Кадастр, номер, объект, адрес, ID/название источника" />
                    <button type="button" @onclick="ApplySearchAsync">Найти</button>
                </div>
                <label>
                    <span>Этап</span>
                    <select value="@stageFilter" @onchange="StageChangedAsync">
                        <option value="">Все активные</option>
                        @foreach (string stage in page.Stages)
                        {
                            <option value="@stage">@ProcurementLabels.Stage(stage)</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Ответственный</span>
                    <select value="@assigneeFilter" @onchange="AssigneeChangedAsync">
                        <option value="">Все</option>
                        @foreach (ProcurementQueueV2Assignee assignee in page.Assignees)
                        {
                            <option value="@assignee.Id">@assignee.Name</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Источник</span>
                    <select value="@sourceFilter" @onchange="SourceChangedAsync">
                        <option value="">Все</option>
                        @foreach (CatalogSource source in Enum.GetValues<CatalogSource>())
                        {
                            <option value="@source">@ProcurementLabels.Source(source)</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Проверки</span>
                    <select value="@checksFilter" @onchange="ChecksChangedAsync">
                        <option value="Any">Все</option>
                        <option value="HasIssues">Есть проблемы</option>
                        <option value="Incomplete">Не завершены</option>
                        <option value="Complete">Завершены</option>
                    </select>
                </label>
                <label>
                    <span>Сортировка</span>
                    <select value="@sort" @onchange="SortChangedAsync">
                        <option value="RecordedAt">Новые сверху</option>
                        <option value="DueAt">По сроку</option>
                        <option value="WorkingPrice">По рабочей цене</option>
                        <option value="Area">По площади</option>
                        <option value="LastContact">По контакту</option>
                    </select>
                </label>
            </div>

            <div class="pq2-chips">
                <button type="button" class="@(sourceChangedOnly ? "is-on" : "")" @onclick="ToggleSourceChangedAsync">Источник изменился</button>
                <button type="button" class="@(dueTodayOnly ? "is-on" : "")" @onclick="ToggleDueTodayAsync">Срок сегодня</button>
                <button type="button" class="@(overdueOnly ? "is-on" : "")" @onclick="ToggleOverdueAsync">Просрочено</button>
                @if (HasFilters)
                {
                    <button type="button" class="pq2-chip-clear" @onclick="ClearFiltersAsync">Сбросить фильтры</button>
                }
                <span class="pq2-found">Найдено: <strong>@page.Total</strong></span>
            </div>

            <div class="pq2-table-shell">
                <div class="pq2-table-scroll">
                    <table class="pq2-table">
                        <thead>
                            <tr>
                                <th>Объект</th>
                                <th>Этап</th>
                                <th>Цена / площадь</th>
                                <th>Следующее действие</th>
                                <th>Проверки</th>
                                <th>Последний контакт</th>
                                <th>Ответственный</th>
                                <th>Источники</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (page.Items.Count == 0)
                            {
                                <tr><td colspan="8" class="pq2-empty">По выбранным условиям объектов нет.</td></tr>
                            }
                            @foreach (ProcurementQueueV2Row item in page.Items)
                            {
                                <tr @key="item.CaseId" class="@RowClass(item.RowState)" @onclick="() => OpenDrawerAsync(item.CaseId)">
                                    <td class="pq2-object-cell">
                                        @if (!string.IsNullOrWhiteSpace(item.ThumbnailUrl))
                                        {
                                            <img src="@item.ThumbnailUrl" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="pq2-thumb-fallback" aria-hidden="true">⌂</div>
                                        }
                                        <div>
                                            <strong>@item.Title</strong>
                                            <span>@ValueOrDash(item.Location)</span>
                                            <small>@item.BusinessNumber@if (!string.IsNullOrWhiteSpace(item.CadastralNumber)) { <text> · @item.CadastralNumber</text> }</small>
                                        </div>
                                    </td>
                                    <td><span class="pq2-stage">@ProcurementLabels.Stage(item.Stage)</span></td>
                                    <td class="pq2-price-cell"><strong>@Money(item.WorkingPrice)</strong><span>@Area(item.AreaSquareMeters)</span></td>
                                    <td>
                                        <strong class="pq2-action-title">@ValueOrDash(item.NextActionTitle)</strong>
                                        <span class="pq2-due @DueClass(item.DueState)">@DueText(item.DueAt, item.DueState)</span>
                                    </td>
                                    <td>@CheckCompact(item.QuickChecks)</td>
                                    <td>
                                        @if (item.LatestContact == null)
                                        {
                                            <span class="pq2-muted">Контактов нет</span>
                                        }
                                        else
                                        {
                                            <strong>@ShortDate(item.LatestContact.EffectiveAt)</strong>
                                            <span>@ContactCaption(item.LatestContact)</span>
                                        }
                                    </td>
                                    <td><span class="pq2-person">@Initials(item.AssigneeName)</span><strong>@item.AssigneeName</strong></td>
                                    <td>
                                        <div class="pq2-source-badges">
                                            @foreach (ProcurementSourceTypeSummary source in item.Sources)
                                            {
                                                <span>@ProcurementLabels.Source(source.Source)@(source.Count > 1 ? $" ×{source.Count}" : "")</span>
                                            }
                                            @if (item.SourceCount == 0) { <span class="pq2-muted-badge">нет</span> }
                                            @if (item.SourceChanged) { <span class="pq2-changed">изменился</span> }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <footer class="pq2-pager">
                    <span>@PageCaption</span>
                    <div>
                        <button type="button" @onclick="PreviousPageAsync" disabled="@(page.Offset == 0)">← Назад</button>
                        <button type="button" @onclick="NextPageAsync" disabled="@(page.Offset + page.Size >= page.Total)">Вперёд →</button>
                    </div>
                </footer>
            </div>
        }
    }
</section>

@if (selectedCaseId != null)
{
    <div class="pq2-overlay" @onclick="CloseDrawer">
        <aside class="pq2-drawer" @onclick:stopPropagation="true" aria-label="Карточка объекта">
            @if (drawerLoading)
            {
                <div class="pq2-drawer-state"><PageState Kind="loading" Title="Загружаем объект…" /></div>
            }
            else if (drawerError != null)
            {
                <div class="pq2-drawer-state"><PageState Kind="error" Title="@drawerError" /></div>
            }
            else if (detail != null)
            {
                <div class="pq2-drawer-scroll">
                    <section class="pq2-hero">
                        <button type="button" class="pq2-close" title="Закрыть" @onclick="CloseDrawer">×</button>
                        <div class="pq2-hero-media">
                            @if (!string.IsNullOrWhiteSpace(detail.ThumbnailUrl)) { <img src="@detail.ThumbnailUrl" alt="" /> }
                            else { <div class="pq2-hero-fallback">⌂</div> }
                        </div>
                        <div class="pq2-hero-main">
                            <div class="pq2-hero-top"><span class="pq2-stage">@ProcurementLabels.Stage(detail.Stage)</span><span>@detail.BusinessNumber</span></div>
                            <h2>@detail.Title</h2>
                            <p>@ValueOrDash(detail.Location)</p>
                            <div class="pq2-hero-facts">
                                <div><span>Кадастр</span><strong>@ValueOrDash(detail.CadastralNumber)</strong></div>
                                <div><span>Площадь</span><strong>@Area(detail.AreaSquareMeters)</strong></div>
                                <div><span>Ответственный</span><strong>@detail.AssigneeName</strong></div>
                            </div>
                            <button type="button" class="pq2-link-button" @onclick="OpenFullCase">Открыть полную карточку ↗</button>
                        </div>
                    </section>

                    <section class="pq2-block">
                        <div class="pq2-block-head"><h3>Цена и торг</h3></div>
                        <div class="pq2-price-grid">
                            <div><span>Рабочая цена</span><strong>@Money(detail.WorkingPrice)</strong></div>
                            <div><span>Источник Ask</span><strong>@Money(detail.CurrentSourceAsk)</strong><small>@ValueOrDash(detail.CurrentSourceLabel)</small></div>
                            <div><span>Продавец</span><strong>@Money(detail.LatestSellerOffer)</strong></div>
                            <div><span>Мы предложили</span><strong>@Money(detail.LatestBuyerOffer)</strong></div>
                            <div><span>Согласовано</span><strong>@Money(detail.LatestAgreedPrice)</strong></div>
                            <div class="pq2-backend-gap" title="TODO-BACKEND-PROCUREMENT: нет immutable baseline для корректного расчёта старта и снижения">
                                <span>Старт / снижение</span><strong>—</strong><small>TODO-BACKEND-PROCUREMENT</small>
                            </div>
                        </div>
                    </section>

                    <section class="pq2-block pq2-next">
                        <div class="pq2-block-head"><h3>Следующее действие</h3></div>
                        <div class="pq2-next-row">
                            <div><strong>@ValueOrDash(detail.NextActionTitle)</strong><span>@detail.AssigneeName</span></div>
                            <span class="pq2-due @DueClass(detail.DueState)">@DueText(detail.DueAt, detail.DueState)</span>
                        </div>
                    </section>

                    <section class="pq2-block">
                        <div class="pq2-block-head">
                            <h3>Переговоры</h3>
                            <div><button type="button" class="pq2-text-button" @onclick="OpenFullCase">Все переговоры</button><button type="button" class="pq2-text-button" @onclick="OpenNegotiation">+ Добавить</button></div>
                        </div>
                        @if (detail.Negotiations.Count == 0)
                        {
                            <p class="pq2-muted">Переговоров пока нет.</p>
                        }
                        else
                        {
                            <div class="pq2-list">
                                @foreach (ProcurementQueueV2Negotiation negotiation in detail.Negotiations)
                                {
                                    <article><div><strong>@ShortDateTime(negotiation.EffectiveAt)</strong><span>@JoinNonEmpty(negotiation.Channel, negotiation.Outcome)</span></div><p>@ValueOrDash(negotiation.Comment)</p></article>
                                }
                            </div>
                        }
                    </section>

                    <section class="pq2-block">
                        <div class="pq2-block-head"><h3>Проверки</h3><button type="button" class="pq2-text-button" @onclick="OpenFullCase">Открыть</button></div>
                        <div class="pq2-check-levels">
                            <div><span>Quick</span><strong>@CheckLevelText(detail.QuickChecks)</strong><small>@ResponsibleText(detail.QuickChecks)</small></div>
                            <div><span>Deep</span><strong>@CheckLevelText(detail.DeepChecks)</strong><small>@ResponsibleText(detail.DeepChecks)</small></div>
                        </div>
                    </section>

                    <section class="pq2-block">
                        <div class="pq2-block-head"><h3>Осмотр участка</h3>@if (detail.Inspection.Exists) { <button type="button" class="pq2-text-button" @onclick="OpenInspection">Результаты осмотра</button> }</div>
                        @if (!detail.Inspection.Exists)
                        {
                            <p class="pq2-muted">Осмотр ещё не начат.</p>
                        }
                        else
                        {
                            <div class="pq2-inspection">
                                <strong>@(detail.Inspection.Status == InspectionStatus.Completed ? "Завершён" : "Начат") · @ShortDate(detail.Inspection.Date)</strong>
                                <span>@detail.Inspection.CheckedItems / @detail.Inspection.TotalItems проверено · проблем @detail.Inspection.Problems · материалов @detail.Inspection.MaterialCount</span>
                                @if (!string.IsNullOrWhiteSpace(detail.Inspection.Conclusion)) { <p>@detail.Inspection.Conclusion</p> }
                            </div>
                        }
                    </section>

                    <section class="pq2-block">
                        <div class="pq2-block-head"><h3>Последние события</h3><button type="button" class="pq2-text-button" @onclick="OpenFullCase">Вся история</button></div>
                        @if (detail.Timeline.Count == 0)
                        {
                            <p class="pq2-muted">Событий пока нет.</p>
                        }
                        else
                        {
                            <div class="pq2-timeline">
                                @foreach (ProcurementTimelineSummary item in detail.Timeline)
                                {
                                    <article><i></i><div><strong>@item.Title</strong><span>@ShortDateTime(item.RecordedAt) · @item.Actor</span>@if (!string.IsNullOrWhiteSpace(item.Body)) { <p>@item.Body</p> }</div></article>
                                }
                            </div>
                        }
                    </section>

                    <section class="pq2-block pq2-sources-block">
                        <div class="pq2-block-head"><h3>Источники <span>@detail.Sources.Count</span></h3></div>
                        @if (detail.Sources.Count == 0)
                        {
                            <p class="pq2-muted">Case создан без внешних источников.</p>
                        }
                        @foreach (ProcurementSourceDetail source in detail.Sources)
                        {
                            <article class="pq2-source-card @(source.Changed ? "is-changed" : "")">
                                <div class="pq2-source-card-head">
                                    <div><strong>@ProcurementLabels.Source(source.Source)</strong><span>@ValueOrDash(source.ExternalId)</span></div>
                                    @if (source.Changed) { <span class="pq2-changed">изменился</span> }
                                </div>
                                <div class="pq2-source-data">
                                    <span>Цена <strong>@Money(source.Price)</strong></span>
                                    <span>Площадь <strong>@Area(source.AreaSquareMeters)</strong></span>
                                    <span>Локация <strong>@ValueOrDash(source.Location)</strong></span>
                                    <span>Provenance <strong>@ValueOrDash(source.Provenance)</strong></span>
                                </div>
                                <div class="pq2-source-actions">
                                    @if (!string.IsNullOrWhiteSpace(source.Url)) { <a href="@source.Url" target="_blank" rel="noopener noreferrer">Открыть источник ↗</a> }
                                    @if (detail.CanManageDossier && source.ApplicableFacts.Count > 0)
                                    {
                                        @foreach (CaseFactField field in source.ApplicableFacts)
                                        {
                                            <button type="button" disabled="@Busy" @onclick="() => ApplySourceFactAsync(source, field)">Применить: @ProcurementLabels.Fact(field)</button>
                                        }
                                    }
                                </div>
                            </article>
                        }
                    </section>
                </div>

                <footer class="pq2-drawer-footer">
                    @if (detail.CanHeadDecide)
                    {
                        <button type="button" class="pq2-button pq2-button-danger" disabled="@Busy" @onclick="() => OpenDecisionAsync(ProcurementAction.Return)">Вернуть</button>
                        <button type="button" class="pq2-button pq2-button-primary" disabled="@Busy" @onclick="() => OpenDecisionAsync(ProcurementAction.Approve)">Продолжить</button>
                    }
                    else if (detail.CanManagerDecide)
                    {
                        <button type="button" class="pq2-button pq2-button-danger" disabled="@Busy" @onclick="() => OpenDecisionAsync(ProcurementAction.Reject)">Не подходит</button>
                        <button type="button" class="pq2-button pq2-button-primary" disabled="@Busy" @onclick="() => OpenDecisionAsync(ProcurementAction.Forward)">Передать руководителю</button>
                    }
                    else
                    {
                        <button type="button" class="pq2-button pq2-button-primary" @onclick="OpenFullCase">Открыть карточку</button>
                    }
                </footer>
            }
        </aside>
    </div>
}

@if (decisionCard != null)
{
    <DecisionDialog Card="decisionCard" Action="decisionAction" Title="@DecisionTitle(decisionAction)" Busy="@Busy" Error="@Error"
                    OnConfirm="ConfirmDecisionAsync" OnClose="CloseDecision" />
}

@if (negotiationOpen && detail != null)
{
    <Modal Title="Добавить переговоры" OnClose="CloseNegotiation">
        <p class="subtle">@detail.BusinessNumber · @detail.Title</p>
        <EditForm Model="negotiation" FormName="procurement-v2-negotiation" OnValidSubmit="SaveNegotiationAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="pq2-form-grid">
                <label class="field"><span>Канал</span><input @bind="negotiation.Channel" maxlength="100" /></label>
                <label class="field"><span>Контакт</span><input @bind="negotiation.Contact" maxlength="200" /></label>
                <label class="field"><span>Результат</span><input @bind="negotiation.Outcome" maxlength="500" /></label>
                <label class="field"><span>Дата контакта (МСК)</span><input type="datetime-local" @bind="negotiation.Effective" /></label>
                <label class="field"><span>Цена продавца</span><InputNumber @bind-Value="negotiation.SellerPrice" /></label>
                <label class="field"><span>Наше предложение</span><InputNumber @bind-Value="negotiation.BuyerOffer" /></label>
                <label class="field"><span>Согласованная цена</span><InputNumber @bind-Value="negotiation.AgreedPrice" /></label>
                <label class="field"><span>Следующий шаг</span><input @bind="negotiation.NextStep" maxlength="500" /></label>
                <label class="field pq2-form-wide"><span>Условия</span><textarea @bind="negotiation.Conditions" maxlength="2000"></textarea></label>
                <label class="field pq2-form-wide"><span>Комментарий</span><textarea @bind="negotiation.Comment" maxlength="4000"></textarea></label>
                <label class="field"><span>Срок следующего шага (МСК)</span><input type="datetime-local" @bind="negotiation.NextStepDue" /></label>
            </div>
            <div class="pq2-atomic-todo" title="Текущий AddNegotiationAsync не возвращает NegotiationId для atomic attachment save.">
                TODO-BACKEND-PROCUREMENT · вложения в том же сохранении переговоров пока недоступны. После сохранения вложение можно добавить в полной карточке.
            </div>
            <div class="form-actions"><button type="button" class="pq2-button pq2-button-secondary" @onclick="CloseNegotiation">Отмена</button><button type="submit" class="pq2-button pq2-button-primary" disabled="@Busy">Сохранить</button></div>
        </EditForm>
    </Modal>
}

@code {
    private ProcurementQueueV2Page? page;
    private ProcurementQueueV2Detail? detail;
    private Guid? selectedCaseId;
    private bool drawerLoading;
    private string? drawerError;

    private string searchDraft = "";
    private string search = "";
    private string stageFilter = "";
    private string assigneeFilter = "";
    private string sourceFilter = "";
    private string checksFilter = nameof(ProcurementQueueV2CheckFilter.Any);
    private string sort = nameof(ProcurementQueueV2Sort.RecordedAt);
    private bool sourceChangedOnly;
    private bool dueTodayOnly;
    private bool overdueOnly;
    private int offset;
    private const int PageSize = 30;

    private CaseCard? decisionCard;
    private ProcurementAction decisionAction;
    private bool negotiationOpen;
    private NegotiationDraft negotiation = new();

    protected override async Task ReadAsync()
    {
        page = await ReadModel.ReadPageAsync(CurrentSubject, BuildFilter(), CancellationToken.None);
        if (selectedCaseId is Guid caseId)
            detail = await ReadModel.ReadDetailAsync(CurrentSubject, caseId, CancellationToken.None);
    }

    private ProcurementQueueV2Filter BuildFilter()
    {
        Guid? assignee = Guid.TryParse(assigneeFilter, out Guid assigneeId) ? assigneeId : null;
        CatalogSource? source = Enum.TryParse(sourceFilter, out CatalogSource parsedSource) ? parsedSource : null;
        ProcurementQueueV2CheckFilter checks = Enum.TryParse(checksFilter, out ProcurementQueueV2CheckFilter parsedChecks) ? parsedChecks : ProcurementQueueV2CheckFilter.Any;
        ProcurementQueueV2Sort parsedSort = Enum.TryParse(sort, out ProcurementQueueV2Sort queueSort) ? queueSort : ProcurementQueueV2Sort.RecordedAt;
        return new(search, stageFilter, assignee, source, sourceChangedOnly, dueTodayOnly, overdueOnly, checks, parsedSort, true, offset, PageSize);
    }

    private bool HasFilters => search.Length > 0 || stageFilter.Length > 0 || assigneeFilter.Length > 0 || sourceFilter.Length > 0
        || checksFilter != nameof(ProcurementQueueV2CheckFilter.Any) || sourceChangedOnly || dueTodayOnly || overdueOnly;

    private string PageCaption => page == null || page.Total == 0 ? "0 объектов" : $"{page.Offset + 1}–{Math.Min(page.Offset + page.Size, page.Total)} из {page.Total}";

    private async Task ApplySearchAsync() { search = searchDraft.Trim(); offset = 0; await ReloadAsync(); }
    private async Task SearchKeyDownAsync(KeyboardEventArgs args) { if (args.Key == "Enter") await ApplySearchAsync(); }
    private async Task StageChangedAsync(ChangeEventArgs e) { stageFilter = e.Value?.ToString() ?? ""; offset = 0; await ReloadAsync(); }
    private async Task AssigneeChangedAsync(ChangeEventArgs e) { assigneeFilter = e.Value?.ToString() ?? ""; offset = 0; await ReloadAsync(); }
    private async Task SourceChangedAsync(ChangeEventArgs e) { sourceFilter = e.Value?.ToString() ?? ""; offset = 0; await ReloadAsync(); }
    private async Task ChecksChangedAsync(ChangeEventArgs e) { checksFilter = e.Value?.ToString() ?? nameof(ProcurementQueueV2CheckFilter.Any); offset = 0; await ReloadAsync(); }
    private async Task SortChangedAsync(ChangeEventArgs e) { sort = e.Value?.ToString() ?? nameof(ProcurementQueueV2Sort.RecordedAt); offset = 0; await ReloadAsync(); }
    private async Task ToggleSourceChangedAsync() { sourceChangedOnly = !sourceChangedOnly; offset = 0; await ReloadAsync(); }
    private async Task ToggleDueTodayAsync() { dueTodayOnly = !dueTodayOnly; if (dueTodayOnly) overdueOnly = false; offset = 0; await ReloadAsync(); }
    private async Task ToggleOverdueAsync() { overdueOnly = !overdueOnly; if (overdueOnly) dueTodayOnly = false; offset = 0; await ReloadAsync(); }
    private async Task ShowReturnedAsync() { stageFilter = stageFilter == "returned" ? "" : "returned"; offset = 0; await ReloadAsync(); }
    private async Task ResetOperationalFiltersAsync() { stageFilter = ""; dueTodayOnly = false; overdueOnly = false; sourceChangedOnly = false; offset = 0; await ReloadAsync(); }
    private async Task ClearFiltersAsync()
    {
        search = searchDraft = stageFilter = assigneeFilter = sourceFilter = "";
        checksFilter = nameof(ProcurementQueueV2CheckFilter.Any);
        sourceChangedOnly = dueTodayOnly = overdueOnly = false;
        offset = 0;
        await ReloadAsync();
    }
    private async Task PreviousPageAsync() { offset = Math.Max(0, offset - PageSize); await ReloadAsync(); }
    private async Task NextPageAsync() { if (page != null && offset + PageSize < page.Total) { offset += PageSize; await ReloadAsync(); } }

    private async Task OpenDrawerAsync(Guid caseId)
    {
        selectedCaseId = caseId; detail = null; drawerError = null; drawerLoading = true;
        try { detail = await ReadModel.ReadDetailAsync(CurrentSubject, caseId, CancellationToken.None); }
        catch (AccessDeniedException) { drawerError = "Нет доступа к этому объекту."; }
        catch (Exception) { drawerError = "Не удалось загрузить объект. Повторите после восстановления соединения."; }
        finally { drawerLoading = false; }
    }
    private void CloseDrawer() { selectedCaseId = null; detail = null; drawerError = null; decisionCard = null; negotiationOpen = false; }

    private void OpenFullCase() { if (detail != null) Navigation.NavigateTo($"/procurement/{detail.CaseId}"); }
    private void OpenInspection() { if (detail != null) Navigation.NavigateTo($"/procurement/{detail.CaseId}/inspection"); }

    private async Task OpenDecisionAsync(ProcurementAction action)
    {
        if (detail == null) return;
        drawerError = null;
        try { decisionAction = action; decisionCard = await Workspace.ReadCardAsync(CurrentSubject, detail.CaseId, CancellationToken.None); }
        catch (AccessDeniedException) { drawerError = "Нет права на это решение."; }
        catch (Exception) { drawerError = "Не удалось подготовить действие."; }
    }
    private void CloseDecision() => decisionCard = null;
    private async Task ConfirmDecisionAsync(DecisionDraft draft)
    {
        if (decisionCard == null) return;
        CaseCard card = decisionCard;
        await ExecuteAsync(() => Workspace.DecideAsync(CurrentSubject,
            new DecisionCommand(card.Item.CaseId, card.Item.CaseVersion, card.Item.SourceRevision, decisionAction,
                draft.Reason, draft.Clarification, draft.Target, ProcurementLabels.ParseLocal(draft.Due)),
            Correlation(), CancellationToken.None));
        if (Error == null) decisionCard = null;
    }

    private void OpenNegotiation()
    {
        if (detail == null || !detail.CanManageDossier) return;
        negotiation = new() { Effective = ProcurementLabels.LocalInput(DateTimeOffset.UtcNow) };
        negotiationOpen = true;
    }
    private void CloseNegotiation() => negotiationOpen = false;
    private async Task SaveNegotiationAsync()
    {
        if (detail == null) return;
        Guid caseId = detail.CaseId;
        long version = detail.CaseVersion;
        await ExecuteAsync(async () =>
        {
            DateTimeOffset effective = ProcurementLabels.ParseLocal(negotiation.Effective) ?? DateTimeOffset.UtcNow;
            DateTimeOffset? nextDue = ProcurementLabels.ParseLocal(negotiation.NextStepDue);
            await Workspace.AddNegotiationAsync(CurrentSubject,
                new AddNegotiation(caseId, version, negotiation.SellerPrice, negotiation.BuyerOffer, negotiation.AgreedPrice,
                    negotiation.Channel, negotiation.Contact, negotiation.Outcome, negotiation.Conditions, negotiation.Comment,
                    negotiation.NextStep, nextDue, effective), Correlation(), CancellationToken.None);
        });
        if (Error == null) negotiationOpen = false;
    }

    private async Task ApplySourceFactAsync(ProcurementSourceDetail source, CaseFactField field)
    {
        if (detail == null) return;
        Guid caseId = detail.CaseId;
        long version = detail.CaseVersion;
        await ExecuteAsync(() => Workspace.ApplySourceFactAsync(CurrentSubject,
            new ApplySourceFact(caseId, source.CatalogItemId, version, field), Correlation(), CancellationToken.None));
    }

    private static string Correlation() => $"procurement-v2-{Guid.NewGuid():N}";
    private static string DecisionTitle(ProcurementAction action) => action switch
    {
        ProcurementAction.Forward => "Передать руководителю",
        ProcurementAction.Return => "Вернуть менеджеру",
        ProcurementAction.Approve => "Продолжить работу",
        ProcurementAction.Reject => "Не подходит",
        _ => "Решение"
    };

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string Money(decimal? value) => value == null ? "—" : ProcurementLabels.Money(value);
    private static string Area(decimal? value) => value == null ? "—" : ProcurementLabels.Area(value);
    private static string ShortDate(DateTimeOffset? value) => value == null ? "—" : ProcurementLabels.Time(value).Split(' ')[0];
    private static string ShortDateTime(DateTimeOffset value) => ProcurementLabels.Time(value).Replace(" МСК", "", StringComparison.Ordinal);
    private static string JoinNonEmpty(string first, string second) => string.Join(" · ", new[] { first, second }.Where(item => !string.IsNullOrWhiteSpace(item)));
    private static string ContactCaption(ProcurementLatestContact item) => JoinNonEmpty(item.Channel, item.Outcome);
    private static string Initials(string name)
    {
        string[] parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return string.Concat(parts.Take(2).Select(item => char.ToUpperInvariant(item[0])));
    }
    private static string DueText(DateTimeOffset? dueAt, ProcurementDueState state) => state switch
    {
        ProcurementDueState.Overdue => $"Просрочено · {ShortDate(dueAt)}",
        ProcurementDueState.Today => $"Сегодня · {ShortDate(dueAt)}",
        ProcurementDueState.Normal => ShortDate(dueAt),
        _ => "Срок не задан"
    };
    private static string DueClass(ProcurementDueState state) => state switch
    {
        ProcurementDueState.Overdue => "is-overdue",
        ProcurementDueState.Today => "is-today",
        _ => ""
    };
    private static string RowClass(ProcurementQueueV2RowState state) => $"pq2-row pq2-row-{state.ToString().ToLowerInvariant()}";
    private static string CheckCompact(ProcurementQuickCheckSummary check) => check.Total == 0
        ? "Не начаты"
        : check.Issues > 0 ? $"{check.Completed}/{check.Total} · проблем {check.Issues}" : $"{check.Completed}/{check.Total} · осталось {check.Remaining}";
    private static string CheckLevelText(ProcurementCheckLevelSummary check) => check.Total == 0
        ? "Не начаты"
        : check.Issues > 0 ? $"{check.Completed}/{check.Total} · проблем {check.Issues}" : $"{check.Completed}/{check.Total} · осталось {check.Remaining}";
    private static string ResponsibleText(ProcurementCheckLevelSummary check) => check.Responsible.Count == 0 ? "Ответственный не назначен" : string.Join(", ", check.Responsible);

    private sealed class NegotiationDraft
    {
        [Required, MaxLength(100)] public string Channel { get; set; } = "Телефон";
        [MaxLength(200)] public string Contact { get; set; } = "";
        [MaxLength(500)] public string Outcome { get; set; } = "";
        [MaxLength(2000)] public string Conditions { get; set; } = "";
        [MaxLength(4000)] public string Comment { get; set; } = "";
        [MaxLength(500)] public string NextStep { get; set; } = "";
        public decimal? SellerPrice { get; set; }
        public decimal? BuyerOffer { get; set; }
        public decimal? AgreedPrice { get; set; }
        public string Effective { get; set; } = "";
        public string NextStepDue { get; set; } = "";
    }
}
