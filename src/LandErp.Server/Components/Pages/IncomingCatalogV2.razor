    private readonly Dictionary<Guid, long> calculationSelected = [];
    private bool allCalculationResults;
    private readonly HashSet<Guid> calculationExcluded = [];
    private string? calculationScope;
    private int calculationTotal;
    private string? selectedCohortStamp;
    private int CalculationCount => allCalculationResults ? Math.Max(0, calculationTotal - calculationExcluded.Count) : calculationSelected.Count;
    private bool IsCalculationSelected(Guid id) => allCalculationResults ? !calculationExcluded.Contains(id) : calculationSelected.ContainsKey(id);
    private bool PageAllSelected => catalogPage?.Items.Count > 0 && catalogPage.Items.All(x => IsCalculationSelected(x.Id));
    private bool PageSomeSelected => catalogPage?.Items.Any(x => IsCalculationSelected(x.Id)) == true;
    private void ClearCalculationSelection() { calculationSelected.Clear(); calculationExcluded.Clear(); allCalculationResults = false; selectedCohortStamp = null; }
    private void SelectAllCalculation() { ClearCalculationSelection(); allCalculationResults = true; calculationTotal = catalogPage?.Total ?? 0; }
    private void ToggleCalculationPage() { bool select = !PageAllSelected; foreach (var item in catalogPage!.Items) SelectCalculationItem(item, select); }

    private bool calculationPreviewBusy;
    private bool calculationInclude;
    private CatalogCalculationSelection? calculationSelection;
    private CatalogCalculationPreview? calculationPreview;

    private void SelectCalculationItem(CatalogItemView item, bool selected)
    {
        if (allCalculationResults) { selectedCohortStamp = null; if (selected) calculationExcluded.Remove(item.Id); else calculationExcluded.Add(item.Id); return; }
        if (selected) calculationSelected[item.Id] = item.Version;
        else calculationSelected.Remove(item.Id);
    }

    private async Task ToggleCalculationAsync(CatalogItemView item)
    {
        if (!CanManageCurrentZoneCalculation || CurrentCalculationGroupId is not Guid searchGroupId)
        {
            ShowValidationError("Выберите доступную зону поиска для изменения медианы.");
            return;
        }
        CatalogCalculationResult? result = null;
        bool saved = await ExecuteConfirmedAsync(async () => result = await Calculation.SetAsync(CurrentSubject,
            new(item.Id, item.Version, searchGroupId), !item.IncludeInCalculation,
            Guid.CreateVersion7().ToString(), CancellationToken.None));
        if (saved && result != null) Success = result.Ineligible>0?"Объявление не подходит для расчёта медианы.":null;
    }

    private async Task PreviewCalculationAsync(bool include)
    {
        if (renderedCalculationFilter == null || calculationPreviewBusy || Busy
            || !CanManageCurrentZoneCalculation || CurrentCalculationGroupId is not Guid searchGroupId) return;
        calculationPreviewBusy = true;
        try
        {
            calculationSelection = new(renderedCalculationFilter, allCalculationResults ? null
                : calculationSelected.Select(item => new CatalogCalculationTarget(item.Key, item.Value, searchGroupId)).ToArray(),
                allCalculationResults ? calculationExcluded.ToArray() : null);
            calculationInclude = include;
            calculationPreview = await Calculation.PreviewAsync(CurrentSubject, calculationSelection, include, CancellationToken.None);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException) { ShowValidationError("Отбор или объявления изменились. Обновите список и выберите строки заново."); }
        catch (AccessDeniedException) { ShowValidationError("Нет права обработки входящих."); }
        catch (Exception exception) { ShowValidationError(ReadFailure(exception, "Не удалось проверить количество объявлений.")); }
        finally { calculationPreviewBusy = false; }
    }

    private async Task ApplyCalculationAsync()
    {
        if (calculationSelection == null || calculationPreview == null) return;
        CatalogCalculationResult? result = null;
        bool saved = await ExecuteConfirmedAsync(async () => result = await Calculation.ApplyAsync(CurrentSubject,
            calculationSelection, calculationInclude, calculationPreview.Stamp, Guid.CreateVersion7().ToString(), CancellationToken.None));
        if (saved && result != null)
        {
            calculationPreview = null;
            ClearCalculationSelection();
            Success = CalculationResultText(result);
        }
    }

